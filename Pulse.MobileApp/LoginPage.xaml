<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pulse.MobileApp.LoginPage"
             Title="Pulse Login"
             BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1f1f1f}">

    <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Center">

        <!-- Logo/Title -->
        <Label 
            Text="Pulse"
            FontSize="48"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center"
            TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}" />

        <Label 
            Text="Production Management System"
            FontSize="14"
            HorizontalTextAlignment="Center"
            TextColor="{AppThemeBinding Light=#666666, Dark=#cccccc}" />

        <!-- Spacer -->
        <BoxView HeightRequest="20" Color="Transparent" />

        <!-- Email Input -->
        <Label Text="Email" FontAttributes="Bold" FontSize="14" />
        <Entry 
            x:Name="EmailEntry"
            Placeholder="Enter your email"
            Keyboard="Email"
            PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#666666}"
            TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}"
            BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#2a2a2a}" />

        <!-- Password Input -->
        <Label Text="Password" FontAttributes="Bold" FontSize="14" Margin="0,10,0,0" />
        <Entry 
            x:Name="PasswordEntry"
            Placeholder="Enter your password"
            IsPassword="True"
            PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#666666}"
            TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}"
            BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#2a2a2a}" />

        <!-- Login Button -->
        <Button 
            x:Name="LoginButton"
            Text="Login"
            Clicked="OnLoginClicked"
            BackgroundColor="#007AFF"
            TextColor="White"
            CornerRadius="8"
            Padding="0,15"
            FontSize="16"
            FontAttributes="Bold"
            Margin="0,20,0,0" />

        <!-- Loading Indicator -->
        <ActivityIndicator 
            x:Name="LoadingIndicator"
            IsRunning="False"
            IsVisible="False"
            Color="#007AFF"
            Margin="0,20,0,0" />

        <!-- Error Message -->
        <Label 
            x:Name="ErrorLabel"
            Text=""
            TextColor="Red"
            IsVisible="False"
            FontSize="12"
            HorizontalTextAlignment="Center"
            Margin="0,10,0,0" />

    </VerticalStackLayout>

</ContentPage>