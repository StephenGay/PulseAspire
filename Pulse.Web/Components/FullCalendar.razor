@inject IJSRuntime JS
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web
@using Pulse.Models.CustomComponents

<div id="@ElementId" class="fc-container"></div>

@code {
    [Parameter] public string ElementId { get; set; } = "fc";
    [Parameter] public IEnumerable<CalendarEvent> Events { get; set; } = Array.Empty<CalendarEvent>();

    // These are the callbacks from JS
    [Parameter] public EventCallback<string> DateClicked { get; set; }
    [Parameter] public EventCallback<string> EventClicked { get; set; }

    private IJSObjectReference? module;
    private DotNetObjectReference<FullCalendar>? dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/fullcalendar.js");

            var json = JsonSerializer.Serialize(Events,
                new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });

            await module.InvokeVoidAsync("initFullCalendar", dotNetRef, ElementId, json);
        }
    }

    // These are called from JavaScript
    [JSInvokable]
    public Task HandleDateClick(string isoDate) => DateClicked.InvokeAsync(isoDate);

    [JSInvokable]
    public Task HandleEventClick(string eventId) => EventClicked.InvokeAsync(eventId);

    public async ValueTask DisposeAsync()
    {
        if (module is not null) await module.DisposeAsync();
        dotNetRef?.Dispose();
    }
}

<style>
    .fc-container {
        height: 680px;
    }
</style>