@using Pulse.Web.Services
@rendermode InteractiveServer

<div class="divShadow pulse-toast pulse-toast-@(Message.Level.ToString().ToLower())" 
     style="animation: slideIn 0.3s ease-out; --toast-bottom: @($"{ToastIndex * 120 + 20}px")">
    <div class="pulse-toast-content">
        <div class="pulse-toast-header">
            <span class="pulse-toast-icon">@GetStatusIcon()</span>
            @if (!string.IsNullOrEmpty(Message.Title))
            {
                <strong class="pulse-toast-title">@Message.Title</strong>
            }
            <button type="button" class="pulse-toast-close" @onclick="HandleDismiss" style="cursor: pointer; pointer-events: auto;">×</button>
        </div>

        <div class="pulse-toast-body">
            <div class="pulse-toast-message-container">
                <div class="pulse-toast-message">
                    @if (Message.IsHtml)
                    {
                        @((MarkupString)Message.Message)
                    }
                    else
                    {
                        @Message.Message
                    }
                </div>
                <div class="pulse-toast-emoji">
                    @if (Message.AiEmoji == "PulseAI")
                    {
                        <img src="Images/AI/PulseAI_Female.jpg" alt="PulseAI" style="width: 70px; height: 40px; border-radius: 4px;" />
                    }
                    else
                    {
                        @GetEmojiDisplay()
                    }
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    [Parameter] public PulseToastMessage Message { get; set; } = default!;
    [Parameter] public EventCallback<Guid> OnClose { get; set; }
    [Parameter] public int ToastIndex { get; set; } = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Message != null)
        {
            // await Task.Delay(Message.AutoHideMs);
            // await HandleDismiss();
        }
    }

    private string GetEmojiDisplay() => Message.AiEmoji switch
    {
        "Tables" => "👨‍💻",
        "Ali" => "🕵️",
        "Flapper" => "👩‍🎓",
        _ => "🤖"
    };

    private string GetStatusIcon() => Message.Level switch
    {
        ToastLevel.Success => "✓",
        ToastLevel.Information => "ℹ",
        ToastLevel.Warning => "⚠",
        ToastLevel.Error => "✕",
        _ => "●"
    };

    private async Task HandleDismiss()
    {
        System.Console.WriteLine($"[PulseToast] HandleDismiss called - Toast ID: {Message.Id}");
        if (OnClose.HasDelegate)
        {
            System.Console.WriteLine($"[PulseToast] Invoking OnClose callback with ID: {Message.Id}");
            await OnClose.InvokeAsync(Message.Id);
            System.Console.WriteLine($"[PulseToast] OnClose callback completed");
        }
        else
        {
            System.Console.WriteLine($"[PulseToast] ERROR: OnClose callback not set!");
        }
    }
}
