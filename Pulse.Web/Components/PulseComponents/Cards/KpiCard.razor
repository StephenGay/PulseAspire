<RadzenCard class="rz-p-4" style="height: 100%;">
    <RadzenRow AlignItems="AlignItems.Center" Gap="1rem">
        <RadzenIcon Icon="@Icon" 
                    Style="@($"color: {Color}; font-size: 2.2rem;")" />
        <div>
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">@Title</RadzenText>
            <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">@Value</RadzenText>
        </div>
    </RadzenRow>
</RadzenCard>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public int Value { get; set; }
    [Parameter] public string Icon { get; set; } = "insights";
    [Parameter] public string Color { get; set; } = "#3b82f6";
}