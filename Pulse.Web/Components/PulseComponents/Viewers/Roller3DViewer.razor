@using BlazorThreeJS.Viewers
@using BlazorThreeJS.Objects
@using BlazorThreeJS.Geometires @* Important: use Geometries, not BufferGeometry directly *@
@using BlazorThreeJS.Materials
@using BlazorThreeJS.Lights
@using BlazorThreeJS.Core
@using BlazorThreeJS.Maths
@using Pulse.Models.Customers
@using Pulse.Web.Services

@inject DataTransferService DTrf
@rendermode InteractiveServer

<FluentCard>
    <ViewerThreeD @ref="viewer"
                  CanvasWidth="1800"
                  CanvasHeight="650"
                  SceneName="RollerScene"
                   />
</FluentCard>

@code {
    private ViewerThreeD? viewer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && viewer != null)
        {
            await CreateRollerSceneAsync();
            await InvokeAsync(() => StateHasChanged());  // Ensure UI updates after scene creation
        }
    }

    private async Task CreateRollerSceneAsync()
    {
        if (viewer == null) return;

        // Clear any previous scene content (good practice when data changes)
        //await viewer.ActiveScene.ClearAll();
        viewer.ActiveScene.BackGroundColor = "#1e1e2e";
        var roller = await DTrf.GetgvSelectedRollSpec();

        if (roller?.ShellDiameter == null || roller.ShellLength == null)
        {
            System.Console.WriteLine("DEBUG: No roller data loaded");
            return;
        }
        System.Console.WriteLine($"DEBUG: Roller - Diameter: {roller.ShellDiameter}, Length: {roller.ShellLength}");
        float radius = (float)roller.ShellDiameter / 2f;
        float height = (float)roller.ShellLength;

        // 1. Create Cylinder Geometry
        var geometry = new CylinderGeometry
        {
            RadiusTop = radius,
            RadiusBottom = radius,
            Height = height,
            RadialSegments = 64,           // smoother look
            HeightSegments = 4
            //,
            //OpenEnded = false
        };
        
        // 2. Create Material (MeshStandardMaterial works well with lights)
        var material = new MeshStandardMaterial
        {
            Color = "#a8b5c0",
            Metalness = 0.78f,
            Roughness = 0.32f
        };

        // 3. Create the Mesh
        var rollerMesh = new Mesh3D
        {
            Name = "Roller",
            Geometry = geometry,
            Material = material,
            Transform = new Transform3("RollerTransform")
            {
                Position = new Vector3(0, height / 2f, 0),     // sits on top of the floor
                Rotation = new Euler(MathF.PI / 2, 0, 0),   // or MathF.PI / 2 if you want it horizontal
                // Scale = Vector3.One
                Scale = new Vector3(3f, 3f, 3f)
                //Position = new Vector3(0, 5, 0)
            }
        };

        // 4. Add the roller to the scene
        
        viewer.ActiveScene.AddChild(rollerMesh);

        // 5. Add helpful lights (very important – without lights the object may be black)
        viewer.ActiveScene.AddChild(new AmbientLight { Color = "#ffffff", Intensity = 0.75f });
        viewer.ActiveScene.AddChild(new PointLight
        {
            Intensity = 3.8f,
            Color = "#ffffff",
            Distance = 200f          // optional - how far the light reaches
        });
        viewer.ActiveScene.AddChild(new PointLight
        {
            Intensity = 2.0f,
            Color = "#e0f0ff",
            Distance = 150f
        });

        // 6. Optional: add a floor/grid for reference
        var floor = new Mesh3D
        {
            Name = "Floor",
            Geometry = new PlaneGeometry
            {
                Width = MathF.Max(150, height * 5),
                Height = MathF.Max(150, height * 5)
            },
            Material = new MeshStandardMaterial
            {
                Color = "#2a2a2a",
                Roughness = 1f
            },
            Transform = new Transform3("FloorTransform")
            {
                Position = new Vector3(0, -0.05f, 0),
                Rotation = new Euler(-MathF.PI / 2, 0, 0)
            }
        };
        viewer.ActiveScene.AddChild(floor);

        // 7. Enable orbit controls so user can rotate/zoom
        viewer.OrbitControls.Enabled = true;
        // await viewer.EnableOrbitControlsAsync();
        await viewer.ActiveScene.SetCameraPosition(new Vector3(0, height * 1.4f, height * 5.5f));   // nice starting view
        /* await viewer.SetCameraPositionAsync(new Vector3(0, 5, 15));  */  // nice starting view
        await InvokeAsync(() => StateHasChanged());
    }

    // Optional: expose a method to refresh when the selected roller changes
    public async Task RefreshRollerAsync()
    {
        if (viewer != null)
            await CreateRollerSceneAsync();
    }
}