@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Models.Api
@using Pulse.Models.Users
@using Pulse.Web.Services

@inject PulseApiService pApi
@inject DataTransferService dTrf
@inject PulseThemeService PulseThemeService
@inject IPulseToastService pulseToastService
@inject Global_AI_Functions GlobalAIFunctions
@inject AppState AppState

<FluentDesignTheme StorageName="themePulse" @bind-Mode="@thMode" />

<FluentLabel Typo="Typography.Body" Color="MsFluent.Color.Custom" CustomColor="var(--pulse-dark-colour)">Theme</FluentLabel>
<div class="theme-switcher">
<FluentSelect TOption="string" 
                Value="@selectedTheme"
                ValueChanged="(newVal => ChangeTheme(newVal))"
                Position="SelectPosition.Below"
              Width="200px"
                  Style="border:1px solid var(--pulse-dark-colour); transition: all 0.3s ease;">
    <FluentOption Value="pulse">Pulse</FluentOption>
    <FluentOption Value="hm">H&amp;M Rollers</FluentOption>
    <FluentOption Value="ocean">Ocean</FluentOption>
    <FluentOption Value="space">Space</FluentOption>
</FluentSelect>
    <FluentButton Appearance="Appearance.Stealth" Class="modeButton" @onclick="ToggleTheme" Style="border:1px solid var(--pulse-dark-colour); margin-left: 8px">
    @if (!IsDarkMode)
    {
        <!-- Sun Icon (Light Mode) -->
        <FluentIcon Class="modeIcon" Value="@(new Icons.Filled.Size24.WeatherSunny().WithColor("#fbbf24"))" />
    }
    else
    {
        <!-- Moon Icon (Dark Mode) -->
        <FluentIcon Class="modeIcon" Value="@(new Icons.Filled.Size24.WeatherMoon().WithColor("#64748b"))" />
    }

</FluentButton>
</div>
    @* IconStart="@(IsDarkMode ? new Icons.Regular.Size24.WeatherSunny() : new Icons.Regular.Size24.WeatherMoon())" /> *@


@code {
    private string selectedTheme = "pulse";
    private ApplicationUserSettings? uSettings;
    private bool IsDarkMode = true;
    private DesignThemeModes thMode;

    protected override async Task OnInitializedAsync()
    {
        uSettings = await dTrf.GetgvUserSettings();
        var saved = uSettings?.UserTheme ?? "pulse-dark";
        IsDarkMode = saved.EndsWith("-dark");
        thMode = IsDarkMode ? DesignThemeModes.Dark : DesignThemeModes.Light;

        if (!string.IsNullOrEmpty(saved))
            selectedTheme = saved.Replace("-dark", "");
    }

    private async Task ToggleTheme()
    {
        IsDarkMode = !IsDarkMode;
        thMode = IsDarkMode ? DesignThemeModes.Dark : DesignThemeModes.Light;
        await OnThemeChanged();
    }
    private async Task ChangeTheme(string newVal)
    {
        selectedTheme = newVal;
        await OnThemeChanged();
    }
    private async Task OnThemeChanged()
    {
        bool isSaved = false;
        try
        {
            uSettings = await dTrf.GetgvUserSettings();
            uSettings.UserTheme = selectedTheme + (IsDarkMode ? "-dark" : "");
            isSaved = await pApi.PutAsync<ApplicationUserSettings>(ApiEndpoints.User.Settings.Update, uSettings);
            if (isSaved)
            {
                await dTrf.SetgvUserSettings(uSettings);
                await PulseThemeService.SetThemeAsync(selectedTheme + (IsDarkMode ? "-dark" : ""));
                await AppState.NotifyThemeChanged();
            }
        }
        catch (Exception ex)
        {
            isSaved = false;
        }
        finally
        {
            if (!isSaved)
            {
                var errMsg = "There was an error saving your theme.<br />Please try again.";
                pulseToastService.ShowToast("Error", errMsg,true);
                await GlobalAIFunctions.AISpeak(errMsg, "PulseAI");
                selectedTheme = uSettings?.UserTheme ?? "pulse";
            }
            StateHasChanged();
        }
    
        
    }
}