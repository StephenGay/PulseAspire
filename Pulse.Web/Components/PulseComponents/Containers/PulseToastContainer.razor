@using Pulse.Web.Components.PulseComponents.Cards
@using Pulse.Web.Services
@implements IAsyncDisposable
@inject IPulseToastService PulseToastService
@rendermode InteractiveServer
<div class="pulse-toast-container">
    @{
        var toasts = _activeMessages.ToList();
        for (int i = 0; i < toasts.Count; i++)
        {
            var msg = toasts[i];
            <PulseToast Message="msg" ToastIndex="i" OnClose="() => RemoveToast(msg.Id)" />
        }
    }
</div>

@code {
    private List<PulseToastMessage> _activeMessages = new();

    protected override void OnInitialized()
    {
        PulseToastService.OnShow += HandleToastShow;
    }

    private void HandleToastShow(PulseToastMessage msg)
    {
        _ = InvokeAsync(async () =>
        {
            _activeMessages.Add(msg);
            StateHasChanged();

            // Auto-dismiss after delay
            await Task.Delay(msg.AutoHideMs);
            RemoveToast(msg.Id);
        });
    }

    private void RemoveToast(Guid id)
    {
        _activeMessages.RemoveAll(m => m.Id == id);
        StateHasChanged();
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        PulseToastService.OnShow -= HandleToastShow;
    }
}