@inherits LayoutComponentBase

@using Microsoft.AspNetCore.Components.Authorization
@using Pulse.Models.Api
@using Pulse.Models.Dtos.Production
@using Pulse.Models.Organizational
@using Pulse.Models.Production.Layout
@using Pulse.Web.Services


@inject DataTransferService dTrf
@inject PulseApiService pApiClient
@inject ProductionStateService State
@inject MessageHubService msgHubService

@layout MasterLayout
@rendermode InteractiveServer

<div class="PulseZoneParent">
    <CascadingValue Value="State">
        <div class="PulseZoneMenubar">
            <Production_Nav_Menu />
        </div>
        <div class="PulseZoneContent">
            @Body
        </div>
    </CascadingValue>
</div>

@code{
    [CascadingParameter]
    public MasterLayout masterLayout { get; set; } = default!;

    private bool isLoading = true;
    private Division? d;
    private List<FactoryZone> zones = new();
    private List<ProductionPlanDto> productionPlanItems = new();

    protected override async Task OnInitializedAsync()
    {
        await RefreshData();

         // Attach a handler that matches Action<ProductionStreamMessageDto>
        msgHubService.OnProductionStreamBroadcast += HandleProductionStreamMessage;
    }

    /// <summary>
    /// Event‑handler invoked when the message hub broadcasts a
    /// ProductionStreamMessageDto.  The payload is ignored – we simply
    /// reload data.
    /// </summary>
    private async void HandleProductionStreamMessage(ProductionStreamMessageDto _)
    {
        await RefreshData();
    }

    private async Task RefreshData()
    {
        isLoading = true;
        d = await dTrf.GetgvSelectedDivision();

        var zonesResponse =
            await pApiClient.GetAsync<ApiResponse<List<FactoryZone>>>(
                ApiEndpoints.Divisions.WithDivisionID.Factory.FactoryLayout.Zones.GetAllWithSubzones(d!.DivisionID));

        State.UpdateZones(zonesResponse?.Data ?? new());

        var planResponse =
            await pApiClient.GetAsync<ApiResponse<List<ProductionPlanDto>>>(
                ApiEndpoints.Production.WorkInProgress.ByDivision.Plan.GetTodaysItems(d.DivisionID));

        State.UpdateProductionPlanItems(planResponse?.Data ?? new());

        isLoading = false;
    }
}
