    private async Task GenerateSalesPrompt()
    {
        if (customer == null || customer.ClientSales == null)
        {
            await SendToast("Error", "No Data", "Client or sales data not loaded.");
            sState = "IDLE";
            return;
        }

        qry = $"This is the sales history for customer {customer.ClientName}. {qry}";

        fileName = $"{customer.FullClientID}-{Hdr.Replace(" ", "_")}";

        var dataText = JsonSerializer.Serialize(customer.ClientSales.ToList(), new JsonSerializerOptions { WriteIndented = true });

        var prompt = $@"""
                You will be given the sales history for a customer. You are a financial analysist and will examine the data and provide
                meaninful responses to the user query provided.

                The query will include the customers name which is to be used when referencing the customer, not the client id.
                The data also includes a sub-object providing details on the period. When referencing periods use the month-calenderyear
                not the PeriodID. If the user seems to be Refering to Financial Year then use the Financial Year, state in your response which year
                field you are using.

                Unless it is specifically asked for in the query, do not include the period sales amounts, just the analysis.
                Note: All Sales Amounts are in ZAR (South African Rands)

                Data:
    {dataText}

                Query: {qry}
                """;
        await ProcessRequest(prompt);

    }

    private async Task GenerateProductionPrompt()
    {
        ClientRollerSpecification? rollerSpec = await dataTrf.GetgvSelectedRollSpec();

        if (rollerSpec == null)
        {
            await SendToast("Error", "No Data", "Roller Spec not loaded.");
            sState = "IDLE";
            return;
        }

        // qry = $"This is the Roller Specification for customer . {qry}";

        fileName = $"{customer.FullClientID}-{Hdr.Replace(" ", "_")}";

        var dataText = JsonSerializer.Serialize(rollerSpec, new JsonSerializerOptions { WriteIndented = true });

        var prompt = $@"""
                You area an analyst at H&M Rollers, a company that provides services related to industrial rollers. Primarily this is recovering
                rollers with new rubber or polyurethane covers, but also includes manufacturing new rollers from scratch based on customer specifications.
                You will be provided with a roller specification to analyse.

                The contents of the specification is as follows:
                1. The specification itself provides details on the roller's physical characteristics, such as dimensions, materials, and construction methods. This
                   is if a new roller is to be manufactured and a new cover is to be applied.
                2. The actual physical rollers that are worked on are attached as sub-objects within the specification called ClientRoller. These are identified using Roll Numbers where
                   possible.
                3. The ClientRoller objects include all the Work Orders when working on them. These Work Orders have sub-objects for Periods and Work Types. It is important to note
                    the Work Type as rollers may go through a couple of Regrinds before a new cover is applied.

                You are to use the data provided to answer the user query in a meaningful way.Note: Any monetary amounts will be in South African Rands (ZAR).

                The query is for customer {customer.ClientName} ,use the name when referencing the customer, not the client id.
                The data also includes a sub-object providing details on the period. When referencing periods use the month-calenderyear
                not the PeriodID. If the user seems to be Refering to Financial Year then use the Financial Year, state in your response which year
                field you are using.

                Do not include your reasoning in the final response, just the answer.

                The Roller Specification and it's subjects are here followed by the users query.

                Data:
    {dataText}

                Query: {qry}
                """;
        await ProcessRequest(prompt);

    }

    private async Task ProcessRequest(string prompt)
    {
        IsOpen = false;

        switch (useModelVal)
        {
            case 0:
            case 2:
                aiModel = "gpt-oss:latest";
                break;
            case 1:
                aiModel = "llama3.1:latest";
                break;
            case 3:
                aiModel = "llama3.3:latest";
                break;
        }

        try
        {
            sState="BUSY";
            StateHasChanged();

            await SendToast("Information", "Processing...", "Your request is being processed.<br />You will be notified when it is complete.");

            _Analysis = await pAI.AskPulseAIAsync(prompt, aiModel);

            if (_Analysis.StartsWith("Error"))
            {
                await SendToast("Error", "An Error Occured", $"Apologies, an error occurred while processing your request.\n Please try again, maybe with a different AI Model - I won't be offended!");
                ResetState();
                return;
            }

            if (string.IsNullOrEmpty(_Analysis))
            {
                await SendToast("Warning", "Nothing Returned", "Either no data matched your query or there was an error processing your request.\n If there should have been results, please try again, maybe with a different AI Model.");
                ResetState();
                return;
            }

            _Analysis = ParseToHtml(_Analysis);
            
            // fileName = $"{customer.FullClientID}-{Hdr}";
            await SendToast("Success", "Processing Complete", "Your request has been completed and can be viewed when you are ready by clicking the button.");
            sState = "WAIT";

        }
        catch (Exception ex)
        {
            await SendToast("Error", "Exception", ex.Message);
            ResetState();
        }
    }

    private void ResetState()
    {
        qry = LoadHdr = Hdr = _Analysis = fileName = "";
        sState = "IDLE"; 
    }

    private async Task SendToast(string tType, string tTitle, string tContent)
    {
        
        if (useSpeechOutput)
        {
            await SayIt(tContent);
            
        }
            var cat = tType switch
        {
            "Success" => ToastCategory.Success,
            "Information" => ToastCategory.Information,
            "Error" => ToastCategory.Error,
            "Warning" => ToastCategory.Warning,
            _ => ToastCategory.Warning
        };

        await ToastService.Show(new ToastOption
        {
            Category = cat,
            Title = tTitle,
            Content = tContent
        });
    }

    private string ParseToHtml(string markdown)
    {
        var pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
        var html = Markdig.Markdown.ToHtml(markdown, pipeline);
        return AddMUcss(html);
    }

    private string AddMUcss(string html)
    {
        return html
            .Replace("<table>", "<table class=\"table table-striped table-hover table-bordered\">")
            .Replace("<th>", "<th style=\"background-color: #365b66; color: #bcd1d4;\">");
    }
