    protected override async Task OnInitializedAsync()
    {
        if (_authService.IsAuthenticated)
        {
            await MsgHubService.EnsureConnectedAsync();
            MsgHubService.OnReceiveMessage += OnMessageReceived;
            MsgHubService.OnPresenceListUpdated += OnPresenceListUpdated; 
            MsgHubService.OnLoadHistory += OnLoadHistory;
        }

        GlobalAI.OnAISpeakRequested += AISpeak;
    }

    public void Dispose()
    {
        MsgHubService.OnReceiveMessage -= OnMessageReceived;
        MsgHubService.OnPresenceListUpdated -= OnPresenceListUpdated;
        MsgHubService.OnLoadHistory -= OnLoadHistory;
        GlobalAI.OnAISpeakRequested -= AISpeak;
    }

