        PulseMessage newMsg = new PulseMessage
        {
            RecipientUserId = "",
            SenderUserId = _userId,
            SenderUserName = _authService.aspireFullName,
            Content = ""
        };
        _dialog = await DialogService.ShowDialogAsync<NewMessage>(newMsg, new Microsoft.FluentUI.AspNetCore.Components.DialogParameters<PulseMessage>()
        {
            Content = newMsg,
            Alignment = Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center,
            Title = "New Message",
            Width = "600px",
            Height = "600px",
            PrimaryAction = "Send",
            SecondaryAction = "Cancel",
        });
        Microsoft.FluentUI.AspNetCore.Components.DialogResult result = await _dialog.Result;

        if (result.Cancelled == false && result.Data is PulseMessage sentMsg && !string.IsNullOrWhiteSpace(sentMsg.Content))
        {
            try
            {
                await MsgHubService.SendMessageAsync(sentMsg);
            }
            catch (Exception ex)
            {
                await SendUserMsg("Error", "Message Send Failed", $"Could not send message: {ex.Message}");
            }
        }

