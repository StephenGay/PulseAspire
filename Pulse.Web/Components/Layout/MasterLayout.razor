    private Microsoft.FluentUI.AspNetCore.Components.PresenceStatus GetPresenceStatus(string value) => value switch
    {
        "0" => Microsoft.FluentUI.AspNetCore.Components.PresenceStatus.Busy,
        "1" => Microsoft.FluentUI.AspNetCore.Components.PresenceStatus.OutOfOffice,
        "2" => Microsoft.FluentUI.AspNetCore.Components.PresenceStatus.Away,
        "3" => Microsoft.FluentUI.AspNetCore.Components.PresenceStatus.Available,
        "4" => Microsoft.FluentUI.AspNetCore.Components.PresenceStatus.Offline,
        "5" => Microsoft.FluentUI.AspNetCore.Components.PresenceStatus.DoNotDisturb,
        _ => Microsoft.FluentUI.AspNetCore.Components.PresenceStatus.Unknown
    };

    // Accessibility: ensure the interactive element (FluentButton) is focusable & labelled.
    private void ViewMsgCentre()
    {
        showChatDot = false;
        ShowMsgCentre = true;
    }

    private async Task SendUserMsg(string tType, string tTitle, string tContent)
    {
        var cat = tType switch
        {
            "Success" => MessageIntent.Success,
            "Information" => MessageIntent.Info,
            "Error" => MessageIntent.Error,
            "Warning" => MessageIntent.Warning,
            _ => MessageIntent.Warning
        };

        MessageService.ShowMessageBar(options =>
        {
            options.Title = tTitle;
            options.Intent = cat;
            options.Body = tContent;
            options.Section = "MESSAGES_TOP";
            options.Timeout = 4000;
        });

        await GlobalAI.AISpeak(tContent, "PulseAI");
    }

#region AI Interactions

    private async Task AISpeak(string what, string who)
    {
        if(user?.UserSettings == null || user.UserSettings.AIHasVoice != true)
        {
            return;
        }

        SpeechSynthesisVoice? vc = who switch
        {
            "Flapper" => flapper?._Voice,
            "Tables" => tables?._Voice,
            "Ali" => ali?._Voice,
            "PulseAI" => await dataTrf.GetgvUserAIVoice(),
            _ => null
        };

        var utterancet = new SpeechSynthesisUtterance
        {
            Text = what,
            Voice = vc
        };
        await this.SpeechSynthesis.SpeakAsync(utterancet);
    }

#endregion
    private async Task Logout()
