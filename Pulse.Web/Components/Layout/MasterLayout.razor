    // In your Blazor component
    
    private async Task ChangePresence(ChangeEventArgs e)
    {
        presence = e.Value?.ToString() ?? "3";
        int code = int.Parse(presence);

        try
        {
            await MsgHubService.SetPresenceAsync(code);
            // Don't update UI here; wait for OnPresenceListUpdated broadcast
        }
        catch (Exception ex)
        {
            await SendUserMsg("Error", "Presence Update Failed", $"Could not update presence: {ex.Message}");
        }
    }

    private async Task NewMsg()
