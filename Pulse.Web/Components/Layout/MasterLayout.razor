                                            <FluentOption Value="2">Away</FluentOption>
                                            <FluentOption Value="0">Busy</FluentOption>
                                            <FluentOption Value="5">Do Not Disturb</FluentOption>
                                            <FluentOption Value="4">Offline</FluentOption>
                                            <FluentOption Value="1">Out Of Office</FluentOption>
                                            <FluentOption Value="6">Unknown</FluentOption>
