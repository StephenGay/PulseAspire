                            <FluentButton id="btnMsg" aria-label="Chat messages, unread count" BackgroundColor="rgba(0,0,0,0)" OnClick="ViewMsgCentre"  @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") ViewMsgCentre(); })"> 
