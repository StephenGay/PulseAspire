@using Microsoft.AspNetCore.Components.Authorization
@using Pulse.Models.AI.Ali
@using Pulse.Models.AI.Flapper
@using Pulse.Models.AI.Tables
@using Pulse.Models.Organizational
@using Pulse.Models.Users
@using Pulse.Web.Components.Pages.Security
@using Pulse.Web.Services
@using Toolbelt.Blazor.SpeechSynthesis
@* @using Microsoft.FluentUI.AspNetCore.Components *@


@inject IJSRuntime JS
@inject AppState AppState
@inject DataTransferService dataTrf


@inject SpeechSynthesis SpeechSynthesis
@inject Global_AI_Functions GlobalAI
@* @inject MsFluent.IMessageService MessageService *@
@inject ILogger<MasterLayout> _logger
@* @inject MsFluent.IDialogService DialogService *@

@* @inject AuthenticationStateProvider AuthStateProvider *@
@* @inject CustomAuthenticationStateProvider _authProvider *@
@inject NavigationManager Navigation
@inject AuthService _authService

@inherits LayoutComponentBase

@implements IDisposable

@rendermode InteractiveServer

<style>
    .drawer {
        --bb-drawer-body-padding: 0 !important;
        /* top: 56px !important; */
        height: calc(100vh - 56px) !important;
        z-index: 500 !important;
    }

    .myDivBtn{
        --pulse-accent-btn-bg: var(--pulse-dark-colour);
        --pulse-accent-btn-colour: var(--pulse-light-colour);
        border: 1px solid var(--pulse-light-colour);
    }
    .myDivBtn:hover {
            --pulse-accent-btn-bg: var(--pulse-light-colour);
        --pulse-accent-btn-colour: var(--pulse-dark-colour);
    }
</style>

<CascadingAuthenticationState>
<AuthorizeView>
    <Authorized>
        <RadzenComponents @rendermode="InteractiveAuto" />

        <div class="MasterLayoutParent">
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
            @if (!isLoading)
            {
                <CascadingValue Value="this">
                    <div class="MasterLayoutHeader">
                        <MasterAIMenu />
                    </div>

                    <div class="MasterLayoutContent">
                        @Body
                    </div>

                    <div class="MasterLayoutFooter">
                        <MasterLayoutBottomBar />
                    </div>
                </CascadingValue>
            }
            else
            {
                <div style="display:flex; align-items:center; justify-content:center; height:200px">
                    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="MsFluent.HorizontalAlignment.Center" Style="gap: 12px;">
                        <FluentProgressRing IsActive="true" />
                        <FluentLabel Typo="Typography.Body">Loading, please be patient...</FluentLabel>
                    </FluentStack>
                </div>
            }
            </ChildContent>
                    <ErrorContent Context="exception">
                        <RadzenCard class="mt-4 mb-4" style="max-width: 600px; margin-left: auto; margin-right: auto; border-left: 6px solid var(--rz-danger);">
                            <div class="d-flex align-items-start gap-3">
                                <!-- Error Icon -->
                                <RadzenIcon Icon="error"
                                            Style="font-size: 3.5rem; color: var(--rz-danger); flex-shrink: 0;" />

                                <div class="flex-grow-1">
                                    <!-- Title -->
                                    <RadzenText TextStyle="TextStyle.H5" class="mb-2" style="color: var(--rz-danger);">
                                        Something went wrong
                                    </RadzenText>

                                    <!-- Message -->
                                    <RadzenText TextStyle="TextStyle.Body1" class="mb-3 text-muted">
                                        An unexpected error occurred. The issue has been logged automatically.
                                        You can try again or return to the dashboard.
                                    </RadzenText>

                                    <!-- Action Buttons -->
                                    <div class="d-flex flex-wrap gap-2">
                                        <RadzenButton Text="Try Again"
                                                      ButtonStyle="ButtonStyle.Primary"
                                                      Icon="refresh"
                                                      Click="Recover" />

                                        <RadzenButton Text="Go to Dashboard"
                                                      ButtonStyle="ButtonStyle.Secondary"
                                                      Icon="home"
                                                      Click="GoHome" />
                                    </div>
                                </div>
                            </div>
                        </RadzenCard>
                    </ErrorContent>
                </ErrorBoundary>
        </div>
        
    </Authorized>
    
    <NotAuthorized>
        <Access_Denied />
    </NotAuthorized>

</AuthorizeView>
</CascadingAuthenticationState>

<FluentTooltipProvider />

@code {

    // User? user;
    public Division? division;
    Flapper? flapper;
    Tables? tables;
    Ali? ali;
  
    public string _userId= string.Empty;
    private string _userName = string.Empty;
    public string? UserFullName => _authService.aspireFullName;
    public string? UserPreferredName = string.Empty;
    private ErrorBoundary? errorBoundary;
    private ApplicationUserSettings? userSettings;
    private bool isLoading = true;
  
    #region Layout Lifecycle Methods

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

            if (!_authService.IsAuthenticated){
                Navigation.NavigateTo("/Home", true);
                return;
            }

            _userId = _authService.aspireUserId;
            _userName = _authService.aspireUsername;

            userSettings = await dataTrf.GetgvUserSettings();
            UserPreferredName = userSettings.PreferredUserName;
            division =  await dataTrf.GetgvSelectedDivision();
            flapper = await dataTrf.GetgvFlapper();
            tables = await dataTrf.GetgvTables();
            ali = await dataTrf.GetgvAli();
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    
    protected override async Task OnInitializedAsync()
    {
        GlobalAI.OnAISpeakRequested += AISpeak;
    }

    public void Dispose()
    {
        GlobalAI.OnAISpeakRequested -= AISpeak;
    }

    #endregion

    #region AI Interactions

    private async Task AISpeak(string what, string who)
    {
        bool isMuted = await dataTrf.GetgvIsMuted();
        if(userSettings == null || userSettings.AIHasVoice != true || isMuted)
        {
            return;
        }

        SpeechSynthesisVoice? vc = who switch
        {
            "Flapper" => flapper?._Voice,
            "Tables" => tables?._Voice,
            "Ali" => ali?._Voice,
            "PulseAI" => await dataTrf.GetgvUserAIVoice(),
            _ => null
        };
        what = what.Replace("\n", " ").Replace("<br />", " ");
        var utterancet = new SpeechSynthesisUtterance
        {
            Text = what,
            Voice = vc
        };
        await this.SpeechSynthesis.SpeakAsync(utterancet);
    }

    #endregion

    #region Error Handling

    private void Recover()
    {
        errorBoundary?.Recover();
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/EmployeeZone/");
        errorBoundary?.Recover();   // optional: clear error state
    }
    #endregion
    
}