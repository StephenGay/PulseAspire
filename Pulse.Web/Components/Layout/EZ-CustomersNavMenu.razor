@* <FluentDialogProvider /> *@

@code
{
    private Customer? customer;
    private bool isLoading = true;
    private bool openAssists = false;
    private string _AnalysisResp = string.Empty;
    private bool showAnalysis = false;
    private bool HasAssists = false;
    private bool mnuAssists = false;
    private List<BlankClientBudget>? upBud;
    private bool showingBody = true;
    private bool startAni = false;
    
    
    private string sState = "LOAD";
    private string _Analysis = string.Empty;
    private string _AssistWith = string.Empty;
    private IDialogReference? _dialog;
    Period? period;
    private User? u;
    bool? canceled;

    #region AppBar Icons

    private static Icon DashboardIcon(bool active = false) =>
        active ? new Icons.Filled.Size24.BoardSplit().WithColor("#365b66")
               : new Icons.Regular.Size24.BoardSplit().WithColor("#365b66");

    private static Icon ProfileIcon(bool active = false) =>
        active ? new Icons.Filled.Size24.ContentView().WithColor("#365b66")
               : new Icons.Regular.Size24.ContentView().WithColor("#365b66");

    private static Icon RollersIcon(bool active = false) =>
        active ? new Icons.Filled.Size24.CompassNorthwest().WithColor("#365b66")
               : new Icons.Regular.Size24.CompassNorthwest().WithColor("#365b66");

    private static Icon ContactsIcon(bool active = false) =>
    active ? new Icons.Filled.Size24.ContactCard().WithColor("#365b66")
    : new Icons.Regular.Size24.ContactCard().WithColor("#365b66");

    private static Icon BudgetsIcon(bool active = false) =>
    active ? new Icons.Filled.Size24.Money().WithColor("#365b66")
    : new Icons.Regular.Size24.Money().WithColor("#365b66");

    private static Icon SalesIcon(bool active = false) =>
        active ? new Icons.Filled.Size24.ChartMultiple().WithColor("#365b66")
               : new Icons.Regular.Size24.ChartMultiple().WithColor("#365b66");

    #endregion

    protected override async Task OnInitializedAsync()
    {
        u = await dataTrf.GetgvUser();
        period = await dataTrf.GetgvCurrentPeriod();
        
        await GetClientInfo();

        isLoading = false;


    }

    private async Task AiSpeak(string text)
    {
        await GlobalAI.AISpeak(text, "PulseAI");
    }

    private async Task GetClientInfo()
    {

        Customer check = await dataTrf.GetgvSelectedClient();
        if (check.ClientSales == null)
        {
            check.ClientSales = await pAI.GetClientSalesAsync(check.FullClientID);
            await dataTrf.SetgvSelectedClient(check);
        }
        if(check.clientBudgets == null)
        {
            check.clientBudgets = await pApi.GetAsync<List<ClientBudgets>>($"/Customers/Details/{check.FullClientID}/Budgets/{period.FinancialYear}");
            // if (check.clientBudgets.Any())
            // {
                await dataTrf.SetgvSelectedClient(check);
            // }
        }
        if (!check.clientBudgets.Any())
        {
            HasAssists = true;
        }
        if (check.AiSummary == null || check.AiSummary == "")
        {
            HasAssists = true;
        }
        customer = check;
    }
    private void CheckForAssists()
    {
        HasAssists = false;
        if (!customer.clientBudgets.Any())
        {
            HasAssists = true;
        }
        if (customer.AiSummary == null || customer.AiSummary == "")
        {
            HasAssists = true;
        }
    }
    private async Task ViewAssist()
    {
        string? sTitle;
        switch (_AssistWith)
        {
            case "Summary":
                await SummaryAssist();
                break;
            case "Budget":
                if (upBud == null)
                {
                    _Analysis = _Analysis.Substring(0, _Analysis.Length - 4);
                    _Analysis = _Analysis.Substring(_Analysis.IndexOf("["));
                }

                await BudgetAssist();
                break;
            default:
                return;
        }
    }
    private async Task BudgetAssist()
    {

        //productionPlanItems = await pApiClient.GetWOProductionPlan(selectedWO.WorksOrderNo);
        upBud = JsonSerializer.Deserialize<List<BlankClientBudget>>(_Analysis, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        _dialog = await DialogService.ShowDialogAsync<AiBudgetCreator>(upBud, new DialogParameters<List<BlankClientBudget>>()
        {
            Content = upBud,
            Alignment = Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Left, // Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Right,
            Title = "Generated Client Budget",
            PrimaryAction = "Save As Budget",
            SecondaryAction = "Cancel",
            Height="70%",
            Width = "50%",
        });
        Microsoft.FluentUI.AspNetCore.Components.DialogResult result = await _dialog.Result;
        HandlePanel(result);

    }
    private  async Task HandlePanel(Microsoft.FluentUI.AspNetCore.Components.DialogResult result)
    {
        if (result.Cancelled)
        {
            ResetState();
            return;
        }

        if (result.Data is not null)
        {
            List<BlankClientBudget> up = result.Data as List<BlankClientBudget>;
            foreach (var bud in up)
            {
                ClientBudgets clientBudgets = new ClientBudgets
                {
                    FullClientId = bud.FullClientId,
                    PeriodID = bud.PeriodID,
                    FinancialYear = bud.FinancialYear,
                    BudgetedSales = bud.BudgetedSales,
                    AIForecast = bud.BudgetedSales
                };
                var response = await pApi.PostAsync<ClientBudgets, ClientBudgets>("/Customers/Budgets/Add/", clientBudgets);
            }
            customer.clientBudgets = await pApi.GetAsync<List<ClientBudgets>>($"/Customers/Details/{customer.FullClientID}/Budgets/{period.FinancialYear}");
            if (customer.clientBudgets.Any())
            {
                await dataTrf.SetgvSelectedClient(customer);
                upBud = null;
                ResetState();
                CheckForAssists();
                StateHasChanged();
            }
            return;
        }
    }
    
    private async Task SummaryAssist()
    {
        var dialog = await DialogService.ShowMessageBoxAsync(new DialogParameters<MessageBoxContent>()
        {

            Content = new()
            {
                Title = "I came up with the following summary:",
                MarkupMessage = new MarkupString(_Analysis),
                Icon = new Icons.Filled.Size48.BotSparkle(),
                IconColor = Microsoft.FluentUI.AspNetCore.Components.Color.Success,
            },
            PrimaryAction = "Save To Client",
            SecondaryAction = "Cancel",
        });
        var result = await dialog.Result;
        canceled = result.Cancelled;

        if (canceled == true) 
        {
            ResetState();
            return; 
        }
        switch (_AssistWith)
        {
            case "Summary":
                customer!.AiSummary = _Analysis;
                customer!.AiUpdated = DateTime.Now;
                break;
            default:
                return;
        }

        var updateDto = new CustomerUpdateDto
        {
            AiSummary = _Analysis
        };
        var resp = await pApi.UpdateClientMasterAsync(customer, updateDto);
        if (resp)
        {
            await dataTrf.SetgvSelectedClient(customer);
            await SendToast("Success", "Saved", "The client summary has been saved to the profile.");
            ResetState();
            StateHasChanged();
            @* Navigation.NavigateTo("/EmployeeZone/Customers/ClientDashboard"); *@
        }
        else
        {
            await SendToast("Error", "Not Saved", "Apologies, there was an error saving the AI generated information to the client profile. Please try again.");
        }

    }
    private async Task AddAiSummary()
    {
        openAssists = false;
        StateHasChanged();
        var dialog = await DialogService.ShowMessageBoxAsync(new DialogParameters<MessageBoxContent>()
        {
            Content = new()
            {
                Title = "Create A Summary",
                MarkupMessage = new MarkupString("I can Analise this account and provide a summary with relevant information that can be saved to the client.<br /><br /><p>Would you like me to do this for you?</p>"),
                Icon = new Icons.Filled.Size48.BotSparkle(),
                IconColor = Microsoft.FluentUI.AspNetCore.Components.Color.Success,
            },
            PrimaryAction = "OK",
            SecondaryAction = "Cancel",
            @* Width = "300px", *@
    });
        var result = await dialog.Result;
        canceled = result.Cancelled;

        if(canceled == true){ return; }
        _AssistWith = "Summary";

        var dataText = JsonSerializer.Serialize(customer.ClientSales.ToList(), new JsonSerializerOptions { WriteIndented = true });

        var prompt = $@"""
                You are a financial analysist and will be given the sales history for {customer.ClientName}. 
                Their account was created {customer.CreatedDate}

                Examine the sales and provide a summary of no more than 450 characters.

                Example Information to include in your summary:
                1) Do we have a long standing relationship with the client or is it a new client?
                2) Is the account active? i.e. Are Sales Consistent, Dropping Off, or InActive for a long period. No Sales for the last 3 years means the client is InActive.
                3) How valuable in terms of contribution to Sales is the client?
                4) Which months are typically high sales months and which are low sales months?
                5) Any other relevant information you can find from the sales history.

                Do not include the any sales amounts in your summary, just the analysis.

                Sales History:
                {dataText}
                """;
        await ProcessRequest(prompt);
    }

    private async Task ProcessRequest(string prompt)
    {
        try
        {
            sState = "BUSY";
            StateHasChanged();

            await SendToast("Information", "Processing...", "Your request is being processed.<br />You will be notified when it is complete.");
            
            _Analysis = await pAI.AskPulseAIAsync(prompt, "gpt-oss:latest");

            if (_Analysis.StartsWith("Error"))
            {
                await SendToast("Error", "An Error Occured", $"Apologies, an error occurred while processing your request.\n Please try again, maybe with a different AI Model \n Don't worry, I won't take it personally!");
                ResetState();
                return;
            }

            if (_Analysis.StartsWith("NoSales"))
            {
                await SendToast("Warning", "Customer In-Active", $"This customer has been inactive for the last three years.<br />We should not budget any sales for this financial year.");
                ResetState();
                return;
            }

            if (string.IsNullOrEmpty(_Analysis))
            {
                await SendToast("Warning", "Nothing Returned", "Either no data matched your query or there was an error processing your request.\n If there should have been results, please try again, maybe with a different AI Model.");
                ResetState();
                return;
            }

            @* _Analysis = ParseToHtml(_Analysis); *@

