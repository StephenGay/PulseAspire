<BootstrapBlazorRoot>
<FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" Width="100%" Style=@(sState == "OPEN" ? "height: 100vh;" : "flex: 0;")>
    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" class="px-4 ai-toprow">
                
        @if (sState == "LOAD")
        {
            <FluentLabel Typo="Typography.H5" style="color:white">Loading...</FluentLabel>
        }
        else
        {
            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="height: 100%; width:50%;">
                <FluentAppBar id="fab1" Style="height: 100%;width:100%; color:white; background-color: rgba(0,0,0,0); align-items:center" Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                    <FluentAppBarItem Href="@(null)"
                                        Match="NavLinkMatch.All"
                                        IconRest="@HomeIcon"
                                          Class="@(homeSel ? "nbMainSel" : "nbMainUnSel")"
                                        Text="Home"
                                        OnClick="AppBarClick" />
                        @* <FluentAppBarItem Href="@(null)"
                                        IconRest="@PulseAIIcon"
                                          Class="@(aiSel ? "nbMainSel" : "nbMainUnSel")"
                                        Text="Pulse AI"
                                        OnClick="AppBarClick" /> *@
                        <FluentAppBarItem Href="@(null)"
                                        IconRest="@CustomersIcon"
                                          Class="@(custSel ? "nbMainSel" : "nbMainUnSel")"
                                        Text="Customers"
                                        OnClick="AppBarClick" />
                        <FluentAppBarItem Href="@(null)"
                                        IconRest="@ProductionIcon"
                                          Class="@(prodSel ? "nbMainSel" : "nbMainUnSel")"
                                        Text="Production"
                                        OnClick="AppBarClick" />
                        <FluentAppBarItem Href="@(null)"
                                        IconRest="@AdminIcon"
                                          Class="@(adminSel ? "nbMainSel" : "nbMainUnSel")"
                                        Text="Admin"
                                        OnClick="AppBarClick" />
                </FluentAppBar>
            </FluentStack>
            <FluentSpacer />
        }
        @if (sState == "IDLE")
        {
                
                if(showAi != null)
                {
                   
                    <Animation Effect="@Effect.HeartBeat" Enabled="showAi.showAli" Speed="@Speed.Fast" IterationCount="3" Delay="@TimeSpan.FromSeconds(0.5)">
                        <FluentButton Id="mnuAliBtn" Style="height:40px" Disabled="!showAi.showAli" class="btnShadow" BackgroundColor="rgba(188,209,212,1)" OnClick="btnOpenAIMenu">
                            @(mAli.emoji.ToMarkup("40px"))
                        </FluentButton>
                    </Animation>
                    <FluentTooltip Anchor="mnuAliBtn" HideTooltipOnCursorLeave="true" Style="background-color:burlywood" AutoUpdateMode="AutoUpdateMode.Auto" Delay=100>
                        <strong>Ali:</strong><br />
                        When I am enabled, I can provide detailed analysis reports<br />
                        on what is showing on the screen.
                        <br /><br />
                        Choose from preset prompts, or create your own.
                    </FluentTooltip>
                   
                    <Animation Effect="@Effect.HeartBeat" Enabled="@showAi.showTables" Speed="@Speed.Fast" IterationCount="3" Delay="@TimeSpan.FromSeconds(0.5)">
                        <FluentButton Id="mnuTablesBtn" Style="height:40px" class="btnShadow" BackgroundColor="rgba(188,209,212,1)" OnClick="btnChooseTables">
                            @(mTables.emoji.ToMarkup("40px"))
                        </FluentButton>
                    </Animation>
                    <FluentTooltip Anchor="mnuTablesBtn" HideTooltipOnCursorLeave="true" AutoUpdateMode="AutoUpdateMode.Anchor" Delay=100>
                        <strong>Tables:</strong><br />
                        Tell me what you want and I will fetch the information<br />
                        from the Pulse database for you and present it in a, <br />
                        you guessed it, lovely table!
                        <br /><br />
                        Choose from a variety of saved queries, or create your own.
                    </FluentTooltip>
                   
                    <Animation Effect="@Effect.HeartBeat" Enabled="showAi.showFlapper" Speed="@Speed.Fast" IterationCount="3" Delay="@TimeSpan.FromSeconds(0.5)">
                        <FluentButton Id="mnuFlapperBtn" Style="height:40px" class="btnShadow" BackgroundColor="rgba(188,209,212,1)" OnClick="btnChooseFlapper">
                            @(mFlapper.emoji.ToMarkup("40px"))
                        </FluentButton>
                    </Animation>
                    <FluentTooltip Anchor="mnuFlapperBtn" HideTooltipOnCursorLeave="true" AutoUpdateMode="AutoUpdateMode.Anchor" Delay=100>
                        <strong>Flapper:</strong><br />
                        Need something more than an Analysis or Table of Data?<br />
                        Have a chat with me, I can go more in depth on a subject<br />
                        and have access to the complete database as well as the<br />
                        web.
                    </FluentTooltip>
                }
                @* <FluentButton IconStart="@(new Icons.Filled.Size32.Bot().WithColor("#bcd1d4"))" BackgroundColor="rgba(0,0,0,0)" ></FluentButton> *@
        }
        @if (sState == "BUSY")
        {
                <Button Color="BootstrapBlazor.Components.Color.Info" Style="border: 1px solid white" class="btnShadow" Icon="fa-solid fa-spinner fa-spin fa-fw" Text="Processing" />
        }
        
        @if (sState == "WAIT")
        {
                <FluentButton BackgroundColor="rgba(0,102,0,1)" Style="border: 1px solid white" class="btnShadow"
                        IconStart="@(new Icons.Filled.Size24.SlideSearch().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight))"
                              OnClick="OpenResults" Color="rgba(255,255,255,1)">VIEW</FluentButton>
        }

    </FluentStack>
        
    <Drawer Placement="Placement.Right" @bind-IsOpen="@IsOpen" AllowResize="true" width="100%" style="overflow-x:hidden">
        <div style="display: flex;flex-direction: column;overflow:hidden;height:100%;padding:5px;background-color:rgba(188,209,212,0.8)">
            @* <div class="d-flex justify-content-end align-items-center flex-row" style=" border-bottom: 1px solid #365b66;padding:10px; overflow-x:hidden"> *@
            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Right" VerticalAlignment="VerticalAlignment.Center" style="padding-bottom: 0px;">
                @* <label style=";height:100%;"><strong>ANALYSIS BY ALI</strong></label> *@
                    <FluentSpacer />
                    <FluentButton Appearance="Appearance.Neutral" Style="border: 1px solid red;height:36px;margin-right:10px;margin-top:10px" class="btnShadow"
                                  IconStart="@(new Icons.Filled.Size32.DismissSquare().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Error))"
                                  OnClick="@(e => IsOpen = false)"  ></FluentButton>
                @* <button type="button" style="margin:3px;" class="btn btn-danger" @onclick="@(e => IsOpen = false)"><i class="bi bi-x-circle-fill"></i> Close </button> *@
            </FluentStack>
        
            
            
            <FluentGrid Style="flex: 1">
                <FluentGridItem xs="12" sm="12" md="6" lg="4" xl="3" xxl="2" Style="height:100%">
                    <div class="d-flex justify-content-start align-items-stretch flex-column myContentDiv" style="height: 95%; margin:10px;overflow-x:hidden">
                        @* <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center" style="padding: 10px;"> *@
                            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center" style="padding-left: 20px;padding-right: 20px;margin-top:5px;margin-bottom:5px;">
                                @(mAli.emoji.ToMarkup("64px"))
                                <FluentSpacer />
                                <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Right" VerticalAlignment="VerticalAlignment.Center">
                                    <FluentLabel Typo="Typography.H4">DATA ANALYSIS</FluentLabel>
                                    <FluentLabel Typo="Typography.Body">by Ali</FluentLabel>
                                </FluentStack>
                        </FluentStack>
                        @* <br />
                        <Divider IsVertical="false" Alignment="Alignment.Center" style="width:90%; margin-left:5%; margin-right:5%; background-color: #365b66;" /> *@
                        <StackItem class="flex-grow-1" >
                            @if (Saving)
                            {
                                <FluentTextField @bind-Value=custTitle style="margin-bottom:5px;margin-left: 20px;margin-right: 20px;" Required="true" Placeholder="Enter A Prompt Title"></FluentTextField>
                                <FluentTextField @bind-Value=custDesc Required="true" style="margin-bottom:5px;margin-left: 20px;margin-right: 20px;" Placeholder="Enter A Short Description"></FluentTextField>
                                    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center" >
                                                   <FluentButton Class="btnShadow" IconStart="@(new Icons.Filled.Size24.DismissCircle().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight))" BackgroundColor="rgba(255,0,0,1)" Color="rgba(255,255,255,1)" Style="border: 1px solid white;margin:10px" @onclick="() => Saving = false">Cancel</FluentButton>
                                        @* <FluentSpacer /><FluentIcon Value="@(new Icons.Filled.Size24.DismissCircle())" Color="@Color.Error" /> *@
                                        <FluentButton Class="btnShadow" IconStart="@(new Icons.Filled.Size24.Save().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight))" BackgroundColor="rgba(0,100,0,1)" Color="rgba(255,255,255,1)" Style="border: 1px solid white;margin:10px" Autofocus="true" @onclick="saveQry">Save Prompt</FluentButton>
                                    </FluentStack>
                            }
                                <Card IsShadow="true" Color="BootstrapBlazor.Components.Color.Dark" style="margin-top: 10px;margin-left: 20px;margin-right: 20px;margin-bottom:10px;" IsCenter="true">
                                <HeaderTemplate>
                                    @custQryHdr
                                </HeaderTemplate>
                                <BodyTemplate>
                                    <Textarea rows="10" style="width:100%; height:100%" @bind-Value="txtQ" PlaceHolder="Ask a question..." />
                                </BodyTemplate>
                                <FooterTemplate>
                                    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Right" VerticalAlignment="VerticalAlignment.Center" style="padding: 10px;">
                                        @if (!Saving)
                                        {
                                                @if (this._isListening)
                                                {
                                                    <Animation Effect="@Effect.FadeIn" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(0)">
                                                        <FluentButton BackgroundColor="rgba(255,255,255,1)" class="myModeBtnOn" IconStart="@(new Icons.Filled.Size24.MicOff().WithColor("#1D722A"))" style="border: 2px solid;height:36px" OnClick="OnClickStop"></FluentButton>
                                                    </Animation>
                                                }
                                                else
                                                {
                                                    <Animation Effect="@Effect.FadeIn" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(0)">
                                                        <FluentButton BackgroundColor="rgba(255,255,255,1)" class="myModeBtnOff" IconStart="@(new Icons.Filled.Size24.Mic().WithColor("#9900FF"))" style="border: 2px solid;height:36px" OnClick="StartRecClick"></FluentButton>
                                                    </Animation>
                                                }
                                            
                                            <FluentSpacer />
                                            
                                            
                                            @if (showSave)
                                            {
                                                <button type="button" class="btn btn-success" style="align-self:center; margin-left:10px;" @onclick="btnOpenSaveDialog">SAVE PROMPT</button>
                                                <FluentSpacer />
                                            }
                                                <FluentButton Appearance="Appearance.Accent" class="btnShadow" OnClick="btnAskAIClick">SUBMIT</FluentButton>
                                                @* <button type="button" class="btn btn-primary" style="align-self:center" @onclick="btnAskAIClick">SUBMIT</button> *@
                                        }
                                        else
                                        {
                                            @* <FluentButton BackgroundColor="rgba(0,100,0,1)" Color="rgba(255,255,255,1)" Autofocus="true" @onclick="saveQry">Save Prompt</FluentButton>
                                            <FluentSpacer />
                                            <FluentButton BackgroundColor="rgba(255,0,0,1)" Color="rgba(255,255,255,1)" @onclick="() => Saving=false">Cancel</FluentButton> *@
                                        }
                                    </FluentStack>
                                </FooterTemplate>
                            </Card>
                            @if (_isListening)
                            {
                                <div>
                                    @foreach (var result in this._results)
                                    {
                                        txtQ = @result.Items![0].Transcript;
                                    }
                                </div>
                            }
                            @* <Divider IsVertical="false" Alignment="Alignment.Center" style="width:90%; margin-left:5%; margin-right:5%; margin-top:5px; background-color: #365b66;" /> *@
                        </StackItem>
                    </div>
                </FluentGridItem>
                    <FluentGridItem >
                        <div class="d-flex justify-content-start align-items-stretch flex-column myContentDiv" style="padding:20px; height: 95%;  margin:10px; overflow-x:hidden">
                    
                        <FluentGrid >
                            @if (ContextPrompts != null)
                        {
                            @foreach (var prompt in ContextPrompts)
                            {
                                <FluentGridItem xs="12" sm="12" md="12" lg="4" xl="3" >
                                    <Popover Placement="Placement.Top" Title="Prompt" ShowShadow="true" Content="@prompt.Prompt" IsHtml="true" CustomClass="custom-popover">
                                        <Card IsShadow="true" Color="BootstrapBlazor.Components.Color.Dark" class="divShadow" style="margin-top: 10px;margin-right: 10px;margin-bottom:10px;" IsCenter="true">
                                            <HeaderTemplate>
                                                <FluentLabel Typo="Typography.Body" Style="white-space:nowrap; color: white"> @prompt.ContextualPromptTitle </FluentLabel>
                                            </HeaderTemplate>
                                            <BodyTemplate>
                                                <FluentTextArea rows="2" Cols="75" style="height:100%;" readonly Value="@prompt.ContextualPromptDescription"></FluentTextArea>
                                            </BodyTemplate>
                                            <FooterTemplate>
                                                <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal">
                                                    <FluentButton Title="Copy Prompt" Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size24.Copy())" OnClick="() => CopyCommunityPrompt(prompt.ContextualPromptId)">Copy</FluentButton>
                                                    <FluentSpacer />
                                                    <FluentButton Title="Run Prompt" Appearance="Appearance.Accent" BackgroundColor="green" IconEnd="@(new Icons.Regular.Size24.CaretRight())" OnClick="() => RunCommunityPrompt(prompt.ContextualPromptId)">Run</FluentButton>
                                                </FluentStack>
                                            </FooterTemplate>
                                        </Card>
                                    </Popover>
                                </FluentGridItem>
                            }
                        }
                        </FluentGrid>
                        </div>
                    </FluentGridItem>
                
            </FluentGrid>
        </div>
    </Drawer>

    <Drawer Id="ResultsPanel" Placement="Placement.Bottom" @bind-IsOpen="@showResultsPanel" width="100%" Height="calc(100vh - 56px)"  AllowResize="true">
        <div style="display: flex;flex-direction: column;overflow:hidden;height:100%;padding:5px;background-color:rgba(188,209,212,0.8)">
            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Left" VerticalAlignment="VerticalAlignment.Center" style="padding: 5px;min-height:50px">
                <FluentButton IconStart="@(new Icons.Filled.Size24.DocumentPdf().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight))"
                    class="btnShadow"
                    BackgroundColor="rgba(255,0,0,0.4)"
                                  Style="border: 1px solid white"
                    Color="rgba(255,255,255,1)"
                    Loading="@pdfLoading"
                    OnClick="ExportToPdf">
                    <strong>PDF</strong>
                </FluentButton>
                <FluentButton IconStart="@(new Icons.Filled.Size24.ArrowDownload().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight))"
                    BackgroundColor="rgba(0,0,0,1)"
                                  Style="border: 1px solid white"
                    class="btnShadow"
                    Color="rgba(255,255,255,1)"
                    OnClick="ExportHtmlFile">
                    <strong>HTML</strong>
                </FluentButton>
                <FluentSpacer />
                <FluentButton BackgroundColor="rgba(255,0,0,0.7)"
                                  Style="border: 1px solid white"
                    class="btnShadow"
                    IconStart="@(new Icons.Filled.Size24.Delete().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight))"
                    OnClick="ResetState" Color="rgba(255,255,255,1)">
                    <strong>CLEAR</strong>
                </FluentButton>
                    <FluentButton Appearance="Appearance.Accent" Style="border: 1px solid white" class="btnShadow" IconStart="@(new Icons.Filled.Size24.Door().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight))" OnClick="CloseResults"><strong>CLOSE</strong></FluentButton>
            </FluentStack>
            <div id="aiResult" style=" flex: 1; padding: 20px;margin:10px;border: 1px solid black; border-radius: 10px;box-shadow: 5px 5px 15px rgba(0, 0, 0, 0.8); background-color:white; overflow: auto;">
                @((MarkupString)_Analysis)
            </div>
        </div>
    </Drawer>

        <Drawer Placement="Placement.Right" @bind-IsOpen="@ChooseAi" AllowResize="true" style="overflow-x:hidden">
            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" Style="margin-top:50px">
            <FluentButton Id="chooseFlapperBtn" class="btnShadow" BackgroundColor="rgba(188,209,212,1)" Style="height:68px" OnClick="btnChooseFlapper">
              @*   @(mFlapper.emoji.ToMarkup("64px")) *@
                Flapper
            </FluentButton>
                <FluentButton Id="chooseTablesBtn" class="btnShadow" BackgroundColor="rgba(188,209,212,1)" Style="height:68px" OnClick="btnChooseTables">
                   @*  <FluentEmoji Value="@(new Emojis.PeopleBody.Color.MediumLight.ManTechnologist())" Width="64px" /> *@
                    Tables
                </FluentButton>
            </FluentStack>
        </Drawer>

     <Drawer Placement="Placement.Right" @bind-IsOpen="@OpenAi" IsBackdrop="true" @OnCloseAsync="() => OpenAi=false" AllowResize="true" width="100%" style="overflow-x:hidden">
            @if (showWho == "Flapper")
            {
                <FlapperPg />
            }
            else
            {
                <TablesPg />
            }

    </Drawer>
            
</FluentStack>
