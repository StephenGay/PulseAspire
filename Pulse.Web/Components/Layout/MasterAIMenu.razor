            return;
        }

        qry = $"This is the Work In Progress for the Division. {qry}";

        fileName = $"{Hdr.Replace(" ", "_")}";

        line1 = custTitle;
        line2 = division.DivisionName;
        var dataText = JsonSerializer.Serialize(divWIP, new JsonSerializerOptions { WriteIndented = true });

        var prompt = $@"""
                You will be provided the Work In Progress for a Division. You are a Production expert and will examine the data and provide
                meaninful responses to the user query provided.

                Note: All Sales Amounts are in ZAR (South African Rands)

                Data:
                {dataText}

                Query: {qry}
                """;
        await ProcessRequest(prompt);

    }
#endregion
