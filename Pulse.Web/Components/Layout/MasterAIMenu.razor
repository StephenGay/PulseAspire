    private async Task ProcessRequest(string prompt)
    {
        IsOpen = false;

        aiModel = await dataTrf.GetgvAIModel();

        try
        {
            sState="BUSY";
            StateHasChanged();

            await SendToast("Information", "Your request is being processed.<br />You will be notified when it is complete.","Ali",true,true);
            var request = new OllamaRequest
            {
                Prompt = prompt,
                Model = aiModel,
                Options = { NumCtx = 32000, NumPredict = 8000 }
                //Options = { NumCtx = Convert.ToInt32(prompt.Length / 4 * 1.3), NumPredict = 8000 }
            };
            // _Analysis = await pAI.AskPulseAIAsync(request);
            _Analysis = await pAI.AskPulseAIAsync(prompt, aiModel);

            if (_Analysis.StartsWith("Error"))
            {
                await SendToast("Error", $"Apologies, an error occurred while processing your request.\n Please try again.","Ali",true,true);
                ResetState();
                return;
            }

            if (string.IsNullOrEmpty(_Analysis))
            {
                await SendToast("Warning", "Either no data matched your query or there was an error processing your request.\n If there should have been results, please try again","Ali",true,true);
                ResetState();
                return;
            }

            _Analysis = ParseToHtml(_Analysis);
            _AliAnalysis = AddMUcss(_Analysis);

            // fileName = $"{customer.FullClientID}-{Hdr}";
            await SendToast("Information", "Your request has been completed.<br />Click the <strong>VIEW</strong> button to see the results.","Ali",true,true);
            sState = "WAIT";

        }
        catch (Exception ex)
        {
            await SendToast("Error", "Exception", ex.Message);
            ResetState();
        }
    }

