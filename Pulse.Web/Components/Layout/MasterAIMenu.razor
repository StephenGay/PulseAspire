<BootstrapBlazorRoot>
<FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" Width="100%" Style=@(sState == "OPEN" ? "height: 100vh;" : "flex: 0;")>
    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" class="px-4 ai-toprow">
                
        @if (sState == "LOAD")
        {
            <FluentLabel Typo="Typography.H5" style="color:white">Loading...</FluentLabel>
        }
        else
        {
            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="height: 100%; width:50%;">
                <FluentAppBar id="fab1" Style="height: 100%;width:100%; color:white; background-color: rgba(0,0,0,0); align-items:end" Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                    <FluentAppBarItem Href="@(null)"
                                        Match="NavLinkMatch.All"
                                        IconRest="@HomeIcon"
                                          Class="@(homeSel ? "nbMainSel" : "nbMainUnSel")"
                                        Text="Home"
                                        OnClick="AppBarClick" />
                        @* <FluentAppBarItem Href="@(null)"
                                        IconRest="@PulseAIIcon"
                                          Class="@(aiSel ? "nbMainSel" : "nbMainUnSel")"
                                        Text="Pulse AI"
                                        OnClick="AppBarClick" /> *@
                        <FluentAppBarItem Href="@(null)"
                                        IconRest="@CustomersIcon"
                                          Class="@(custSel ? "nbMainSel" : "nbMainUnSel")"
                                        Text="Customers"
                                        OnClick="AppBarClick" />
                        <FluentAppBarItem Href="@(null)"
                                        IconRest="@ProductionIcon"
                                          Class="@(prodSel ? "nbMainSel" : "nbMainUnSel")"
                                        Text="Production"
                                        OnClick="AppBarClick" />
                        <FluentAppBarItem Href="@(null)"
                                        IconRest="@AdminIcon"
                                          Class="@(adminSel ? "nbMainSel" : "nbMainUnSel")"
                                        Text="Admin"
                                        OnClick="AppBarClick" />
                </FluentAppBar>
            </FluentStack>
            <FluentSpacer />
        }
        @if (sState == "IDLE")
        {

                if (showAi != null)
                {
                    if (IsOpen || OpenFlapper || OpenTables)
                    {
                        
                    }
                    else
                    {
                        <Animation Effect="@Effect.HeartBeat" Enabled="showAi.showAli" Speed="@Speed.Fast" IterationCount="3" Delay="@TimeSpan.FromSeconds(0.5)">
                            <FluentButton Id="mnuAliBtn" Style="height:40px;width:62px;margin-right:15px" Disabled="!showAi.showAli" class="btnShadow" BackgroundColor="white" OnClick="btnOpenAIMenu">
                                @* @(mAli.emoji.ToMarkup("40px")) *@
                                <img src="Images/AI/Ali.jpg" alt="Ali" style="height:40px;width:40px" />
                            </FluentButton>
                        </Animation>
                        <FluentTooltip Anchor="mnuAliBtn" HideTooltipOnCursorLeave="true" Style="background-color:burlywood" AutoUpdateMode="AutoUpdateMode.Auto" Delay=100>
                            <strong>Ali:</strong><br />
                            When I am enabled, I can provide detailed analysis reports<br />
                            on what is showing on the screen.
                            <br /><br />
                            Choose from preset prompts, or create your own.
                        </FluentTooltip>

                        <Animation Effect="@Effect.HeartBeat" Enabled="@showAi.showTables" Speed="@Speed.Fast" IterationCount="3" Delay="@TimeSpan.FromSeconds(0.5)">
                            <FluentButton Id="mnuTablesBtn" Style="height:40px;width:62px;margin-right:15px" class="btnShadow" BackgroundColor="white" OnClick="btnChooseTables">
                                @* @(mTables.emoji.ToMarkup("40px")) *@
                                <img src="Images/AI/Tables.jpg" alt="Tables" style="height:40px;width:40px;align-content:center" />
                            </FluentButton>
                            <FluentTooltip Anchor="mnuTablesBtn" HideTooltipOnCursorLeave="true" AutoUpdateMode="AutoUpdateMode.Anchor" Delay=100>
                                <strong>Tables:</strong><br />
                                Tell me what you want and I will fetch the information<br />
                                from the Pulse database for you and present it in a, <br />
                                you guessed it, lovely table!
                                <br /><br />
                                Choose from a variety of saved queries, or create your own.
                            </FluentTooltip>
                        </Animation>
                        

                        <Animation Effect="@Effect.HeartBeat" Enabled="showAi.showFlapper" Speed="@Speed.Fast" IterationCount="3" Delay="@TimeSpan.FromSeconds(0.5)">
                            <FluentButton Id="mnuFlapperBtn" Style="height:40px;width:62px;margin-right:15px" class="btnShadow" BackgroundColor="white" OnClick="btnChooseFlapper">
                                @* @(mFlapper.emoji.ToMarkup("40px")) *@
                                <img src="Images/AI/Flapper.jpg" alt="Flapper" style="height:40px;width:40px" />
                            </FluentButton>
                            <FluentTooltip Anchor="mnuFlapperBtn" HideTooltipOnCursorLeave="true" Delay=100>
                                <strong>Flapper:</strong><br />
                                Need something more than an Analysis or Table of Data?<br />
                                Have a chat with me, I can go more in depth on a subject<br />
                                and have access to the complete database as well as the<br />
                                web.
                            </FluentTooltip>
                        </Animation>
                        
                    }
                }
                @* <FluentButton IconStart="@(new Icons.Filled.Size32.Bot().WithColor("#bcd1d4"))" BackgroundColor="rgba(0,0,0,0)" ></FluentButton> *@
        }
        @if (sState == "BUSY")
        {
                <Button Color="BootstrapBlazor.Components.Color.Info" style="border: 1px solid white; background-color:#9900FF; color: white;" class="btnShadow" Icon="fa-solid fa-spinner fa-spin fa-fw" Text="Processing" />
        }
        
        @if (sState == "WAIT")
        {
                <FluentButton BackgroundColor="rgba(0,102,0,1)" Style="border: 1px solid white" class="btnShadow"
                        IconStart="@(new Icons.Filled.Size24.SlideSearch().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight))"
                              OnClick="OpenResults" Color="rgba(255,255,255,1)">VIEW</FluentButton>
        }

    </FluentStack>
          <Drawer Placement="Placement.Right" @bind-IsOpen="@IsOpen" IsBackdrop="true" @OnCloseAsync="() => IsOpen=false" AllowResize="true" width="100%" style="overflow-x:hidden">
              <div style="width:100%;height:56px;background-color:var(--pulse-dark-colour) !important; text-align:center">
             <FluentButton BackgroundColor="rgba(188,209,212,1)" Style="border: 1px solid red;height:40px;" 
                    IconStart="@(new Icons.Filled.Size32.DismissSquare().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Error))" OnClick="() => IsOpen=false">
            </FluentButton>

         </div>
        <div class="dparent">
            <div class="dheader" Style="border-bottom: 1px solid black">
                <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Left" VerticalAlignment="VerticalAlignment.Center" style="padding:10px">
                    <FluentButton class=@(!viewBox ? "myModeBtnOff" : "myModeBtnOn")
                                  BackgroundColor="white"
                                  Style="border: 2px solid ;height:50px;width:fit-content;margin-left:10px"
                                  OnClick="() => viewBox = !viewBox">
                        <img src="Images/AI/Ali.jpg" style="height:45px;width:45px" />
                    </FluentButton>
                </FluentStack>
            </div>
            <div class="dcontent">
                @if (viewBox)
                {
                    <div class="sidebar">
                        <div class="aiBox divShadow">
                            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center" style="background-color: var(--pulse-dark-t75-colour); border-bottom: 1px solid var(--pulse-dark-colour); border-top-left-radius: 10px; border-top-right-radius: 10px; padding-left: 20px;padding-right: 20px;padding-top:10px;padding-bottom:10px;margin-bottom:0px;">
                                <img src="Images/AI/Ali.png" style="height:96px;width:96px" />
                                <FluentSpacer />
                                <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Right" VerticalAlignment="VerticalAlignment.Center">
                                        <FluentLabel Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="rgba(255,255,255,1)" Typo="Typography.H4">DATA ANALYSIS</FluentLabel>
                                    <FluentLabel Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="rgba(255,255,255,1)" Typo="Typography.Body">by Ali</FluentLabel>
                                </FluentStack>
                            </FluentStack>
                            <StackItem >
                                <FluentLabel Typo="Typography.H6" Alignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" Style="padding:5px;margin-top:10px;width:100%;" >@custTitle.ToUpper()</FluentLabel>
                                <FluentTextArea rows="10" style="width:95%; height:100%;margin-left: 2.5%;margin-right:2.55%;margin-bottom:10px; border:1px solid var(--pulse-dark-colour);border-radius:5px" @bind-Value="txtQ" ReadOnly="!isEditMode" PlaceHolder="Ask a question or select a prompt..." />
                                <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Right" VerticalAlignment="VerticalAlignment.Center" style="padding-left: 20px;padding-right: 20px;margin-top:5px;margin-bottom:20px;">
                                    @if (!Saving)
                                    {
                                        @if (this._isListening)
                                        {
                                            <Animation Effect="@Effect.FadeIn" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(0)">
                                                <FluentButton class="myModeBtnOn" BackgroundColor="var(--pulse-mode-btn-bg)" Title="Turn Off Microphone" IconStart="@(new Icons.Filled.Size24.MicOff().WithColor("var(--pulse-mode-btn-item-colour)"))" style="height:50px;width:50px" OnClick="OnClickStop"></FluentButton>
                                            </Animation>
                                        }
                                        else
                                        {
                                            <Animation Effect="@Effect.FadeIn" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(0)">
                                                <FluentButton class="myModeBtnOff" BackgroundColor="var(--pulse-mode-btn-bg)" Disabled="!isEditMode" Title="Turn On Microphone" IconStart="@(new Icons.Filled.Size24.Mic().WithColor("var(--pulse-mode-btn-item-colour)"))" style="height:50px;width:50px" OnClick="StartRecClick"></FluentButton>
                                            </Animation>
                                        }
                                            
                                        <FluentSpacer />
                                        <FluentButton class="myAccentBtn" BackgroundColor="var(--pulse-accent-btn-bg)" Color="var(--pulse-accent-btn-colour)"
                                                        IconStart="@(new Icons.Filled.Size24.ChatAdd().WithColor("var(--pulse-accent-btn-colour)"))"
                                                        Title="New Prompt"
                                                        Style="height:50px;width:50px" OnClick="@NewPrompt"></FluentButton>
                                            <FluentSpacer />
                                        @if (showSave)
                                        {
                                            <FluentButton class="myAccentBtn" BackgroundColor="var(--pulse-accent-btn-bg)" Color="var(--pulse-accent-btn-colour)"
                                                                IconStart="@(new Icons.Filled.Size24.Save().WithColor("var(--pulse-accent-btn-colour)"))"
                                                                Style="height:50px;width:50px" 
                                                                OnClick="() => {Saving = true; showSave = false;}"></FluentButton>
                                            <FluentSpacer />
                                        }
                                        else if (!isEditMode)
                                        {
                                            <FluentButton class="myAccentBtn" BackgroundColor="var(--pulse-accent-btn-bg)" Color="var(--pulse-accent-btn-colour)"
                                                        IconStart="@(new Icons.Filled.Size24.Edit().WithColor("var(--pulse-accent-btn-colour)"))"
                                                        Title="Edit Prompt"
                                                        Style="height:50px;width:50px" OnClick="@EditPrompt"></FluentButton>
                                            <FluentSpacer />
                                        }
                                    }
                                    <FluentButton class="myOkBtn" BackgroundColor="var(--pulse-ok-btn-bg)" Color="var(--pulse-ok-btn-colour)" IconStart="@(new Icons.Filled.Size24.Send().WithColor("--pulse-ok-btn-colour"))"
                                                Disabled="@string.IsNullOrEmpty(txtQ)" Style="height:50px;width:50px" OnClick="@btnAskAIClick"></FluentButton>
                                </FluentStack>
                                @if (_isListening)
                                {
                                    <div>
                                        @foreach (var result in this._results)
                                        {
                                            txtQ = @result.Items![0].Transcript;
                                        }
                                    </div>
                                }
                                    
                                @if (Saving)
                                {
                                    <div style="margin-left: 5%;margin-right: 5%;margin-bottom:10px;border: 1px solid var(--pulse-dark-colour);background-color:var(--pulse-light-2-colour);border-radius:10px;width:90%;padding:5px;">
                                        <FluentTextField @bind-Value=custTitle style="margin-bottom:5px;width:100%" Required="true" Label="Title" Placeholder="Enter A Prompt Title"></FluentTextField>
                                        <FluentTextField @bind-Value=custDesc Required="true" style="margin-bottom:5px;width:100%" Label="Description" Placeholder="Enter A Short Description"></FluentTextField>
                                        <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Left" VerticalAlignment="VerticalAlignment.Center" Style="margin-top:15px;margin-bottom:15px;">
                                            <FluentButton Class="myCancelBtn" 
                                                BackgroundColor="var(--pulse-cancel-btn-bg)"
                                                Color="var(--pulse-cancel-btn-colour)"
                                                Style="height:40px;"
                                                IconStart="@(new Icons.Filled.Size24.DismissCircle().WithColor("--pulse-ok-btn-colour"))"
                                                OnClick="() => {Saving = false; showSave = true;}">
                                                Cancel
                                            </FluentButton>
                                            <FluentSpacer />
                                            <FluentButton class="myOkBtn" BackgroundColor="var(--pulse-ok-btn-bg)" Color="var(--pulse-ok-btn-colour)" IconStart="@(new Icons.Filled.Size24.Save().WithColor("--pulse-ok-btn-colour"))"
                                                                  Style="height:40px;" OnClick="saveQry">Save Prompt</FluentButton>
                                        </FluentStack>
                                    </div>
                                }
                            </StackItem>
                        </div>
                    </div>
                }
                <div class="prompt-area">
                    <FluentGrid >
                        @if (ContextPrompts != null)
                        {
                            @foreach (var prompt in ContextPrompts)
                            {
                                <FluentGridItem xs="12" sm="12" md="12" lg="4" xl="3" >
                                    <FluentButton  BackgroundColor="var(--pulse-dark-t50-colour)" Class="btnShadow" Style="height:fit-content; border: 2px solid white; border-radius:10px" OnClick="() => CopyCommunityPrompt(prompt)">
                                        <div style="width:100%;background-color: rgba(0,0,0,0)">
                                            <FluentLabel Typo="Typography.Body" Style="white-space:nowrap; color: white;padding:3px"> @prompt.ContextualPromptTitle </FluentLabel>
                                            <FluentTextArea rows="2" Cols="75" style="height:100%;margin-bottom:15px" readonly Value="@prompt.ContextualPromptDescription"></FluentTextArea> 
                                        </div>
                                    </FluentButton>
                                </FluentGridItem>
                            }
                        }
                    </FluentGrid>
                </div>
            </div>
        </div>

        
    </Drawer>

    <Drawer Id="ResultsPanel" Placement="Placement.Bottom" @bind-IsOpen="@showResultsPanel" width="100%" Height="calc(100vh - 56px)"  AllowResize="true">
        <div style="width:100%;height:56px;background-color:var(--pulse-dark-colour) !important; text-align:center">
             <FluentButton BackgroundColor="rgba(188,209,212,1)" Disabled="true" Style="border: 1px solid red;height:40px;" 
                    IconStart="@(new Icons.Filled.Size32.DismissSquare().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Error))" OnClick="() => IsOpen=false">
            </FluentButton>

         </div>
        <div style="display: flex;flex-direction: column;overflow:hidden;height:100%;padding:5px;background-color:rgba(188,209,212,0.8)">
            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Left" VerticalAlignment="VerticalAlignment.Center" style="padding: 5px;min-height:50px">
                <FluentButton IconStart="@(new Icons.Filled.Size24.DocumentPdf().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight))"
                    class="btnShadow"
                    BackgroundColor="rgba(255,0,0,0.4)"
                                  Style="border: 1px solid white"
                    Color="rgba(255,255,255,1)"
                    Loading="@pdfLoading"
                    OnClick="ExportToPdf">
                    <strong>PDF</strong>
                </FluentButton>
                <FluentButton IconStart="@(new Icons.Filled.Size24.ArrowDownload().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight))"
                    BackgroundColor="rgba(0,0,0,1)"
                                  Style="border: 1px solid white"
                    class="btnShadow"
                    Color="rgba(255,255,255,1)"
                    OnClick="ExportHtmlFile">
                    <strong>HTML</strong>
                </FluentButton>
                <FluentButton IconStart="@(new Icons.Filled.Size24.ArrowDownload().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight))"
                    BackgroundColor="rgba(0,0,0,1)"
                                  Style="border: 1px solid white"
                    class="btnShadow"
                    Color="rgba(255,255,255,1)"
                    OnClick="ExportHtmlMsg">
                    <strong>Msg</strong>
                </FluentButton>
                <FluentSpacer />
                <FluentButton BackgroundColor="rgba(255,0,0,0.7)"
                                  Style="border: 1px solid white"
                    class="btnShadow"
                    IconStart="@(new Icons.Filled.Size24.Delete().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight))"
                    OnClick="ResetState" Color="rgba(255,255,255,1)">
                    <strong>CLEAR</strong>
                </FluentButton>
                    <FluentButton Appearance="Appearance.Accent" Style="border: 1px solid white" class="btnShadow" IconStart="@(new Icons.Filled.Size24.Door().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight))" OnClick="CloseResults"><strong>CLOSE</strong></FluentButton>
            </FluentStack>
            <div id="aiResult" style=" flex: 1; padding: 20px;margin:10px;border: 1px solid black; border-radius: 10px;box-shadow: 5px 5px 15px rgba(0, 0, 0, 0.8); background-color:white; overflow: auto;">
                @((MarkupString)_AliAnalysis)
            </div>
        </div>
    </Drawer>

        

     <Drawer Placement="Placement.Right" @bind-IsOpen="@OpenFlapper" IsBackdrop="true" @OnCloseAsync="() => OpenFlapper=false" AllowResize="true" width="100%" style="overflow-x:hidden">
         <FluentButton BackgroundColor="rgba(255,255,255,1)" Style="position:absolute; border: 1px solid red;height:40px;margin-top:8px;left:calc(100vw - 50%)"
                        IconStart="@(new Icons.Filled.Size32.DismissSquare().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Error))" OnClick="() => OpenFlapper=false">
            Close
        </FluentButton>
        <FluentButton BackgroundColor="rgba(255,255,255,1)" Style="position:absolute; border: 1px solid red;height:40px;margin-top:8px;margin-left:10px"
                        IconStart="@(new Icons.Filled.Size32.DismissSquare().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Error))" OnClick="() => flapperVersion1=!flapperVersion1">
            Ver
        </FluentButton>
        @if (flapperVersion1)
        {
             <FlapperPg />
        }
        else
        {
            <FlapperPg_v2 />
        }
    </Drawer>

        <Drawer Placement="Placement.Right" @bind-IsOpen="@OpenTables" IsBackdrop="true" @OnCloseAsync="() => OpenTables=false" AllowResize="true" width="100%" style="overflow-x:hidden">
            <div style="width:100%;height:56px;background-color:var(--pulse-dark-colour) !important; justify-content:end">
             <FluentButton BackgroundColor="rgba(188,209,212,1)" Style="border: 1px solid red;height:40px;" 
                    IconStart="@(new Icons.Filled.Size32.DismissSquare().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Error))" OnClick="() => OpenTables=false">
            </FluentButton>

         </div>
                <TablesPg />
