    private async Task AppBarClick(IAppBarItem item)
    {
        homeSel = false;
        custSel = false;
        prodSel = false;
        adminSel = false;
        string pgNav = string.Empty;

        switch (item.Text)
        {
            case "Home":
                homeSel = true;
                pgNav = "/EmployeeZone/";
                break;
            case "Customers":

                string? result = await mnuAiGlobalFunctions.OpenClientSearch(mnuAiDialogService);

                if (string.IsNullOrEmpty(result))
                {
                    string cErrMsg = "There is no client selected.<br />Please select one to access customer information.";
                    PulseToastService.ShowToast("Warning", cErrMsg, true);
                    await GlobalAI.AISpeak(cErrMsg, "PulseAI");
                    return;
                }

                // customer = await pApiClient.GetAsync<Customer>(ApiEndpoints.Customers.ByFullClientID.MasterFile.Get(result));
                await dataTrf.SetgvSelectedClient(await pApiClient.GetAsync<Customer>(ApiEndpoints.Customers.ByFullClientID.MasterFile.Get(result)));
                //
                custSel = true;
                pgNav = "/EmployeeZone/Customers/ClientDashboard";
                await aiMnuAppState.NotifyClientChanged();
                break;
            // custSel = true;
            // pgNav = "/EmployeeZone/SearchPages/ClientSearch";
            // break;
            case "Production":
                prodSel = true;
                pgNav = "/EmployeeZone/Production/ProductionDashboard";
                break;
            case "Admin":
                adminSel = true;
                pgNav = "/AdminZone/AdminDashboard";
                break;

        }

        Navigation.NavigateTo(pgNav);
