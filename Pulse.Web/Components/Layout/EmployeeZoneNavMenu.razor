@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Models.Organizational
@using Pulse.Models.Users
@using Pulse.Web.Services

@inject DataTransferService DataTransferService
@inject PulseApiService CustomerService


<FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" class="px-4 zone-toprow" Style="padding-top:5px;padding-bottom:5px;">
                
    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="height: 100%; width:50%;">
        <FluentAppBar Style="height: 90%;width:100%; color:white; background-color: rgba(0,0,0,0); align-items:center" Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
            <FluentAppBarItem Href="/EmployeeZone/"
                                        Match="NavLinkMatch.All"
                                        IconRest="DashboardIcon()"
                                        IconActive="DashboardIcon(active: true)"
                              OnClick="@(() => mnuActive="Dashboard")"
                              Class="@(mnuActive == "Dashboard" ? "nbZoneSel" : "nbZoneUnSel")"
                                        Text="Dashboard" />
            <FluentAppBarItem Href="/DivisionLogon"
                              IconRest="DivisionIcon()"
                              IconActive="DivisionIcon(active: true)"
                              OnClick="@(() => mnuActive="Division")"
                              Class="@(mnuActive == "Division" ? "nbZoneSel" : "nbZoneUnSel")"
                              Text="Division" />
            <FluentAppBarItem Href="/UserSettings/UserSettingsPg"
                                        IconRest="SetupIcon()"
                                        IconActive="SetupIcon(active: true)"
                              OnClick="@(() => mnuActive="MySetup")"
                              Class="@(mnuActive == "MySetup" ? "nbZoneSel" : "nbZoneUnSel")"
                                        Text="My Setup" />
            @* <FluentAppBarItem Href="/UserSettings/ThemesPg"
                              IconRest="SetupIcon()"
                              IconActive="SetupIcon(active: true)"
                              Text="Theme" /> *@
        </FluentAppBar>

    </FluentStack>
    <FluentSpacer />
</FluentStack>


@code 
{
    // private User? u;
    private string mnuActive = "Dashboard";
    #region AppBar Icons

    private static Icon DashboardIcon(bool active = false) =>
        active ? new Icons.Filled.Size24.BoardSplit()
               : new Icons.Regular.Size24.BoardSplit();

    private static Icon DivisionIcon(bool active = false) =>
            active ? new Icons.Filled.Size24.BuildingSwap()
                : new Icons.Regular.Size24.BuildingSwap();

    private static Icon SetupIcon(bool active = false) =>
        active ? new Icons.Filled.Size24.Settings()
               : new Icons.Regular.Size24.Settings();

    #endregion
    // protected override async Task OnInitializedAsync()
    // {
    //     u = await DataTransferService.GetgvUser();

    // }
}