@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Models.Users
@using Pulse.Web.Components.Pages.EmployeeZone.Production.Dialogs
@using Pulse.Web.Components.Pages.EmployeeZone.Production.Planning
@using Pulse.Web.Components.Pages.EmployeeZone.Production.Setup.Factory.FactoryLayout
@using Pulse.Web.Services
@inject DataTransferService dtrf

<FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" class="px-4 zone-toprow" Style="padding-top:5px;padding-bottom:5px;">
                
    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="height: 100%; width:50%;">
        <FluentAppBar Style="height: 90%;width:100%; color:white; background-color: rgba(0,0,0,0); align-items:center" Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
            <FluentAppBarItem Href="/EmployeeZone/Production/Planning/PlanDashboard"
                                        Match="NavLinkMatch.All"
                                        IconRest="DashboardIcon()"
                                        IconActive="DashboardIcon(active: true)"
                                          OnClick="@(() => mnuActive="Dashboard")"
                                          Class="@(mnuActive == "Dashboard" ? "nbZoneSel" : "nbZoneUnSel")"
                                        Text="Dashboard" />
            <FluentAppBarItem Href="/EmployeeZone/Production/WorkInProgress"
                                        IconRest="WIPIcon()"
                                        IconActive="WIPIcon(active: true)"
                                          OnClick="@(() => mnuActive="WIP")"
                                          Class="@(mnuActive == "WIP" ? "nbZoneSel" : "nbZoneUnSel")"
                                        Text="W.I.P." />
            <FluentAppBarItem Href="/EmployeeZone/Production/ProductionCalendar"
                                        IconRest="PlanIcon()"
                                        IconActive="PlanIcon(active: true)"
                                          OnClick="@(() => mnuActive="Plan")"
                                          Class="@(mnuActive == "Plan" ? "nbZoneSel" : "nbZoneUnSel")"
                                        Text="Plan" />
            <FluentAppBarItem Href="/EmployeeZone/Production/NonConformance/NCRReports"
                                          IconRest="PlanIcon()"
                                          IconActive="PlanIcon(active: true)"
                                          OnClick="@(() => mnuActive="NCR")"
                                          Class="@(mnuActive == "NCR" ? "nbZoneSel" : "nbZoneUnSel")"
                                          Text="Non-Conformance" />
            <FluentAppBarItem Href="/EmployeeZone/Production/Setup/old/ProductionSetupHome"
                                        IconRest="SetupIcon()"
                                        IconActive="SetupIcon(active: true)"
                                          OnClick="@(() => mnuActive="Setup")"
                                          Class="@(mnuActive == "Setup" ? "nbZoneSel" : "nbZoneUnSel")"
                                        Text="Setup" />
            <FluentAppBarItem Href="/EmployeeZone/Production/Setup/WorkCentres/WorkCentreManagementPg"
                              IconRest="SetupIcon()"
                              IconActive="SetupIcon(active: true)"
                              OnClick="@(() => mnuActive="WorkCentres")"
                              Class="@(mnuActive == "WorkCentres" ? "nbZoneSel" : "nbZoneUnSel")"
                              Text="Work Centres" />
            <FluentAppBarItem Href="/EmployeeZone/Production/Setup/WorkTypes/WorkTypeManagementPg"
                              IconRest="SetupIcon()"
                              IconActive="SetupIcon(active: true)"
                              OnClick="@(() => mnuActive="WorkTypes")"
                              Class="@(mnuActive == "WorkTypes" ? "nbZoneSel" : "nbZoneUnSel")"
                              Text="Work Types" />
            <FluentAppBarItem Href="/EmployeeZone/Production/Setup/Factory/FactoryLayout/FactoryLayout"
                              IconRest="SetupIcon()"
                              IconActive="SetupIcon(active: true)"
                              OnClick="@(() => mnuActive="Layout")"
                              Class="@(mnuActive == "Layout" ? "nbZoneSel" : "nbZoneUnSel")"
                              Text="Factory Layout" />
            <FluentAppBarItem Href="/EmployeeZone/Production/Setup/Equipment/EquipmentPg"
                              IconRest="SetupIcon()"
                              IconActive="SetupIcon(active: true)"
                              OnClick="@(() => mnuActive="Equipment")"
                              Class="@(mnuActive == "Equipment" ? "nbZoneSel" : "nbZoneUnSel")"
                              Text="Equipment" />
        </FluentAppBar>

    </FluentStack>
    <FluentSpacer />
    <FluentButton Id="mnuProdPlanViewBtn" Style="height:40px;margin-right:15px;border:2px solid var(--pulse-dark-colour)" 
                  class="btnShadow" BackgroundColor="white" Color="var(--pulse-dark-colour)" data-bs-toggle="offcanvas"
                          IconStart="@(new Icons.Filled.Size32.CalendarEye().WithColor("var(--pulse-dark-colour)"))"
                          data-bs-target="#ocProdPlan">
                <strong>MONITOR</strong>
    </FluentButton>
</FluentStack>

<div class="offcanvas offcanvas-top" style="width:100%;height:100%" tabindex="-1" id="ocProdPlan">
    <FluentStack Orientation="MsFluent.Orientation.Horizontal" Style="width:100%;height:60px;background-color:var(--pulse-dark-colour);padding:10px" HorizontalAlignment="HorizontalAlignment.Start" VerticalAlignment="VerticalAlignment.Center">
        <FluentLabel Typo="Typography.H3" Color="MsFluent.Color.Custom" CustomColor="var(--pulse-light-colour)">Production Plan For @DateTime.Today.ToString("dd-MM-yy")</FluentLabel>
        <FluentSpacer />
        <FluentButton class=@(pView == ProductionView.Dashboard ? "myModeBtnOn" : "myModeBtnOff") BackgroundColor="var(--pulse-mode-btn-bg)"
                      Color="var(--pulse-mode-btn-item-colour)" Style="height:40px;margin-right:10px"
                      OnClick="() => ChangeView(ProductionView.Dashboard)">
            Dashboard
        </FluentButton>
        <FluentButton class=@(pView == ProductionView.FactoryLayout ? "myModeBtnOn" : "myModeBtnOff") BackgroundColor="var(--pulse-mode-btn-bg)"
                      Color="var(--pulse-mode-btn-item-colour)" Style="height:40px;margin-right:10px"
                      OnClick="() => ChangeView(ProductionView.FactoryLayout)">
            Factory
        </FluentButton>
        <FluentButton class=@(pView == ProductionView.DataGrid ? "myModeBtnOn" : "myModeBtnOff") BackgroundColor="var(--pulse-mode-btn-bg)"
                      Color="var(--pulse-mode-btn-item-colour)" Style="height:40px;margin-right:10px"
                      OnClick="() => ChangeView(ProductionView.DataGrid)">
            Grid
        </FluentButton>
        @* <FluentSpacer /> *@
        <FluentButton BackgroundColor="rgba(255,255,255,1)" Style=" border: 1px solid red;height:40px;margin-right:10px"
                        IconStart="@(new Icons.Filled.Size32.DismissSquare().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Error))" data-bs-dismiss="offcanvas">
        </FluentButton>
    </FluentStack> @* Style="height:calc(100vh - 60px);" *@
    @if (pView == ProductionView.DataGrid)
    {
        <Animation Effect="@(pChangeTo == ProductionView.DataGrid ? Effect.BounceInUp : Effect.BounceOutDown)" Enabled="@startAni" Speed="@Speed.Slow" Style="height:calc(100vh - 60px);" OnAnimationEnd="@(() => EndAnimation(ProductionView.DataGrid))">
            <TodaysPlan />                    
        </Animation>
    }

    else if (pView == ProductionView.FactoryLayout)
    {
        <Animation Effect="@(pChangeTo == ProductionView.FactoryLayout ? Effect.BounceInUp : Effect.BounceOutDown)" Enabled="@startAni" Speed="@Speed.Slow" Style="height:calc(100vh - 60px);" OnAnimationEnd="@(() => EndAnimation(ProductionView.FactoryLayout))">
            <FactoryLayout />
        </Animation>
    }
    else if (pView == ProductionView.Dashboard)
    {
        <Animation Effect="@(pChangeTo == ProductionView.Dashboard ? Effect.FadeIn : Effect.FadeOut)" Enabled="@startAni" Speed="@Speed.Slow" Style="height:calc(100vh - 60px);" OnAnimationEnd="@(() => EndAnimation(ProductionView.Dashboard))">
            <PlanDashboard />
        </Animation>
    }

    
</div>

@code
{
    private ProductionView pView = ProductionView.Dashboard;
    private ProductionView pChangeTo = ProductionView.Dashboard;
    private string mnuActive = "Dashboard";
    private bool startAni = false;
    #region AppBar Icons

    private static Icon DashboardIcon(bool active = false) =>
        active ? new Icons.Filled.Size24.BoardSplit().WithColor("#365b66")
               : new Icons.Regular.Size24.BoardSplit().WithColor("#365b66");

    private static Icon WIPIcon(bool active = false) =>
        active ? new Icons.Filled.Size24.WrenchScrewdriver().WithColor("#365b66")
               : new Icons.Regular.Size24.WrenchScrewdriver().WithColor("#365b66");

    private static Icon PlanIcon(bool active = false) =>
        active ? new Icons.Filled.Size24.CalendarEdit().WithColor("#365b66")
               : new Icons.Regular.Size24.CalendarEdit().WithColor("#365b66");

    private static Icon SetupIcon(bool active = false) =>
        active ? new Icons.Filled.Size24.Settings().WithColor("#365b66")
               : new Icons.Regular.Size24.Settings().WithColor("#365b66");

    #endregion
    // private User? user;
    // #region Properties

    // #endregion

    // protected override async Task OnInitializedAsync()
    // {
    //     // Simulate asynchronous loading to demonstrate streaming rendering

    //     user = await dtrf.GetgvUser();

    // }
    private async Task ChangeView(ProductionView pw)
    {
        if(pw != pView)
        {
            pChangeTo = pw;
            startAni = true;
            await InvokeAsync(StateHasChanged);
        }
    }
    private async Task EndAnimation(ProductionView vFrom)
    {
        if (vFrom != pChangeTo)
        {
            pView = pChangeTo;
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            startAni = false;
        }
    }
    private enum ProductionView
    {
        DataGrid,
        FactoryLayout,
        Dashboard
    } 
}