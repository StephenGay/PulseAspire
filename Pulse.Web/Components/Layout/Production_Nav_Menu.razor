@code
{
    #region AppBar Icons

    private static Icon DashboardIcon(bool active = false) =>
        active ? new Icons.Filled.Size24.BoardSplit().WithColor("#365b66")
               : new Icons.Regular.Size24.BoardSplit().WithColor("#365b66");

    private static Icon WIPIcon(bool active = false) =>
        active ? new Icons.Filled.Size24.WrenchScrewdriver().WithColor("#365b66")
               : new Icons.Regular.Size24.WrenchScrewdriver().WithColor("#365b66");

    private static Icon PlanIcon(bool active = false) =>
        active ? new Icons.Filled.Size24.CalendarEdit().WithColor("#365b66")
               : new Icons.Regular.Size24.CalendarEdit().WithColor("#365b66");
   
    private static Icon SetupIcon(bool active = false) =>
        active ? new Icons.Filled.Size24.Settings().WithColor("#365b66")
               : new Icons.Regular.Size24.Settings().WithColor("#365b66");

    #endregion
