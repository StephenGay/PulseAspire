@using Microsoft.FluentUI.AspNetCore.Components
<div class="navmenu">
    <input type="checkbox" title="Menu expand/collapse toggle" id="navmenu-toggle" class="navmenu-icon" />
    <label for="navmenu-toggle" class="navmenu-icon"><FluentIcon Value="@(new Icons.Regular.Size20.Navigation())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Fill" /></label>
    <nav class="sitenav" aria-labelledby="main-menu">
        <FluentNavMenu Id="main-menu" Collapsible="true" Width="250" Title="Navigation menu" @bind-Expanded="expanded" CustomToggle="true">
            <FluentNavLink Href="/" Match="NavLinkMatch.All" Icon="@(new Icons.Regular.Size20.Home())" IconColor="Microsoft.FluentUI.AspNetCore.Components.Color.Accent">Home</FluentNavLink>
            <FluentNavGroup Title="Customers" Tooltip="Item 3.3 tooltip" Icon="@(new Icons.Regular.Size24.LeafThree())">
                <FluentNavLink Href="/EmployeeZone/CustomerSearch" Icon="@(new Icons.Regular.Size20.NumberSymbolSquare())" IconColor="Microsoft.FluentUI.AspNetCore.Components.Color.Accent">Search</FluentNavLink>
                <FluentNavLink Href="/EmployeeZone/Customers/ClientDashboard" Icon="@(new Icons.Regular.Size20.WeatherPartlyCloudyDay())" IconColor="Microsoft.FluentUI.AspNetCore.Components.Color.Accent">Dashboard</FluentNavLink>
                <FluentNavLink Href="/EmployeeZone/Customers/ClientProfile" Icon="@(new Icons.Regular.Size20.WeatherPartlyCloudyDay())" IconColor="Microsoft.FluentUI.AspNetCore.Components.Color.Accent">Profile</FluentNavLink>
                <FluentNavLink Href="/EmployeeZone/Customers/ClientRollerSpecs" Icon="@(new Icons.Regular.Size20.WeatherPartlyCloudyDay())" IconColor="Microsoft.FluentUI.AspNetCore.Components.Color.Accent">Roll Specifications</FluentNavLink>
                <FluentNavLink Href="/EmployeeZone/Customers/ClientSales" Icon="@(new Icons.Regular.Size20.WeatherPartlyCloudyDay())" IconColor="Microsoft.FluentUI.AspNetCore.Components.Color.Accent">Sales</FluentNavLink>
            </FluentNavGroup>
            
            <FluentNavGroup Title="Production" Tooltip="Item 3.3 tooltip" Icon="@(new Icons.Regular.Size24.LeafThree())">
                <FluentNavLink Href="/EmployeeZone/Production/ProductionDashboard" Icon="@(new Icons.Regular.Size20.WeatherPartlyCloudyDay())" IconColor="Microsoft.FluentUI.AspNetCore.Components.Color.Accent">Production</FluentNavLink>
                <FluentNavLink Href="/EmployeeZone/Production/WorkInProgress" Icon="@(new Icons.Regular.Size20.WeatherPartlyCloudyDay())" IconColor="Microsoft.FluentUI.AspNetCore.Components.Color.Accent">Work In Progress</FluentNavLink>
                <FluentNavLink Href="/EmployeeZone/Production/ProductionCalendar" Icon="@(new Icons.Regular.Size20.WeatherPartlyCloudyDay())" IconColor="Microsoft.FluentUI.AspNetCore.Components.Color.Accent">Production Plan</FluentNavLink>
                <FluentNavGroup Title="Production Setup" Tooltip="Item 3.3 tooltip" Icon="@(new Icons.Regular.Size24.LeafThree())">
                    <FluentNavLink Href="/EmployeeZone/Production/WorkCentres" Icon="@(new Icons.Regular.Size20.WeatherPartlyCloudyDay())" IconColor="Microsoft.FluentUI.AspNetCore.Components.Color.Accent">Work Centres</FluentNavLink>
                    <FluentNavLink Href="/EmployeeZone/Production/WorkTypes" Icon="@(new Icons.Regular.Size20.WeatherPartlyCloudyDay())" IconColor="Microsoft.FluentUI.AspNetCore.Components.Color.Accent">Work Types</FluentNavLink>
                </FluentNavGroup>
            </FluentNavGroup>
        </FluentNavMenu>
    </nav>
</div>

@code {
    private bool expanded = true;
}
