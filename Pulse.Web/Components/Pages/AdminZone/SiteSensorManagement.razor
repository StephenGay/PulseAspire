        </div>

        <!-- Network Scan Panel -->
        <div class="scan-panel divShadow" id="scanPanel">
            <h3>🌐 Local Network Scanner</h3>
            <p>Scan your local network to automatically discover cameras, RTSP streams, ONVIF devices, and other sensor points. The scan runs in your browser and probes common ports.</p>
            <div class="quick-add">
                <div class="quick-chip" @onclick="@(() => openAddSensor("camera"))">
                    <span class="qc-icon">📷</span> IP Camera
                </div>
                <div class="quick-chip" @onclick="@(() => openAddSensor("rtsp"))">
