<!-- ===== ADD SENSOR MODAL ===== -->
    <div class="modal-overlay" id="addSensorModal">
        <div class="modal">
            <div class="modal-header">
                <h3 id="modalTitle">Add Sensor</h3>
                <button class="modal-close" onclick="closeAddSensorModal()">&times;</button>
            </div>
            <div class="modal-body">
                <form id="addSensorForm" onsubmit="submitSensor(event)">
                    <div class="form-group">
                        <label>Sensor Type</label>
                        <select class="form-control" id="sensorType" onchange="updateSensorForm()">
                            <option value="camera">📷 IP Camera</option>
                            <option value="rtsp">📹 RTSP Stream</option>
                            <option value="usb">🔌 USB Camera</option>
                            <option value="mqtt">📊 MQTT Sensor</option>
                            <option value="http">🌐 HTTP Endpoint</option>
                            <option value="audio">🎤 Audio Input</option>
                            <option value="onvif">🎥 ONVIF Camera</option>
                            <option value="gpio">⚡ GPIO Sensor</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Name</label>
                        <input type="text" class="form-control" id="sensorName" placeholder="e.g. Front Gate Camera" required>
                    </div>
                    <div class="form-group" id="grpIp">
                        <label>IP Address</label>
                        <input type="text" class="form-control" id="sensorIp" placeholder="192.168.1.100">
                    </div>
                    <div class="form-group" id="grpPort">
                        <label>Port</label>
                        <input type="number" class="form-control" id="sensorPort" placeholder="554">
                    </div>
                    <div class="form-group" id="grpUrl">
                        <label>URL / Stream Path</label>
                        <input type="text" class="form-control" id="sensorUrl" placeholder="rtsp://192.168.1.100:554/stream">
                        <div class="form-hint" id="urlHint">Full connection URL for the sensor</div>
                    </div>
                    <div class="form-group" id="grpEdge">
                        <label>Link to Edge Device (optional)</label>
                        <select class="form-control" id="sensorEdge">
                            <option value="">— None (standalone) —</option>
                            
                            <option value="hm-vdb-floor-cam">Production Floor Cam</option>
                            
                            <option value="hm-vdb-oven-cam">Oven Bay Cam</option>
                            
                            <option value="hm-vdb-dispatch-cam">Dispatch &amp; QC Cam</option>
                            
                            <option value="hm-vdb-gate-cam">Security Gate Cam</option>
                            
                        </select>
                        <div class="form-hint">Which edge device should process this sensor's feed</div>
                    </div>
                    <div class="form-group">
                        <label>Zone / Description (optional)</label>
                        <input type="text" class="form-control" id="sensorZone" placeholder="e.g. Main entrance, Kraal area">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeAddSensorModal()">Cancel</button>
