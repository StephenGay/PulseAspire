    <div class="ccontent">
        <div class="page-header">
            <div>
                <h1>📡 Sensors & Edge Devices</h1>
                <div class="subtitle">Manage edge devices, cameras, and sensor points connected to Vereeniging Plant</div>
            </div>
            <div class="header-actions">
            <button class="myAccentBtn" style="height:50px;padding-left:10px;padding-right:10px;border-radius:10px" onclick="startNetworkScan()" id="scanBtn">
                    <span>🔍</span> Scan Network
                </button>
            <button class="myAccentBtn" style="height:50px;padding-left:10px;padding-right:10px;border-radius:10px" onclick="openAddSensorModal()">
                <span>+</span> Add Sensor
                </button>
            </div>
        </div>

