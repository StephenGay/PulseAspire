@page "/AdminZone/UserManagementPg"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Models.Users
@using Pulse.Models.Api
@using Pulse.Web.Services

@attribute [Authorize(Roles = "Admin")]

@inject IPulseToastService PulseToastService
@inject PulseApiService ApiService
@inject ILogger<UserManagementPg> Logger
@inject Global_AI_Functions GlobalAI
@rendermode InteractiveServer

<style>
    .ccontent {
        flex: 1; /* This magic makes it grow to fill the space */
        background: rgba(255,255,255,0.5);
        margin: 10px;
        padding: 10px;
        border-radius: 10px;
        overflow: auto;
    }
    /* Animation for form submission */
    @@keyframes slideRight {
        
        0%{
            box-shadow: 5px 5px 15px rgba(0, 0, 0, 0);
            transform: translateX(0);
            opacity: 1;
        }
        85% {
            box-shadow: 5px 5px 15px rgba(0, 0, 0, 0);
            transform: translateX(calc(50vw - 50%));
            opacity: 1;
        }
        90% {
            box-shadow: 5px 5px 15px rgba(0, 0, 0, 0);
            transform: translateX(calc(50vw - 50%));
            opacity: 1;
        }
        100%{
            box-shadow: 5px 5px 15px rgba(0, 0, 0, 0.8);
            transform: translateX(calc(50vw - 50%));
            opacity: 1;
        }
    }

    .slide-right-animation {
        animation: slideRight 1.5s ease-in-out forwards;
    }
    @@keyframes slideleft {
        0% {
            box-shadow: 5px 5px 15px rgba(0, 0, 0, 0.8);
            transform: translateX(calc(50vw - 50%));
            opacity: 1;
        }
        85%{
            box-shadow: 5px 5px 15px rgba(0, 0, 0, 0.8);
            transform: translateX(0);
            opacity: 1;
        }
        90%{
            box-shadow: 5px 5px 15px rgba(0, 0, 0, 0.8);
            transform: translateX(0);
            opacity: 1;
        }
        100% {
            box-shadow: 5px 5px 15px rgba(0, 0, 0, 0);
            transform: translateX(0);
            opacity: 1;
        }
        
    }
    .slide-left-animation {
        animation: slideleft 1.5s ease-in-out forwards;
    }
    .stay-right {
        transform: translateX(calc(50vw - 50%));
        box-shadow: 5px 5px 15px rgba(0, 0, 0, 0.8);
    }

    .stay-left {
        transform: translateX(0);
        box-shadow: 5px 5px 15px rgba(0, 0, 0, 0);
    }
</style>

