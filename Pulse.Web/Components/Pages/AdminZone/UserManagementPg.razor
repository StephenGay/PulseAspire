@page "/AdminZone/UserManagementPg"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Models.Users
@using Pulse.Models.Api
@using Pulse.Web.Services

@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@inject PulseApiService ApiService
@inject ILogger<UserManagementPg> Logger

<style>
    .ccontent {
        flex: 1; /* This magic makes it grow to fill the space */
        background: rgba(255,255,255,0.5);
        margin: 10px;
        padding: 10px;
        border-radius: 10px;
        overflow: auto;
    }
</style>

<div class="ccontent">

    @if (pgMode == "New")
    {
        <!-- Create New User Section -->
        <FluentCard>
            <FluentHeader Style="background-color: var(--pulse-dark-t75-colour); margin: -16px -16px 16px -16px; padding: 16px;">
                <h2 style="margin: 0; color: white;">Add New User</h2>
            </FluentHeader>

            <FluentStack Orientation="Orientation.Vertical" Style="gap: 16px;">
                <!-- User Registration Form -->
                <FluentStack Orientation="Orientation.Vertical" Style="gap: 12px;">
                    <FluentTextField @bind-Value="newUser.FullName"
                                     Label="Full Name"
                                     Placeholder="User Name and Surname"
                                     Required="true"
                                     Style="width: 100%;" />
                    <FluentTextField @bind-Value="newUser.Email"
                                     Label="Email"
                                     Type="InputType.Email"
                                     Placeholder="Enter User's Email Address"
                                     Required="true"
                                     Style="width: 100%;" />
                    <FluentTextField @bind-Value="newUser.Password"
                                     Label="Password"
                                     TextFieldType="TextFieldType.Password"
                                     Placeholder="Enter password (min 8 characters)"
                                     Required="true"
                                     Style="width: 100%;" />
                    <FluentTextField @bind-Value="confirmPassword"
                                     Label="Confirm Password"
                                     TextFieldType="TextFieldType.Password"
                                     Placeholder="Confirm password"
                                     Required="true"
                                     Style="width: 100%;" />
                </FluentStack>
                @* Type="InputType.Password" *@
                <!-- Messages -->
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <FluentMessageBar Severity="MessageSeverity.Success"
                                      OnDismiss="() => successMessage = string.Empty">
                        @successMessage
                    </FluentMessageBar>
                }

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <FluentMessageBar Severity="MessageSeverity.Error"
                                      OnDismiss="() => errorMessage = string.Empty">
                        @errorMessage
                    </FluentMessageBar>
                }

                <!-- Action Buttons -->
                <FluentStack Orientation="Orientation.Horizontal" Style="gap: 12px;">
                    <FluentButton Class="myOkBtn"
                                  BackgroundColor="var(--pulse-ok-btn-bg)"
                                  Color="var(--pulse-ok-btn-colour)"
                                  @onclick="CreateUserAsync"
                                  Disabled="@(isCreatingUser || !IsFormValid())">
                        @(isCreatingUser ? "Creating..." : "Create User")
                    </FluentButton>

                    <FluentButton Class="myCancelBtn" 
                        BackgroundColor="var(--pulse-cancel-btn-bg)"
                        Color="var(--pulse-cancel-btn-colour)"
                        @onclick="ResetForm"
                        Disabled="@isCreatingUser">
                        Cancel
                    </FluentButton>
                </FluentStack>
            </FluentStack>
        </FluentCard> 
    }
    else if (pgMode == "Edit" || pgMode="New")
    {
        <!-- Edit User Section -->
        <FluentCard>
            <FluentHeader Style="background-color: var(--pulse-dark-t75-colour); margin: -16px -16px 16px -16px; padding: 16px;">
                <h2 style="margin: 0; color: white;">@(pgMode == "Edit" ? "Edit User" : "New User")</h2>
            </FluentHeader>

            <FluentStack Orientation="Orientation.Vertical" Style="gap: 16px;">
                <FluentStack Orientation="Orientation.Vertical" Style="gap: 12px;">
                <!-- User Registration Form -->
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap: 12px;">
                    <FluentLabel Typo="Typography.H6" Style="width:100px">User ID :</FluentLabel>
                    <FluentTextField @bind-Value="editUser.Id"
                                     ReadOnly="true"
                                     Style="width:300px"
                                      />
                </FluentStack>
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap: 12px;">
                    <FluentLabel Typo="Typography.H6" Style="width:100px">Full Name :</FluentLabel>
                    <FluentTextField @bind-Value="editUser.FullName"
                                     Placeholder="User Name and Surname"
                                     Required="true"
                                     Style="width:300px"
                                      />
                </FluentStack>
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap: 12px;">
                    <FluentLabel Typo="Typography.H6" Style="width:100px">E-Mail :</FluentLabel>
                    <FluentTextField @bind-Value="editUser.Email"
                                        Type="InputType.Email"
                                        Placeholder="Enter User's Email Address"
                                        Required="true"
                                         Style="width:300px" />
                   
                </FluentStack>
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap: 12px;">
                    <FluentLabel Typo="Typography.H6" Style="width:100px">Phone :</FluentLabel>
                    <FluentTextField @bind-Value="editUser.PhoneNumber"
                                        Placeholder="Enter User's Phone Number"
                                        Style="width:300px" />
                </FluentStack>
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap: 12px;">
                    <FluentLabel Typo="Typography.H6" Style="width:100px">Require Pwd Change :</FluentLabel>
                    <FluentSwitch @bind-Value="editUser.RequirePwdChange" />
                </FluentStack>
                    <!-- Action Buttons -->
                    <FluentStack Orientation="Orientation.Horizontal" Style="gap: 12px;">
                        <FluentButton Class="myOkBtn"
                                      BackgroundColor="var(--pulse-ok-btn-bg)"
                                      Color="var(--pulse-ok-btn-colour)"
                                      @onclick="UpdateUserAsync"
                                      Disabled="@(isUpdatingUser || !IsEditFormValid())">
                            @(isCreatingUser ? "Updating..." : "Update User")
                        </FluentButton>

                        <FluentButton Class="myCancelBtn"
                                      BackgroundColor="var(--pulse-cancel-btn-bg)"
                                      Color="var(--pulse-cancel-btn-colour)"
                                      @onclick="ResetForm"
                                      Disabled="@isCreatingUser">
                            Cancel
                        </FluentButton>
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap: 12px;">
                        @if (editUser.EmailConfirmed)
                        {
                            <FluentIcon Value="@(new Icons.Filled.Size32.CheckmarkCircle())" Color="@Microsoft.FluentUI.AspNetCore.Components.Color.Success" />
                        }
                        else
                        {
                            <FluentIcon Value="@(new Icons.Filled.Size32.DismissCircle())" Color="@Microsoft.FluentUI.AspNetCore.Components.Color.Error" />
                        }
                        <FluentLabel Typo="Typography.H6">E-Mail Confirmed</FluentLabel>
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap: 12px;">
                        @if (editUser.TwoFactorEnabled)
                        {
                            <FluentIcon Value="@(new Icons.Filled.Size32.CheckmarkCircle())" Color="@Microsoft.FluentUI.AspNetCore.Components.Color.Success" />
                        }
                        else
                        {
                            <FluentIcon Value="@(new Icons.Filled.Size32.DismissCircle())" Color="@Microsoft.FluentUI.AspNetCore.Components.Color.Error" />
                        }
                        <FluentLabel Typo="Typography.H6">Two Factor Authentication Enabled</FluentLabel>
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap: 12px;">
                        @if (editUser.RequirePwdChange)
                        {
                            <FluentIcon Value="@(new Icons.Filled.Size32.CheckmarkCircle())" Color="@Microsoft.FluentUI.AspNetCore.Components.Color.Success" />
                        }
                        else
                        {
                            <FluentIcon Value="@(new Icons.Filled.Size32.DismissCircle())" Color="@Microsoft.FluentUI.AspNetCore.Components.Color.Error" />
                        }
                        <FluentLabel Typo="Typography.H6">Password Change Requested</FluentLabel>
                    </FluentStack>
                    
                    @* <FluentStack Orientation="Orientation.Horizontal" Style="gap: 12px;">
                        <FluentNumberField @bind-Value="editUser.AccessFailedCount"
                                         Label="Login Failed Count"
                                         ReadOnly="true" />
                        <FluentSwitch @bind-Value="editUser.LockoutEnabled"
                                      Label="Account Locked"
                                      Style="align-self: center;" />
                        @* <FluentTextField @bind-Value="editUser.LockoutEnd"
                                          Label="Lockout End"
                                          Style="align-self: center;" /> 
                    </FluentStack> *@
                    
                </FluentStack>
                @* Type="InputType.Password" *@
                <!-- Messages -->
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <FluentMessageBar Severity="MessageSeverity.Success"
                                      OnDismiss="() => successMessage = string.Empty">
                        @successMessage
                    </FluentMessageBar>
                }

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <FluentMessageBar Severity="MessageSeverity.Error"
                                      OnDismiss="() => errorMessage = string.Empty">
                        @errorMessage
                    </FluentMessageBar>
                }

                
            </FluentStack>
        </FluentCard>
    }
    else
    {


        <!-- Users List Section -->
        <FluentCard>
            <FluentHeader Style="background-color: var(--pulse-dark-t75-colour); margin: -16px -16px 16px -16px; padding: 16px;">
                <h2 style="margin: 0; color: white;">Manage Users</h2>
            </FluentHeader>

            @if (isLoadingUsers)
            {
                <FluentProgressRing></FluentProgressRing>
                <p>Loading users...</p>
            }
            else if (users?.Any() == true)
            {
                <FluentStack Orientation="Orientation.Vertical" Style="gap: 12px;">
                    <FluentStack Orientation="Orientation.Horizontal" Style="gap: 12px; align-items: flex-start;">
                        <FluentButton Class="myAccentBtn" 
                            BackgroundColor="var(--pulse-accent-btn-bg)"
                            Color="var(--pulse-accent-btn-colour)"
                            @onclick="AddNewUser">
                            Add New User
                        </FluentButton>
                        <FluentSpacer />
                        <FluentLabel Typo="Typography.Body" Style="color: #666;">
                            Showing @filteredUsers?.Count() of @users?.Count() users
                        </FluentLabel>
                    </FluentStack>
                    <!-- Filter Section -->
                    <FluentStack Orientation="Orientation.Horizontal" Style="gap: 12px; align-items: center;">
                        <FluentTextField @bind-Value="filterEmail"
                        Label="Search by Name"
                        Placeholder="Filter users..."
                        @oninput="@((ChangeEventArgs e) => { filterEmail = e.Value?.ToString() ?? string.Empty; ApplyUserFilter(); })"
                        Style="flex: 1;" />

                        <FluentButton Appearance="Appearance.Neutral"
                        @onclick="ClearUserFilter"
                        Disabled="@string.IsNullOrEmpty(filterEmail)">
                            Clear
                        </FluentButton>
                    </FluentStack>

                    <!-- Users Data Grid -->
                    <FluentDataGrid Items="@(filteredUsers?.AsQueryable() ?? new List<ApplicationUserDto>().AsQueryable())"
                    TItem="ApplicationUserDto"
                    ResizableColumns="true"
                    Style="width:100%"
                    Pagination="@pagination">
                        <PropertyColumn Property="@(u => u.FullName)" Title="Full Name" />
                        <PropertyColumn Property="@(u => u.Email)" Title="Email" />
                        @* <PropertyColumn Property="@(u => u.UserName)" Title="Username" /> *@

                        <TemplateColumn Title="Roles" Context="user">
                            @if (user.Roles?.Any() == true)
                            {
                                <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                                    @foreach (var role in user.Roles)
                                    {
                                        <FluentBadge Appearance="Appearance.Accent">@role</FluentBadge>
                                    }
                                </div>
                            }
                            else
                            {
                                <span style="color: #999;">No roles assigned</span>
                            }
                        </TemplateColumn>

                        <TemplateColumn Title="Actions" Context="user">
                            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 8px;">
                                <FluentButton Appearance="Appearance.Lightweight"
                                Size="ButtonSize.Small"
                                @onclick="() => EditUser(user)"
                                Title="Edit user details">
                                    Edit
                                </FluentButton>

                                <FluentButton Appearance="Appearance.Lightweight"
                                IconStart="@(new Icons.Filled.Size16.Delete())"
                                Size="ButtonSize.Small"
                                @onclick="() => DeleteUserAsync(user.Id)"
                                Title="Delete user">
                                    Delete
                                </FluentButton>
                            </FluentStack>
                        </TemplateColumn>
                    </FluentDataGrid>

                    <FluentPaginator State="@pagination" Style="margin-top: 20px; width:100%;padding:10px;"></FluentPaginator>
                </FluentStack>
            }
            else
            {
                <FluentMessageBar Severity="MessageSeverity.Warning">
                    No users found in the system.
                </FluentMessageBar>
            }
        </FluentCard>
    }
</div>

@code {
    private RegisterModel newUser = new();
    private string confirmPassword = string.Empty;
    private List<ApplicationUserDto> users = new();
    private List<ApplicationUserDto> filteredUsers = new();
    private ApplicationUserDto? editUser;
    private string filterEmail = string.Empty;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private bool isCreatingUser = false;
    private string pgMode = "List";
    private bool isNewUserMode = false;
    private bool isLoadingUsers = false;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            isLoadingUsers = true;
            errorMessage = string.Empty;
            var apiResponse = await ApiService.GetAsync<ApiResponse<List<ApplicationUserDto>>>("/Security/users");
            users = apiResponse?.Data ?? new();
            filteredUsers = users.ToList();
            Logger.LogInformation("Loaded {Count} users", users.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load users");
            errorMessage = "Failed to load users. Please try again.";
        }
        finally
        {
            isLoadingUsers = false;
        }
    }

    private async Task CreateUserAsync()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        // Validation
        if (!IsFormValid())
        {
            errorMessage = "Please fill in all fields correctly.";
            return;
        }

        try
        {
            isSavingUser = true;
            editUser.UserName = editUser.Email;
            var result = await ApiService.UserRegisterAsync(editUser);

            if (result != null)
            {
                successMessage = $"User '{editUser.Email}' created successfully.";
                ResetForm();
                await LoadUsersAsync();
                Logger.LogInformation("User created: {Email}", editUser.Email);
                pgMode = "List";
            }
            else
            {
                errorMessage = "Failed to create user. Please try again.";
            }
        }
        catch (PulseApiException ex)
        {
            Logger.LogError(ex, "API error creating user: {Message}", ex.UserMessage);
            errorMessage = ex.UserMessage ?? "Failed to create user.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error creating user");
            errorMessage = "An unexpected error occurred while creating the user.";
        }
        finally
        {
            isCreatingUser = false;
        }
    }

    private async Task AddNewUser()
    {
        ResetForm();
        editUser = new ApplicationUserDto { Id = "(New)", RequirePwdChange = true };
        pgMode = "New";
        //isNewUserMode = true;
        // StateHasChanged();
    }

    private async Task DeleteUserAsync(string userId)
    {
        if (!await ConfirmAsync("Are you sure you want to delete this user?"))
            return;

        try
        {
            // TODO: Implement DeleteUserAsync in PulseApiService
            errorMessage = "Delete functionality not yet implemented.";
            Logger.LogWarning("Delete user attempted for userId: {UserId}", userId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting user");
            errorMessage = "Failed to delete user.";
        }
    }

    private void EditUser(ApplicationUserDto user)
    {
        // TODO: Implement edit functionality (could open a dialog)
        editUser = user;
        pgMode = "Edit";

        Logger.LogInformation("Edit user: {Email}", user.Email);
    }

    private void ApplyUserFilter()
    {
        if (users == null) return;

        filteredUsers = users
            .Where(u => string.IsNullOrWhiteSpace(filterEmail) || 
                        (u.FullName?.Contains(filterEmail, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();

        pagination = new PaginationState { ItemsPerPage = 10 };
    }

    private void ClearUserFilter()
    {
        filterEmail = string.Empty;
        filteredUsers = users?.ToList() ?? new();
        pagination = new PaginationState { ItemsPerPage = 10 };
    }

    private void ResetForm()
    {
        newUser = new();
        confirmPassword = string.Empty;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        isNewUserMode = false;
        StateHasChanged();
    }

    private bool IsFormValid()
    {
        return !string.IsNullOrWhiteSpace(editUser.Email) &&
               !string.IsNullOrWhiteSpace(editUser.FullName);
    }

    private async Task<bool> ConfirmAsync(string message)
    {
        // Simple confirmation (you can enhance this with a dialog)
        return await Task.FromResult(true); // Placeholder
    }
}