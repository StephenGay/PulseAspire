@code {
    // private RegisterModel newUser = new();
    private string confirmPassword = string.Empty;
    private List<ApplicationUserDto> users = new();
    private List<ApplicationUserDto> filteredUsers = new();
    private ApplicationUserDto? editUser;
    private ApplicationUserDto? editCancelledUser;
    private string filterEmail = string.Empty;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private bool isSavingUser = false;
    private bool isAnimating = false;
    private string animationDirection = "none";
    private string pgMode = "List";
    private string pgTitle = "Manage Users";
    // private bool isNewUserMode = false;
    private bool isLoadingUsers = false;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task EditUserDetails()
    {
        editCancelledUser = new ApplicationUserDto
            {
                Id = editUser.Id,
                FullName = editUser.FullName,
                Email = editUser.Email,
                PhoneNumber = editUser.PhoneNumber
            };
        await SwitchPageMode("Edit");
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            isLoadingUsers = true;
            errorMessage = string.Empty;
            var apiResponse = await ApiService.GetAsync<ApiResponse<List<ApplicationUserDto>>>("/Security/users");
            users = apiResponse?.Data ?? new();
            filteredUsers = users.ToList();
            Logger.LogInformation("Loaded {Count} users", users.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load users");
            errorMessage = "Failed to load users. Please try again.";
        }
        finally
        {
            isLoadingUsers = false;
        }
    }

    private async Task SaveUserAsync()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        // Validation
        if (!IsFormValid())
        {
            errorMessage = "One or more of the fields do not have a valid entry.<br />Please check and try again.";
            PulseToastService.ShowToast("Warning", errorMessage);
            await GlobalAI.AISpeak(errorMessage, "PulseAI");
            return;
        }

        isSavingUser = true;
        if (pgMode == "New")
        {
            await CreateUserAsync();
        }
        else if (pgMode == "Edit" && editUser != null)
        {
            await UpdateUser();
        }


        isSavingUser = false;
    }

    private async Task SwitchPageMode(string Mode)
    {
        switch (Mode)
        {
            case "View":
                await AniLeft();
                pgTitle = "View User";
                pgMode = "View";
                break;
            case "New":
                await AniMiddle();
                pgTitle = "New User";
                pgMode = "New";
                break;
            case "Edit":
                await AniMiddle();
                pgTitle = "Edit User";
                pgMode = "Edit";
                break;
            case "List":
                ResetForm();
                pgTitle = "Manage Users";
                pgMode = "List";
                break;
        }
        StateHasChanged();
    }

    #region Animations

    private string GetAnimationClass()
    {
        if (isAnimating)
            return animationDirection == "left" ? "slide-left-animation" : "slide-right-animation";

        return animationDirection switch
        {
            "left" => "stay-left",
            "right" => "stay-right",
            _ => string.Empty
        };
    }

    private async Task AniMiddle()
    {
        animationDirection = "right"; // Reset to center
        isAnimating = true;
        StateHasChanged();
        await Task.Delay(1500);
        isAnimating = false;
    }

    private async Task AniLeft()
    {
        animationDirection = "left";
        isAnimating = true;
        StateHasChanged();
        await Task.Delay(1500);
        // Keep it on the left permanently
        isAnimating = false;
        // StateHasChanged();
    }

    #endregion

    private async Task UpdateUser()
    {
        try
        {
            editUser.UserName = editUser.Email;
            var result = await ApiService.EditUserAsync(editUser);
            if(result.Success == true)
            {
                successMessage = $"{editUser.FullName} has been updated.";
                PulseToastService.ShowToast("Success", successMessage);
                await GlobalAI.AISpeak(successMessage, "PulseAI");
                await SwitchPageMode("View");
                return;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "There was an error updating the user.<br />Please check the form and try again.";
            PulseToastService.ShowToast("Warning", errorMessage);
            await GlobalAI.AISpeak(errorMessage, "PulseAI");
            Logger.LogError(ex, "Error updating user");
            return;
        }
    }
    private async Task CreateUserAsync()
    {

        try
        {
            editUser.UserName = editUser.Email;
            var result = await ApiService.UserRegisterAsync(editUser);

            if (result.Success == true)
            {
                successMessage = $"User '{editUser.FullName}' created successfully.";
                editUser = result.Data;
                // ResetForm();
                successMessage = $"New user {editUser.FullName} has been created.<br />A Welcome message will be sent to their email.";
                Logger.LogInformation("User created: {FullName}", editUser.FullName);
                PulseToastService.ShowToast("Success", successMessage);
                await GlobalAI.AISpeak(successMessage, "PulseAI");
                await SwitchPageMode("View");
                await SendWelcomeEmail();
                return;
                // pgMode = "List";
            }
            else
            {
                errorMessage = "There was an error creating the user.<br />Please check the form and try again.";
                PulseToastService.ShowToast("Error", errorMessage);
                await GlobalAI.AISpeak(errorMessage, "PulseAI");
                Logger.LogWarning("Error updating user");
                return;
            }
        }
        catch (PulseApiException ex)
        {
            Logger.LogError(ex, "API error creating user: {Message}", ex.UserMessage);
            errorMessage = "There was an error creating the user.<br />Please check the form and try again.";
            PulseToastService.ShowToast("Error", errorMessage);
            await GlobalAI.AISpeak(errorMessage, "PulseAI");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error creating user");
            errorMessage = "There was an Unexpected error creating user.<br />Please try again.";
            PulseToastService.ShowToast("Error", errorMessage);
            await GlobalAI.AISpeak(errorMessage, "PulseAI");
        }
    }

    private async Task SendWelcomeEmail()
    {
        bool isSuccess = false;
        try
        {
            var result = await ApiService.PostAsync<ApplicationUserDto, ApiResponse>(ApiEndpoints.User.SendWelcomeEmail, editUser);
            isSuccess = result?.Success == true;
        }
        catch(Exception ex)
        {
            isSuccess = false;
        }
        finally
        {
            if (isSuccess)
            {
                var msg = $"A Welcome message has been sent to {editUser.FullName}";
                PulseToastService.ShowToast("Success", msg);
                await GlobalAI.AISpeak(msg, "PulseAI");
            }
            else
            {
                var msg = "There was an error sending the Welcome message.<br />You can use the 'Resend Welcome Message' button to try again.";
                PulseToastService.ShowToast("Error", msg);
                await GlobalAI.AISpeak(msg, "PulseAI");
            }
        }
    }
    private async Task AddNewUser()
    {
        ResetForm();
        editUser = new ApplicationUserDto(); // { Id = "(New)", RequirePwdChange = true };
        animationDirection = "right";
        pgTitle = "New User";
        pgMode = "New";
        //isNewUserMode = true;
        // StateHasChanged();
    }

    private async Task DeleteUserAsync(string userId)
    {
        if (!await ConfirmAsync("Are you sure you want to delete this user?"))
            return;

        try
        {
            // TODO: Implement DeleteUserAsync in PulseApiService
            errorMessage = "Delete functionality not yet implemented.";
            Logger.LogWarning("Delete user attempted for userId: {UserId}", userId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting user");
            errorMessage = "Failed to delete user.";
        }
    }

    private void ViewUser(ApplicationUserDto user)
    {
        // TODO: Implement edit functionality (could open a dialog)
        editUser = user;
        animationDirection = "left";
        pgMode = "View";
        pgTitle = "View User";

        Logger.LogInformation("Edit user: {Email}", user.Email);
    }

    private void ApplyUserFilter()
    {
        if (users == null) return;

        filteredUsers = users
            .Where(u => string.IsNullOrWhiteSpace(filterEmail) || 
                        (u.FullName?.Contains(filterEmail, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();

        pagination = new PaginationState { ItemsPerPage = 10 };
    }

    private void ClearUserFilter()
    {
        filterEmail = string.Empty;
        filteredUsers = users?.ToList() ?? new();
        pagination = new PaginationState { ItemsPerPage = 10 };
    }

    private void CancelClick()
    {
        if(pgMode == "Edit")
        {
            if(editUser.Id == editCancelledUser.Id)
            {
                editUser.FullName = editCancelledUser.FullName;
                editUser.Email = editCancelledUser.Email;
                editUser.PhoneNumber = editCancelledUser.PhoneNumber;
                SwitchPageMode("View");
            }
            else
            {
                editCancelledUser = null;
                SwitchPageMode("List");
            }
        }
        else
        {
            SwitchPageMode("List");    
        }
    }

    private void ResetForm()
    {
        editUser = new();
        errorMessage = string.Empty;
        successMessage = string.Empty;
        
        // StateHasChanged();
    }

    private bool IsFormValid()
    {
        return !string.IsNullOrWhiteSpace(editUser.Email) &&
               !string.IsNullOrWhiteSpace(editUser.FullName);
    }

    private async Task<bool> ConfirmAsync(string message)
