@using Pulse.Models.Users
@inject Pulse.Web.Services.PulseApiService pApiClient

@rendermode InteractiveServer

<style>

fluent-select::part(listbox) {
    z-index: 1000;  /* Increase to layer above grid */
    max-height: 300px;  /* Optional: Allow scrolling for long lists */
    overflow-y: auto;
}

