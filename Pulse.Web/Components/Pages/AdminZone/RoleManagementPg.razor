@page "/AdminZone/RoleManagementPg"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Models.Users
@using Pulse.Models.Api
@using Pulse.Web.Services

@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@inject PulseApiService ApiService
@inject ILogger<RoleManagementPg> Logger

<style>
    .ccontent {
        flex: 1; /* This magic makes it grow to fill the space */
        background: rgba(255,255,255,0.5);
        margin: 10px;
        padding: 10px;
        border-radius: 10px;
        overflow: auto;
    }
</style>

<div class="ccontent">
    <!-- User Role Assignment Section -->
    @* <FluentCard Height="50%">

        <FluentHeader Style="background-color: #365b66; margin: -16px -16px 16px -16px; padding: 16px;">
            <h2 style="margin: 0; color: white;">Assign Roles to Users</h2>
        </FluentHeader>

        @if (isLoadingUsers)
        {
            <FluentProgressRing></FluentProgressRing>
            <p>Loading users...</p>
        }
        else if (users?.Any() == true)
        {
            <FluentDataGrid Items="@users.AsQueryable()"
                            TItem="UserRoleDto"
                            ResizableColumns="true"
                            Pagination="@pagination">

                <PropertyColumn Property="@(u => u.Email)" Title="Email" />

                <TemplateColumn Title="Current Roles" Context="user">
