@page "/AdminZone/RoleManagementPg"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Models.Permissions
@using Pulse.Models.Api
@using Pulse.Web.Services

@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@inject PulseApiService ApiService
@inject ILogger<RoleManagementPg> Logger
@inject IPulseToastService PulseToastService
@inject Global_AI_Functions GlobalAI

<style>
    .permission-grid {
        /* display: grid;
            grid-auto-flow: column;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            grid-auto-rows: 1fr;
            gap: 12px;
            margin: 16px 0;
            overflow-x: auto;
            overflow-y: hidden; */
        display: grid;
        grid-auto-flow: column;
        grid-template-columns: repeat(auto-fill, minmax(325px, 325px));
        /*grid-auto-columns: minmax(320px, 1fr);*/
        grid-template-rows: repeat(auto-fill, minmax(120px, auto));
        gap: 15px;
        padding: 20px;
        height: 100%;
        overflow: auto;
    }

    .equal-height-fluent-item {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background-color: var(--neutral-layer-1);
        border: 1px solid var(--neutral-stroke-1);
        border-radius: 4px;
        padding: 12px;
        box-sizing: border-box;
    }

    .permission-card {
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 12px;
        background: white;
        transition: box-shadow 0.2s ease;
    }

        .permission-card:hover {
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

    .permission-item {
        padding: 8px;
        background: #f5f5f5;
        border-radius: 4px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .permission-item:last-child {
            margin-bottom: 0;
        }

    .permissions-container {
        max-height: 85%; 
        overflow-y: auto;
        border: 1px solid #e0e0e0;
        border-radius: 4px;
        padding: 12px;
    }

    .selected-permission {
        border: 2px double var(--pulse-dark-colour);
        background-color: var(--pulse-dark-t25-colour);
        /* animation: selected-item-pulse 2s infinite; */
    }

    @@keyframes selected-item-pulse {
        0%, 100% {
            box-shadow: 0 0 0 0 var(--pulse-dark-t25-colour);
        }

        50% {
            box-shadow: 0 0 15px 8px var(--pulse-dark-t50-colour);
        }
    }

    @@media (max-width: 768px) {
        .permission-grid {
            grid-auto-flow: row;
            grid-auto-columns: 1fr;
            max-height: none;
            overflow-x: hidden;
            overflow-y: auto;
        }
    }

    .pmContent {
        flex: 1;
        /* padding: 10px; */
        overflow: hidden;
        display: flex;
        height: 100%;
        /* background-color: white; */
        gap: 10px;
    }

    .pmSidebar {
        flex-shrink: 0;
        width: 15%;
        overflow: auto;
        padding: 10px;
        height: calc(100% - 103px);
        /*border: 1px solid var(--pulse-dark-colour);*/
        border-radius: 8px;
    }

    .ali-pulse-column-grid {
        display: grid;
        grid-auto-flow: column;
        grid-template-columns: repeat(auto-fill, minmax(325px, 325px));
        /*grid-auto-columns: minmax(320px, 1fr);*/
        grid-template-rows: repeat(auto-fill, minmax(120px, auto));
        gap: 15px;
        padding: 20px;
        height: 100%;
        overflow: auto;
    }

    .ali-pulse-grid-item {
        display: flex;
        flex-direction: column;
        border-radius: 8px;
        background-color: white;
        width: 320px;
        height: 120px;
        padding: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .ali-pulse-grid-item:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
        }
</style>

