    private object GetRolePermissionIcon(bool isAssigned)
    {
        return isAssigned
            ? new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size24.CheckmarkCircle()
            : new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.Circle();
    }
