    private async Task SaveRole()
    {
        bool isSuccess = false;

        try
        {
            var response = await ApiService.PostAsync<string, ApiResponse<string>>(ApiEndpoints.Security.Roles.Create, newRole);
            isSuccess = response?.Success == true;
            if (isSuccess)
            {
                roles.Add( new RoleWithIdDto { Id = response!.Data!, Name = newRole });
                newRole = string.Empty;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
        }
        finally
        {
            if (isSuccess)
            {
                PulseToastService.ShowToast("Success", $"The '{newRole}' role has been created successfully.<br />You may now assign Permissions and Users to it.", true, true);
                await GlobalAI.AISpeak($"The '{newRole}' role has been created successfully.<br />You may now assign permissions and Users to it.", "PulseAI");
                addMode = false;
            }
            else
            {
                PulseToastService.ShowToast("Error", "There was a problem saving the New Role.<br />Please try again.",true,true);
                await GlobalAI.AISpeak("There was a problem saving the New Role.<br />Please try again.", "PulseAI");
            }
        }
    }

    private async Task LoadPermissionsAsync()
    {
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<List<PermissionDto>>>(ApiEndpoints.Security.Permissions.GetAll);
            permissions = response?.Data ?? new();
            Logger.LogInformation("Loaded {Count} permissions", permissions.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load permissions");
            errorMessage = "Failed to load permissions.";
        }
        finally
        {
            isLoadingPermissions = false;
        }
    }

