@page "/AdminZone/PermissionManagementPg"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Models.Permissions
@using Pulse.Models.Api
@using Pulse.Web.Services

@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@inject PulseApiService ApiService
@inject ILogger<RoleManagementPg> Logger
@inject IPulseToastService PulseToastService
@inject Global_AI_Functions GlobalAI

<style>
    .permission-grid {
        display: grid;
        grid-auto-flow: column;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        /* grid-auto-rows: 1fr; */
        gap: 12px;
        margin: 16px 0;
        overflow-x: auto;
        overflow-y: hidden;
    }

    .equal-height-fluent-item {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--neutral-layer-1);
    border: 1px solid var(--neutral-stroke-1);
    border-radius: 4px;
    padding: 12px;
    box-sizing: border-box;
}
    .permission-card {
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 12px;
        background: white;
        transition: box-shadow 0.2s ease;
    }

    .permission-card:hover {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .permission-item {
        padding: 8px;
        background: #f5f5f5;
        border-radius: 4px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .permission-item:last-child {
        margin-bottom: 0;
    }

    .permissions-container {
        max-height: 500px;
        overflow-y: auto;
        border: 1px solid #e0e0e0;
        border-radius: 4px;
        padding: 12px;
    }

    .selected-permission {
                
                border:2px double var(--pulse-dark-colour);
                background-color:  var(--pulse-dark-t25-colour);
                /* animation: selected-item-pulse 2s infinite; */
            }
    @@keyframes selected-item-pulse {
                0%, 100% {
                    box-shadow: 0 0 0 0 var(--pulse-dark-t25-colour);
                }

                50% {
                    box-shadow: 0 0 15px 8px var(--pulse-dark-t25-colour);
                }
            }
    @@media (max-width: 768px) {
        .permission-grid {
            grid-auto-flow: row;
            grid-auto-columns: 1fr;
            max-height: none;
            overflow-x: hidden;
            overflow-y: auto;
        }
    }
</style>

<div style="flex: 1; background: rgba(255,255,255,0.5); margin: 10px; padding: 10px; border-radius: 10px; overflow: auto;">
    <FluentCard>
        <FluentHeader Style="background-color: var(--pulse-dark-t75-colour); margin: -16px -16px 16px -16px; padding: 16px;">
            <h2 style="margin: 0; color: white;">
                <FluentIcon Value="@(new Icons.Filled.Size24.PlayCircle().WithColor("white"))" Style="margin-right: 8px;" OnClick="NavigatePermissions" />
                @tabTitle</h2>
        </FluentHeader>

        @* @if (!string.IsNullOrEmpty(successMessage))
        {
            <FluentMessageBar Severity="MessageSeverity.Success" 
                            OnDismiss="() => successMessage = string.Empty"
                            Style="margin-bottom: 16px;">
                @successMessage
            </FluentMessageBar>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <FluentMessageBar Severity="MessageSeverity.Error"
                            OnDismiss="() => errorMessage = string.Empty"
                            Style="margin-bottom: 16px;">
                @errorMessage
            </FluentMessageBar>
        } *@

        @* <FluentTabs ActiveTabId="@activeTab"> *@
        @if (activeTab == "tbOverview")
        {
            <div Id="tbOverview">
                @* <FluentStack Orientation="Orientation.Vertical" Style="gap: 16px; margin-top: 16px;"> *@
                    

                    @if (isLoadingPermissions)
                    {
                        <FluentProgressRing></FluentProgressRing>
                        <p>Loading permissions...</p>
                    }
                    else if (permissions?.Any() == true)
                    {
                        <div style="margin-top: 16px;width:stretch">
                            <h4>All Permissions (@permissions.Count)</h4>
                            </div>
                            <div class="permission-grid">
                                @foreach (var categoryGroup in permissions.GroupBy(p => p.Category))
                                {
                                    <div>
                                        <h5 style="margin: 0 0 12px 0; color: var(--pulse-dark-colour);">@categoryGroup.Key</h5>
                                        @foreach (var perm in categoryGroup)
                                        {
                                            <div class="permission-card divShadow" style=" margin-bottom:10px">
                                                <FluentStack Orientation="Orientation.Vertical" Style="gap: 8px;">
                                                    <FluentLabel Typo="Typography.Body" Style="font-weight: bold;">@perm.Name</FluentLabel>
                                                    <FluentLabel Typo="Typography.Body" Style="font-size: 0.875rem; color: #666;">@perm.Description</FluentLabel>
                                                    <FluentLabel Typo="Typography.Body" Style="font-size: 0.75rem; color: #999;">ID: @perm.Id</FluentLabel>
                                                </FluentStack>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        
                    }
                    else
                    {
                        <FluentMessageBar Severity="MessageSeverity.Warning">
                            No permissions found. Create one to get started!
                        </FluentMessageBar>
                    }
                @* </FluentStack> *@
            </div>
        }
        else if(activeTab == "tbCategory")
        {
            <div Id="tbCategory">
                <FluentStack Orientation="Orientation.Vertical" Style="gap: 16px; margin-top: 0px;">
                    @* <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap: 12px;background-color: var(--pulse-light-2-colour); flex-wrap: wrap;border: 1px solid var(--pulse-dark-colour);border-radius:10px;padding:10px;"> *@
                    @if (addMode)
                    {
                        <div class="divShadow" style="min-width: 200px;max-width:800px;width:95%;border-radius:10px;padding:10px;margin-left:auto;margin-right:auto">
                            <FluentStack Orientation="Orientation.Vertical" Style="gap: 5px; align-items: flex-start;">
                                <FluentTextField @bind-Value="newCategory"
                                    Immediate="true"
                                    Placeholder="Add A New Category (e.g., Admin)"
                                    Required="true"
                                    Label="Category Name"
                                    Style="width:stretch; min-width: 200px;" />
                                    <div style="width:stretch;text-align:center">
                                        <FluentButton Class="myOkBtn"
                                                    BackgroundColor="var(--pulse-ok-btn-bg)"
                                                    Color="var(--pulse-ok-btn-colour)"
                                                    @onclick="SaveNewCategory"
                                                    IconStart="@(new Icons.Filled.Size24.Save().WithColor("--pulse-ok-btn-colour"))"
                                                    Style="height:40px;margin:10px;"
                                                    Disabled="@(string.IsNullOrEmpty(newCategory))">
                                                Save
                                        </FluentButton>
                                    </div>
                            </FluentStack>
                        </div>
                    }
                        
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center" Style="gap: 12px; flex-wrap: wrap;">
                        <FluentButton Class="myAccentBtn" BackgroundColor="var(--pulse-accent-btn-bg)"  style="height:50px;width:200px" Color="var(--pulse-accent-btn-colour)" OnClick="@(() => { addMode= !addMode ; selectedCategory = string.Empty;})">
                            <FluentIcon Value="@(new Icons.Filled.Size32.AddCircle().WithColor("var(--pulse-accent-btn-colour)"))" /> New
                        </FluentButton>
                        <FluentButton Class="myCancelBtn"
                                    BackgroundColor="var(--pulse-cancel-btn-bg)"
                                    Color="var(--pulse-cancel-btn-colour)"
                                    IconStart="@(new Icons.Filled.Size24.DismissCircle().WithColor("--pulse-cancel-btn-colour"))"
                                    Disabled ="string.IsNullOrEmpty(selectedCategory)"
                                    style="height:50px;width:200px"
                                    @onclick="DeleteCategoryClick">
                                    Delete
                        </FluentButton>
                        <FluentButton Class="myAccentBtn" BackgroundColor="var(--pulse-accent-btn-bg)" Disabled ="string.IsNullOrEmpty(selectedCategory)"  style="height:50px;width:200px" Color="var(--pulse-accent-btn-colour)" OnClick="ViewCatPermissions">Permissions</FluentButton>
                    </FluentStack>
                       

                    @* </FluentStack> *@
                     @if (isLoadingCategories)
                    {
                        <FluentProgressRing></FluentProgressRing>
                        <p>Loading categories...</p>
                    }
                    else
                    {
                        <FluentGrid style="width:stretch" Justify="JustifyContent.Center">
                            @foreach (var cat in categories)
                            {
                                <FluentGridItem xs="12" sm="6" md="4" lg="2" >
                                <FluentButton Class=@(cat.Category == selectedCategory ? "myModeBtnOn" : "myModeBtnOff") BackgroundColor="var(--pulse-mode-btn-bg)" style="width:80%;height:50px;margin-left:10%" Color="var(--pulse-mode-btn-item-colour)" OnClick="@(() => { addMode = false ; selectedCategory= cat.Category; })">@cat.Category</FluentButton>
                                </FluentGridItem>
                            }
                        </FluentGrid>
                    }
                </FluentStack>
            </div>
            }else if(activeTab == "permissions")
            {
                <div Id="permissions">
                    <FluentStack Orientation="Orientation.Vertical" Style="gap: 16px; margin-top: 0px;">

                        @if (addEditPermission)
                        {
                            <div class="divShadow" style="min-width: 200px;max-width:800px;width:95%;padding:10px;border-radius:10px;margin-left:auto;margin-right:auto">
                                <FluentStack Orientation="Orientation.Vertical" Style="gap: 5px; align-items: flex-start;">
                                    <FluentLabel Typo="Typography.PaneHeader" Style="display: block; margin-bottom: 8px;width:100%">Category : @selectedCategory</FluentLabel>
                                    <FluentTextField @bind-Value="newPermissionName"
                                            Placeholder="Permission name (e.g., View Users)"
                                            Label="Permission Name"
                                            Required="true"
                                            Style="flex: 1; min-width: 200px;width:100%;" />
                                    <FluentTextField @bind-Value="newPermissionDesc"
                                                    Placeholder="Description"
                                                    Label="Description"
                                                    Style="flex: 1; min-width: 200px;width:100%;" />
                                    <FluentStack Orientation="Orientation.Horizontal" Style="padding: 12px;">
                                        <FluentButton Class="myCancelBtn"
                                            BackgroundColor="var(--pulse-cancel-btn-bg)"
                                            Color="var(--pulse-cancel-btn-colour)"
                                            IconStart="@(new Icons.Filled.Size24.DismissCircle().WithColor("--pulse-cancel-btn-colour"))"
                                            Style="height:40px"
                                            @onclick="() => { newPermissionName = newPermissionDesc = string.Empty; addEditPermission = false;}">
                                            Cancel
                                        </FluentButton>
                                        <FluentSpacer />
                                        <FluentButton Class="myOkBtn"
                                                          Appearance="Appearance.Accent"
                                                          BackgroundColor="var(--pulse-ok-btn-bg)"
                                                          Color="var(--pulse-ok-btn-colour)"
                                                          @onclick="SavePermission"
                                                          IconStart="@(new Icons.Filled.Size24.Save().WithColor("--pulse-ok-btn-colour"))"
                                                          Style="height:40px"
                                                          Disabled="@(string.IsNullOrWhiteSpace(newPermissionName) || isSavingPermission)">
                                            @(isSavingPermission ? "Saving..." : "Save Permission")
                                        </FluentButton>
                                    </FluentStack>
                                </FluentStack>
                            </div>
                        }
                        
                    }
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center" Style="gap: 12px; flex-wrap: wrap;">
                        <FluentButton Class="myAccentBtn" BackgroundColor="var(--pulse-accent-btn-bg)" style="height:50px;width:200px" Color="var(--pulse-accent-btn-colour)" OnClick="() => { selectedPermission = null ; addEditPermission = true;}">
                            <FluentIcon Value="@(new Icons.Filled.Size32.AddCircle().WithColor("var(--pulse-accent-btn-colour)"))" /> New
                        </FluentButton>
                        <FluentButton Class="myAccentBtn" Disabled="@(selectedPermission == null)" BackgroundColor="var(--pulse-accent-btn-bg)" style="height:50px;width:200px" Color="var(--pulse-accent-btn-colour)" OnClick="() => { newPermissionName = selectedPermission.Name ; newPermissionDesc = selectedPermission.Description ; ; addEditPermission = true;}">
                            <FluentIcon Value="@(new Icons.Filled.Size32.Edit().WithColor("var(--pulse-accent-btn-colour)"))" /> Edit
                        </FluentButton>
                        <FluentButton Class="myAccentBtn" Disabled="@(selectedPermission == null)" BackgroundColor="var(--pulse-accent-btn-bg)" style="height:50px;width:200px" Color="var(--pulse-accent-btn-colour)" OnClick="ViewPermissionRoles">
                            <FluentIcon Value="@(new Icons.Filled.Size32.People().WithColor("var(--pulse-accent-btn-colour)"))" /> Assignments
                        </FluentButton>
                    </FluentStack>

                    @if (isLoadingPermissions)
                    {
                        <FluentProgressRing></FluentProgressRing>
                        <p>Loading permissions...</p>
                    }
                    else if (permissions?.Any() == true)
                    {
                        <FluentGrid style="width:stretch" Justify="JustifyContent.Center">
                        @* <FluentGrid Class="permission-grid"> *@
                            @foreach (var perm in permissions)
                            {
                                <FluentGridItem xs="12" sm="6" md="4" lg="2" >
                                    <div class="permission-card @(selectedPermission?.Id != perm.Id ? "divShadow" : "selected-permission")" style=" margin-bottom:10px" @onclick="@(() => @selectedPermission = perm)">
                                        <FluentStack Orientation="Orientation.Vertical" Style="gap: 8px;">
                                            <FluentLabel Typo="Typography.Body" Style="font-weight: bold;">@perm.Name</FluentLabel>
                                            <FluentLabel Typo="Typography.Body" Style="font-size: 0.875rem; color: #666;">@perm.Description</FluentLabel>
                                            <FluentLabel Typo="Typography.Body" Style="font-size: 0.75rem; color: #999;">ID: @perm.Id</FluentLabel>
                                        </FluentStack>
                                    </div>
                                     
                                        @* <div Class="btnShadow" Style="height:fit-content;padding-bottom:15px; border: 2px solid black; border-radius:10px;width:100%;background-color: white" @onclick="@(() => @selectedPermission = perm)">
                                            <FluentLabel Typo="Typography.Body" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="rgba(255,255,255,1)"  Style="background-color:var(--pulse-dark-t75-colour); padding:5px;font-weight: bold;">@perm.Name</FluentLabel>
                                            <span style="padding:5px">@perm.Description</span>
                                        </div> *@
                                
                                </FluentGridItem>
                            }
                        </FluentGrid>
                        @* <div style="margin-top: 16px;">
                            <h4>All Permissions (@permissions.Count)</h4>
                            <div class="permission-grid">
                                @foreach (var categoryGroup in permissions.GroupBy(p => p.Category))
                                {
                                    <div>
                                        <h5 style="margin: 0 0 12px 0; color: var(--pulse-dark-colour);">@categoryGroup.Key</h5>
                                        @foreach (var perm in categoryGroup)
                                        {
                                            <div class="permission-card">
                                                <FluentStack Orientation="Orientation.Vertical" Style="gap: 8px;">
                                                    <FluentLabel Typo="Typography.Body" Style="font-weight: bold;">@perm.Name</FluentLabel>
                                                    <FluentLabel Typo="Typography.Body" Style="font-size: 0.875rem; color: #666;">@perm.Description</FluentLabel>
                                                    <FluentLabel Typo="Typography.Body" Style="font-size: 0.75rem; color: #999;">ID: @perm.Id</FluentLabel>
                                                </FluentStack>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div> *@
                    }
                    else
                    {
                        <FluentMessageBar Severity="MessageSeverity.Warning">
                            No permissions found. Create one to get started!
                        </FluentMessageBar>
                    }
                </FluentStack>
            </div>
            } else if(activeTab == "assign")
            {
            <div Id="assign">
                <FluentStack Orientation="Orientation.Vertical" Style="gap: 16px; margin-top: 0px;">
                    @if (isLoadingRoles)
                    {
                        <FluentProgressRing></FluentProgressRing>
                        <p>Loading roles...</p>
                    }
                    else
                    {

                        @if (selectedPermission != null)
                        {
                            <FluentStack Orientation="Orientation.Vertical" Style="gap: 12px;">
                                <h4>@selectedPermission.Name - Assigned Roles (@assignedRoleIds.Count)</h4>
                                
                                @if (isLoadingPermissions)
                                {
                                    <FluentProgressRing></FluentProgressRing>
                                }
                                else if (permissions?.Any() == true)
                                {
                                    @* <div class="permissions-container"> *@

                                        <FluentGrid style="width: stretch;">
                                            @foreach (var role in roles)
                                            {
                                                var isActive = assignedRoleIds.Contains(role.Id.ToString());
        
                                                <FluentGridItem  xs="12" sm="6" md="4" lg="2" >
                                                    <FluentButton Class="@(isActive ? "myModeBtnOn" : "myModeBtnOff")"
                                                                BackgroundColor="var(--pulse-mode-btn-bg)"
                                                                Color="var(--pulse-mode-btn-item-colour)"
                                                                Style="width:80%;height:50px"
                                                                @onclick="async () => { selectedRole = role; await TogglePermissionAsync(role.Id, !isActive); }">
    
                                                            @role.Name
                
                                                    </FluentButton>
                                                </FluentGridItem>
                                            }
                                        </FluentGrid>
                                        
                                    @* </div> *@
                                }
                            </FluentStack>
                        }
                    }
                </FluentStack>
            </div>
            }
        @* </FluentTabs> *@
    </FluentCard>
</div>

@code {
    private List<PermissionDto> permissions = new();
    private List<RoleWithIdDto> roles = new();
    private RolePermissionDto? rolePermissions;
    private List<RolePermission>? permissionRoles;
    private List<string> assignedRoleIds = new();
    private List<PermissionCategory>? categories;

    private string newPermissionName = string.Empty;
    private string newPermissionDesc = string.Empty;
    private string? newCategory;
    private string? selectedCategory;
    private PermissionDto? selectedPermission;
    private RoleWithIdDto? selectedRole;
    private string activeTab = "tbOverview";
    private string tabTitle = "Permissions Overview";

    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private bool addMode = false;
    private bool addEditPermission = false;

    private bool isLoadingPermissions = true;
    private bool isLoadingRoles = true;
    private bool isLoadingCategories = true;
    private bool isSavingPermission = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadPermissionCategories();
        await LoadPermissionsAsync();
        await LoadRolesAsync();
    }

    private async Task LoadPermissionCategories()
    {
        try{
            var response = await ApiService.GetAsync<ApiResponse<List<PermissionCategory>>>(ApiEndpoints.Security.Permissions.Categories.GetAll);
            categories = response?.Data ?? new();
            Logger.LogInformation("Loaded {Count} permission categories", categories?.Count ?? 0);
        }
        catch(Exception ex)
        {
            Logger.LogError(ex, "Failed to load permission categories");
            errorMessage = "Failed to load permission categories.";
        }
        finally
        {
            isLoadingCategories = false;
        }
    }

    private async Task NavigatePermissions()
    {
        switch(activeTab)
        {
            case "tbOverview":
                activeTab = "tbCategory";
                tabTitle = "Categories";
                break;
            case "tbCategory":
                activeTab = "tbOverview";
                tabTitle = "Permissions Overview";
                selectedCategory= null;
                break;
            case "permissions":
                activeTab = "tbCategory";
                tabTitle = "Categories";
                selectedPermission = null;
                break;
            case "assign":
                activeTab = "permissions";
                tabTitle = $"{selectedCategory} : Permissions";
                selectedRole = null;
                break;
            default:
                activeTab = "tbOverview";
                tabTitle = "Permissions Overview";
                break;
        }
    }
    private async Task ViewCatPermissions()
    {
        if(!string.IsNullOrEmpty(selectedCategory))
        {
            await FilterCategoryPermissions();
            StateHasChanged();
            activeTab = "permissions";
            tabTitle = $"{selectedCategory} : Permissions";
        }
    }

    private async Task ViewPermissionRoles()
    {
        if(selectedPermission != null)
        {
            await LoadAssignedPermissionRolessAsync();
            StateHasChanged();
            activeTab = "assign";
            tabTitle = $"{selectedPermission.Name} : AssignedRoles";
        }
    }
    private async Task DeleteCategoryClick()
    {
        PulseToastService.ShowToast("Information", $"This feature is not yet implemented.");
        await GlobalAI.AISpeak("I'm sorry, but this feature is still under development.", "PulseAI");
    }

    private async Task SaveNewCategory()
    {
        try
        {
            var response = await ApiService.PostAsync<PermissionCategory, ApiResponse<PermissionCategory>>(ApiEndpoints.Security.Permissions.Categories.Create, new PermissionCategory { Category = newCategory });
            if(response.Success == true)
            {
                PulseToastService.ShowToast("Success", $"{newCategory} has been added as a new category.");
                await GlobalAI.AISpeak($"{newCategory} has been added as a new category. You can start creating permissions for it if you like.", "PulseAI");
                categories.Add(response.Data);
                newCategory = string.Empty;
                StateHasChanged();
                return;
            }
            else
            {
                PulseToastService.ShowToast("Error", "There was a problem saving the New Category.<br />Please try again.");
                await GlobalAI.AISpeak("There was a problem saving the New Category.<br />Please try again.", "PulseAI");
                return;
            }
        }
        catch (Exception ex)
        {
            PulseToastService.ShowToast("Error", "There was a problem saving the New Category.<br />Please try again.");
            await GlobalAI.AISpeak("There was a problem saving the New Category.<br />Please try again.", "PulseAI");
            return;
        }
    }

    private async Task LoadPermissionsAsync()
    {
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<List<PermissionDto>>>(ApiEndpoints.Security.Permissions.GetAll);
            permissions = response?.Data ?? new();
            Logger.LogInformation("Loaded {Count} permissions", permissions.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load permissions");
            errorMessage = "Failed to load permissions.";
        }
        finally
        {
            isLoadingPermissions = false;
        }
    }

    private async Task FilterCategoryPermissions(){
        if(string.IsNullOrEmpty(selectedCategory))
        {
            await LoadPermissionsAsync();
        }
        else
        {
            try
            {
                isLoadingPermissions = true;
                var response = await ApiService.GetAsync<ApiResponse<List<PermissionDto>>>(ApiEndpoints.Security.Permissions.GetByCategory(selectedCategory));
                permissions = response?.Data ?? new();
                Logger.LogInformation("Loaded {Count} permissions for category {Category}", permissions.Count, selectedCategory);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to load permissions for category {Category}", selectedCategory);
                errorMessage = $"Failed to load permissions for category {selectedCategory}.";
            }
            finally
            {
                isLoadingPermissions = false;
            }
        }
    }
    private async Task LoadRolesAsync()
    {
        try
        {
            isLoadingRoles = true;
            var response = await ApiService.GetAsync<ApiResponse<List<RoleWithIdDto>>>(ApiEndpoints.Security.Roles.GetAll);
            roles = response?.Data ?? new();
            Logger.LogInformation("Loaded {Count} roles", roles.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load roles");
            errorMessage = "Failed to load roles.";
        }
        finally
        {
            isLoadingRoles = false;
        }
    }

    private async Task SavePermission()
    {
        isSavingPermission = true;
        if(selectedPermission != null)
        {
            await EditPermissionAsync();
        }
        else
        {
            await CreatePermissionAsync();
        }
        isSavingPermission = false;
    }

    private async Task EditPermissionAsync()
    {
        if (string.IsNullOrWhiteSpace(newPermissionName))
        {
            errorMessage = "A permission name is required.<br />Please enter one and try again";
            PulseToastService.ShowToast("Warning", errorMessage);
            await GlobalAI.AISpeak(errorMessage, "PulseAI");
            return;
        }
        PermissionDto updatedPermission = new PermissionDto
        {
            Id = selectedPermission.Id,
            Name = newPermissionName,
            Description = newPermissionDesc,
            Category = selectedCategory
        };
        try
        {
            var result = await ApiService.PostAsync<PermissionDto, ApiResponse<PermissionDto>>(
                ApiEndpoints.Security.Permissions.Update, updatedPermission);

            if (result?.Success == true)
            {
                successMessage = $"The '{updatedPermission.Name}' has been updated.";
                PulseToastService.ShowToast("Success", successMessage);
                await GlobalAI.AISpeak(successMessage, "PulseAI");

                newPermissionName = string.Empty;
                newPermissionDesc = string.Empty;

                addEditPermission = false;
                await FilterCategoryPermissions();
                StateHasChanged();
                Logger.LogInformation("Permission updated: {Name}", updatedPermission.Name);
            }
            else
            {
                errorMessage = "There was an error updating the permission.";
                PulseToastService.ShowToast("Error", errorMessage);
                await GlobalAI.AISpeak(errorMessage, "PulseAI");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating permission");
            errorMessage = "An error occurred while updating the permission.";
            PulseToastService.ShowToast("Error", errorMessage);
            await GlobalAI.AISpeak(errorMessage, "PulseAI");
        }
    }
    private async Task CreatePermissionAsync()
    {
        if (string.IsNullOrWhiteSpace(newPermissionName))
        {
            errorMessage = "A permission name is required.<br />Please enter one and try again";
            PulseToastService.ShowToast("Warning", errorMessage);
            await GlobalAI.AISpeak(errorMessage, "PulseAI");
            return;
        }

        try
        {
            var model = new CreatePermissionModel
            {
                Name = newPermissionName,
                Description = newPermissionDesc,
                Category = selectedCategory
            };

            var result = await ApiService.PostAsync<CreatePermissionModel, ApiResponse<PermissionDto>>(ApiEndpoints.Security.Permissions.Create, model);

            if (result?.Success == true)
            {
                successMessage = $"The '{model.Name}' permission has been created successfully.";
                PulseToastService.ShowToast("Success", successMessage);
                await GlobalAI.AISpeak(successMessage, "PulseAI");

                newPermissionName = string.Empty;
                newPermissionDesc = string.Empty;
                // newPermissionCategory = "General";

                addEditPermission = false;
                await FilterCategoryPermissions();
                StateHasChanged();
                Logger.LogInformation("Permission created: {Name}", model.Name);
            }
            else
            {
                errorMessage = "There was an error creating the permission.";
                PulseToastService.ShowToast("Error", errorMessage);
                await GlobalAI.AISpeak(errorMessage, "PulseAI");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating permission");
            errorMessage = "An error occurred while creating the permission.";
            PulseToastService.ShowToast("Error", errorMessage);
            await GlobalAI.AISpeak(errorMessage, "PulseAI");
        }
    }

    private async Task TogglePermissionAsync(string roleId, bool assign)
    {
        try
        {
            if (assign)
            {
                var model = new AssignPermissionModel
                {
                    RoleId = roleId,
                    PermissionId = selectedPermission.Id
                };

                var result = await ApiService.PostAsync<AssignPermissionModel, ApiResponse>( ApiEndpoints.Security.Permissions.AssignToRole, model);

                if (result?.Success == true)
                {
                    successMessage = $"This permission is now available to the '{selectedRole?.Name}' role.";
                    PulseToastService.ShowToast("Success", successMessage);
                    await GlobalAI.AISpeak(successMessage, "PulseAI");
                }
                else
                {
                    errorMessage = "There was an error assigning the permission.";
                    PulseToastService.ShowToast("Error", errorMessage);
                    await GlobalAI.AISpeak(errorMessage, "PulseAI");
                }
            }
            else
            {
                var result = await ApiService.DeleteAsync<ApiResponse>(ApiEndpoints.Security.Permissions.RemoveFromRole(selectedRole.Id, selectedPermission.Id));


                if (result?.Success == true)
                {
                    successMessage = $"This permission has been removed from the '{selectedRole?.Name}' role.";
                    PulseToastService.ShowToast("Success", successMessage);
                    await GlobalAI.AISpeak(successMessage, "PulseAI");
                    
                }
                else
                {
                    errorMessage = "There was an error removing the permission.";
                    PulseToastService.ShowToast("Error", errorMessage);
                    await GlobalAI.AISpeak(errorMessage, "PulseAI");
                }
            }

            await LoadAssignedPermissionRolessAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling permission");
            errorMessage = "An error occurred while updating permissions.";
            PulseToastService.ShowToast("Error", errorMessage);
            await GlobalAI.AISpeak(errorMessage, "PulseAI");
        }
    }

    private async Task LoadAssignedPermissionRolessAsync()
    {
        if (selectedPermission == null)
            return;

        try
        {
            isLoadingRoles = true;
            var response = await ApiService.GetAsync<ApiResponse<List<RolePermission>>>(
                ApiEndpoints.Security.Permissions.GetAssignedRoles(selectedPermission.Id));

            permissionRoles = response?.Data;
            assignedRoleIds = permissionRoles?.Select(rp => rp.RoleId.ToString()).ToList() ?? new List<string>();
            Logger.LogInformation("Loaded roles permissions for permission: {PermissionId}", selectedPermission.Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load permission roles");
            errorMessage = "Failed to load permission roles.";
        }
        finally
        {
            isLoadingRoles = false;
        }
    }

