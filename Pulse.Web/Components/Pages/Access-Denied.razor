@page "/access-denied"
@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Web.Components.Layout
@inject NavigationManager Navigation
@layout NoLayout

<div class="  divShadow" style="display: flex;overflow:hidden; justify-content:center;background-color:rgba(255,255,255,0.5);border:2px solid black;margin-top:10vh;margin-left:10vw;height:70vh;width:80vw;align-items:center;text-align:center">

    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" Style="margin:20px; justify-content:center" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center"> 
    <p><h5>You are not logged in</h5></p>
<FluentButton Appearance="Appearance.Accent" OnClick="GoToLogin">Login Here</FluentButton>
</FluentStack>
</div>
@code {
    private void GoToLogin()
    {
        Navigation.NavigateTo("/home", true);
    }
}
