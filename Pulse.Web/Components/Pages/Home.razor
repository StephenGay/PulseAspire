			<br />
			<br />
			<button class="btn btn-light btn-lg" @onclick="NavigateToCustomerZone">Login</button>
				<br />
				<br />
			<button class="btn btn-light btn-lg" @onclick="CancelLogin">Cancel</button>
			</div>
		</Animation>
	

	@* @if (!string.IsNullOrEmpty(client_Id))
	{
