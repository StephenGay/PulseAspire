	@* <CustomerLogin OnCancel="() => showCustLogin = false" /> *@
}
else if (showEmpLogin)
{
		<Animation Effect="@Effect.FadeIn" Speed="@TimeSpan.FromSeconds(1.5)" Delay="@Delay.None">
			<div class="col-12">
				<div class="card shadow-2-strong" style="border-radius: 1rem;">
				  <div class="card-body p-5 text-center">

					<h3 class="mb-5">Sign in</h3>

					<div data-mdb-input-init class="form-outline mb-4">
							<input type="text" id="txtEmp" @bind="empEM" @bind:event="oninput" class="form-control form-control-lg" placeholder="Enter Your E-Mail Address" />
					</div>
								
				<div data-mdb-input-init class="form-outline mb-4">
							<input type="password" id="txtPwd" @bind="empPwd" @bind:event="oninput" class="form-control form-control-lg" placeholder="Enter Your Password" />
				</div>

				
				<br />
						<button class="btn btn-danger btn-lg btn-block" @onclick="CancelLogin">Cancel</button>
				<button class="btn btn-primary btn-lg btn-block" @onclick="NavigateToEmployeeZone">Login</button>

				
					</div>
				</div>
				
				
			</div>
		</Animation>
}
</div>


@code 
{

	private bool showCustLogin = false;
	private bool showEmpLogin = false;
	private string clientId = string.Empty;
	private string? client_Id;
	private string validationMessage = string.Empty;
	private string empEM = string.Empty;
	private string empPwd = string.Empty;
	private AnimationEffect logoSelectedEffect = new AnimationEffect("FadeIn");
	private AnimationEffect logoBtnSelectedEffect = new AnimationEffect("FadeInUp");

	private void ShowClientLogin()
	{
		// logoSelectedEffect = new AnimationEffect("LightSpeedOutLeft");
		// // logoBtnSelectedEffect = new AnimationEffect("LightSpeedOutLeft");
		//  StateHasChanged();
		// await Task.Delay(2000); // Wait for the animation to complete
		showCustLogin = true;
	}

	private void ShowEmployeeLogin()
	{
		showEmpLogin = true;
	}

	private void CancelLogin()
	{
		showCustLogin = false;
		showEmpLogin = false;
	}

	private async void NavigateToEmployeeZone()
	{
		if (string.IsNullOrWhiteSpace(empEM) || string.IsNullOrWhiteSpace(empPwd))
		{
			validationMessage = "Please enter both E-Mail and Password.";
			return;
		}
		string hashedPwd = HashPassword(empPwd);
		User? user = await _pulseApiClient.GetAsync<User>($"/Security/EmployeeLogin/email={empEM}pwd={hashedPwd}");
		if (user == null)
		{
			validationMessage = "Invalid E-Mail or Password. Please try again.";
			return;
		}
		validationMessage = string.Empty;
		await _DataTransferService.SetgvUser(user);

		Navigation.NavigateTo("/EmployeeZone/");
    }
	
	public static string HashPassword(string password)
	{
		using (SHA256 sha256 = SHA256.Create())
		{
			byte[] bytes = sha256.ComputeHash(Encoding.UTF8.GetBytes(password));
			StringBuilder builder = new StringBuilder();
			foreach (byte b in bytes)
			{
				builder.Append(b.ToString("x2"));
			}
			return builder.ToString();
		}
	}

	private async void NavigateToCustomerZone() 
    {
		Customer? client = await _pulseApiClient.GetAsync<Customer>($"/Customers/Details/{clientId}");
		if (client == null)
		{
			validationMessage = "Client ID not found. Please enter a valid Client ID.";
			return;
		}
		validationMessage = string.Empty;
		await _DataTransferService.SetgvClient(client);
        // if (string.IsNullOrWhiteSpace(clientId) || clientId.Length != 8)
		// {
		// 	validationMessage = "Please enter a valid 8-character Client ID.";
		// 	client_Id = null; // Prevent navigation/rendering
		// }
		// else
		// {
		// 	validationMessage = string.Empty;
		// 	client_Id = clientId;
		// 	// AppState.SetMessage(clientId);
		// 	Navigation.NavigateTo("/CustomerZone/");
		// }
		// client_Id = clientId;
		Navigation.NavigateTo("/CustomerZone/");
	}
}
