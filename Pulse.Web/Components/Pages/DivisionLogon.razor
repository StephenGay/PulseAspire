@page "/DivisionLogon"
@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Models.Api
@using Pulse.Models.Misc
@using Pulse.Models.Organizational
@using Pulse.Web.Components.Layout
@using Pulse.Web.Components.PulseComponents.Controls
@using static Pulse.Web.Models.MiscEnumLists
@using Pulse.Web.Services
@inject Pulse.Web.Services.PulseApiService pApiClient
@inject DataTransferService dTrf
@inject NavigationManager Navigation
@inject IPulseToastService ToastService
@layout NoLayout
@rendermode InteractiveServer

<style>
    .divLayoutParent {
        display: flex;
        width: 100vw;
        flex-direction: column; /* Stack children vertically */
        height: 100vh; /* Or whatever height your parent should be, like 100% */
        overflow: hidden;
    }
    .divLayoutContent {
        width: 100vw;
        flex: 1; /* This magic makes it grow to fill the space */
        overflow: hidden;
    }
    .clientSpeeddialCard {
        background-color: var(--pulse-light-colour) !important;
        color: var(--pulse-dark-colour) !important;
        border: 1px solid black;
        align-items: center;
        align-content: center;
        text-align:center;
        border-radius: 10px;
        box-shadow: 5px 5px 15px var(--pulse-light-colour);
    }

        .clientSpeeddialCard:hover {
            cursor: pointer;
            background-color: var(--pulse-dark-colour) !important;
            color: var(--pulse-light-colour) !important;
            border: 1px solid black;
            border-radius: 10px;
            scale: 1.2;
            box-shadow: 0px 0px 0px rgba(0, 0, 0, 0);
        }

    .stagger-item {
        opacity: 0;
        transform: translateY(50px);
        transition: all 0.5s ease;
    }

        .stagger-item.visible {
            opacity: 1;
            transform: translateY(0);
        }
</style>
<RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="50px" JustifyContent="Radzen.JustifyContent.Center" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Style="height: 100%;width: 100%;padding:5%">
    @if (_allDivisions.Count == 0)
    {
        <FluentProgressRing Width="128px" />
    }
    else
    {


        @for (var i = 0; i < _allDivisions.Count; i++)
        {
            var item = _allDivisions[i];
            <AnimatedObserver Animation="AnimationType.FadeUp" StaggerDelay="@(i * 120)">
                <div class="clientSpeeddialCard" style="height:250px;width:210px" @onclick="async () => await OnDivisionClick(item)">
                    @if (!string.IsNullOrEmpty(item.DivisionID))
                    {
                        <img src="Images/Divisions/@(item.DivisionID).jpg"
                        onerror="this.src='Images/Divisions/default.jpg'"
                        alt="@item.DivisionName" />
                    }
                    else
                    {
                        <img src="Images/Divisions/default.jpg"
                        alt="Division Image" />
                    }
                    <div class="lv-demo-desc" style="text-align:center;margin:5px;">@item.DivisionName</div>

                </div>
                @* <FluentButton Appearance="Appearance.Outline" Style="min-width:120px; max-width:200px; height:50px;"
                                OnClick="async () => await btnSelectClickSpeedDial(item.ItemCode)">
                    @item.ItemName
                </FluentButton> *@
            </AnimatedObserver>
        }
    }
</RadzenStack>
