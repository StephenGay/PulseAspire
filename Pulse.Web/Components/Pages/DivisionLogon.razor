@code {
    [Parameter][SupplyParameterFromQuery(Name = "nextpage")] public string? NextPage { get; set; } = "/EmployeeZone";
    List<Division> _allDivisions = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await pApiClient.GetAsync<ApiResponse<List<Division>>>(ApiEndpoints.Divisions.GetActive);
            _allDivisions = response?.Data ?? new();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load divisions: {ex.Message}", "Error");
            _allDivisions = new();
        }
    }
    
    private async Task OnDivisionClick(Division div)
    {
        await dTrf.SetgvSelectedDivision(div);
        string m = DateTime.Now.ToString("MMMM");
        string y = DateTime.Now.Year.ToString();
        Period cur = await pApiClient.GetAsync<Period>($"/Companies/{div.CompanyID}/CurrentPeriod/{m}/{y}");
        Company company = await pApiClient.GetAsync<Company>(ApiEndpoints.Companies.GetById(div.CompanyID));
        await dTrf.SetgvCompany(company);
        await dTrf.SetgvCurrentPeriod(cur);
        Navigation.NavigateTo("/EmployeeZone");
    }
}
