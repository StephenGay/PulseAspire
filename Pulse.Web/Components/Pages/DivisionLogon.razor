@page "/DivisionLogon"
@using Pulse.Models.Organizational
@using Pulse.Web.Components.Layout
@using Pulse.Web.Services
@inject Pulse.Web.Services.PulseApiService pApiClient
@inject DataTransferService dTrf
@inject NavigationManager Navigation

@layout NoLayout
@rendermode InteractiveServer

<div class="div-center-screen" style="align-items:center">
<ListView TItem="Division" Items="@_allDivisions" style="align-items:center; max-width:60%"  OnListViewItemClick="OnDivisionClick" Height="100%">
    <HeaderTemplate>
        <div style="color:white">SELECT A DIVISION</div>
    </HeaderTemplate>
    <BodyTemplate>
        <Card>
            <BodyTemplate>
                <img src="Images/Divisions/@(context.DivisionID).jpg" />
                <div class="lv-demo-desc" style="text-align:center;margin:5px;">@context.DivisionName</div>
            </BodyTemplate>
        </Card>
    </BodyTemplate>
    <FooterTemplate>
        <div class="text-end">
            
        </div>
    </FooterTemplate>
</ListView>
</div>


@code {
    [Parameter] [SupplyParameterFromQuery(Name = "nextpage")] public string? NextPage { get; set; }
    List<Division>? _allDivisions;

    protected override async Task OnInitializedAsync()
    {
        _allDivisions = await pApiClient.GetAsync<List<Division>>("/Divisions/GetAll");
    }

    private async Task OnDivisionClick(Division div)
    {
        await dTrf.SetgvSelectedDivision(div);
        Navigation.NavigateTo(NextPage);
    }
}
