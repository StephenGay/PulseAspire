@page "/AiZone/AIQueryPg"


@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.DesignTokens
@using Microsoft.FluentUI.AspNetCore.Components.Icons
@using Pulse.Models.CustomComponents
@using Pulse.Models.Misc
@using Pulse.Models.Users
@using Pulse.Web.Services
@using System.Data
@using Pulse.Web.Tools
@using System.Threading.Tasks
@using Markdig
@using Toolbelt.Blazor.SpeechSynthesis

@inject Pulse_AI pAI
@inject PulseApiService pulseApiClient 
@inject IMessageService MessageService
@inject IDialogService DialogService
@inject DataTransferService dtrf
@inject IMenuService ms
@inject IJSRuntime JSRuntime
@inject AccentBaseColor AccentBaseColor
@inject SpeechSynthesis SpeechSynthesis

@rendermode InteractiveServer


<style>
    :root {
        --datagrid-hover-color: lightyellow;
    }

    .fluent-data-grid {
        --fluent-data-grid-resize-handle-color: var(--neutral-stroke-rest) !important;
        
    }
</style>

<FluentLayout Style="display: flex; flex-direction: column; height: 100vh; width: 100%; overflow: hidden;">
    
    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" class="px-4 ai-toprow">
        <FluentLabel Typo="Typography.Body" Style="color:white">AI Model : </FluentLabel>
        
        @if(ollamaModels == null)
        {
            <FluentButton Appearance="Appearance.Accent" Loading="true" />
        }else{
            @* <Select TItem="string" bind-value="aiModel"  Items="ollamaModels" ValueChanged="OnSelectionChanged" Placeholder="Select AI Model" /> *@
            <select @bind="aiModel" class="form-select" style="width: auto;">
                @foreach (var model in ollamaModels)
                {
                    <option value="@model">@model</option>
                }
            </select>
        }

        <FluentSpacer />

        @if (DataMode)
        {
            <Animation Effect="@Effect.FadeIn" Speed="@TimeSpan.FromSeconds(0.5)" Delay="@TimeSpan.FromSeconds(0.5)">
                <FluentButton BackgroundColor="green" Color="white" Disabled="@(!showResults)" OnClick="SaveQry">
                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size16.Save())" Slot="start" Style="fill:white" />
                    Save Query
                </FluentButton>
                <FluentButton Appearance="Appearance.Accent" Disabled="true" OnClick="SaveQry">
                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size16.SaveMultiple())" Slot="start" Style="fill:white" />
                    Save And Add To Favourites
                </FluentButton>
            </Animation>
        }

        @if (ChatMode)
        {
            <Animation Effect="@Effect.FadeIn" Speed="@TimeSpan.FromSeconds(0.5)" Delay="@TimeSpan.FromSeconds(0.5)">
                <FluentButton Appearance="Appearance.Accent" OnClick="@ClearChatHistory">Clear History</FluentButton>
                <FluentButton BackgroundColor=@(togWebSearch ? "green" : "#EFC3CA") Color=@(togWebSearch ? "white" : "black") Style="border: 1px solid black;" OnClick="ToggleWebSearch">
                    Search The Web
                </FluentButton>
            </Animation>
        }

        @if (SavedQueryMode)
        {
            <Animation Effect="@Effect.FadeIn" Speed="@TimeSpan.FromSeconds(0.5)" Delay="@TimeSpan.FromSeconds(0.5)">
                <FluentButton BackgroundColor=@(myFave ? "green" : "#EFC3CA") Disabled="@showResults" Color=@(myFave ? "white" : "black") Style="border: 1px solid black;" OnClick="ToggleFavourites">
                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size16.Star())" Slot="start" Style="fill:yellow" />
                    Only Favourites
                </FluentButton>

                <FluentButton BackgroundColor="white" Disabled="@(selectedSavedQuery != null ? false : true)" Style="border: 1px solid black;" OnClick="btnFaveClick">
                    @if (isFavourite)
                    {
                        <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size16.StarOff())" Slot="start" Style="fill:red;" />
                    }
                    else
                    {

                        <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size16.StarAdd())" Slot="start" Style="fill:green;" />
                    }
                    @(isFavourite ? "Remove From" : "Add To") Favourites
                </FluentButton>

            @if (showResults)
            {
                <FluentButton Appearance="Appearance.Accent" Style="color:white;" OnClick="ToggleSavedQueries">
                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Backspace())" Slot="start" Style="fill:white;" />
                    Back To Queries
                </FluentButton>
            }
            else
            {
                <FluentButton BackgroundColor="green" Disabled="@(selectedSavedQuery != null ? false : true)" Style="color:white;" OnClick="ExecuteSavedQuery">
                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Play())" Slot="start" Style="fill:white;" />
                    Run Query
                </FluentButton>
            }
            </Animation>
            
        }

        <FluentSpacer />
        <Animation Effect="@Effect.FadeIn" Speed="@TimeSpan.FromSeconds(0.5)" Delay="@TimeSpan.FromSeconds(0.5)">
            <FluentButton BackgroundColor=@(DataMode ? "#1D722A" : "#EFC3CA") Color=@(DataMode ? "white" : "black") Style="border: 1px solid black;" OnClick="ToggleDataMode">Query Data</FluentButton>
            <FluentButton BackgroundColor=@(SavedQueryMode ? "green" : "#EFC3CA") Color=@(SavedQueryMode ? "white" : "black") Style="border: 1px solid black;" OnClick="ToggleSavedQryMode">Saved Queries</FluentButton>
            <FluentButton BackgroundColor=@(ChatMode ? "green" : "#EFC3CA") Color=@(ChatMode ? "white" : "black") Style="border: 1px solid black;" OnClick="ToggleChat">Chat</FluentButton>
        </Animation>

    </FluentStack>

    <FluentMessageBarProvider Section="MESSAGES_TOP" />
    
    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" Style="flex: 1; padding: 10px; overflow: auto;">

        @if (!string.IsNullOrEmpty(strReasoning))
        {
            <FluentMessageBar Intent="MessageIntent.Info">@strReasoning</FluentMessageBar>
        }

        

        @if (ChatMode) 
        { 
            <!-- Chat History Display -->
            <div @ref="chatContainer" style="max-height: 100%; width: 100%; overflow-y: auto; padding: 10px; border: 1px solid #ccc;">
                @foreach (var message in chatHistory)
                {
                    @* <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="margin-bottom: 10px;">
                        <FluentLabel Typo="Typography.Body"><strong>@(message.Role.ToUpper()): </strong></FluentLabel>
                        <FluentLabel Typo="Typography.Body">@message.Content</FluentLabel>
                    </FluentStack> *@
            
                    @if (message.Role.ToUpper() == "USER")
                    {
                        <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Left" Style="margin-bottom: 10px;">
                            <FluentLabel Typo="Typography.Body" Style="max-width:80%; background-color:lightblue; padding:10px; border-radius:15px;">@message.Content</FluentLabel>
                        </FluentStack>
                    }
                    else
                    {
                        <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Right" Style="margin-bottom: 10px;">
                             @* <div style="color: black;">
                                @((MarkupString)FormatMessageToHtml(message.Content))
                            </div> *@
                            @* <FluentCard Style="max-width:50%; background-color:khaki; padding:10px;">
                                <p>@((MarkupString)FormatMessageToHtml(message.Content))</p></FluentCard> *@
                            @* <FluentLabel Typo="Typography.Body" Style="max-width:50%; background-color:khaki; padding:10px;">@((MarkupString)FormatMessageToHtml(message.Content))</FluentLabel> *@

                            <FluentLabel Typo="Typography.Body" Style="max-width:80%; background-color:lemonchiffon; padding:10px; border-radius:15px;">
                               @*  @((MarkupString)FormatMessageToHtml(message.Content)) *@
                                <div style="color: black;">@((MarkupString)ParseToHtml(message.Content)) </div>
                            </FluentLabel>
                        </FluentStack>
                    }
            
                }
            </div>
        }

        @if (SavedQueryMode)
        {
            
            <FluentLabel Typo="Typography.H4" Style="width:100% ; color: white;" Alignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center">@(selectedSavedQuery == null ? "Select a Query to Run..." : selectedSavedQuery.Question)</FluentLabel>

            @if (showSavedQueries)
            {
                @if (savedQueries.Any())
                {
                    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" Width="100%">
                        <FluentGrid Spacing="4">
                            <FluentGridItem  xs="12">
                            <FluentDataGrid Items="@savedQueries.AsQueryable()" TGridItem="AiQuery"
                                            RowClass="@(context => context == selectedSavedQuery ? "fdgrselected" : "fdgrunselected")"
                                            SelectionMode="SelectionMode.Single"
                                            SelectedItem="@selectedSavedQuery"
                                            OnRowClick="OnSaveQueryRowClick"
                                            ResizableColumns="true"
                                            Pagination="@pagination"
                                                ShowHover="true"
                                            AutoFit="true"
                                            Style="width: 100%;" 
                                            GenerateHeader="GenerateHeaderOption.Sticky">
                                <PropertyColumn Property="@(context => context.AiQueryID)" Title="ID" Align="Align.Center" Sortable="true" />

                                    <TemplateColumn Context="gridContext" Align="Align.Center">
                                        <HeaderCellTitleTemplate >
                                            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center">
                                                <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size24.Star())" Style="fill:blue" />
                                        </FluentStack>
                                    </HeaderCellTitleTemplate>
                                
                                    <ChildContent >
                                            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center">
                                            @if (user.UserFavouriteQueries.Any(q => q.QueryId == gridContext.AiQueryID))
                                            {
                                                <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size24.Star())" Style="fill:yellow" />
                                            }
                                        </FluentStack>
                                    </ChildContent>

                                </TemplateColumn>
                                <PropertyColumn Property="@(context => context.Question)" Title="Query" Sortable="true" />
                                <PropertyColumn Property="@(context => context.UpVote)" Align="Align.Center" Sortable="true">
                                        <HeaderCellTitleTemplate >
                                            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center">
                                            <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size24.ThumbLike())" Style="fill:green" />
                                        </FluentStack>
                                    </HeaderCellTitleTemplate>
                                    </PropertyColumn>
                                    <PropertyColumn Property="@(context => context.DownVote)" Align="Align.Center" Sortable="true">
                                        <HeaderCellTitleTemplate>
                                            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center">
                                            <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size24.ThumbDislike())" Style="fill:red" />
                                        </FluentStack>
                                    </HeaderCellTitleTemplate>
                                    </PropertyColumn>
                         
                                @* <TemplateColumn Title="SQL Query (Truncated)" Context="gridContext">
                                    user.UserFavouriteQueries.FirstOrDefault(q => q.QueryId == selectedSavedQuery.AiQueryID)
                                    @GetTruncatedSql(gridContext.SqlQuery)
                                </TemplateColumn> *@
                                </FluentDataGrid>
                                <FluentPaginator State="@pagination" Style="background-color: #365b66 ; padding:10px ; color: white; width:100%" />
                            </FluentGridItem> 
                        
                        </FluentGrid>
                    </FluentStack>
                    @* </div> *@
                }
                else if (isLoadingSaved)
                {
                    <FluentProgress Indeterminate="true" />
                }
                else
                {
                    <FluentMessageBar Intent="MessageIntent.Info">No saved queries found.</FluentMessageBar>
                }
                
            }
            
        }

        @if(showResults && !isLoading)
        {
            if (rows.Any())
            {
                
                <div style="overflow-x: auto; width: 100%; align-content:center; background-color: white;">
                    
                    <FluentDataGrid Items="@rows.AsQueryable()" 
                                    ResizableColumns="true" 
                                    GenerateHeader="GenerateHeaderOption.Sticky" 
                                    AutoFit="true" 
                                    Pagination="@pagination">

                        @foreach (var column in columns)
                        {
                            var localColumn = column;
                            <PropertyColumn Property="@(r => r[localColumn])" Title="@localColumn" Style="background-color: #bcd1d4; color: rgb(54,91,102);" Sortable="true" />
                        }
                    </FluentDataGrid>
                    
                </div>
                
                <FluentPaginator State="@pagination" Style="color: white; width:100%;" />
                
            }
            else
            {
                <FluentMessageBar Intent="@MessageIntent.Warning">No Results Found</FluentMessageBar>
            }
        }
        
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <FluentMessageBar Intent="@MessageIntent.Error">@errorMessage</FluentMessageBar>
        }

    </FluentStack>

    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" Style="flex: 0 0 auto; padding: 10px;" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center">
    @if (!SavedQueryMode && !isLoading)
        {
            
            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Right" Width="25%" Style="height:100%">
                
                <FluentButton BackgroundColor="red" Style="height:100%; margin-top: 10px; margin-bottom: 10px;" OnClick="@MarkIncorrect">
                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size28.Replay())" Slot="start" Style="fill:white;" />
                </FluentButton>
                
            </FluentStack>
            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" Width="50%">
                
                @* <FluentLabel Typo="Typography.Body"  Style="color:white; white-space:nowrap;">Enter your question</FluentLabel> *@
                <FluentTextArea @ref=txtQ @bind-Value="@query" Placeholder="Enter your question" Rows="3" Appearance="FluentInputAppearance.Outline" Style="width: 100%; height:100%; margin: 10px;" />
                
            </FluentStack>

            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" Width="25%" Style="height:100%">
                
                <FluentButton Appearance="Appearance.Accent" Style="height:100%; margin: 10px;" OnClick="@SubmitQuery">
                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size28.Send())" Slot="start" Style="fill:white;" />

                </FluentButton>
            
            </FluentStack>
            
            
        }
        else if (isLoading)            
        {
            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Left" VerticalAlignment="VerticalAlignment.Center" Width="50%" Style="height:100%; margin-right:20px;">
                <FluentLabel Typo="Typography.Body" Style="color:white;">Thinking...</FluentLabel>
                <FluentProgress Indeterminate="true" Width="100%" Style="margin:10px" />
                <FluentLabel Typo="Typography.Body" Style="color:white;">Question : @query</FluentLabel>
            </FluentStack>
            <FluentButton BackgroundColor="red" Style="margin-top: 10px; margin-bottom: 10px;" OnClick="@CancelQuery">
                <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size28.RecordStop())" Slot="start" Style="fill:white;" />
                
            </FluentButton>
        }
        else if (SavedQueryMode && showResults)
        {
            
            <FluentStack Style="margin-bottom: 10px;" Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center">
                    <FluentLabel Typo="Typography.Body" Style="color:white;">Are your results for this query correct?</FluentLabel>
                
                <FluentStack Style="margin-bottom: 10px;" Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center">
                
                        <FluentButton BackgroundColor="var(--success)" Color="white" OnClick="QryUpVote">
                            <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size24.ThumbLike())" Slot="start" Style="fill:white;" />
                                Yes
                        </FluentButton>
                
                        <FluentButton BackgroundColor="var(--error)" Color="white" OnClick="QryDownVote">
                            <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size24.ThumbDislike())" Slot="start" Style="fill:white;" />
                                No
                        </FluentButton>
                    </FluentStack>
                </FluentStack>
            
        }
    </FluentStack>
    
</FluentLayout>
<FluentMenuProvider />

@code {
    private string query = string.Empty;
    private List<string> columns = new();
    private List<Dictionary<string,object>> rows = new();
    private bool isLoading = false;
    private bool isCorrect = true;
    private bool togChat = false;
    private bool myFave = false;
    private bool isFavourite = false;
    private bool togWebSearch = false;
    private bool showResults = false;
    private bool SavedQueryMode = false;
    private bool ChatMode = false;
    private bool DataMode = true;
    private string errorMessage = string.Empty;
    private string aiSQL = string.Empty;
    private string aiSQLv = string.Empty;
    private string strReasoning = string.Empty;
    private string strResponse = string.Empty;
    private string aiModel = "gpt-oss:latest";
    private ElementReference chatContainer;
    private bool useSpeechOutput = false;
    private SpeechSynthesisVoice? _voice;
    private User? user;
    PaginationState pagination = new PaginationState { ItemsPerPage = 19 };

    // Dynamic models for select
    private List<string>? ollamaModels = new();
    // Multi-turn chat history
    private List<OllamaMessage> chatHistory = new();

    // Saved Queries state
    private bool showSavedQueries = false;
    private List<AiQuery>? savedQueries = new();
    private AiQuery? selectedSavedQuery;
    private bool isLoadingSaved = false;
    private string? uName;

    FluentTextArea? txtQ;

    private void OnSelectionChanged(string selectedModel)
    {
        aiModel = selectedModel;
    }

    private async Task ChangeMode(string sMode)
    {
        errorMessage = string.Empty;
        strResponse = string.Empty;
        strReasoning = string.Empty;
        aiSQL = string.Empty;
        query = string.Empty;
        isLoading = false;
        showResults = false;
        showSavedQueries = false;

        columns.Clear();
        rows.Clear();
        chatHistory.Clear();
        selectedSavedQuery = null;

        switch (sMode)
        {
            case "Data":
                ChatMode = false;
                SavedQueryMode = false;
                DataMode = true;
                break;

            case "Chat":
                ChatMode = true;
                SavedQueryMode = false;
                DataMode = false;
                chatHistory.Add(new OllamaMessage { Role = "assistant", Content = "**Hi there!** I am Pulse AI and am here to assist you anyway I can.<br>I can summarise or provide insights on data inside Pulse, search the web and compare.<br>My capabilities are growing all the time, so go ahead - ask me anything!" });
                await SayIt($"What would you like to know {uName}?");
                break;

            case "SavedQry":
                ChatMode = false;
                SavedQueryMode = true;
                showSavedQueries = true;
                DataMode = false;
                await LoadSavedQueries();
                break;

            default:
                break;
        }    
    }

    private async Task btnFaveClick()
    {
        if (!isFavourite)
        {
            UserFavouriteQry favouriteQry = new UserFavouriteQry();
            favouriteQry.UserId = user.UserID;
            favouriteQry.QueryId = selectedSavedQuery.AiQueryID;
            var response = await pulseApiClient.SaveFavouriteQueryAsync(favouriteQry);
            if(response != null)
            {
                user.UserFavouriteQueries.Add(response);
                isFavourite = !isFavourite;
            }
        }
        else
        {
            UserFavouriteQry delfav = user.UserFavouriteQueries.FirstOrDefault(q => q.QueryId == selectedSavedQuery.AiQueryID);
            if(delfav == null){ return; }
            var dresponse = await pulseApiClient.DeleteFavouriteQueryAsync(delfav.Id);
            if (dresponse != null)
            {
                user.UserFavouriteQueries.Remove(delfav);
                isFavourite = !isFavourite;
            }
        }
    }

    private async Task SetQuestionFocus()
    {
        try
        {
            txtQ!.FocusAsync();
        }
        catch(Exception ex)
        {
            return;
        }

    }

    private string GetTruncatedSql(string sql)
    {
        return sql.Substring(0, Math.Min(100, sql.Length)) + (sql.Length > 100 ? "..." : "");
    }

    private void ToggleWebSearch()
    {
        togWebSearch = !togWebSearch;
    }

    private async void ToggleFavourites()
    {
        selectedSavedQuery = null;
        myFave = !myFave;
        await LoadSavedQueries();
    }

    public async Task QryUpVote()
    {
        string message = string.Empty;
        MessageIntent type;

        bool res = await pulseApiClient.RecordQueryVoteAsync(selectedSavedQuery.AiQueryID, "up");
        if (res)
        {
            message = "Thank you for your feedback! The Query has been Up Voted.";
            await SayIt(message);
            type = MessageIntent.Success;
        }
        else
        {
            message = "There was an issue saving your feedback. Please try again later.";
            await SayIt(message);
            type = MessageIntent.Error;
        }

        MessageService.ShowMessageBar(options =>
        {
            options.Title = message;
            options.Intent = type;
            options.Section = "MESSAGES_TOP"; // Use your actual section name or constant here
            options.Timeout = 4000;
        });
    }

    public async Task QryDownVote()
    {
        string message = string.Empty;
        MessageIntent type;

        bool res = await pulseApiClient.RecordQueryVoteAsync(selectedSavedQuery.AiQueryID, "down");
        if (res)
        {
            message = "Thank you for your feedback! The Query has been Down Voted.";
            await SayIt(message);
            type = MessageIntent.Success;
        }
        else
        {
            message = "There was an issue saving your feedback. Please try again later.";
            await SayIt(message);
            type = MessageIntent.Error;
        }

        MessageService.ShowMessageBar(options =>
        {
            options.Title = message;
            options.Intent = type;
            options.Section = "MESSAGES_TOP"; // Use your actual section name or constant here
            options.Timeout = 4000;
        });
    }

    private async Task ToggleSavedQryMode()
    {
        if (SavedQueryMode) { return; }
        await ChangeMode("SavedQry");
        // selectedSavedQuery = null;
        // showSavedQueries = !showSavedQueries;
        // if (showSavedQueries)
        // {
        //     await LoadSavedQueries();  // Load via API
        // }
    }

    private async Task ToggleChat()
    {
        if(ChatMode){ return; }
        await ChangeMode("Chat");
    }

    private async Task ToggleDataMode()
    {
        if (DataMode) { return; }
        await ChangeMode("Data");
    }

    private async Task CancelQuery()
    {
        await pAI.CancelQueryAsync();
        isLoading = false;
    }

    private async Task LoadSavedQueries()
    {
        isLoadingSaved = true;
        errorMessage = string.Empty;
        strResponse = string.Empty;
        strReasoning = string.Empty;
        aiSQL = string.Empty;
        query = string.Empty;
        columns.Clear();
        rows.Clear();

        try
        {
            // Call Web API to get saved queries (e.g., GET /AI/savedqueries?active=true)
            var allQ = await pulseApiClient.GetAsync<List<AiQuery>>("/AI/savedqueries");
            savedQueries = await pulseApiClient.GetAsync<List<AiQuery>>("/AI/savedqueries");
            if (allQ == null || !allQ.Any())
            {
                savedQueries = new();
            }
            else
            {
                if (!myFave)
                {
                    savedQueries = allQ;
                }
                else
                {
                    var favoriteQueryIds = user.UserFavouriteQueries.Select(f => f.QueryId).ToList(); // Or .ToHashSet() for faster lookups if the list is large.
                    savedQueries = allQ.Where(q => favoriteQueryIds.Contains(q.AiQueryID)).ToList();

                }
            }
            // Debug: Log or check IDs

            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading saved queries: {ex.Message}";
            savedQueries = new();
        }
        finally
        {
            isLoadingSaved = false;
        }
    }

    private async Task ClearChatHistory()
    {
        chatHistory.Clear();
        strResponse = string.Empty;
        rows.Clear();
        columns.Clear();
        StateHasChanged();
    }
    private async Task SayIt(string text)
    {
        if (useSpeechOutput)
        {
            var utterancet = new SpeechSynthesisUtterance
            {
                Text = text.Replace("<br />", ""),
                Voice = _voice
            };
            await this.SpeechSynthesis.SpeakAsync(utterancet);
        }
        // Microsoft Ava Online(Natural) - English(United States)(en - US)
    }
