    private async Task SubmitQuery()
    {
        if (string.IsNullOrWhiteSpace(query) && isCorrect) return;

        isLoading = true;
        errorMessage = string.Empty;
        strResponse = string.Empty;
        strReasoning = string.Empty;
        aiSQL = string.Empty;
        columns.Clear();
        rows.Clear();

        try
        {
            // Call Ollama to process the natural language query
            using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(10));
            if(ChatMode)
            {
                // Add user message to history
                if (!isCorrect)
                {
                    query = chatHistory.LastOrDefault(m => m.Role == "user")?.Content;
                    isCorrect = true;
                }
                chatHistory.Add(new OllamaMessage { Role = "user", Content = query });

                // StateHasChanged();
                // await JSRuntime.InvokeVoidAsync("scrollToBottom", chatContainer);
                aiSQL = await pAI.ChatWithOllamaAsync(chatHistory, aiModel, togWebSearch, cts.Token);

                if (aiSQL.StartsWith("Error:"))
                {
                    // errorMessage = aiSQL;
                    chatHistory.Add(new OllamaMessage { Role = "assistant", Content = "I'm sorry, there was a problem responding to your question. Try again, reword the question or try another AI model..." });
                }
                else
                {
                    // Add assistant response to history
                    chatHistory.Add(new OllamaMessage { Role = "assistant", Content = aiSQL });
                    // StateHasChanged();
                    // await JSRuntime.InvokeVoidAsync("scrollToBottom", chatContainer);
                }
                query = string.Empty;
                isLoading = false;
                StateHasChanged();
                await JSRuntime.InvokeVoidAsync("scrollToBottom", chatContainer);
                return; 
            }

            showResults = true;
            if (!isCorrect)
            {
                // If marked incorrect, adjust the query to inform the AI
                aiSQL = "The previous SQL query was incorrect. Please provide a revised SQL query. ";
                isCorrect = true; // Reset for next time
            }

            Dictionary<string, string> aiSQLv = await pAI.GetSQLFromOllamaAsync(aiSQL + query, aiModel, cts.Token);

            if( aiSQLv["Status"] == "Error")
            {
                errorMessage = aiSQLv["Comments"];
                return;
            }

            strResponse = aiSQLv["SQL"];
            strReasoning = aiSQLv["Comments"];

            var aiResponse = await pulseApiClient.GetAsync<List<Dictionary<string, object>>>($"/AI/execute:{strResponse}");
            if (aiResponse == null)
            {
                errorMessage = "No response from AI execution.";
                return;
            }
            rows = aiResponse;
            if (rows.Any())
            {
                columns = rows.First().Keys.ToList();
            }

            // StateHasChanged();

        }
        catch (Exception ex)
        {
            errorMessage = ex.Message.Contains("timeout") ? "Ollama is taking too long—try simpler query or check local service." : $"Error: {ex.Message}";
        }
        finally
        {

            isLoading = false;
            // if (ChatMode) { await SetQuestionFocus(); }
        }
    }

