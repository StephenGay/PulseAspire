        if (this._isListening) return;
        this._isListening = true;
        this._results = [];
        query = string.Empty;
        await this.SpeechRecognition.StartAsync();
    }
    public void Dispose()
    {
        this.SpeechRecognition.Result -= OnSpeechRecognized;
        this.SpeechRecognition.End -= OnSpeechEnded;
    }
    private async Task ChangeMode(string sMode)
    {
        errorMessage = string.Empty;
        strResponse = string.Empty;
        strReasoning = string.Empty;
        aiSQL = string.Empty;
        query = string.Empty;
        isLoading = false;
        showResults = false;
        showSavedQueries = false;
        string hellomsg=string.Empty;
        columns.Clear();
        rows.Clear();
        chatHistory.Clear();
        selectedSavedQuery = null;

        switch (sMode)
        {
            case "Data":
                SavedQueryMode = false;
                DataMode = true;
                break;

            case "SavedQry":
                SavedQueryMode = true;
                showSavedQueries = true;
                viewBox = true;
                DataMode = false;
                await LoadSavedQueries();
                break;

            default:
                break;
        }    
    }

