            errorMessage = $"Error executing saved query: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SubmitQuery()
    {
        if (string.IsNullOrWhiteSpace(txtQ) && isCorrect) return;

        isLoading = true;
        errorMessage = string.Empty;
        strResponse = string.Empty;
        showSQL = false;
        strReasoning = string.Empty;
        aiSQL = string.Empty;
        columns.Clear();
        rows.Clear();

        try
        {
            // Call Ollama to process the natural language query
            cts = new CancellationTokenSource();
            query = txtQ;

            showResults = true;
            if (!isCorrect)
            {
                // If marked incorrect, adjust the query to inform the AI
                aiSQL = "The previous SQL query was incorrect. Please provide a revised SQL query. ";
                isCorrect = true; // Reset for next time
            }

            Dictionary<string, string> aiSQLv = await pAI.GetSQLFromOllamaAsync(aiSQL + query, aiModel, cts.Token);

            if( aiSQLv["Status"] == "Error")
            {
                errorMessage = aiSQLv["Comments"];
                return;
            }
            if (aiSQLv["Status"] == "Cancelled")
            {
                
                errorMessage = aiSQLv["Comments"];
                return;
            }
            strResponse = aiSQLv["SQL"];
            strReasoning = $"SQL:\n {aiSQLv["SQL"]}\n\nExecuting...";
            StateHasChanged();

            var aiResponse = await pulseApiClient.GetAsync<List<Dictionary<string, object>>>($"/AI/execute:{strResponse}",cts.Token);
            if (aiResponse == null)
            {
                errorMessage = "No response from AI execution.";
                return;
            }
            rows = aiResponse;
            if (rows.Any())
            {
                columns = rows.First().Keys.ToList();
            }

            // StateHasChanged();

        }
        catch (TaskCanceledException)
        {
            errorMessage = "Operation canceled.";
            showResults = false;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message.Contains("timeout") ? "Ollama is taking too long—try simpler query or check local service." : $"Error: {ex.Message}";
        }
        finally
        {

            isLoading = false;
            // if (ChatMode) { await SetQuestionFocus(); }
        }
    }
    private async Task ExportToExcelAsync()
    {
        if (!rows.Any()) return;

        using var workbook = new XLWorkbook();
        var worksheet = workbook.Worksheets.Add("QueryResults");

        // Add headers
        for (int i = 0; i < columns.Count; i++)
        {
            worksheet.Cell(1, i + 1).Value = columns[i];
        }

        // Add data rows
        for (int r = 0; r < rows.Count; r++)
        {
            for (int c = 0; c < columns.Count; c++)
            {
                var value = rows[r].TryGetValue(columns[c], out var val) ? val : null;
                worksheet.Cell(r + 2, c + 1).Value = value?.ToString() ?? string.Empty;
            }
        }

        using var stream = new MemoryStream();
        workbook.SaveAs(stream);
        var content = stream.ToArray();
        var base64 = Convert.ToBase64String(content);

        await JSRuntime.InvokeVoidAsync("downloadExcel", "query_results.xlsx", base64);
    }

