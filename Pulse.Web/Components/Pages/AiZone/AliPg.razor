    #region Ali

    private async Task btnAskAIClick()
    {
        bool isSuccess = false;
        try
        {
            var aReq = new AnalysisRequestDto
         (
             keyPropertyVal,
             _authService.aspireUserId,
             Convert.ToInt32(selAreaId),
             txtQ,
             custTitle
         );
            var response = await pApiClient.PostAsync<AnalysisRequestDto, ApiResponse>(ApiEndpoints.PulseAi.Ali.Analysis.AddToQueue, aReq);
            isSuccess = response.Success == true;
        }
        catch (Exception ex)
        {
            isSuccess = false;
        }
        finally
        {
            if (!isSuccess)
            {
                var errMsg = "There was an error adding your request to the queue.<br />Please try again.";
                PulseToastService.ShowToast("Error", errMsg, true, true, "Ali");
                await GlobalAI.AISpeak("There was an error adding your request to the queue. Please try again.", "Ali");
            }
            else
            {
                var msg = "Your request has been added to the queue.<br />You will receive a message when it has been processed.";
                PulseToastService.ShowToast("Information", msg, true, true, "Ali");
                await GlobalAI.AISpeak(msg, "Ali");
            }
        }
    }

    private async Task SendToast(string tType, string tContent, string tAI = "Ali", bool autoHide = true, bool isHtml = false, string? tTitle = null)
    {
        await GlobalAI.AISpeak(tContent, tAI);
        PulseToastService.ShowToast(tType, tContent, isHtml, autoHide, tAI, tTitle);
    }

    private async Task ProcessRequest(string prompt)
    {
        IsOpen = false;

        aiModel = await dtrf.GetgvAIModel();

        try
        {
            sState = "BUSY";
            StateHasChanged();

            await SendToast("Information", "Your request is being processed.<br />You will be notified when it is complete.", "Ali", true, true);
            var request = new OllamaRequest
            {
                Prompt = prompt,
                Model = aiModel,
                Options = { NumCtx = 32000, NumPredict = 8000 }
                //Options = { NumCtx = Convert.ToInt32(prompt.Length / 4 * 1.3), NumPredict = 8000 }
            };
            // _Analysis = await pAI.AskPulseAIAsync(request);
            _Analysis = await pAI.AskPulseAIAsync(prompt, aiModel);

            if (_Analysis.StartsWith("Error"))
            {
                await SendToast("Error", $"Apologies, an error occurred while processing your request.\n Please try again.", "Ali", true, true);
                ResetState();
                return;
            }

            if (string.IsNullOrEmpty(_Analysis))
            {
                await SendToast("Warning", "Either no data matched your query or there was an error processing your request.\n If there should have been results, please try again", "Ali", true, true);
                ResetState();
                return;
            }

            _Analysis = ParseToHtml(_Analysis);
            _AliAnalysis = AddMUcss(_Analysis);

            // fileName = $"{customer.FullClientID}-{Hdr}";
            await SendToast("Information", "Your request has been completed.<br />Click the <strong>VIEW</strong> button to see the results.", "Ali", true, true);
            sState = "WAIT";

        }
        catch (Exception ex)
        {
            await SendToast("Error", "Exception", ex.Message);
            ResetState();
        }
    }

    private void ResetState()
    {
        qry = LoadHdr = Hdr = _Analysis = _AliAnalysis = fileName = "";
        sState = "IDLE";
        showResultsPanel = false;
    }


    private async Task saveQry()
    {
        //User u = await dtrf.GetgvUser();
        if (string.IsNullOrEmpty(custTitle) || string.IsNullOrEmpty(custDesc) || string.IsNullOrEmpty(txtQ))
        {
            var msgErr = "There is a value missing for either:<br /><strong>Title, Description or Prompt.</strong>";
            PulseToastService.ShowToast("Error", msgErr, true, true, "Ali", "Incomplete");
            msgErr += "Enter the required data and try again.";
            await GlobalAI.AISpeak(msgErr, "Ali");
            return;
        }

        ContextualPrompt newPrompt = new ContextualPrompt
        {
            ContextualAreaId = (string.IsNullOrEmpty(selAreaId) ? 0 : int.Parse(selAreaId)),
            ContextualPromptTitle = custTitle,
            ContextualPromptDescription = custDesc,
            Prompt = txtQ,
            ApplicationUserId = _authService.aspireUserId,
            Likes = 0
        };
        try
        {
            ContextualPrompt newP = await pApiClient.SaveCustomPromptAsync(newPrompt);
            Saving = false;
            txtQ = custTitle = custDesc = string.Empty;
            showSave = false;
            // ContextPrompts.Add(newP);
            StateHasChanged();
            return;
        }
        catch (Exception ex)
        {
            await SendToast("Error", "There was an error saving the prompt", "Ali");
            await GlobalAI.AISpeak("There was an error saving the prompt. Please try again.", "Ali");
            return;
        }
    }

    private async Task RunCommunityPrompt(int promptId)
    {
        IsOpen = false;
        var prompt = await pApiClient.GetAsync<ContextualPrompt>($"/AI/GetContextualPromptById/{promptId}");
        if (prompt != null)
        {
            LoadHdr = "Processing";
            Hdr = prompt.ContextualPromptTitle;
            qry = prompt.Prompt;
            await GeneratePrompt();

        }
    }

    private async Task CopyCommunityPrompt(ContextualPrompt prompt)
