        // showCommunityPanel = false;
        // var prompt = await pApiClient.GetAsync<ContextualPrompt>($"/AI/GetContextualPromptById/{promptId}");
        selPrompt = prompt;

        if (prompt != null)
        {
            selAreaId = prompt.ContextualAreaId.ToString();
            keyPropertyLbl = contextualAreas.FirstOrDefault(a => a.ContextAreaId == prompt.ContextualAreaId)?.KeyProperty;
            keyPropertyVal = string.Empty;
