                cnt = $"<hr><p><strong>USER</strong>: {userQry}</p><hr>{flapperAnswer}";
                if (stream) { cnt += $"<hr><p><i>{flapperThinking}</i></p><hr>"; }
            }
            else
            {
                foreach (var message in Messages)
                {
                    if (message.Sender != "User")
                    {
                        cnt += @message.Content;

                    }
                    else
                    {
                        cnt += $"<hr><p><strong>USER: </strong>: " + @message.Content + "</p><hr>";
                    }
                }
            }

            // cnt = await HtmlCapture.CaptureForExportAsync(chatContainer);
            var fileName = "ChatLog" + DateTime.Now.ToShortDateString();
            await GlobalFunctions.ExportToPdf(cnt, fileName);

