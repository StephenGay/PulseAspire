    private async Task ToggleHistory()
    {
        viewHistory = !viewHistory;

        if(viewHistory && ConversationHistory.Count == 0)
        {
            await LoadConversationHistory();
        }
    }

    private async Task LoadConversationHistory()
    {
        bool isSuccess = false;
        try
        {
            var response = await pulseApiClient.GetAsync<ApiResponse<List<FlapperConversation>>>(ApiEndpoints.PulseAi.EndpointsFlapper.GetUserConversationHistory(_authService.aspireUserId));
            isSuccess = response?.Success == true ? true : false;
            if (isSuccess)
            {
                await ClearChatHistory();
                ConversationHistory = response?.Data?.ToList();
                
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
        }
        finally
        {
            if (!isSuccess)
            {
                PulseToastService.ShowToast("Error", "There was an error loading your conversation history.<br />Please try again.", true, true, "Flapper");
                await GlobalAI.AISpeak("There was an error loading your conversation history.<br />Please try again.", "Flapper");
                viewHistory = false;
            }
            await InvokeAsync(StateHasChanged);
        }
    }
