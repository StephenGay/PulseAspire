    private async Task StartRecClick()
    {
        if (this._isListening) return;
        this._isListening = true;
        this._results = [];
        query = string.Empty;
        await this.SpeechRecognition.StartAsync();
    }
    public void Dispose()
    {
        this.SpeechRecognition.Result -= OnSpeechRecognized;
        this.SpeechRecognition.End -= OnSpeechEnded;
    }
    private async Task ExportToPdf()
    {
        if (chatHistory==null)
        {
            return;
        }

        try
        {
            string cnt = string.Empty;
            pdfLoading = true;
            if (!ViewAll)
            {
                cnt = $"<hr><p><strong>USER</strong>: {userQry}</p><hr>{ParseToHtml(aiSQL)}";
                if (stream) { cnt += $"<hr>{ParseToHtml(strResponse)}< hr >"; }
            }
            else
            {
                foreach (var message in chatHistory)
                {
                    if (message.Role.ToUpper() != "USER")
                    {
                        cnt += ParseToHtml(@message.Content);
                    }
                    else
                    {
                        cnt += $"<hr><p><strong>" + message.Role.ToUpper() + "</strong>: " + @message.Content +"</p><hr>";
                    }
                }
            }

            using var client = HttpClientFactory.CreateClient("PulseApiClient"); // Named client from Aspire
            var fileName = "ChatLog" + DateTime.Now.ToShortDateString() + ".pdf";
            var H = AddExportMUcss(cnt);

            var request = new PdfRequest
            {
                Html = H,
                FileName = fileName,
            };

            var response = await client.PostAsJsonAsync("/Utilities/pdf/export", request);
            response.EnsureSuccessStatusCode();

            var pdfBytes = await response.Content.ReadAsByteArrayAsync();
            var base64 = Convert.ToBase64String(pdfBytes);
            // var retFileName = response.Content.Headers.ContentDisposition?.FileName?.Trim('"') ?? "analysis.pdf";

            pdfLoading = false;
            await JSRuntime.InvokeVoidAsync("downloadPdfFile", fileName, base64);

            // await SendToast("Success", "Exported", $"PDF saved as {fileName}");
        }
        catch (Exception ex)
        {
            return;
        }
    }
    private async Task ExportHtmlFile()
    {
        if (chatHistory == null)
        {
            return;
        }

        try
        {
            string cnt = string.Empty;

            foreach (var message in chatHistory)
            {
                cnt += "<br /><br /><strong>" + message.Role.ToUpper() + "</strong>: ";
                if (message.Role.ToUpper() != "USER")
                {
                    cnt += "<br />";
                }
                cnt += @message.Content;
            }

            var fileName = "ChatLog" + DateTime.Now.ToShortDateString() + ".pdf";

            var Html = ParseToHtml(cnt);
            // Call JavaScript function to download the file
            await JSRuntime.InvokeVoidAsync("downloadHTMLFile", $"{fileName}.html", Html.Replace("h5","h3"));
        }
        catch (Exception ex)
        {
            await SayIt("I'm sorry, there was a problem exporting the conversation.", "Flapper");
            return;
        }
    }

