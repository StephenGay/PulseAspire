        <div class="chat-area">
            <div class="chat-messages" @ref="chatContainer">
                @if (viewHistory)
                {
                    if(ConversationHistory.Count == 0)
                    {
                        <FluentLabel Typo="Typography.Body" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight" Style=" background-color:var(--pulse-dark-t50-colour); border: 1px solid white; padding:10px; border-radius:15px;width:100%;text-align:center">No past conversations found.</FluentLabel>
                    }
                    else
                    {
                        @foreach (var convo in ConversationHistory)
                        {
                            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Left" Style="margin-bottom: 10px;">
                                @* <FluentLabel Typo="Typography.Body" class="divShadow" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight" Style=" background-color:var(--pulse-dark-t50-colour); border: 1px solid white; padding:10px; border-radius:15px;width:100%;font-style:italic" onclick=$"()=>LoadHistoryConversation("{@convo.Id}")">@convo.StartedAt.ToString("g") - @convo.Title</FluentLabel> *@
                                <FluentLabel Typo="Typography.Body" class="btnShadow" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="var(--pulse-light-colour)" Style=" background-color:var(--pulse-dark-t50-colour); border: 1px solid white; padding:10px; border-radius:15px;width:100%;font-style:italic" @onclick="() => LoadHistoryConversation(convo.Id)">@convo.StartedAt.ToString("g") - @convo.Title.Replace("[REPORT] ","").Replace("[SPEECH] ","")</FluentLabel>
                            </FluentStack>
                        }
                    }
                }
                else
                {
                    @if (!ViewAll)
                    {
                        @if (!string.IsNullOrEmpty(userQry))
                        {
                            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Left" Style="margin-bottom: 10px;">
                                <FluentLabel Typo="Typography.Body" class="divShadow" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="var(--pulse-light-colour)" Style=" background-color:var(--pulse-dark-t50-colour); border: 1px solid white; padding:10px; border-radius:15px;width:100%">@userQry</FluentLabel>
                            </FluentStack>
                        }
                        @if (!string.IsNullOrEmpty(CurrentFlapperResponse))
                        {
                            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment=" Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" Style="margin-bottom: 10px;">
                                <FluentLabel class="divShadow flapper-response" Typo="Typography.Body" Style=" background-color:lemonchiffon; padding:10px; border-radius:15px; border: 1px solid black">
                                    <div style="color: black; word-break: break-word;">
                                        @* <RadzenMarkdown Style="margin:0; padding:0" Text="@CurrentFlapperResponse" AllowHtml="true" /> *@
                                         @((MarkupString)FlapperAddMUcss(FlapperParseToHtml(CurrentFlapperResponse))) 
                                        @* @CurrentFlapperResponse *@
                                    </div>
                                    
                                </FluentLabel>
                                @if (CurrentChartConfig != null)
                                {
                                    <div class="flapper-chart">
                                        <DynamicRadzenChart Config="CurrentChartConfig" />
                                    </div>
                                }
                            </FluentStack>
                        }
                        @if (IsAwaitingClarification && CurrentClarificationQuestion is not null)
                        {
                            <div class="divShadow" style="padding: 16px; background-color: var(--pulse-light-colour);max-width:30%; border: 1px solid var(--pulse-dark-colour);border-radius:10px;">
                                <p><strong>Flapper asks:</strong></p>
                                <p>@CurrentClarificationQuestion</p>
                                @if (CurrentClarificationType == "Text")
                                {
                                    <FluentTextField @bind-Value="CustomReply" Placeholder="Type your custom reply here..." Style="margin:10px;border:1px solid var(--pulse-dark-colour);width:stretch" />
                                    <FluentButton Appearance="Appearance.Accent" Disabled="@string.IsNullOrEmpty(CustomReply)" OnClick="@(() => SendQuickReplyAsync(CustomReply))">Send Custom Reply</FluentButton>
                                }
                                else
                                {
                                    
                                <FluentStack Orientation="MsFluent.Orientation.Horizontal">
                                    <FluentButton Appearance="Appearance.Accent" OnClick="@(() => SendQuickReplyAsync("Yes"))">Yes</FluentButton>
                                    <FluentButton Appearance="Appearance.Neutral" OnClick="@(() => SendQuickReplyAsync("No"))">No</FluentButton>
                                </FluentStack>
                                }
                            </div>
                        }
                        @if (stream && !string.IsNullOrEmpty(flapperThinking))
                        {
                            <br />
                            <FluentLabel Typo="Typography.Body" style="background-color:rgba(255,255,255,0.8);margin-top: 10px; padding:10px; font-style:italic; border-radius:15px; border: 1px solid black ;margin-left: 20px;margin-right: 20px;margin-bottom:10px;color:black; white-space:pre-line">@flapperThinking</FluentLabel>
                            if (!string.IsNullOrEmpty(tablesResponse))
                            {
                                <br />
                                <FluentLabel Typo="Typography.Body" style="background-color:var(--pulse-light-colour);margin-top: 10px; padding:10px; font-style:italic; border-radius:15px; border: 1px solid black ;margin-left: 20px;margin-right: 20px;margin-bottom:10px;color:var(--pulse-dark-colour); white-space:pre-line">@((MarkupString)FlapperAddMUcss(FlapperParseToHtml(tablesResponse)))</FluentLabel>
                            }
                        }
                    }
                    else
                    {
                        @foreach (var message in (oldFirst ? Messages : Enumerable.Reverse(Messages)) )
                        {
