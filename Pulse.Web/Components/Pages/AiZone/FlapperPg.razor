@code {
    private Flapper? flapper;
    private List<FlapperMessageDto> Messages { get; set; } = new();
    private string CurrentUserMessage { get; set; } = string.Empty;
    private bool IsAwaitingClarification { get; set; } = false;
    private bool isStreamingResponse = true;
    private string? CurrentClarificationQuestion { get; set; }
    private string CurrentFlapperResponse { get; set; } = string.Empty;
    private Guid CurrentConversationId { get; set; } = Guid.NewGuid();



    private string? flapperSystemPrompt = string.Empty;
    private string query = string.Empty;
    // private bool firstMsg = true;
    private bool isLoading = false;
    // private bool togChat = false;
    private bool pdfLoading = false;
    private bool oldFirst = false;
    private string txtQ = string.Empty;
    // private bool togWebSearch = true;
    private bool showResults = false;
    private bool ViewAll = false;
    private bool ViewSettings = false;
    private bool viewBox = true;
    // private bool ChatMode = true;
    private bool showViewMenu = false;
    private bool showDownloadMenu = false;
    private string errorMessage = string.Empty;
    private string aiSQL = string.Empty;
    private string userQry = string.Empty;
    private string flapperThinking = string.Empty;
    private string flapperAnswer = string.Empty;
    // private string? aiModel;
    private bool AdminMode = false;
    private ElementReference chatContainer;
    // private bool useSpeechOutput = false;
    private bool retryBtn = false;
    private bool fromRetryBtn = false;
    // private SpeechSynthesisVoice? _voice;
    // private User? user;
    private bool stream = false;

    // Dynamic models for select
    // private List<string>? ollamaModels = new();
    // Multi-turn chat history
    private List<OllamaMessage> chatHistory = new();
    private List<OllamaMessage> currMsgs = new();
    private SpeechRecognitionResult[] _results = [];
    private bool _available = true;
    private bool _isListening = false;
    private bool _inThinking = false;
    private CancellationTokenSource? cts;
    // Saved Queries state
    private bool isLoadingSaved = false;
    private string? uName;
    private HttpClient? ollamaClient;
    // FluentTextArea? txtQ;


    #region Page Lifecycle and Initialization



    protected override async Task OnInitializedAsync()
    {
        await MsgHubService.EnsureConnectedAsync();
        // Setup SignalR connection
        MsgHubService.OnReceiveMessage +=
                OnFlapperMessageReceived;
        MsgHubService.OnReceiveFlapperChunk +=
                OnFlapperMessageChunkReceived;
        uName = await dtrf.GetgvUserFirstName();
        ollamaClient = HttpClientFactory.CreateClient("OllamaClient");
    }

    #endregion

    #region Message Handling

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(CurrentUserMessage)) return;

        isLoading = true;
        flapperThinking = "";
        userQry = CurrentUserMessage;
        Messages.Add(new FlapperMessageDto { Sender = "You", Content = CurrentUserMessage });
        CurrentUserMessage = string.Empty;

        // Add placeholder for Flapper
        Messages.Add(new FlapperMessageDto { Sender = "Flapper", Content = "..." });
        CurrentFlapperResponse = "";
        StateHasChanged();

        // Send to API
        var request = new FlapperChatRequest
        (
            _authService.aspireUserId,
            CurrentConversationId,
            userQry,
            _authService.aspireFullName, isStreamingResponse = stream
        );

        using var flapperClient = HttpClientFactory.CreateClient("FlapperApiClient");
        var fResponse = await flapperClient.PostAsJsonAsync("https://localhost:5475" + ApiEndpoints.PulseAi.EndpointsFlapper.OllamaChatSession, request);
        if(fResponse.IsSuccessStatusCode)
        {
            var fContent = await fResponse.Content.ReadAsStringAsync();
            var fResult = JsonSerializer.Deserialize<FlapperResponse>(fContent, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (fResult != null)
            {
                if (fResult.RequiresClarification)
                {
                    CurrentFlapperResponse = "<p><strong>Flapper Asked For The Following Clarification:</strong></p><p>" + fResult.ClarificationQuestion + "</p>";
                    var lastMsg = Messages.LastOrDefault(m => m.Sender == "Flapper");
                    if (lastMsg != null)
                        lastMsg.Content = CurrentFlapperResponse;
                }
                // flapperThinking = "";
                flapperAnswer = CurrentFlapperResponse;
                retryBtn = false;
            }
            else
            {
                CurrentFlapperResponse = "Error: Unable to parse response.";
                var lastMsg = Messages.LastOrDefault(m => m.Sender == "Flapper");
                if (lastMsg != null)
                    lastMsg.Content = CurrentFlapperResponse;
                retryBtn = true;
            }
        }
        else
        {
            CurrentFlapperResponse = "Error: No response from server.";
            var lastMsg = Messages.LastOrDefault(m => m.Sender == "Flapper");
            if (lastMsg != null)
                lastMsg.Content = CurrentFlapperResponse;
            retryBtn = true;
        }
        
    }

    private async Task SendQuickReplyAsync(string answer)
    {
        if (string.IsNullOrEmpty(answer)) return;

        // Add user reply to chat
        Messages.Add(new FlapperMessageDto { Sender = "You", Content = answer });

        // Send the clarification answer back to continue the session
        var request = new FlapperChatRequest
        (
            _authService.aspireUserId,
            CurrentConversationId,
            answer,
            _authService.aspireFullName   // Yes / No becomes the next user message
        );

        using var flapperClient = HttpClientFactory.CreateClient("FlapperApiClient");
        await flapperClient.PostAsJsonAsync("https://localhost:5475" + ApiEndpoints.PulseAi.EndpointsFlapper.OllamaChatSession, request);
        // await PulseApi.PostAsync<FlapperChatRequest, object>(ApiEndpoints.PulseAi.Flapper.Chat, request);

        // Reset clarification UI
        IsAwaitingClarification = false;
        CurrentClarificationQuestion = null;

        StateHasChanged();
    }

    private async Task SendCustomReplyAsync()
    {
        // Show input again for custom answer
        IsAwaitingClarification = false;
        StateHasChanged();
    }
    private async void OnFlapperMessageChunkReceived(PulseMessage msg)
    {
        if (msg.Role != "Flapper")
        {
            return;
        }
        // Clarification detection
        if (msg.Content.StartsWith("[CLARIFICATION]"))
        {
            IsAwaitingClarification = true;
            CurrentClarificationQuestion = msg.Content.Replace("[CLARIFICATION]", "").Trim();
            CurrentFlapperResponse = "";

            // Clear the "..." placeholder
            // var placeholder = Messages.LastOrDefault(m => m.Sender == "Flapper" && m.Content == "...");
            // if (placeholder != null)
            //     Messages.Remove(placeholder);

            StateHasChanged();
            return;
        }

        var msgContent = msg.Content;

        if(msg.Content.StartsWith("<thinking>"))
        {
            _inThinking = true; 
            msgContent = msgContent.Replace("<thinking>", "").Trim();
        }
        if (msg.Content.StartsWith("</thinking>"))
        {
            _inThinking = false;
            msgContent = msgContent.Replace("</thinking>", "").Trim();
        }

        // Normal streaming content
        if(_inThinking)
        {
            flapperThinking += msgContent;
        }
        else
        {
            CurrentFlapperResponse += msgContent;
        }
        

        var lastMsg = Messages.LastOrDefault(m => m.Sender == "Flapper");
        if (lastMsg != null)
            lastMsg.Content = CurrentFlapperResponse;
        else
            Messages.Add(new FlapperMessageDto { Sender = "Flapper", Content = CurrentFlapperResponse });
        // isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async void OnFlapperMessageReceived(PulseMessage msg)
    {

        if (msg.Role != "Flapper")
        {
            return;
        }
        Messages.Add(new FlapperMessageDto
        {
            Sender = "Flapper",
            Content = msg.Content
        });

        // Check if this is a clarification question
        if (msg.Subject?.Contains("Clarification", StringComparison.OrdinalIgnoreCase) == true)
        {
            IsAwaitingClarification = true;
            CurrentClarificationQuestion = msg.Content;
        }
        else
        {
            CurrentFlapperResponse = msg.Content;
        }
        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

