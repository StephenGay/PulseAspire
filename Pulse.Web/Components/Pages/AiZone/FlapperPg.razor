    private async void OnFlapperChatResponse(FlapperResponse response)
    {

        Messages.Add(new FlapperMessage
        {
            Sender = "Flapper",
            Content = response.Content,
            ContentType = response.RequiresClarification ? "AiQuestion" : "AiResponse"

        });

        // Check if this is a clarification question
        if (response.RequiresClarification)
        {
            IsAwaitingClarification = true;
            CurrentClarificationQuestion = response.ClarificationQuestion;
            CurrentClarificationType = response.ClarificationType;
        }
        else
        {
            if(response.EndReason == "natural_stop")
            {
                CurrentFlapperResponse = response.Content;
                if (!string.IsNullOrEmpty(response.RawContent))
                {
                    CurrentChartConfig = GlobalFunctions.DeserialiseChartConfigString(response.RawContent);
                }
            }
            else
            {
                var endReasonErr = "The response ended abnormally.";
                switch (response.EndReason)
                {
                    case "context_window_exceeded":
                        endReasonErr = "The context window limit has been reached";
                        break;
                    case "max_tokens_reached":
                        endReasonErr = "The max token limit has been reached";
                        break;
                    default:
                        endReasonErr = $"The response ended abnormally.<br />{response.EndReason}";
                        break;
                }
                PulseToastService.ShowToast("Warning", endReasonErr, true, true, "Flapper");
                await GlobalAI.AISpeak(endReasonErr, "Flapper");
                _answerBuilder.Clear();
            }

        }
        // ====================== FINAL FLUSH ======================
        if (SpokenResponse && _answerBuilder.Length > _lastSpokenCharIndex)
        {
            string remainingText = _answerBuilder.ToString().Substring(_lastSpokenCharIndex).Trim();

            if (!string.IsNullOrWhiteSpace(remainingText))
            {
                string cleanText = PrepareForSpeech(remainingText);
                await GlobalAI.AISpeak(cleanText, "Flapper");
            }
        }

        // Reset for next conversation turn
        _answerBuilder.Clear();
        _lastSpokenCharIndex = 0;

        isLoading = IsAwaitingClarification;
        await InvokeAsync(StateHasChanged);
    }

