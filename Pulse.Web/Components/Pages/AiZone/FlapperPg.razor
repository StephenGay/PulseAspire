                                            <FluentSpacer />
                                            
                                            <FluentButton class="myAccentBtn" BackgroundColor="var(--pulse-accent-btn-bg)" Color="var(--pulse-accent-btn-colour)"
                                                          IconStart="@(new Icons.Filled.Size24.QuizNew().WithColor("var(--pulse-accent-btn-colour)"))"
                                                          Title="New Topic"
                                                          Style="height:50px;width:50px" OnClick="@ClearChatHistory"></FluentButton>
