    private async Task SubmitQuery()
    {
        if (string.IsNullOrWhiteSpace(txtQ))
        {
            PulseToastService.ShowToast("Warning", "You have not entered anything for me to respond to?", false, true, "Flapper");
            await GlobalAI.AISpeak("You have not entered anything for me to respond to?", "Flapper");
            return;
        }

        // Set Variables
        userQry = query = txtQ;
        flapperAnswer = string.Empty;
        flapperThinking = string.Empty;
        isLoading = true;
        retryBtn = false;

        // reload Flapper config in case settings were changed
        flapper = await dtrf.GetgvFlapper();

        // check if this is a retry, we don't want to add the query again to the history if so as it was already added when the query was first submitted


        cts = new CancellationTokenSource();

        if (stream)
        {
            await FlapperChatStream(cts.Token);
        }
        else
        {
            await FlapperChatNonStream(cts.Token);
        }
        query = txtQ = string.Empty;
        txtQ = string.Empty;
        isLoading = false;
        StateHasChanged();
        return;
    }

    #region Flapper Chat Stream

    private async Task FlapperChatStream(CancellationToken cToken = default)
    {
        Company c = await dtrf.GetgvCompany();
        List<OllamaMessage> newMsgs = new List<OllamaMessage>();

        if (!fromRetryBtn)
        {
            chatHistory.Add(new OllamaMessage { Role = "user", Content = query });
        }
        else
        {
            var lastMsg = $@"""This is a repeat of the last query as there was either an error or the user was not satisfied with the response. 
                        Query: {query}""";
            chatHistory.Add(new OllamaMessage { Role = "user", Content = lastMsg });
        }
        fromRetryBtn = false;

        try
        {
            var systemMessageData = new SystemMessageData
            {
                DbStructure = AiPrompts.GetDatabaseStructure(),
                DbSchema = await pAI.GetDetailedSchemaAsync(cToken),
                DbExamples = await pAI.GetAiExamplesAsync(cToken),
                CompanyName = c.CompanyName,
                CompanyInformation = AiPrompts.GetTempCoInfo(),
                SqlGuidelines = AiPrompts.GetSqlGuidelines(),
                UserName = uName,
                Tools = AiPrompts.GetToolsGuidelines(AdminMode),
                UserQuery = txtQ
            };

            flapperSystemPrompt = flapper?.BuildSystemMessagev2(systemMessageData);

            // ✅ Create QueryContext with original user query
            var context = new QueryContext 
            { 
                OriginalUserQuery = userQry  // Store the original query!
            };

            await foreach (var chunk in FlapperStream(chatHistory, context, cToken))
            {
                if (string.IsNullOrEmpty(chunk)) continue;
                if(chunk.StartsWith("Error:"))
                {
                    flapperAnswer = chunk.Substring("Error:".Length);
                    PulseToastService.ShowToast("Error", flapperAnswer, true, true, "Flapper");
                    await GlobalAI.AISpeak(flapperAnswer, "Flapper");
                    return;
                }

                // Check for thinking marker
                if (chunk.StartsWith("__THINKING__"))
                {
                    var thinking = chunk.Substring("__THINKING__".Length);
                    if (!string.IsNullOrEmpty(thinking))
                    {
                        flapperThinking += thinking;
                        StateHasChanged();
                        await Task.Delay(5);
                    }
                }
                else if (chunk.StartsWith("__FINAL_ANSWER__"))
                {
                    var answer = chunk.Substring("__FINAL_ANSWER__".Length);
                    flapperAnswer += answer;
                    StateHasChanged();
                    await Task.Delay(5);
                }
            }
        }
        catch (OperationCanceledException)
        {
            PulseToastService.ShowToast("Warning", "Response cancelled.", false, true, "Flapper");
            await GlobalAI.AISpeak("Response cancelled.", "Flapper");
        }
        catch (Exception ex)
        {
            PulseToastService.ShowToast("Error", $"There was an error processing your request.<br />{ex.Message}", true, true, "Flapper");
            await GlobalAI.AISpeak("There was an error processing your request. Please try again.", "Flapper");
            retryBtn = true;
        }
    }

    // Update FlapperStream signature to accept QueryContext
    private async IAsyncEnumerable<string> FlapperStream(
        List<OllamaMessage> newMessages,
        QueryContext context,  // ← Add QueryContext parameter
        [EnumeratorCancellation] CancellationToken ct = default,
        int qryLoop = 0,
        bool inThinking = false,
        int failedAttempts = 0)
    {
        if (!AdminMode && qryLoop >= flapper.MaxRecursionDepth) // MAX_RECURSION_DEPTH)
        {
            yield return $"Error: I have reached the maximum recursion limit.<br />Try breaking the query into smaller steps.";
            yield break;
        }

        if (!AdminMode && failedAttempts >= flapper.MaxFailedAttempts) // MAX_FAILED_ATTEMPTS)
        {
            yield return $"Error: The failed attempts limit has been reached.<br />Please rephrase or try a different query.";
            yield break;
        }

        var tools = BuildFlapperTools();
        currMsgs = new List<OllamaMessage>();

        currMsgs.Add(new OllamaMessage { Role = "system", Content = flapperSystemPrompt });
        currMsgs.AddRange(newMessages);

        var ollamaRequest = new
        {
            model = flapper!.Model,
            messages = currMsgs.ToArray(),
            tools = tools.ToArray(),
            think = flapper.Think,
            keep_alive = "30m",
            stream = true,
            options = new
            {
                temperature = flapper.Options.Temperature,
                num_ctx = flapper.Options.NumCtx,
                repeat_penalty = flapper.Options.RepeatPenalty,
                frequency_penalty = flapper.Options.FrequencyPenalty,
                presence_penalty = flapper.Options.PresencePenalty
            }
        };

        var accumulatedMessage = new OllamaMessage { Role = "assistant" };
        bool hasYieldedContent = false;
        string? pendingError = null;

        // Get the stream - handle initialization errors
        HttpResponseMessage? response = null;
        try
        {
            response = await ollamaClient!.PostAsJsonAsync("/api/chat", ollamaRequest, ct);
            response.EnsureSuccessStatusCode();
        }
        catch (OperationCanceledException)
        {
            pendingError = "Request cancelled.";
        }
        catch (Exception ex)
        {
            pendingError = $"Error connecting to Ollama: {ex.Message}";
        }

        // Yield initialization error outside catch
        if (pendingError != null)
        {
            yield return pendingError;
            yield break;
        }

        Stream? contentStream = null;
        try
        {
            contentStream = await response.Content.ReadAsStreamAsync(ct);
        }
        catch (Exception ex)
        {
            pendingError = $"Error reading response: {ex.Message}";
        }

        if (pendingError != null)
        {
            yield return pendingError;
            yield break;
        }

        using var reader = new StreamReader(contentStream!);

        // Process stream line by line
        while (true)
        {
            string? line = null;
            bool readerDone = false;

            try
            {
                line = await reader.ReadLineAsync(ct);
                readerDone = line == null;
            }
            catch (OperationCanceledException)
            {
                pendingError = "Request cancelled.";
                break;
            }
            catch (Exception ex)
            {
                pendingError = $"Stream error: {ex.Message}";
                break;
            }

            if (readerDone) break;
            if (string.IsNullOrWhiteSpace(line)) continue;

            OllamaChatChunk? chunk = null;
            try
            {
                chunk = JsonSerializer.Deserialize<OllamaChatChunk>(line, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            }
            catch (JsonException ex)
            {
                pendingError = $"Failed to parse response: {ex.Message}";
                break;
            }

            if (chunk == null) continue;

            // Accumulate tool calls first
            if (chunk.Message?.ToolCalls != null)
            {
                accumulatedMessage.ToolCalls ??= new List<OllamaToolCall>();
                accumulatedMessage.ToolCalls.AddRange(chunk.Message.ToolCalls);
            }

            // Handle thinking content
            if (!string.IsNullOrEmpty(chunk.Message?.Thinking))
            {
                accumulatedMessage.Thinking = (accumulatedMessage.Thinking ?? string.Empty) + chunk.Message.Thinking;
                if (!inThinking)
                {
                    inThinking = true;
                    // flapperThinking += $"Thinking:\n";
                    yield return "__THINKING__Thinking:\n";
                }
                // flapperThinking += chunk.Message.Thinking;
                hasYieldedContent = true;
                yield return $"__THINKING__{chunk.Message.Thinking}";
                // StateHasChanged();
                // await Task.Delay(5, ct);

            }



            // Handle answer content - ONLY if no tool calls are present
            if (!string.IsNullOrEmpty(chunk.Message?.Content))
            {
                accumulatedMessage.Content = (accumulatedMessage.Content ?? string.Empty) + chunk.Message.Content;

                if (accumulatedMessage.ToolCalls == null || accumulatedMessage.ToolCalls.Count == 0)
                {
                    if (inThinking)
                    {
                        inThinking = false;
                        // flapperAnswer += "Answer:\n";
                        yield return "__FINAL_ANSWER__";
                    }
                    hasYieldedContent = true;
                    // flapperAnswer += chunk.Message.Content;
                    // StateHasChanged();
                    // await Task.Delay(5, ct);
                    yield return $"__FINAL_ANSWER__{chunk.Message.Content}";
                }
            }

            // Only break when Done=true, regardless of content type
            // Ollama sends thinking first, then content, both with Done=false except the last chunk
            if (chunk.Done)
            {
                // ✅ ALWAYS add the assistant message to history
                accumulatedMessage.Role = "assistant";
                currMsgs.Add(accumulatedMessage);
                // chatHistory.Add(accumulatedMessage);

                if (accumulatedMessage.ToolCalls is { Count: > 0 })
                {
                    if (!hasYieldedContent)
                    {
                        // flapperThinking += "Analyzing query and preparing tools...\n";
                        yield return "__THINKING__Analyzing query and preparing tools...\n";
                    }
                    else
                    {
                        // flapperThinking += "\nTool calls detected. Processing...\n";
                        yield return "__THINKING__\nTool calls detected. Processing...\n";
                    }
                    // StateHasChanged();
                    // await Task.Delay(5, ct);

                    // Process tool calls (they'll add results to newMessages)
                    var toolError = await ProcessToolCallsAsync(accumulatedMessage.ToolCalls,context, ct);
                    if (toolError != null)
                    {
                        yield return $"Error: {toolError}";
                        yield break;
                    }

                    // Recursive call with updated history (WITHOUT system message)
                    await foreach (var recursiveChunk in FlapperStream(
                        currMsgs,
                        context,  // ← Pass context to recursive call
                        ct,
                        qryLoop + 1,
                        inThinking,
                        failedAttempts))
                    {
                        yield return recursiveChunk;
                    }
                    // Recursive call with updated history (WITHOUT system message)
                    // FlapperStream(currMsgs, context, ct, qryLoop + 1, inThinking, failedAttempts);
                }
                break;
            }
        }

        // Yield any pending error outside the loop
        if (pendingError != null)
        {
            yield return pendingError;
            yield break;
        }

        if (!hasYieldedContent && accumulatedMessage.ToolCalls is not { Count: > 0 })
        {
            yield return "Error: No response from Ollama.";
        }
        accumulatedMessage.Role = "assistant";
        chatHistory.Add(accumulatedMessage);
        // ✅ DON'T yield final accumulated answer here!
        // We already yielded individual chunks, so accumulating and yielding the whole thing causes duplication
    }
