<style>
    .chat-area {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid var(--pulse-dark-colour);
        background-color: var(--pulse-dark-t25-colour);
        border-radius: 8px;
    }

    .chat-messages {
        flex: 1;
        overflow: auto;
        padding: 10px;
    }

        .chat-messages img {
            max-width: 25%;
            height: auto;
        }

    .flapper-response-image {
        max-width: 25%;
        height: auto;
        border-radius: 8px;
        margin: 10px 0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        display: block;
    }

    /* For Flapper's response messages */
    .flapper-response {
        overflow-wrap: break-word;
        word-break: break-word;
    }

        .flapper-response img {
            max-width: 25%;
            height: auto;
            border-radius: 8px;
            margin: 10px 0;
        }
</style>

<div class="aiParent">
    <div class="aiHeader" />
    <div class="aiMenu">
        <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Left" VerticalAlignment="VerticalAlignment.Center" style="padding:10px">
                <FluentButton Appearance="Appearance.Accent"
                                    class=@(!viewBox ? "myModeBtnOff" : "myModeBtnOn")
                                    BackgroundColor="var(--pulse-mode-btn-bg)"
                                    Color="var(--pulse-mode-btn-item-colour)"
                                    Style="border: 1px solid var(--pulse-mode-btn-item-colour) ;height:50px;width:50px;margin-left:10px"
                                    OnClick="() => viewBox = !viewBox">
                    @if (flapper is not null)
                    {
                        @(flapper.emoji.ToMarkup("45px"))
                    }
                </FluentButton>
                <FluentButton Appearance="Appearance.Accent" class=@(!stream ? "myModeBtnOff" : "myModeBtnOn") BackgroundColor="var(--pulse-mode-btn-bg)"
                              Color="var(--pulse-mode-btn-item-colour)"
                              IconStart="@(new Icons.Filled.Size24.Thinking().WithColor("var(--pulse-mode-btn-item-colour)"))" style="height:50px;width:50px"
                              Title="Toggle Thinking"
                              OnClick="() => stream = !stream"></FluentButton>
            <FluentButton Appearance="Appearance.Accent" class=@(!viewHistory ? "myModeBtnOff" : "myModeBtnOn") BackgroundColor="var(--pulse-mode-btn-bg)"
                          Color="var(--pulse-mode-btn-item-colour)"
                          IconStart="@(new Icons.Filled.Size24.History().WithColor("var(--pulse-mode-btn-item-colour)"))" style="height:50px;width:50px"
                          Title="Toggle History"
                          OnClick="ToggleHistory"></FluentButton>
            <FluentButton Appearance="Appearance.Accent" class=@(!SpokenResponse ? "myModeBtnOff" : "myModeBtnOn") BackgroundColor="var(--pulse-mode-btn-bg)"
                          Color="var(--pulse-mode-btn-item-colour)"
                          IconStart="@(new Icons.Filled.Size24.PersonVoice().WithColor("var(--pulse-mode-btn-item-colour)"))" style="height:50px;width:50px"
                          Title="Toggle Spoken Responses"
                          OnClick="ToggleSpeechOutput"></FluentButton>
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <!-- Create Role Form (only shown to admins) -->
                        <FluentButton Appearance="Appearance.Accent" class=@(!ViewSettings ? "myModeBtnOff" : "myModeBtnOn") BackgroundColor="var(--pulse-mode-btn-bg)"
                                      Color="var(--pulse-mode-btn-item-colour)"
                                      IconStart="@(new Icons.Filled.Size24.Settings().WithColor("var(--pulse-mode-btn-item-colour)"))"
                                      Style="height:50px;width:50px"
                                      Title="Flapper Settings"
                                      OnClick="() => ViewSettings = !ViewSettings"></FluentButton>
                        <FluentButton Appearance="Appearance.Accent" class=@(!AdminMode ? "myModeBtnOff" : "myModeBtnOn") BackgroundColor="var(--pulse-mode-btn-bg)"
                                      Color="var(--pulse-mode-btn-item-colour)"
                                      Style="height:50px;width:50px"
                                      IconStart="@(new Icons.Filled.Size24.PersonEdit().WithColor("var(--pulse-mode-btn-item-colour)"))"
                                      Title="Admin Mode"
                                      OnClick="() => AdminMode = !AdminMode"></FluentButton>
                    <FluentButton Appearance="Appearance.Accent" class=@(!useIChat ? "myModeBtnOff" : "myModeBtnOn") BackgroundColor="var(--pulse-mode-btn-bg)"
                                  Color="var(--pulse-mode-btn-item-colour)"
                                  IconStart="@(new Icons.Filled.Size24.Settings().WithColor("var(--pulse-mode-btn-item-colour)"))"
                                  Style="height:50px;width:50px"
                                  Title="Use IChat Client"
                                  
                                  OnClick="() => useIChat = !useIChat"></FluentButton>
                                  @* OnClick="FlapChat"></FluentButton> *@
                    </Authorized>
                </AuthorizeView>
                <FluentSpacer />
                <FluentButton id="btnView2" class="myAccentBtn" BackgroundColor="var(--pulse-accent-btn-bg)" Color="var(--pulse-accent-btn-colour)"
                              IconStart="@(new Icons.Filled.Size24.Eye().WithColor("var(--pulse-accent-btn-colour)"))"
                              Title="View"
                              Style="height:50px;width:50px" OnClick="() => showViewMenu = !showViewMenu"></FluentButton>
                <FluentPopover Style="width: 300px; border: 2px solid var(--pulse-dark-colour); border-radius:10px;" VerticalThreshold="170" FixedPlacement="true" HorizontalPosition="HorizontalPosition.Start" VerticalPosition="VerticalPosition.Bottom" AutoFocus="false" AnchorId="btnView2" @bind-Open="showViewMenu">
                    <Body>
                        <FluentStack Orientation="MsFluent.Orientation.Vertical" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center">
                            <FluentButton Appearance="Appearance.Accent" class=@(!ViewAll ? "myModeBtnOff" : "myModeBtnOn") BackgroundColor="var(--pulse-mode-btn-bg)"
                                            Color="var(--pulse-mode-btn-item-colour)"
                                            Style="height:40px;width:80%"
                                            OnClick="() => ViewAll = !ViewAll">View All</FluentButton>
                            <FluentButton Appearance="Appearance.Accent" class=@(!oldFirst ? "myModeBtnOff" : "myModeBtnOn") BackgroundColor="var(--pulse-mode-btn-bg)"
                                        Color="var(--pulse-mode-btn-item-colour)"
                                        Style="height:40px;width:80%"
                                        Disabled="!ViewAll"
                                        OnClick="() => oldFirst = !oldFirst">Oldest First</FluentButton>
                        </FluentStack>
                    </Body>
                </FluentPopover>
                @if (pdfLoading)
                {
                    <div class="spinner-grow text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                }
                else
                {
                    <FluentButton id="btnDownload2" class="myAccentBtn" BackgroundColor="var(--pulse-accent-btn-bg)" Color="var(--pulse-accent-btn-colour)"
                                      IconStart="@(new Icons.Filled.Size24.ArrowDownload().WithColor("var(--pulse-accent-btn-colour)"))"
                                      Title="Download"
                                      Style="height:50px;width:50px" OnClick="() => showDownloadMenu = !showDownloadMenu"></FluentButton>
                    <FluentPopover Style="width: 300px; border: 2px solid var(--pulse-dark-colour); border-radius:10px;" Class="divShadow" VerticalThreshold="170" FixedPlacement="true" HorizontalPosition="HorizontalPosition.Start" VerticalPosition="VerticalPosition.Bottom" AutoFocus="false" AnchorId="btnDownload2" @bind-Open="showDownloadMenu">
                        <Body>
                            <FluentStack Orientation="MsFluent.Orientation.Vertical" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center">
                                <FluentButton IconStart="@(new Icons.Filled.Size24.DocumentPdf().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight))"
                                                class="btnShadow"
                                                BackgroundColor="rgba(255,0,0,0.4)"
                                                Style="height:40px; width:80%; border:1px solid white"
                                                Color="rgba(255,255,255,1)"
                                                OnClick="ExportToPdf">
                                    <strong>PDF</strong>
                                </FluentButton>
                                <FluentButton IconStart="@(new Icons.Filled.Size24.Globe().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight))"
                                                BackgroundColor="rgba(0,0,0,1)"
                                                class="btnShadow"
                                                Style="height:40px; width:80%; border:1px solid white"
                                                Color="rgba(255,255,255,1)"
                                                OnClick="ExportHtmlFile">
                                    <strong>HTML</strong>
                                </FluentButton>
                                <FluentButton IconStart="@(new Icons.Filled.Size24.Globe().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight))"
                                                BackgroundColor="rgba(0,0,0,1)"
                                                class="btnShadow"
                                                Style="height:40px; width:80%; border:1px solid white"
                                                Color="rgba(255,255,255,1)"
                                                OnClick="ExportToPulseMsg">
                                    <strong>PULSE MSG</strong>
                                </FluentButton>
                            </FluentStack>
                        </Body>
                    </FluentPopover>
                }
        </FluentStack>
    </div>
    <FluentMessageBarProvider Section="MESSAGES_TOP" />

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <FluentMessageBar Intent="@MessageIntent.Error">@errorMessage</FluentMessageBar>
    }
    <div class="aiContent" style="background-color: white">
        
        @if (viewBox)
        {
            <div class="aiSidebar">
                <Animation Effect="@Effect.FadeIn" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(0)">
                    <div class="aiBox">
                        <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center" style="background-color: var(--pulse-dark-t75-colour); border-bottom: 1px solid white; padding-left: 20px;padding-right: 20px;padding-top:10px;padding-bottom:10px;margin-bottom:5px;">
                            @* @if(flapper != null)
                            {
                                 @(flapper.emoji.ToMarkup("64px")) 
                            }  *@
                            <img src="Images/AI/Flapper.png" style="width:96px;height:96px" />
                            @if (showTables)
                            {
                                <Animation Effect="@Effect.FadeIn" Speed="Speed.Fast" Enabled="@showTables" Delay="@TimeSpan.FromSeconds(0)">
                                    <img src="Images/AI/Tables.png" style="width:96px;height:96px" />
                                </Animation>
                            }
                            <FluentSpacer />
                            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Right" VerticalAlignment="VerticalAlignment.Center">
                                <FluentLabel Typo="Typography.H4" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="rgba(255, 255, 255, 1)">FLAPPER</FluentLabel>
                                <FluentLabel Typo="Typography.Body" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="rgba(255, 255, 255, 1)">@(!ViewSettings ? "Conversation" : "Settings")</FluentLabel>
                            </FluentStack>
                        </FluentStack>
                        @* @if (showTables)
                        {
                            <Animation Effect="@Effect.FlipInX" Speed="Speed.Fast" Enabled="@showTables" Delay="@TimeSpan.FromSeconds(0)">
                                 <div class="aiAssistBox">
                                    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center" style="background-color: var(--pulse-dark-t75-colour);padding-left: 20px;padding-right: 20px;padding-top:10px;padding-bottom:10px;">
                                        <img src="Images/AI/Tables.png" style="width:96px;height:96px" />
                                         <FluentSpacer />
