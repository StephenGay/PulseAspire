    private async Task ExportToPulseMsg()
    {

        if (Messages is null)
        {
            return;
        }

        try
        {
            showDownloadMenu = false;
            pdfLoading = true;
            string cnt = $"<div style=\"width:100%\">";

            if (!ViewAll)
            {
                cnt += $"<hr><p><strong>USER</strong>: {userQry}</p><hr>{flapperAnswer}";
                if (stream) { cnt += $"<hr><p><i>{flapperThinking}</i></p><hr>"; }
            }
            else
            {
                foreach (var message in Messages)
                {
                    if (message.Sender != "User")
                    {
                        cnt += @message.Content;
                    }
                    else
                    {
                        cnt += $"<hr><p><strong>USER: </strong>: " + @message.Content + "</p><hr>";
                    }
                }
            }
            cnt += "</div>";
            // cnt = await HtmlCapture.CaptureForExportAsync(chatContainer);
            var subject = "ChatLog" + DateTime.Now.ToShortDateString();
            var msg = new PulseMessage()
                {
                    SenderUserName = "Flapper",
                    RecipientUserId = _authService.aspireUserId,
                    RecipientUserName = _authService.aspireFullName,
                    Role = "PulseAI",
                    ContentType = "MARKUP",
                    Content = cnt,
                    Subject = subject
                };
            await GlobalFunctions.ExportToPulseMsg(msg);

        }
        catch (Exception ex)
        {
            return;
        }
        finally
        {
            pdfLoading = false;
        }
    }

