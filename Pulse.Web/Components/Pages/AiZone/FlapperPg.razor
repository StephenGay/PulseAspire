                                </div> 
                            </Animation>
                        } *@
                            @if (!ViewSettings)
                            {
                                @* <StackItem > *@
                                    @* @if (IsAwaitingClarification && CurrentClarificationQuestion is not null)
                                    {
                                        <div style="padding: 16px; background-color: var(--neutral-layer-2); border-top: 2px solid var(--accent-fill-rest);">
                                            <p><strong>Flapper asks:</strong></p><p>@CurrentClarificationQuestion</p>
            
                                            <FluentStack Orientation="MsFluent.Orientation.Horizontal" >
