    /// <summary>
    /// Streams chat chunks with proper error handling.
    /// </summary>
    private static string NormaliseToolNamev3(string? toolName)
    {
        if (string.IsNullOrEmpty(toolName))
            return "unknown";

        var normalized = toolName.ToLowerInvariant().Trim();
        return ToolNames.All.FirstOrDefault(t => normalized.Contains(t)) ?? normalized;
    }

    /// <summary>
    /// Processes tool calls with error handling.
    /// </summary>
    private async Task<string?> ProcessToolCallsAsync(
    List<OllamaToolCall> toolCalls,
    QueryContext context,  // ← Add QueryContext parameter
    CancellationToken ct)
    {
        try
        {
            foreach (var toolCall in toolCalls)
            {
                string toolName = NormaliseToolNamev3(toolCall.Function?.Name);

                if (!ToolNames.All.Contains(toolName))
                {
                    currMsgs.Add(new OllamaMessage
                    {
                        Role = "tool",
                        Content = $"Invalid tool '{toolName}'. Available: {string.Join(", ", ToolNames.All)}",
                        ToolName = toolName
                    });
                    continue;
                }

                if (!context.ShouldRetryTool(toolName, flapper.MaxToolRetries))
                {
                    currMsgs.Add(new OllamaMessage
                    {
                        Role = "tool",
                        Content = $"Tool '{toolName}' exceeded maximum retry attempts.",
                        ToolName = toolName
                    });
                    continue;
                }

                flapperThinking += $"\n🔧 Executing: {toolName}...\n";
                StateHasChanged();
                await Task.Delay(5, ct);

                // ✅ Pass QueryContext to ExecuteToolAsync
                var toolResult = await ExecuteToolAsyncv3(
                    toolName, 
                    toolCall.Function?.Arguments ?? default, 
                    context,  // ← Pass context!
                    ct);

                currMsgs.Add(new OllamaMessage
                {
                    Role = "tool",
                    Content = toolResult,
                    ToolName = toolName
                });

                flapperThinking += $"✓ {toolName} completed.\n";
                StateHasChanged();
                await Task.Delay(5, ct);
            }

            return null;
        }
        catch (OperationCanceledException)
        {
            return "Request cancelled.";
        }
        catch (Exception ex)
        {
            return $"{ex.Message}";
        }
    }

    private async Task<string> ExecuteToolAsyncv3(string toolName, JsonElement args, QueryContext context, CancellationToken ct)
    {
        try
        {
            return toolName switch
            {
                ToolNames.AskTables => await AskTablesAsync(args, context, ct),
                ToolNames.WebSearch => await WebSearchAsync(args, context, ct),
                ToolNames.WebFetch => await WebFetchAsync(args, context, ct),
                ToolNames.ExecuteActionSql => await ExecuteActionSqlToolAsync(args, context, ct),
                _ => $"Unknown tool: {toolName}"
            };
        }
        catch (Exception ex)
        {
            // _logger.LogError(ex, "Tool {Tool} failed", toolName);
            return $"Tool error: {ex.Message}";
        }
    }

    private async Task<string> AskTablesAsync(JsonElement args, QueryContext context, CancellationToken ct)
    {
        if (!args.TryGetProperty("query", out var queryProp))
            return "Error: Missing 'query' argument";

        var query = queryProp.GetString()?.Trim();
        if (string.IsNullOrEmpty(query))
            return "Error: Query is empty";


        // _logger.LogInformation("Asking Tables: {Query}", query[..Math.Min(100, query.Length)]);

        try
        {
            Tables tbl = await dtrf.GetgvTables();

            var req = new PulseAiRequest
                {
                    UserId = "Flapper",
                    UserEmail = "flapper@pulseai.ste",
                    ModelName = tbl.Model,
                    AiName = AiName.Tables,
                    UserRequest = new OllamaChatMessage
                    {
                        Role = "user",
                        Content = query
                    }
                };

            var response = await pulseApiClient.PostAsync<PulseAiRequest, ApiResponse<List<Dictionary<string, object>>>>(ApiEndpoints.PulseAi.EndpointsTables.SendRequest, req, ct);


            // Check for HTTP errors
            if (!response.Success)
            {
                var errorContent = response.Message;
                // _logger.LogError("SQL execution returned {StatusCode}: {Error}", response.StatusCode, errorContent[..Math.Min(200, errorContent.Length)]);
                return $"❌ __SQL_ERROR__ ❌\n\n" +
                   $"**User asked**: {context.OriginalUserQuery}\n\n" +
                   $"**Error**: {errorContent}\n\n" +
                   $"Rephrase your query and try again, OR use web_search if the query cannot be fixed.";
            }

            JsonSerializerOptions _jsonOptions = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
                DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
            };
            var result = response.Data;
            

            // ✅ Check if result is empty (no data found)
            if (result == null || !result.Any())
            {
                // _logger.LogWarning("SQL query returned no results");
                return $"⚠️ __SQL_NO_RESULTS__ ⚠️\n\n" +
                   $"**User asked**: {context.OriginalUserQuery}\n\n" +
                   $"**SQL query executed successfully but returned NO DATA from the database**\n\n" +
                   $"This means the requested data does not exist in our database.\n\n" +
                   $"You MUST now use web_search to find this information externally.";
            }

            //return result;
            // ✅ Include user query context in successful SQL results
            return $"**User asked**: {context.OriginalUserQuery}\n\n" +
                   $"**Data from database**:\n{JsonSerializer.Serialize(result, _jsonOptions)}";
        }
        catch (HttpRequestException ex)
        {
            // _logger.LogError(ex, "SQL execution failed with HTTP error");
            return $"__SQL_ERROR__\n\n**User asked**: {context.OriginalUserQuery}\n\n" +
                   $"Database connection failed: {ex.Message}";
        }
        catch (Exception ex)
        {
            // _logger.LogError(ex, "SQL execution failed");
            return $"__SQL_ERROR__\n\n**User asked**: {context.OriginalUserQuery}\n\n" +
                   $"SQL error: {ex.Message}";
        }
    }

