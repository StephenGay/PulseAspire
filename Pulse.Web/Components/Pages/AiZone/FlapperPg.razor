    private async Task SpeakIncremental(string newDelta)
    {

        _answerBuilder.Append(newDelta);

        string full = _answerBuilder.ToString();

        // Find last complete sentence end
        int boundary = full.LastIndexOfAny(new[] { '!', '?', '\n' });

        if (boundary < _lastSpokenCharIndex) return; // nothing new to speak

        string toSpeak = full.Substring(_lastSpokenCharIndex, boundary - _lastSpokenCharIndex + 1).Trim();

        if (string.IsNullOrWhiteSpace(toSpeak)) return;

        _isSpeaking = true;
        await InvokeAsync(StateHasChanged);

        await GlobalAI.AISpeak(toSpeak, "Flapper");

        _lastSpokenCharIndex = boundary + 1;

        // If very long chunk without punctuation → force speak every ~250 chars
        if (full.Length - _lastSpokenCharIndex > 300)
        {
            string chunk = full.Substring(_lastSpokenCharIndex, 300);
            chunk = PrepareForSpeech(chunk);
            await GlobalAI.AISpeak(chunk, "Flapper");
            _lastSpokenCharIndex += 300;
        }

        _isSpeaking = false;
        await InvokeAsync(StateHasChanged);
    }
    private int GetLastRealSentenceBoundary(string text)
    {
        // Look for .!? followed by space or end
        var match = System.Text.RegularExpressions.Regex.Match(
            text,
            @"[.!?](?=\s|$)",
            System.Text.RegularExpressions.RegexOptions.RightToLeft);

        return match.Success ? match.Index : -1;
    }
    private string PrepareForSpeech(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return text;

        text = text
            .Replace("\n\n", "\n")           // reduce big gaps
            .Replace("  ", " ")              // collapse spaces
            .Replace("*", "")                // remove asterisks
            .Replace("**", "")
            .Replace("```", "")
            .Replace("`", "")
            .Replace("# ", "")               // remove markdown headings
            .Replace("### ", "")
            .Replace("## ", "")
            .Replace("#### ", "")
            .Trim();

        // Optional: make it even more spoken
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\b(SQL|query|table|column)\b", match =>
            match.Value.ToLower()); // or rephrase specific terms if needed

        return text;
    }

