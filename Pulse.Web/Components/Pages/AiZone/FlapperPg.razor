    private string FlapperParseToHtml(string markdownContent)
    {
        if (string.IsNullOrEmpty(markdownContent))
        {
            return string.Empty;
        }
        var pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
        var html = Markdig.Markdown.ToHtml(markdownContent, pipeline);

        html = System.Text.RegularExpressions.Regex.Replace(
            html,
            @"<a\s+href=""([^""]*)""",
            @"<a href=""$1"" target=""_blank"" rel=""noopener noreferrer"""
        );
        // ✅ Add image styling and responsive sizing
        html = System.Text.RegularExpressions.Regex.Replace(
            html,
            @"<img\s+src=""([^""]*)""\s+alt=""([^""]*)""",
            @"<img src=""$1"" alt=""$2"" class=""flapper-response-image"" style=""max-width: 25%; height: auto; border-radius: 8px; margin: 10px 0; box-shadow: 0 2px 8px rgba(0,0,0,0.5);"""
        );
        return html;
    }

