    private FlapperAvatar.FlapperEmotion DetectSimpleEmotion(string text)
    {
        text = text.ToLower();
        if (text.Contains("great") || text.Contains("happy") || text.Contains("love") || text.Contains("excellent"))
            return FlapperAvatar.FlapperEmotion.Happy;

        if (text.Contains("hmm") || text.Contains("thinking") || text.Contains("let me") || text.Contains("checking"))
            return FlapperAvatar.FlapperEmotion.Thinking;

        if (text.Contains("wow") || text.Contains("really") || text.Contains("?"))
            return FlapperAvatar.FlapperEmotion.Surprised;

        return FlapperAvatar.FlapperEmotion.Neutral;
    }
