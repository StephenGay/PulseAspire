                                            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center" Width="100%" Style="margin-right:20px;">

                                                <FluentProgress Indeterminate="true" Width="75%" Style="margin:10px" />
                                                <FluentButton Class="btnShadow" BackgroundColor="red" IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size28.RecordStop().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight))" Style="height:100%;margin-top: 10px; margin-bottom: 10px;" OnClick="@CancelQuery"> </FluentButton>
                                            </FluentStack>
                                        </FluentStack>
                                    }
                                    else
                                    {
                                    @if (!IsAwaitingClarification)
                                    {
                                    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Start" VerticalAlignment="VerticalAlignment.Center" style="padding-left: 20px;padding-right: 20px;margin-top:5px;margin-bottom:5px;">
                                            <FluentSpacer />
                                        </FluentStack>
                                        <FluentTextArea rows="10" style="border: 1px solid var(--pulse-dark-colour); margin-top: 0px;margin-left: 10px;margin-right: 10px;margin-bottom:20px;width: calc(100% - 20px)" @bind-Value="CurrentUserMessage" PlaceHolder="What would you like to know?..." />
                                        <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Right" VerticalAlignment="VerticalAlignment.Center" style="padding-left: 20px;padding-right: 20px;margin-top:5px;margin-bottom:20px;">
                                            @if (this._isListening)
                                            {
                                                <Animation Effect="@Effect.FadeIn" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(0)">
                                                    <FluentButton class="myModeBtnOn" BackgroundColor="var(--pulse-mode-btn-bg)" Title="Turn Off Microphone" IconStart="@(new Icons.Filled.Size24.MicOff().WithColor("var(--pulse-mode-btn-item-colour)"))" style="height:50px;width:50px" OnClick="OnClickStop"></FluentButton>
                                                </Animation>
                                            }
                                            else
                                            {
                                                <Animation Effect="@Effect.FadeIn" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(0)">
                                                    <FluentButton class="myModeBtnOff" BackgroundColor="var(--pulse-mode-btn-bg)" Title="Turn On Microphone" IconStart="@(new Icons.Filled.Size24.Mic().WithColor("var(--pulse-mode-btn-item-colour)"))" style="height:50px;width:50px" OnClick="StartRecClick"></FluentButton>
