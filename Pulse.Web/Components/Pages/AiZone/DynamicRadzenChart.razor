@using Pulse.Models.AI
@using Pulse.Models.AI.Tools
@using Radzen.Blazor

<RadzenChart Style="height: 420px; width: 100%;" @ref="_chart">
    <RadzenChartTitle Text="@Config.Title" />

    @if (Config.ChartType.Equals("Bar", StringComparison.OrdinalIgnoreCase))
    {
        @foreach (var series in Config.Series ?? new List<ChartSeriesConfig>())
        {
            <RadzenBarSeries Data="@series.Data" 
                             CategoryProperty="Label" 
                             ValueProperty="Value" 
                             Title="@series.Name" />
        }
    }
    else if (Config.ChartType.Equals("Column", StringComparison.OrdinalIgnoreCase))
    {
        @foreach (var series in Config.Series ?? new List<ChartSeriesConfig>())
        {
            <RadzenColumnSeries Data="@series.Data"
                             CategoryProperty="Label"
                             ValueProperty="Value"
                             Title="@series.Name" />
        }
    }
    else if (Config.ChartType.Equals("Line", StringComparison.OrdinalIgnoreCase))
    {
        @foreach (var series in Config.Series ?? new List<ChartSeriesConfig>())
        {
            <RadzenLineSeries Data="@series.Data" 
                              CategoryProperty="Label" 
                              ValueProperty="Value" 
                              Title="@series.Name" />
        }
    }
    else if (Config.ChartType.Equals("Pie", StringComparison.OrdinalIgnoreCase) || 
             Config.ChartType.Equals("Doughnut", StringComparison.OrdinalIgnoreCase))
    {
        <RadzenPieSeries Data="@(Config.Series?.FirstOrDefault()?.Data ?? new())" 
                         CategoryProperty="Label" 
                         ValueProperty="Value" />
    }

    <!-- Correct way to set axis titles in Radzen -->
    <RadzenCategoryAxis>
        <RadzenAxisTitle Text="@(Config.XAxisTitle ?? "")" />
    </RadzenCategoryAxis>

    <RadzenValueAxis>
        <RadzenAxisTitle Text="@(Config.YAxisTitle ?? "")" />
    </RadzenValueAxis>
</RadzenChart>

@if (!string.IsNullOrWhiteSpace(Config.FooterNote))
{
    <div class="text-muted small mt-2">@Config.FooterNote</div>
}

@code {
    [Parameter, EditorRequired] 
    public ChartConfig Config { get; set; } = new();

    private RadzenChart? _chart;

    // public async Task ExportAsPng() => await (_chart?.Export("png") ?? Task.CompletedTask);
}