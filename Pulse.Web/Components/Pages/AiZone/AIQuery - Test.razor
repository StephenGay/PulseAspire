@page "/AiZone/AIQueryTest"
@using MudBlazor
@using Pulse.Web.Services
@using System.Data
@inject Pulse_AI pAI
@* @inject OllamaService ollama *@
@inject PulseApiService pulseApiClient 
@rendermode InteractiveServer

@* <h3 class="h3-overide">AI Roller Query</h3> *@

<InputSelect @bind-Value="aiModel">
    <option value="llama3.1:latest">llama3.1 (7b)</option>
    <option value="gemma3:27b">gemma3 (27b)</option>
    <option value="sqlcoder:15b">sqlcoder (15b)</option>
</InputSelect>

<MudText>@aiModel</MudText>

<MudTextField @bind-Value="query" Label="Enter your question" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Send" OnAdornmentClick="SubmitQuery" Immediate="true" Style="background-color: #FFFFFF !important;" />

@if (!string.IsNullOrEmpty(strReasoning))
{
    <MudAlert Severity="Severity.Info">@strReasoning</MudAlert>
}

@if (!string.IsNullOrEmpty(strResponse))
{
    <MudAlert Severity="Severity.Info">@strResponse</MudAlert>
}

@if (rows.Any())
{
    @* <div style="overflow-x: auto; max-width: 100%;">
        <MudTable Items="@rows" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
            
                @foreach (var column in columns)
                {
                    <MudTh>@column</MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                @foreach (var column in columns)
                {
                    <MudTd DataLabel="@column">@context[column]?.ToString()</MudTd>
                    // Handles nulls gracefully
                }
            </RowTemplate>
             <PagerContent>
                
                 <MudTablePager PageSizeOptions="new int[] { 5, 10, 25, 50 }" />  
             </PagerContent> 
        </MudTable>
    </div> *@
}
else if (isLoading)
{
    <MudProgressCircular Color="Color.Info" Indeterminate="true" />
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
}

@code {
    private string query = string.Empty;
    private List<string> columns = new();
    private List<Dictionary<string,object>> rows = new();
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private string aiSQL = string.Empty;
    private string aiSQLv = string.Empty;
    private string strReasoning = string.Empty;
    private string strResponse = string.Empty;
    private string aiModel = "llama3.1:latest";
    //private string aiModel = "gemma3:27b";
    // private MudTable<Dictionary<string, object>> table;

    private async Task SubmitQuery()
    {
        if (string.IsNullOrWhiteSpace(query)) return;

        isLoading = true;
        errorMessage = string.Empty;
        strResponse = string.Empty;
        aiSQL = string.Empty;
        columns.Clear();
        rows.Clear();

        try
        {
            // Call Ollama to process the natural language query
            var aiSQLv = await pAI.GetSQLFromOllamaAsync(query);

            // var reason = aiSQLv.IndexOf("### Reasoning:");
            // var resp = aiSQLv.IndexOf("### Response:");
            // if(reason > -1)
            // {
            //     if(resp > reason)
            //     {
            //         strReasoning = aiSQLv.Substring(reason + 15, resp - (reason + 15));
            //     }   
            // }
            // if(resp > -1)
            // {
            //     strResponse = aiSQLv.Substring(resp + 14);
            //     if (strResponse.StartsWith("Generated SQL: ``` SELECT"))
            //     {
            //         strResponse = strResponse.Substring(19);
            //         var endResp = strResponse.IndexOf(" ``` ");
            //         if(endResp > -1)
            //         {
            //             strResponse = strResponse.Substring(0, endResp);
            //         }
            //     }
            //     else { resp = -1; }
            // }

            // if(resp==-1)
            // {
            //     errorMessage = $"AI did not return a valid SQL query:\n {aiSQLv}";
            //     return;
            // }
            if(!aiSQLv.StartsWith("Generated SQL: "))
            {
                errorMessage = "AI did not generate a valid SQL Statement.";
                return;
            }
            strResponse = aiSQLv.Replace("Generated SQL: ", "");
            var aiResponse = await pulseApiClient.GetAsync<List<Dictionary<string, object>>>($"/AI/execute:{strResponse}");
            if(aiResponse == null)
            {
                errorMessage = "No response from AI execution.";
                return;
            }
            rows = aiResponse;
            if (rows.Any())
            {
                columns = rows.First().Keys.ToList();
            }
            // StateHasChanged();

        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing query: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Example helper methods (implement based on your models)
    private async Task<List<RollerResult>> GetDataFromDbAsync(string filter)
    {
        // Translate filter to LINQ, e.g., DbContext.Rollers.Where(r => r.CoveringType == "Rubber" && ...).ToListAsync();
        return new List<RollerResult>(); // Populate with actual data
    }

    // Define a result model for the table
    private class RollerResult
    {
        public int RollerId { get; set; }
        public string CoveringType { get; set; } // "Rubber" or "Polyurethane"
        public DateTime LastRecoveryDate { get; set; }
        public DateTime? PredictedRecoveryDate { get; set; }
        public string Suggestions { get; set; } // e.g., "Merge with Roller 456 (duplicate entry)"
    }

    // Placeholder for parsed AI response
    private class AIParsedResponse
    {
        public string Action { get; set; }
        public string SqlFilter { get; set; }
        public object Data { get; set; } // Or specific types
        // etc.
    }
}