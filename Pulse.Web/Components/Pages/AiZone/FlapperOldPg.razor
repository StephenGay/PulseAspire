    /// <summary>
    /// Prepares context for streaming chat - handles exceptions safely.
    /// </summary>
    private async Task<(string? Schema, string? Examples, string? Error)> PrepareStreamContextAsync(CancellationToken ct)
    {
        try
        {
            var schemaText = await pAI.GetDetailedSchemaAsync(ct);
            if (string.IsNullOrEmpty(schemaText))
            {
                return (null, null, "Error: Unable to retrieve database schema information.");
            }

            var examples = await pAI.GetAiExamplesAsync(ct);
            return (schemaText, examples, null);
        }
        catch (OperationCanceledException)
        {
            return (null, null, "Request cancelled.");
        }
        catch (Exception ex)
        {
            return (null, null, $"Error during setup: {ex.Message}");
        }
    }

    /// <summary>
    /// Streams chat chunks with proper error handling.
    /// </summary>
    private async IAsyncEnumerable<string> StreamChatWithFlapperAsync(
        List<OllamaMessage> historyMessages,
        bool enableSearch = true,
        [EnumeratorCancellation] CancellationToken ct = default,
        int qryLoop = 0,
        bool inThinking = false,
        int failedAttempts = 0)
    {
        flapper = await dtrf.GetgvFlapper();
        if (flapper == null)
        {
            yield return "Error: Flapper configuration not available";
            yield break;
        }

        // ⚠️ PREVENT INFINITE LOOPS
        // int MAX_RECURSION_DEPTH = 6;
        // int MAX_FAILED_ATTEMPTS = 2;

        if (!AdminMode && qryLoop >= flapper.MaxRecursionDepth) // MAX_RECURSION_DEPTH)
        {
            yield return $"\n\n⚠️ **Maximum recursion depth reached ({flapper.MaxRecursionDepth})**. " +
                        "The conversation loop is too deep. Please start a new query.";
            yield break;
        }

        if (!AdminMode && failedAttempts >= flapper.MaxFailedAttempts) // MAX_FAILED_ATTEMPTS)
        {
            yield return $"\n\n❌ **Too many failed attempts ({flapper.MaxFailedAttempts})**. " +
                        "The system is unable to execute your request. Please rephrase or try a different query.";
            yield break;
        }

        // Prepare context - errors handled inside, returns tuple
        var prepResult = await pAI.PrepareStreamContextAsync(ct);
        if (prepResult.Error != null)
        {
            yield return prepResult.Error;
            yield break;
        }



        string inAdmin = AdminMode
            ? """
              **Admin Mode**
              You are in a special mode available to administrators. You can now do the following:
              - You can add further assistance and offer to write results back to the database.
              - This mode removes the limitation of only being able to create SELECT SQL Statements
              - An additional tool 'execute_action_sql' is available to run any SQL Statements that are not SELECT Statements
              - Only offer this if relevant
              """
            : string.Empty;

        // var systemMessage = BuildFlapperSystemMessage(
        //     historyMessages,
        //     prepResult.Schema!,
        //     prepResult.Examples!,
        //     inAdmin,
        //     qryLoop);  // ← Pass recursion level

        var messages = new List<OllamaMessage>();

        // Only add system message on first call (qryLoop == 0)
        if (qryLoop == 0)
        {
            var systemMessage = BuildFlapperSystemMessage(
                historyMessages,
                prepResult.Schema!,
                prepResult.Examples!,
                inAdmin,
                qryLoop);
            messages.Add(systemMessage);
        }

        // Always add full history on recursive calls (it includes previous system message effects)
        messages.AddRange(historyMessages);

        var tools = BuildFlapperTools(enableSearch);

        var ollamaRequest = new
        {
            model = flapper!.Model,
            messages = messages.ToArray(),
            tools = tools.ToArray(),
            think = flapper.Think,
            keep_alive = "30m",
            stream = true,
            options = new
            {
                temperature = flapper.Options.Temperature,
                num_ctx = flapper.Options.NumCtx,
                repeat_penalty = flapper.Options.RepeatPenalty,
                frequency_penalty = flapper.Options.FrequencyPenalty,
                presence_penalty = flapper.Options.PresencePenalty
            }
        };

        var accumulatedMessage = new OllamaMessage { Role = "assistant" };
        bool hasYieldedContent = false;
        string? pendingError = null;

        // Get the stream - handle initialization errors
        HttpResponseMessage? response = null;
        try
        {
            response = await ollamaClient!.PostAsJsonAsync("/api/chat", ollamaRequest, ct);
            response.EnsureSuccessStatusCode();
        }
        catch (OperationCanceledException)
        {
            pendingError = "Request cancelled.";
        }
        catch (Exception ex)
        {
            pendingError = $"Error connecting to Ollama: {ex.Message}";
        }

        // Yield initialization error outside catch
        if (pendingError != null)
        {
            yield return pendingError;
            yield break;
        }

        Stream? contentStream = null;
        try
        {
            contentStream = await response.Content.ReadAsStreamAsync(ct);
        }
        catch (Exception ex)
        {
            pendingError = $"Error reading response: {ex.Message}";
        }

        if (pendingError != null)
        {
            yield return pendingError;
            yield break;
        }

        using var reader = new StreamReader(contentStream!);

        // Process stream line by line
        while (true)
        {
            string? line = null;
            bool readerDone = false;

            try
            {
                line = await reader.ReadLineAsync(ct);
                readerDone = line == null;
            }
            catch (OperationCanceledException)
            {
                pendingError = "Request cancelled.";
                break;
            }
            catch (Exception ex)
            {
                pendingError = $"Stream error: {ex.Message}";
                break;
            }

            if (readerDone) break;
            if (string.IsNullOrWhiteSpace(line)) continue;

            OllamaChatChunk? chunk = null;
            try
            {
                chunk = JsonSerializer.Deserialize<OllamaChatChunk>(line, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            }
            catch (JsonException ex)
            {
                pendingError = $"Failed to parse response: {ex.Message}";
                break;
            }

            if (chunk == null) continue;

            // Handle thinking content
            if (!string.IsNullOrEmpty(chunk.Message?.Thinking))
            {
                if (!inThinking)
                {
                    inThinking = true;
                    yield return "__THINKING__Thinking:\n";
                }
                hasYieldedContent = true;

                // ✅ Yield thinking chunk as-is (chunks are already good sizes from Ollama)
                // Don't split by sentences/paragraphs - chunks may break mid-word, destroying formatting
                yield return $"__THINKING__{chunk.Message.Thinking}";
                // Small delay to let UI render between chunks
                await Task.Delay(5, ct);
            }

            // Handle answer content
            if (!string.IsNullOrEmpty(chunk.Message?.Content))
            {
                if (inThinking)
                {
                    inThinking = false;
                    yield return "__FINAL_ANSWER__Answer:\n";
                }
                hasYieldedContent = true;
                yield return $"__FINAL_ANSWER__{chunk.Message.Content}";
            }

            // Accumulate tool calls
            if (chunk.Message?.ToolCalls != null)
            {
                accumulatedMessage.ToolCalls ??= new List<OllamaToolCall>();
                accumulatedMessage.ToolCalls.AddRange(chunk.Message.ToolCalls);
            }

            // Only break when Done=true, regardless of content type
            // Ollama sends thinking first, then content, both with Done=false except the last chunk
            if (chunk.Done)
            {
                if (accumulatedMessage.ToolCalls is { Count: > 0 })
                {
                    if (!hasYieldedContent)
                    {
                        yield return "<thinking>Analyzing query and preparing tools...</thinking>\n";
                    }
                    else
                    {
                        yield return "\n<thinking>Tool calls detected. Processing...</thinking>\n";
                    }

                    // Process tool calls
                    var toolError = await ProcessToolCallsAsync(accumulatedMessage.ToolCalls, messages, ct);
                    if (toolError != null)
                    {
                        yield return toolError;
                        // Increment failed attempts if tool processing failed
                        var newFailureCount = toolError.Contains("unable to execute") || toolError.Contains("error") 
                            ? failedAttempts + 1 
                            : failedAttempts;
                        yield break;
                    }

                    // Recursive call for tool results
                    await foreach (var recursiveChunk in StreamChatWithFlapperAsync(
                        messages, enableSearch, ct, qryLoop + 1, inThinking, failedAttempts))
                    {
                        yield return recursiveChunk;
                    }
                }
                break;
            }
        }

        // Yield any pending error outside the loop
        if (pendingError != null)
        {
            yield return pendingError;
            yield break;
        }

        if (!hasYieldedContent && accumulatedMessage.ToolCalls is not { Count: > 0 })
        {
            yield return "No response from Ollama.";
        }

        // ✅ DON'T yield final accumulated answer here!
        // We already yielded individual chunks, so accumulating and yielding the whole thing causes duplication
    }

    /// <summary>
    /// Processes tool calls with error handling.
    /// </summary>
    private async Task<string?> ProcessToolCallsAsync(
        List<OllamaToolCall> toolCalls,
        List<OllamaMessage> messages,
        CancellationToken ct)
    {
        try
        {
            var context = new QueryContext();
            foreach (var toolCall in toolCalls)
            {
                var toolName = toolCall.Function?.Name ?? "unknown";
                strResponse += $"\n\nInvoking tool: {toolName}...";
                StateHasChanged();

                await pAI.HandleToolCallsAsync(
                    [toolCall],
                    messages,
                    context,
                    ct);

                strResponse += $"complete.\n\n";
                StateHasChanged();
            }
            return null;
        }
        catch (OperationCanceledException)
        {
            return "Request cancelled.";
        }
        catch (Exception ex)
        {
            return $"Tool error: {ex.Message}";
        }
    }

