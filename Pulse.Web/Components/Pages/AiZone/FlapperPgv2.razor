@code {
    private string query = string.Empty;
    
    private bool isLoading = false;
    private bool togChat = false;
    private string txtQ = string.Empty;
    private bool togWebSearch = true;
    private bool showResults = false;
    private bool ChatMode = true;
    private bool startingChat = false;
    private string errorMessage = string.Empty;
    private string aiSQL = string.Empty;
    private string aiSQLv = string.Empty;
    private string strReasoning = string.Empty;
    private string strResponse = string.Empty;
    private string aiModel = "gpt-oss:latest";
    private ElementReference chatContainer;
    private bool useSpeechOutput = false;
    private SpeechSynthesisVoice? _voice;
    private User? user;
    private Flapper? flapper;
    // Dynamic models for select
    // private List<string>? ollamaModels = new();
    // Multi-turn chat history
    private List<OllamaMessage> chatHistory = new();
    private SpeechRecognitionResult[] _results = [];
    private bool _available = true;
    private bool _isListening = false;

    // Saved Queries state
    private bool isLoadingSaved = false;
    private string? uName;

    // FluentTextArea? txtQ;

    private async Task StartRecClick()
    {
        if (this._isListening) return;
        this._isListening = true;
        this._results = [];
        txtQ = string.Empty;
        await this.SpeechRecognition.StartAsync();
    }
   
    private async Task ExportToPdf()
    {
        if (chatHistory==null)
        {
            return;
        }

        try
        {
            string cnt = string.Empty;
            foreach (var message in chatHistory)
            {
                cnt += "<br />" + message.Role.ToUpper() + ":<br />" + @message.Content;
            }
            var client = HttpClientFactory.CreateClient("PulseApiClient"); // Named client from Aspire
            var fileName = "ChatLog" + DateTime.Now.ToShortDateString() + ".pdf";
            var request = new PdfRequest
            {
                Html = ParseToHtml(cnt),
                FileName = fileName,
            };

            var response = await client.PostAsJsonAsync("/Utilities/pdf/export", request);
            response.EnsureSuccessStatusCode();

            var pdfBytes = await response.Content.ReadAsByteArrayAsync();
            var base64 = Convert.ToBase64String(pdfBytes);
            // var retFileName = response.Content.Headers.ContentDisposition?.FileName?.Trim('"') ?? "analysis.pdf";

            await JSRuntime.InvokeVoidAsync("downloadPdfFile", fileName, base64);
            // await SendToast("Success", "Exported", $"PDF saved as {fileName}");
        }
        catch (Exception ex)
        {
            return;
        }
    }
    

    // private async Task SetQuestionFocus()
    // {
    //     try
    //     {
    //         txtQ!.FocusAsync();
    //     }
    //     catch(Exception ex)
    //     {
    //         return;
    //     }

    // }

    
    
    private async Task CancelQuery()
    {
        await pAI.CancelQueryAsync();
        isLoading = false;
    }

    
    private async Task ClearChatHistory()
    {
        chatHistory.Clear();
        strResponse = string.Empty;
        
        StateHasChanged();
    }
    private async Task SayIt(string text,string V = "User")
    {
        SpeechSynthesisVoice? vc;
        vc = _voice;
        if (V == "Flapper")
        {
            vc = flapper._Voice;
        }

        if (useSpeechOutput)
        {
            var utterancet = new SpeechSynthesisUtterance
            {
                Text = text.Replace("<br />", ""),
                Voice = vc
            };
            await this.SpeechSynthesis.SpeakAsync(utterancet);
        }
        // Microsoft Ava Online(Natural) - English(United States)(en - US)
    }
    protected override async Task OnInitializedAsync()
    {
        // ollamaModels = await pAI.GetOllamaModelsAsync();
        user = await dtrf.GetgvUser();
        uName = await dtrf.GetgvUserFirstName();
        
        useSpeechOutput = user.UserSettings.AIHasVoice;
        if (useSpeechOutput)
        {
            _voice = await dtrf.GetgvUserAIVoice();
        }
        // aiModel = ollamaModels.FirstOrDefault() ?? "llama3.1:latest"; // Default to first or fallback
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            flapper = await dtrf.GetgvFlapper();
            this._available = await this.SpeechRecognition.IsAvailableAsync();
            StateHasChanged();
        }
    }
    private void OnSpeechRecognized(object? sender, SpeechRecognitionEventArgs args)
    {
        this._results = args.Results?.Skip(args.ResultIndex).ToArray() ?? [];
        this.StateHasChanged();
    }
    private async Task OnClickStop()
    {
        if (!this._isListening) return;
        this._isListening = false;
        await this.SpeechRecognition.StopAsync();
    }
    private void OnSpeechEnded(object? sender, EventArgs args)
    {
        if (this._isListening)
        {
            this._isListening = false;
            this.StateHasChanged();
        }
    }

    private async Task SubmitQuery()
    {
        if (string.IsNullOrWhiteSpace(query)) return;

        isLoading = true;
        errorMessage = string.Empty;
        strResponse = string.Empty;
        strReasoning = string.Empty;
        aiSQL = string.Empty;

        try
        {
            // Call Ollama to process the natural language query
            using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(10));
            
                startingChat = false;
                // Add user message to history
            
                chatHistory.Add(new OllamaMessage { Role = "user", Content = query });

                // StateHasChanged();
                // await JSRuntime.InvokeVoidAsync("scrollToBottom", chatContainer);
                aiSQL = await pAI.ChatWithOllamaAsync(chatHistory, aiModel, togWebSearch, cts.Token);

                if (aiSQL.StartsWith("Error:"))
                {
                    // errorMessage = aiSQL;
                    chatHistory.Add(new OllamaMessage { Role = "assistant", Content = "I'm sorry, there was a problem responding to your question. Try again, reword the question or try another AI model..." });
                    await SayIt("I'm sorry, there was a problem responding to your question.", "Flapper");
                }
                else
                {
                    // Add assistant response to history
                    chatHistory.Add(new OllamaMessage { Role = "assistant", Content = aiSQL });
                    // StateHasChanged();
                    // await JSRuntime.InvokeVoidAsync("scrollToBottom", chatContainer);
                }
                query = string.Empty;
                isLoading = false;
                StateHasChanged();
                await JSRuntime.InvokeVoidAsync("scrollToBottom", chatContainer);
                return; 
            

        }
        catch (Exception ex)
        {
            errorMessage = ex.Message.Contains("timeout") ? "Ollama is taking too long—try simpler query or check local service." : $"Error: {ex.Message}";
        }
        finally
        {

            isLoading = false;
            // if (ChatMode) { await SetQuestionFocus(); }
        }
    }


    private string FormatMessageToHtml(string content) //, string role, string toolName)
    {
        if (string.IsNullOrEmpty(content)) return "";

        // Basic Markdown-like to HTML (customize for your needs)
        var html = content
            .Replace("\n", "<br>")
            .Replace("**", "<strong>")
            .Replace("`", "<code>")
            .Replace("```sql", "<pre><code>")
            .Replace("```", "</code></pre>")
            .Replace("* ", "<li>"); // Simple list support

        // Style based on role or tool
        // string style = role switch
        // {
        //     "user" => "color: navy;",
        //     "assistant" => "color: darkgreen;",
        //     "tool" => $"color: purple; font-style: italic;{(toolName == "web_search" ? " background-color: #f0f8ff;" : "")}",
        //     _ => ""
        // };

        // return $"<div style='{style}'>{html}</div>";
        return html;
    }

    private string ParseToHtml(string markdownContent)
    {
        var pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build(); // Customize extensions (e.g., syntax highlighting)
        return Markdig.Markdown.ToHtml(markdownContent, pipeline);
    }
}