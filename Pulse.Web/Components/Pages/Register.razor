@page "/register"
@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Models.Users
@using Pulse.Web.Components.Layout
@inject NavigationManager Navigation
@inject Pulse.Web.Services.PulseApiService pApi
@inject ILogger<Register> Logger
@rendermode InteractiveServer
@layout NoLayout

<div style="display: flex; justify-content: center; align-items: center; height: 100vh; background: linear-gradient(135deg, #365b66 0%, #bcd1d4 100%);">
    <FluentCard Style="width: 400px; padding: 30px;">
        <div style="text-align: center; margin-bottom: 24px;">
            <h2 style="margin: 0; color: #365b66;">Register</h2>
            <p style="color: #666; font-size: 14px;">Create a new account</p>
        </div>

        <FluentStack Orientation="Orientation.Vertical" Style="gap: 16px;">
            <FluentTextField @bind-Value="registerModel.Email"
                             Label="Email"
                             Type="InputType.Email"
                             Placeholder="you@example.com"
                             Required="true"
                             @oninput="@((ChangeEventArgs e) => { registerModel.Email = e.Value?.ToString() ?? string.Empty; ClearError(); })" />

            <FluentTextField @bind-Value="registerModel.FullName"
                             Label="Full Name"
                             Placeholder="John Doe"
                             @oninput="@((ChangeEventArgs e) => { registerModel.FullName = e.Value?.ToString() ?? string.Empty; ClearError(); })" />

            <FluentTextField @bind-Value="registerModel.UserName"
                             Label="Username (Optional)"
                             Placeholder="johndoe"
                             @oninput="@((ChangeEventArgs e) => { registerModel.UserName = e.Value?.ToString() ?? string.Empty; ClearError(); })" />

            <FluentTextField @bind-Value="registerModel.Password"
                             Label="Password"
                             Type="InputType.Password"
                             Placeholder="Min. 8 characters"
                             Required="true"
                             @oninput="@((ChangeEventArgs e) => { registerModel.Password = e.Value?.ToString() ?? string.Empty; ClearError(); })" />

            <FluentTextField @bind-Value="registerModel.ConfirmPassword"
                             Label="Confirm Password"
                             Type="InputType.Password"
                             Placeholder="Re-enter password"
                             Required="true"
                             @oninput="@((ChangeEventArgs e) => { registerModel.ConfirmPassword = e.Value?.ToString() ?? string.Empty; ClearError(); })" />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <FluentMessageBar Severity="MessageSeverity.Error"
                                  OnDismiss="() => errorMessage = string.Empty">
                    @errorMessage
                </FluentMessageBar>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <FluentMessageBar Severity="MessageSeverity.Success"
                                  OnDismiss="() => successMessage = string.Empty">
                    @successMessage
                </FluentMessageBar>
            }

            <FluentButton Appearance="Appearance.Accent"
                          @onclick="HandleRegister"
                          Disabled="@(isRegistering || !IsFormValid())"
                          Style="width: 100%;">
                @(isRegistering ? "Registering..." : "Register")
            </FluentButton>

            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 8px; justify-content: center;">
                <span style="font-size: 14px;">Already have an account?</span>
                <a href="/login" style="color: #365b66; text-decoration: none; font-weight: bold;">Login here</a>
            </FluentStack>
        </FluentStack>
    </FluentCard>
</div>

@code {
    private RegisterModel registerModel = new();
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isRegistering = false;

    private bool IsFormValid()
    {
        return !string.IsNullOrWhiteSpace(registerModel.Email) &&
               !string.IsNullOrWhiteSpace(registerModel.Password) &&
               !string.IsNullOrWhiteSpace(registerModel.ConfirmPassword) &&
               registerModel.Password == registerModel.ConfirmPassword &&
               registerModel.Password.Length >= 8;
    }

    private void ClearError()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private async Task HandleRegister()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        // Client-side validation
        if (!IsFormValid())
        {
            if (string.IsNullOrWhiteSpace(registerModel.Email))
                errorMessage = "Email is required.";
            else if (string.IsNullOrWhiteSpace(registerModel.Password))
                errorMessage = "Password is required.";
            else if (registerModel.Password.Length < 8)
                errorMessage = "Password must be at least 8 characters.";
            else if (registerModel.Password != registerModel.ConfirmPassword)
                errorMessage = "Passwords do not match.";
            return;
        }

        try
        {
            isRegistering = true;
            var response = await pApi.UserRegisterAsync(registerModel);

            if (response != null)
            {
                successMessage = "Registration successful! Redirecting to login...";
                await Task.Delay(2000);
                Navigation.NavigateTo("/login");
            }
            else
            {
                errorMessage = "Registration failed. Please try again.";
            }
        }
        catch (Pulse.Models.Api.PulseApiException ex)
        {
            Logger.LogError(ex, "API error during registration");
            errorMessage = ex.UserMessage ?? "An error occurred during registration.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error during registration");
            errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            isRegistering = false;
        }
    }
}