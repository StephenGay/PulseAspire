@page "/UserSettings/AISettings"
@using System.Globalization
@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Models.AI.AIds
@using Pulse.Models.Users
@using Pulse.Web.Services
@using Toolbelt.Blazor.SpeechSynthesis

@inject PulseApiService pApi
@inject SpeechSynthesis SpeechSynthesis
@inject DataTransferService dt

@rendermode InteractiveServer
<style>
    .cparent {
        display: flex;
        flex-direction: column; /* Stack children vertically */
        height: 100%; /* Or whatever height your parent should be, like 100% */
        width:100%;
    }

    .cheader, .cfooter {
        /* Fixed sizes; flexbox will respect these */
        min-height: 50px; /* Or min-height if you want flexibility */
        /* background: lightgray; */
    }

    .ccontent {
        flex: 1; /* This magic makes it grow to fill the space */
        background: white; /* rgba(255,255,255,0.3); */
        margin: 10px;
        padding: 10px;
        border-radius: 10px;
        overflow: auto;
    }
</style>

<div class="cparent">
<div class="ccontent">
    <FluentStack Orientation="Orientation.Horizontal" Style="flex: 0">
        <h3>AI Settings</h3><FluentSpacer /><FluentButton Appearance="Appearance.Accent" @onclick="onClickSave">Update</FluentButton>
    </FluentStack>
    <FluentButton Appearance="Appearance.Accent" OnClick="() => onTour=true">Meet The Gang</FluentButton>
        @if (!onTour)
        {
        @if(u != null)
    {
        
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="flex: 0">
            
                    <FluentDesignTheme @bind-Mode="@currentMode" 
                                       @bind-OfficeColor="@currentOfficeColor"
                                       @bind-CustomColor="@currentCustomColor"
                                        StorageName="themePulse" />

                    <FluentSelect Label="Theme"
                                  Width="250px"
                                  Items="@(Enum.GetValues<DesignThemeModes>())"
                                  @bind-SelectedOption="@currentMode" />
                    <FluentSelect Label="Color"
                          Items="@(Enum.GetValues<OfficeColor>().Select(i => (OfficeColor?)i))"
                          Height="200px"
                          Width="250px"
                                  @bind-SelectedOption="@currentOfficeColor" />
                    <FluentTextField @bind-Value="@currentCustomColor" Label="Custom Color (Hex)" />
                    
            <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" Style="width: 50%">
                <FluentCheckbox @bind-Value="@u.UserSettings.AIHasVoice" Label="Add A Voice To My AI" />
                <br />
                @* <FluentLabel Typo="Typography.Body">Select A Voice</FluentLabel> *@
                <FluentSelect Label="Choose A Voice" TOption="SpeechSynthesisVoice" Items="Voices" OptionValue="@(v => v.VoiceIdentity.ToString())"
                              Disabled="!u.UserSettings.AIHasVoice"
                              Appearance="Appearance.Outline"
                              OptionText="@(v => v.Name)"
                              Placeholder="Make A Selection..."
                              Height="500px"
                              @bind-SelectedOption="@_voice"
                              @bind-Value="@u.UserSettings.AIVoiceID"
                              
                              />
                              <FluentTextField @bind-Value="@speech"></FluentTextField>
                

                <FluentButton Appearance="Appearance.Accent" @onclick="onClickSpeak">Hear Voice</FluentButton>
                <FluentEmoji Value="@(new Emojis.PeopleBody.Color.MediumLight.Detective())" Width="256px" />
                <FluentEmoji Value="@(new Emojis.PeopleBody.Color.MediumLight.ManTechnologist())" Width="256px" />
                <FluentEmoji Value="@(new Emojis.PeopleBody.Color.MediumLight.WomanStudent())" Width="256px" />
            </FluentStack>
        
            <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" Style="width: 50%">
            <br />
            <FluentLabel Typo="Typography.Body">Select A Default Model</FluentLabel>
            <br />
            <div style="margin-bottom: 60px;">
  
                <FluentSlider Orientation="Orientation.Vertical" Min="0" Max="5" Step="1" @bind-Value=u.UserSettings.AIDefaultPref>
                    <FluentSliderLabel Position="0">Automatic</FluentSliderLabel>
                    <FluentSliderLabel Position="1">llama 3.1 (4.9GB)</FluentSliderLabel>
                    <FluentSliderLabel Position="2">Chat GPT (13GB) Low Reasoning</FluentSliderLabel>
                    <FluentSliderLabel Position="3">Chat GPT (13GB) Medium Reasoning</FluentSliderLabel>
                    <FluentSliderLabel Position="4">Chat GPT (13GB) High Reasoning</FluentSliderLabel>
                    <FluentSliderLabel Position="5">llama 3.3 (42GB)</FluentSliderLabel>
                </FluentSlider>
            </div>
        </FluentStack>   
        </FluentStack>
            }
        }
        else
        {
            <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center">
                <Animation Effect="@Effect.BounceInDown" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(0.5)" OnAnimationEnd="paiIntro">
                <FluentButton IconStart="@(new Icons.Filled.Size48.Bot().WithColor("#bcd1d4"))" BackgroundColor="rgba(0,0,0,0)"></FluentButton>
                </Animation>
                
            </FluentStack>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center">
                @if (shAli)
                {
                    <Animation Effect="@Effect.FlipInX" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(0.5)" OnAnimationEnd="aliIntro">
                        <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center">
                        @(ali.emoji.ToMarkup("128px"))
                        Ali
                        </FluentStack>
                    </Animation>
                }
                @if (shTbls)
                {
                    <Animation Effect="@Effect.FlipInX" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(0.5)" OnAnimationEnd="tablesIntro">
                        <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center">
                        @(tables.emoji.ToMarkup("128px"))
                        Tables
                        </FluentStack>
                    </Animation>
                }
                @if (shFlapper)
                {
                    <Animation Effect="@Effect.FlipInX" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(0.5)" OnAnimationEnd="flapperIntro">
                        <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center">
                        @(flapper.emoji.ToMarkup("128px"))
                        Flapper
                        </FluentStack>
                    </Animation>
                }
            </FluentStack>
            @if (tourIndx > 0)
            {
                <FluentButton Appearance="Appearance.Accent" OnClick="btnContinue">Continue >></FluentButton>
            }
        }
</div>      
</div>

@code 
{
    IEnumerable<SpeechSynthesisVoice> Voices;
    private SpeechSynthesisVoice? _voice;
    private string? selectedVoice;
    private bool onTour = false;
    private bool shAli = false;
    private bool shTbls = false;
    private bool shFlapper = false;
    private DesignThemeModes currentMode = DesignThemeModes.System;
    private OfficeColor? currentOfficeColor = OfficeColor.Default;
    private string? currentCustomColor;
    private Flapper? flapper;
    private Ali? ali;
    private Tables? tables;
    private int tourIndx = 0;
    private int? slVal;
    private User? u;
    private string? uName;
    private string? speech;
    private string logg = string.Empty;

    
    private void btnContinue()
    {
        switch (tourIndx)
        {
            case 1:
                shAli = true;
                break;
            case 2:
                shTbls = true;
                break;
            case 3:
                shFlapper = true;
                break;
        }
    }
    public async void paiIntro()
    {
        string i = $"Hey there {uName}, Welcome to Pulse";
        aiSpeak(i, _voice);
        i = "I am Pulse AI, your main assistant for this program. I have built a team of agents that have specialised abilities to aid you as you use Pulse Aspire. Let's meet them now.";
        //Task.Run(async () => { await aiSpeak(i, _voice); }).Wait();
        await aiSpeak(i, _voice);
        tourIndx++;
        StateHasChanged();

    }

    public async Task aliIntro()
    {
        string i = $"Hi, I am Ali";
        aiSpeak(i, ali._Voice);
        i = "I specialise in performing analysis on a specific subset of information. For instance, I can look for patterns in the activity of a client you are currently viewing, or forecast sales based on history.";
        aiSpeak(i, ali._Voice);
        tourIndx++;
    }
    public async Task tablesIntro()
    {
        string i = $"Hey, I am Tables";
        aiSpeak(i, tables._Voice);
        i = "I deal in nothing but data. I can fetch anything from the Pulse database, just tell me what you need. I will then give you a nice organised table you can view, save or download.";
        aiSpeak(i, tables._Voice);
        tourIndx++;
    }
    public async Task flapperIntro()
    {
        string i = $"And last but definately not least, I'm Flapper";
        aiSpeak(i, flapper._Voice);
        i = "Not to boast, but I am the most powerful. Have a full conversation with me, I can remember what topic we are discussing, have full access to the database as well as the web! I'm pretty awesome.";
        aiSpeak(i, flapper._Voice);
        tourIndx++;
    }
    protected override async Task OnInitializedAsync()
    {
        await dt.SetgvContextArea(0);
        flapper = await dt.GetgvFlapper();
        ali = await dt.GetgvAli();
        tables = await dt.GetgvTables();

        // u = await dt.GetgvUser();
        // if (u.UserSettings.AIHasVoice)
        // {
        //     _voice = await dt.GetgvUserAIVoice();
        //     StateHasChanged();
        // }

    }
    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            this.Voices = await this.SpeechSynthesis.GetVoicesAsync();
            u = await dt.GetgvUser();
            if (u.UserSettings.AIHasVoice)
            {
                _voice = await dt.GetgvUserAIVoice();
                // StateHasChanged();
            }
            uName = await dt.GetgvUserFirstName();
            this.StateHasChanged();
        }
    }
    private async Task onClickSave()
    {
        bool saved = await pApi.PutAsync<User>($"/user/{u.UserID}/UpdateSettings", u);
        await dt.SetgvUser(u);
        if(u.UserSettings.AIHasVoice && _voice != null)
        {
            await dt.SetgvUserAIVoice(_voice);
        }
    }
    async Task onClickSpeak()
    {
        var utterancet = new SpeechSynthesisUtterance
            {
                Text = speech, //"Hi there, it would be an honour, to be the voice behind your Pulse AI.",
                Voice = _voice // this.Voices.FirstOrDefault(v => v.Name.Contains("Haruka"))
            };
        await this.SpeechSynthesis.SpeakAsync(utterancet); // 👈 Speak with "Haruka"'s voice!
    }
    private async Task aiSpeak(string sTxt, SpeechSynthesisVoice v)
    {
        var utterancet = new SpeechSynthesisUtterance
        {
            Text = sTxt,
            Voice = v // this.Voices.FirstOrDefault(v => v.Name.Contains("Haruka"))
        };
        await this.SpeechSynthesis.SpeakAsync(utterancet); // 👈 Speak with "Haruka"'s voice!
        // Task.CompletedTask;
    }
}
