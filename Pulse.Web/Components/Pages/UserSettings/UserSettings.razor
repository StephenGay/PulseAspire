    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            this.Voices = await this.SpeechSynthesis.GetVoicesAsync();
            uSettings = await dt.GetgvUserSettings();
            pTheme = uSettings.UserTheme;
            if (uSettings.AIHasVoice)
            {
                _voice = await dt.GetgvUserAIVoice();
                // StateHasChanged();
            }
            // uName = await dt.GetgvUserFirstName();
            this.StateHasChanged();
        }
    }
    private async Task onClickSave()
    {
        bool themeChanged = uSettings.UserTheme != pTheme;
        uSettings.UserTheme = pTheme;
        bool saved = await pApi.PutAsync<ApplicationUserSettings>(ApiEndpoints.User.Settings.Update, uSettings);
        await dt.SetgvUserSettings(uSettings);

        if (uSettings.AIHasVoice && _voice != null)
        {
            await dt.SetgvUserAIVoice(_voice);
        }
        if (themeChanged)
        {
            await AppState.NotifyThemeChanged();
        }
    }
