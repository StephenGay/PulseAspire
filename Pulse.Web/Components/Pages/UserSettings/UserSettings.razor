@page "/UserSettings/UserSettingsPg"
@using System.Globalization
@using DocumentFormat.OpenXml.InkML
@using Microsoft.FluentUI.AspNetCore.Components
@using Polly
@using Pulse.Models.Api
@using Pulse.Models.Users
@using Pulse.Web.Services
@using Toolbelt.Blazor.SpeechSynthesis

@inject PulseApiService pApi
@inject SpeechSynthesis SpeechSynthesis
@inject DataTransferService dt
@inject NavigationManager Navigation
@inject AppState AppState
@rendermode InteractiveServer
<style>
    .cparent {
        display: flex;
        flex-direction: column; /* Stack children vertically */
        height: 100%; /* Or whatever height your parent should be, like 100% */
        width: 100%;
    }

    .cheader, .cfooter {
        /* Fixed sizes; flexbox will respect these */
        min-height: 50px; /* Or min-height if you want flexibility */
        /* background: lightgray; */
    }

    .ccontent {
        flex: 1; /* This magic makes it grow to fill the space */
        /* color: var(--neutral-foreground-rest); */
        background: rgba(255,255,255,0.5);
        margin: 10px;
        padding: 10px;
        border-radius: 10px;
        overflow: auto;
    }
</style>

<div class="cparent">
    <div class="ccontent">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
            <h2>My Setup</h2>
            <FluentSpacer />
            <FluentButton class="myAccentBtn" BackgroundColor="var(--pulse-accent-btn-bg)" Color="var(--pulse-accent-btn-colour)" IconStart="@(new Icons.Filled.Size28.Save().WithColor("var(--pulse-accent-btn-colour)"))" Style="height: 50px; border-radius: 10px;" OnClick="onClickSave">Update</FluentButton>
            @* <FluentButton BackgroundColor="var(--pulse-dark-t75-colour)" IconStart="@(new Icons.Filled.Size28.Save().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Lightweight))" Color="rgba(255,255,255,1)" Style="height: 50px; border-radius: 10px; border: 1px solid var(--pulse-light-colour)" class="btnShadow" OnClick="onClickSave">Update</FluentButton> *@
        </FluentStack>
        <hr />
        @if (uSettings != null)
        {
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="30" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" Wrap="true">
                <FluentCard AreaRestricted="false" Class="divShadow" Style="background-color: var(--pulse-light-colour);width:fit-content">
                    <FluentHeader Style="background-color: var(--pulse-dark-t75-colour); margin: -16px -16px 16px -16px; padding: 16px;">
                        <h2 style="margin: 0; color: white;">AI Settings</h2>
                    </FluentHeader>
                    <FluentStack Orientation="Orientation.Vertical" VerticalAlignment="VerticalAlignment.Center">
                        <FluentCheckbox @bind-Value="@uSettings.AIHasVoice" Label="Add A Voice To My AI" />
                        @* <FluentSpacer /> *@
                        <FluentTextField @bind-Value="@uSettings.PreferredUserName"
                                         Label="What should I call you?"
                                         Required="true"
                                         Style="border: 1px solid var(--pulse-dark-colour)" />
                        @* <FluentSpacer /> *@
                        <FluentSelect TOption="SpeechSynthesisVoice" Items="Voices" OptionValue="@(v => v.VoiceIdentity.ToString())"
                                      Disabled="!uSettings.AIHasVoice"
                                      Appearance="Appearance.Outline"
                                      OptionText="@(v => v.Name)"
                                      Placeholder="Make A Selection..."
                                      Label="AI Voice"
                                      Height="500px"
                                      Style="border: 1px solid var(--pulse-dark-colour)"
                                      @bind-SelectedOption="@_voice"
                                      @bind-Value="@uSettings.AIVoiceID" />
                        <FluentButton class="myAccentBtn" BackgroundColor="var(--pulse-accent-btn-bg)" Color="var(--pulse-accent-btn-colour)" IconStart="@(new Icons.Filled.Size20.PersonSoundSpatial().WithColor("var(--pulse-accent-btn-colour)"))" style="margin-left:10px" @onclick="onClickSpeak"></FluentButton>
                    </FluentStack>
                </FluentCard>
                <FluentCard AreaRestricted="false" Class="divShadow" Style="background-color: var(--pulse-light-colour);width:fit-content">
                    <FluentHeader Style="background-color: var(--pulse-dark-t75-colour); margin: -16px -16px 16px -16px; padding: 16px;">
                        <h2 style="margin: 0; color: white;">Theme</h2>
                    </FluentHeader>
                    @* <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" style="padding-left:32px;padding-right:32px;"> *@
                    <FluentSelect @bind-Value="@pTheme" TOption="string" Style="border: 1px solid var(--pulse-dark-colour)" Label="Select A Theme">
                        <FluentOption Value="HM">H&amp;M Rollers</FluentOption>
                        <FluentOption Value="pulse">Pulse</FluentOption>
                        <FluentOption Value="ocean">Ocean</FluentOption>
                        <FluentOption Value="space">Space</FluentOption>
                    </FluentSelect>
                    @* </FluentStack> *@
                </FluentCard>
                
                @* <hr> *@
            </FluentStack>
        }
    </div>
</div>

