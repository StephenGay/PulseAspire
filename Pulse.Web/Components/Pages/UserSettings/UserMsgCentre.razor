@code {
    private enum MessageFilter { Active, Archived }

    [Parameter]
    public Action<bool>? OnCloseDrawer { get; set; }

    private List<PulseMessage>? messages;
    private PulseMessage? selectedMessage;
    private string currentUserId = string.Empty;
    private bool fltrPulseAI = true;
    private bool fltrUsers = true;
    private bool fltrStreams = true;
    private bool fltrNotify = true;
    private bool showFilterMenu = false;
    private bool isSendingEmail = false;
    private List<UserPresenceDto> presenceList = new();
    private MessageFilter messageFilter = MessageFilter.Active;

    private List<PulseMessage> filteredMessages =>
    messages?.Where(m =>
        (messageFilter == MessageFilter.Active ? m.Delivered != true : m.Delivered == true) &&
        (fltrPulseAI && m.Role.ToLower() == "pulseai" ||
         fltrUsers && m.Role.ToLower() == "user" ||
         fltrStreams && m.Role.ToLower() == "stream" ||
         fltrNotify && m.Role.ToLower() == "notification")
    ).ToList() ?? new();
    // messages?.Where(m => messageFilter == MessageFilter.Active ? m.Delivered != true : m.Delivered == true, m => (fltrPulseAI ? m.Role == "PulseAI" : ""), m => (fltrUsers ? m.Role == "user" : ""), m => (fltrNotify ? m.Role == "notification" : ""), m => (fltrStream ? m.Role == "stream" : "")).ToList() ?? new();

    protected override async Task OnInitializedAsync()
    {
        // Ensure connection
        await MsgHubService.EnsureConnectedAsync();

        // Subscribe to events
        MsgHubService.OnReceiveMessage += HandleReceiveMessage;
        MsgHubService.OnPresenceListUpdated += HandlePresenceListUpdated;

        // Get current user ID
        currentUserId = _authService.aspireUserId;

        // Load initial messages
        await LoadMessagesAsync();
    }

    private async Task LoadMessagesAsync()
    {
        // Wait a moment for MasterLayout to load messages via SignalR and save to DataTransferService
        await Task.Delay(1500);
        messages = await dataTrf.GetgvUserMessages();
        await InvokeAsync(StateHasChanged);
    }

    private void SetMessageFilter(MessageFilter filter)
    {
        messageFilter = filter;
        // Clear selected message when switching filters
        selectedMessage = null;
        StateHasChanged();
    }

    private async Task ArchiveMsg()
    {
        await MsgHubService.MarkMessageAsDeliveredAsync(selectedMessage.Id);
        selectedMessage.Delivered = true;
        SetMessageFilter(messageFilter);
    }

    private void HandleReceiveMessage(PulseMessage msg)
    {
        if (messages != null)
        {
            // messages.Add(msg);
            InvokeAsync(StateHasChanged);
        }
    }

    private void HandlePresenceListUpdated(List<UserPresenceDto> list)
    {
        presenceList = list;
        InvokeAsync(StateHasChanged);
    }

    private void SelectMessage(PulseMessage msg)
    {
        selectedMessage = msg;
    }

    private async Task OnPresenceUserSelected(UserPresenceDto user)
    {
        PulseMessage newMsg = new PulseMessage
            {
                RecipientUserId = user.UserId,
                SenderUserId = currentUserId,
                SenderUserName = _authService.aspireFullName,
                Subject = "",
                Content = ""
            };

        var dialog = await DialogService.ShowDialogAsync<NewMessage>(newMsg, new DialogParameters<PulseMessage>()
            {
                Content = newMsg,
                Alignment = Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center,
                Title = $"New Message to {user.FullName}",
                Width = "600px",
                Height = "600px",
                PrimaryAction = "Send",
                SecondaryAction = "Cancel",
            });

        var result = await dialog.Result;
        if (result.Cancelled == false && result.Data is PulseMessage sentMsg && !string.IsNullOrWhiteSpace(sentMsg.Content))
        {
            try
            {
                await MsgHubService.SendPrivateMessageAsync(sentMsg);
            }
            catch (Exception ex)
            {
                // Handle error
            }
        }
    }
    private string GenerateExportHeader(PulseMessage msgToSend)
    {
        var htmlHeader = "<div style=\"display:flex;width: 100% ; padding: 8px; border-bottom: 1px solid hsl(0,100%,20%); justify-content: start; \">";

        switch (msgToSend.Role.ToLower())
        {
            case "pulseai":
                if(msgToSend.SenderUserName.ToLower() == "ali")
                {
                    htmlHeader += "<img src=\"https://hmtechnologies.org/Pulse/Aspire/Images/AI/Ali.jpg\" style=\"width:50px;height:50px;margin-right:10px\"><h3>Analysis By Ali</h3>";
                }
                else if(msgToSend.SenderUserName.ToLower() == "flapper")
                {
                    htmlHeader += "<img src=\"https://hmtechnologies.org/Pulse/Aspire/Images/AI/Flapper.jpg\" style=\"width:50px;height:50px;margin-right:10px\"><h3>Conversations With Flapper</h3>";
                }
                else if(msgToSend.SenderUserName.ToLower() == "tables")
                {
                    htmlHeader += "<img src=\"https://hmtechnologies.org/Pulse/Aspire/Images/AI/Tables.jpg\" style=\"width:50px;height:50px;margin-right:10px\"><h3>Data Extraction By Tables</h3>";
                }
                break;
            default:
                break;
        }
        htmlHeader += "</div>";
        return @htmlHeader;

    }
    private async Task SendToEmail(PulseMessage msgToSend)
    {
        bool isSuccess = false;
        isSendingEmail = true;

        try
        {
            var hdr = GenerateExportHeader(msgToSend);
            var css = GetExportCss();
            var htmlBodyContent = ParseToHtml(msgToSend.Content);
            var msghtml = $"{css}{hdr}{htmlBodyContent}";

            EMailMessage emsg = new EMailMessage
            {
                ToEMailAddress = _authService.aspireEmail,
                ToEMailName = _authService.aspireFullName,
                Subject = msgToSend.Subject ?? "Message From Pulse Aspire",
                HtmlBody = msghtml
            };

            var result = await pApi.PostAsync<EMailMessage, ApiResponse>(ApiEndpoints.Utilities.SendEmail, emsg);
            isSuccess = result?.Success == true;

        }
        catch (Exception ex)
        {
            isSuccess = false;
        }
        finally
        {
            if (isSuccess)
            {
                var Msg = "The message was forwarded to your email.";
                PulseToastService.ShowToast("Success", Msg);
                await Global_AI.AISpeak(Msg, "PulseAI");
            }
            else
            {
                var Msg = "There was an error forwarding the message.<br />Please try again.";
                PulseToastService.ShowToast("Error", Msg);
                await Global_AI.AISpeak(Msg, "PulseAI");
            }
            isSendingEmail = false;
        }
    }

    private string GetExportCss()
    {
        return @"
            <style>
                body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 20px; }
                h1, h2, h3, h4, h5 { color: #660000; }
                table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
                th { background-color: #660000; color: white; padding: 8px; text-align: left; }
                td { border: 1px solid #ddd; padding: 8px; }
                tr:nth-child(even) { background-color: #f1f1f1; }
                tr:hover { background-color: black; color: white; }
            </style>";
    }

    private async Task OpenReplyDialog(PulseMessage msgToReplyTo)
    {
        if(msgToReplyTo.Role.ToLower() == "pulseai")
        {
            var m = "I'm sorry, I can't receive replies to messages.";
            PulseToastService.ShowToast("Information", m, true, true, msgToReplyTo.SenderUserName);
            await Global_AI.AISpeak(m, msgToReplyTo.SenderUserName);
            return;
        }

        var sub = msgToReplyTo.Subject.StartsWith("RE: ") ? msgToReplyTo.Subject : "RE: " + msgToReplyTo.Subject;

        PulseMessage replyMsg = new PulseMessage
            {
                RecipientUserId = msgToReplyTo.SenderUserId,
                SenderUserId = currentUserId,
                Subject = sub,
                SenderUserName = _authService.aspireFullName,
                Content = ""
            };

        var dialog = await DialogService.ShowDialogAsync<NewMessage>(replyMsg, new DialogParameters<PulseMessage>()
            {
                Content = replyMsg,
                Alignment = Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center,
                Title = $"Reply to {msgToReplyTo.SenderUserName}",
                Width = "600px",
                Height = "600px",
                PrimaryAction = "Send",
                SecondaryAction = "Cancel",
            });

        var result = await dialog.Result;
        if (result.Cancelled == false && result.Data is PulseMessage sentMsg && !string.IsNullOrWhiteSpace(sentMsg.Content))
        {
            try
            {

                sentMsg.Content += $"<br /><br /><p style='font-size:0.95em; font-weight:bold;'>{selectedMessage?.SenderUserName} - ({selectedMessage?.SentAt})</p><div style='color:#666666; font-style:italic; font-size:0.95em;'>{selectedMessage?.Content}</div>";
                await MsgHubService.SendPrivateMessageAsync(sentMsg);
            }
            catch (Exception ex)
            {
                // Handle error
            }
        }
    }

        private async Task OpenNewMessageDialog()
        {
            PulseMessage newMsg = new PulseMessage
            {
                RecipientUserId = "",
                SenderUserId = currentUserId,
                SenderUserName = _authService.aspireFullName,
                Content = ""
            };

            var dialog = await DialogService.ShowDialogAsync<NewMessage>(newMsg, new DialogParameters<PulseMessage>()
            {
                Content = newMsg,
                Alignment = Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center,
                Title = "New Broadcast",
                Width = "600px",
                Height = "600px",
                PrimaryAction = "Send",
                SecondaryAction = "Cancel",
            });

            var result = await dialog.Result;
            if (result.Cancelled == false && result.Data is PulseMessage sentMsg && !string.IsNullOrWhiteSpace(sentMsg.Content))
            {
                try
                {
                    await MsgHubService.SendMessageAsync(sentMsg);
                }
                catch (Exception ex)
                {
                    // Handle error
                }
            }
        }

        public async ValueTask DisposeAsync()
        {
            MsgHubService.OnReceiveMessage -= HandleReceiveMessage;
            MsgHubService.OnPresenceListUpdated -= HandlePresenceListUpdated;
        }
        private string ParseToHtml(string markdown)
        {
            var pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
            return Markdig.Markdown.ToHtml(markdown, pipeline);
        }
    }
