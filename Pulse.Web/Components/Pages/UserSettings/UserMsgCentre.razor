@page "/UserSettings/UserMsgCentre"

@using Markdig
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.FluentUI.AspNetCore.Components
@using System.Text.Json
@using Pulse.Models
@using Pulse.Models.CustomComponents
@using System.Security.Claims
@using Pulse.Web.Components.Pages.EmployeeZone.Customers.Dialogs
@using Pulse.Web.Components.Pages.Notifications
@using Pulse.Web.Services
@attribute [Authorize]
@inject MessageHubService MsgHubService
@inject AuthService _authService
@inject DataTransferService dataTrf
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService

@implements IAsyncDisposable

<CascadingValue Value="this">
    <div style="display: flex; height: 100%; background-color: var(--pulse-light-colour);">
    <!-- Sidebar - Message List -->
        <div style="width: 350px; border-right: 1px solid var(--neutral-stroke-divider); display: flex; flex-direction: column; background-color: var(--pulse-light-colour);">
        <!-- Header with Tabs -->
        <div style="padding: 16px; border-bottom: 1px solid var(--neutral-stroke-divider);">
                @* Appearance="@(messageFilter == MessageFilter.Archived ? Appearance.Accent : Appearance.Outline)" *@
                @* Appearance="@(messageFilter == MessageFilter.Active ? Appearance.Accent : Appearance.Outline)" *@
            <FluentStack Orientation="Orientation.Vertical">
                
        
                <FluentStack Orientation="Orientation.Horizontal" Style="padding-left:10px;padding-right:10px;margin-top:10px">
                    <FluentButton class=@(fltrPulseAI ? "myModeBtnOn" : "myModeBtnOff")
                                  BackgroundColor="var(--pulse-mode-btn-bg)"
                                  Color="var(--pulse-mode-btn-item-colour)"
                                  @onclick="() => { fltrPulseAI = !fltrPulseAI; StateHasChanged(); }"
                                  Style="height:40px; width:40px">
                        <FluentEmoji Value="@(new Emojis.SmileysEmotion.Color.Default.Robot())" Width="32px" />
                    </FluentButton>
                    <FluentSpacer />
                    <FluentButton class=@(fltrUsers ? "myModeBtnOn" : "myModeBtnOff")
                                  BackgroundColor="var(--pulse-mode-btn-bg)"
                                  Color="var(--pulse-mode-btn-item-colour)"
                                  @onclick="() => { fltrUsers = !fltrUsers; StateHasChanged(); }"
                                    Style="height:40px; width:40px">
                        <FluentEmoji Value="@(new Emojis.PeopleBody.Color.MediumLight.PersonBlondHair())" Width="32px" />
                    </FluentButton>
                    <FluentSpacer />
                    <FluentButton class=@(fltrStreams ? "myModeBtnOn" : "myModeBtnOff")
                                  BackgroundColor="var(--pulse-mode-btn-bg)"
                                  Color="var(--pulse-mode-btn-item-colour)"
                                  @onclick="() => { fltrStreams = !fltrStreams; StateHasChanged(); }"
                                    Style="height:40px; width:40px">
                        <FluentEmoji Value="@(new Emojis.Symbols.Color.Default.Information())" Width="32px" />
                    </FluentButton>
                    <FluentSpacer />
                    <FluentButton class=@(fltrNotify ? "myModeBtnOn" : "myModeBtnOff")
                                  BackgroundColor="var(--pulse-mode-btn-bg)"
                                  Color="var(--pulse-mode-btn-item-colour)"
                                  @onclick="() => { fltrNotify = !fltrNotify; StateHasChanged(); }"
                                    Style="height:40px; width:40px">
                        <FluentEmoji Value="@(new Emojis.Objects.Color.Default.Bell())" Width="32px" />
                    </FluentButton>
                </FluentStack>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin-top:15px" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Left">
                        <FluentButton class=@(messageFilter == MessageFilter.Active ? "myModeBtnOn" : "myModeBtnOff") BackgroundColor="var(--pulse-mode-btn-bg)"
                                      Color="var(--pulse-mode-btn-item-colour)"
                                      @onclick="() => SetMessageFilter(MessageFilter.Active)"
                                      Style="flex: 1;">
                            Active @if (messages != null) {
                            <span style="font-size: 12px;">(@messages.Count(m => m.Delivered != true))</span>
                        }
                    </FluentButton>
                    <FluentButton class=@(messageFilter == MessageFilter.Archived ? "myModeBtnOn" : "myModeBtnOff") BackgroundColor="var(--pulse-mode-btn-bg)"
                                  Color="var(--pulse-mode-btn-item-colour)"
                                  @onclick="() => SetMessageFilter(MessageFilter.Archived)"
                                  Style="flex: 1;">
                        Archived @if (messages != null) {
                        <span style="font-size: 12px;">(@messages.Count(m => m.Delivered == true))</span>
                    }
                </FluentButton>
            </FluentStack>
            </FluentStack>
        </div>

        <!-- Message List -->
        <div style="flex: 1; overflow-y: auto; padding: 8px; background-color: var(--pulse-light-colour)">
            @if (messages == null)
            {
                <div style="display: flex; justify-content: center; align-items: center; height: 100%;">
                    <FluentProgressRing />
                </div>
            }
            else if (filteredMessages.Count == 0)
            {
                <FluentCard Style="padding: 16px; text-align: center;">
                    <FluentLabel>No @(messageFilter == MessageFilter.Active ? "active" : "archived") messages</FluentLabel>
                </FluentCard>
            }
            else
            {
                @foreach (var msg in filteredMessages.OrderByDescending(m => m.SentAt))
                {
                    var isSelected = selectedMessage?.Id == msg.Id;
                <div style="@($"padding: 8px; margin: 4px 0; border-radius: 6px; border: 1px solid var(--pulse-dark-colour); cursor: pointer; border-bottom: {(isSelected ? "3px solid var(--pulse-dark-colour)" : "1px solid var(--pulse-dark-colour)")}; background-color: {(isSelected ? "white" : "var(--pulse-dark-t50-colour)")}; {(isSelected ? "color: var(--pulse-dark-colour)" : "color: white;")}")"
                         @onclick="() => SelectMessage(msg)">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                        <FluentLabel Style="@(isSelected ? "color: var(--pulse-dark-colour); font-weight: 600;" : "font-weight: 600; color: white;")" Typo="Typography.Body">
                                @msg.SenderUserName
                            </FluentLabel>
                        </div>
                    <div style="font-size: 12px; margin-top: 4px; @(isSelected ? "color: var(--pulse-dark-colour);" : "color: white;")" title="@msg.Subject">
                        @(msg.Subject?.Length > 50 ? msg.Subject.Substring(0, 50) + "..." : msg.Subject)
                        </div>
                    <div style="font-size: 11px; margin-top: 2px; @(isSelected ? "color: var(--pulse-dark-colour);" : "color: white;")" title="@msg.SentAt">
                            @msg.SentAt.ToString()
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Main Content Area - Message Detail -->
    <div style="flex: 1; display: flex; flex-direction: column; background-color: var(--pulse-light-colour);">
        <!-- Header Bar -->
        <div style="padding: 16px; border-bottom: 1px solid var(--neutral-stroke-divider); background-color: var(--neutral-layer-3);">
            @if (selectedMessage != null)
            {
                
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12">
                        @* <div style="flex: 1;"> *@
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                            <FluentLabel Typo="Typography.PageTitle" Style="color: var(--pulse-dark-colour);">@selectedMessage.SenderUserName</FluentLabel>
                            <FluentLabel Typo="Typography.Body" Style="color: var(--pulse-dark-colour); font-size: 12px;">@selectedMessage.SentAt.ToString()</FluentLabel>
                            </FluentStack>
                        @* </div> *@
                        
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                                <FluentSpacer />
                            
                            @* <FluentButton Appearance="Appearance.Outline" @onclick="() => OpenNewMessageDialog()" aria-label="Compose new message">
                                Broadcast
                            </FluentButton> *@
                        </FluentStack>
                    
                </FluentStack>
            }
            else
            {
                <FluentLabel Typo="Typography.PageTitle" Style="color: var(--neutral-foreground-hint);">Select a message to view</FluentLabel>
            }
        </div>

        <!-- Message Content -->
    <div style="flex: 1; padding: 24px; overflow: hidden; background-color: white;">
            @if (selectedMessage != null)
            {
                <FluentCard class="divShadow" Style="padding: 20px">
                    <FluentStack Orientation="Orientation.Vertical" Style="height:100%" VerticalGap="16">
                        <!-- From -->
                        @* <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" VerticalGap="0">
                            <FluentLabel Style="width: 100px; font-weight: 600;">From:</FluentLabel>
                            <FluentLabel>@selectedMessage.SenderUserName</FluentLabel>
                        </FluentStack> *@

                        <!-- To -->
                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" VerticalGap="0">
                            <FluentLabel Style="width: 100px; font-weight: 600;">To:</FluentLabel>
                            <FluentLabel>@selectedMessage.RecipientUserName</FluentLabel>
                            <FluentSpacer />
                            <FluentButton class="myAccentBtn" BackgroundColor="var(--pulse-accent-btn-bg)" Color="var(--pulse-accent-btn-colour)" @onclick="() => OpenReplyDialog(selectedMessage)" aria-label="Reply to message">
                                Reply
                            </FluentButton>
                            <FluentButton class="myAccentBtn" BackgroundColor="var(--pulse-accent-btn-bg)" Color="var(--pulse-accent-btn-colour)" @onclick="ArchiveMsg" Disabled=@(selectedMessage.Delivered == true ? true : false) aria-label="Archive message">
                                Archive
                            </FluentButton>
                        </FluentStack>

                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" VerticalGap="0" Style="padding-bottom: 5px; border-bottom: 1px solid var(--pulse-dark-colour)">
                            <FluentLabel Style="width: 100px; font-weight: 600;">Subject:</FluentLabel>
                            <FluentLabel>@selectedMessage.Subject</FluentLabel>
                        </FluentStack>
                
                        <!-- Date -->
                       @*  <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" VerticalGap="0">
                            <FluentLabel Style="width: 100px; font-weight: 600;">Date:</FluentLabel>
                            <FluentLabel>@selectedMessage.SentAt.ToString()</FluentLabel>
                        </FluentStack> *@

                        <!-- Message Content -->
                        <div style="border-top: 1px solid var(--neutral-stroke-divider); padding-top: 5px;margin-bottom: 5px;padding-bottom:5px; margin-top: 5px;flex: 1;overflow: auto;">
                            <p style="white-space: pre-wrap; word-wrap: break-word; color: var(--neutral-foreground-rest);">@((MarkupString)ParseToHtml(@selectedMessage.Content))</p>
                        </div>
                </FluentStack>
                </FluentCard>
            }
            else
            {
                <FluentCard class="divShadow" Style="padding: 40px; text-align: center;">
                    <FluentLabel Typo="Typography.Body">Select a message from the inbox to view its content</FluentLabel>
                </FluentCard>
            }
                </div>
            </div>

            <!-- Right Sidebar - User Presence List -->
<div style="width: 280px; border-left: 1px solid var(--neutral-stroke-divider); display: flex; flex-direction: column; background-color: var(--pulse-light-colour);">
                <!-- Header -->
                <div style="padding: 16px; border-bottom: 1px solid var(--neutral-stroke-divider);">
                    <FluentLabel Typo="Typography.PageTitle" Style="color: var(--pulse-dark-colour);">Users</FluentLabel>
                </div>

                <!-- User Presence List -->
                <div style="flex: 1; overflow-y: auto; padding: 8px; ">
                    <UserPresenceList OnUserSelected="OnPresenceUserSelected" />
                </div>
                        </div>
                    </div>
                </CascadingValue>

@code {
    private enum MessageFilter { Active, Archived }

    [Parameter]
    public Action<bool>? OnCloseDrawer { get; set; }

    private List<PulseMessage>? messages;
    private PulseMessage? selectedMessage;
    private string currentUserId = string.Empty;
    private bool fltrPulseAI = true;
    private bool fltrUsers = true;
    private bool fltrStreams = true;
    private bool fltrNotify = true;
    private List<UserPresenceDto> presenceList = new();
    private MessageFilter messageFilter = MessageFilter.Active;

    private List<PulseMessage> filteredMessages =>
    messages?.Where(m =>
        (messageFilter == MessageFilter.Active ? m.Delivered != true : m.Delivered == true) &&
        (fltrPulseAI && m.Role.ToLower() == "pulseai" ||
         fltrUsers && m.Role.ToLower() == "user" ||
         fltrStreams && m.Role.ToLower() == "stream" ||
         fltrNotify && m.Role.ToLower() == "notification")
    ).ToList() ?? new();
    // messages?.Where(m => messageFilter == MessageFilter.Active ? m.Delivered != true : m.Delivered == true, m => (fltrPulseAI ? m.Role == "PulseAI" : ""), m => (fltrUsers ? m.Role == "user" : ""), m => (fltrNotify ? m.Role == "notification" : ""), m => (fltrStream ? m.Role == "stream" : "")).ToList() ?? new();

    protected override async Task OnInitializedAsync()
    {
        // Ensure connection
        await MsgHubService.EnsureConnectedAsync();

        // Subscribe to events
        MsgHubService.OnReceiveMessage += HandleReceiveMessage;
        MsgHubService.OnPresenceListUpdated += HandlePresenceListUpdated;

        // Get current user ID
        currentUserId = _authService.aspireUserId;

        // Load initial messages
        await LoadMessagesAsync();
    }

    private async Task LoadMessagesAsync()
    {
        // Wait a moment for MasterLayout to load messages via SignalR and save to DataTransferService
        await Task.Delay(500);
        messages = await dataTrf.GetgvUserMessages();
        await InvokeAsync(StateHasChanged);
    }

    private void SetMessageFilter(MessageFilter filter)
    {
        messageFilter = filter;
        // Clear selected message when switching filters
        selectedMessage = null;
        StateHasChanged();
    }

    private async Task ArchiveMsg()
    {
        await MsgHubService.MarkMessageAsDeliveredAsync(selectedMessage.Id);
        selectedMessage.Delivered = true;
        SetMessageFilter(messageFilter);
    }
    
    private void HandleReceiveMessage(PulseMessage msg)
    {
        if (messages != null)
        {
            // messages.Add(msg);
            InvokeAsync(StateHasChanged);
        }
    }

    private void HandlePresenceListUpdated(List<UserPresenceDto> list)
    {
        presenceList = list;
        InvokeAsync(StateHasChanged);
    }

    private void SelectMessage(PulseMessage msg)
    {
        selectedMessage = msg;
    }

    private async Task OnPresenceUserSelected(UserPresenceDto user)
    {
        PulseMessage newMsg = new PulseMessage
            {
                RecipientUserId = user.UserId,
                SenderUserId = currentUserId,
                SenderUserName = _authService.aspireFullName,
                Content = ""
            };

        var dialog = await DialogService.ShowDialogAsync<NewMessage>(newMsg, new DialogParameters<PulseMessage>()
            {
                Content = newMsg,
                Alignment = Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center,
                Title = $"New Message to {user.FullName}",
                Width = "600px",
                Height = "600px",
                PrimaryAction = "Send",
                SecondaryAction = "Cancel",
            });

        var result = await dialog.Result;
        if (result.Cancelled == false && result.Data is PulseMessage sentMsg && !string.IsNullOrWhiteSpace(sentMsg.Content))
        {
            try
            {
                await MsgHubService.SendPrivateMessageAsync(sentMsg);
            }
            catch (Exception ex)
            {
                // Handle error
            }
        }
    }

    private async Task OpenReplyDialog(PulseMessage msgToReplyTo)
    {
        PulseMessage replyMsg = new PulseMessage
            {
                RecipientUserId = msgToReplyTo.SenderUserId,
                SenderUserId = currentUserId,
                SenderUserName = _authService.aspireFullName,
                Content = ""
            };

        var dialog = await DialogService.ShowDialogAsync<NewMessage>(replyMsg, new DialogParameters<PulseMessage>()
            {
                Content = replyMsg,
                Alignment = Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center,
                Title = $"Reply to {msgToReplyTo.SenderUserName}",
                Width = "600px",
                Height = "600px",
                PrimaryAction = "Send",
                SecondaryAction = "Cancel",
            });

        var result = await dialog.Result;
        if (result.Cancelled == false && result.Data is PulseMessage sentMsg && !string.IsNullOrWhiteSpace(sentMsg.Content))
        {
            try
            {

                sentMsg.Content += $"<br /><br /><p style='font-size:0.95em; font-weight:bold;'>{selectedMessage?.SenderUserName} - ({selectedMessage?.SentAt})</p><div style='color:#666666; font-style:italic; font-size:0.95em;'>{selectedMessage?.Content}</div>";
                await MsgHubService.SendPrivateMessageAsync(sentMsg);
            }
            catch (Exception ex)
            {
                // Handle error
            }
        }
    }

        private async Task OpenNewMessageDialog()
        {
            PulseMessage newMsg = new PulseMessage
            {
                RecipientUserId = "",
                SenderUserId = currentUserId,
                SenderUserName = _authService.aspireFullName,
                Content = ""
            };

            var dialog = await DialogService.ShowDialogAsync<NewMessage>(newMsg, new DialogParameters<PulseMessage>()
            {
                Content = newMsg,
                Alignment = Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center,
                Title = "New Broadcast",
                Width = "600px",
                Height = "600px",
                PrimaryAction = "Send",
                SecondaryAction = "Cancel",
            });

            var result = await dialog.Result;
            if (result.Cancelled == false && result.Data is PulseMessage sentMsg && !string.IsNullOrWhiteSpace(sentMsg.Content))
            {
                try
                {
                    await MsgHubService.SendMessageAsync(sentMsg);
                }
                catch (Exception ex)
                {
                    // Handle error
                }
            }
        }

        public async ValueTask DisposeAsync()
        {
            MsgHubService.OnReceiveMessage -= HandleReceiveMessage;
            MsgHubService.OnPresenceListUpdated -= HandlePresenceListUpdated;
        }
        private string ParseToHtml(string markdown)
        {
            var pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
            return Markdig.Markdown.ToHtml(markdown, pipeline);
        }
    }
