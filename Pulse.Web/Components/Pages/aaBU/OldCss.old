:root {
    --pulse-dark-colour: #365b66; /*#660000;*/ /*#365b66;*/
    --pulse-dark-t25-colour: #5a7a89;
    --pulse-dark-t50-colour: #5a7a89;
    --pulse-dark-t75-colour: #5a7a89;
    --pulse-light-colour: #bcd1d4; /*#d9d9d9;*/ /*#bcd1d4;*/
    --pulse-light-2-colour: #a0b0b3;
    --pulse-theme-bg: url(../images/backgrounds/HMBG.png);
    /* My Accent Button */
    /* From the Theme */
    --pulse-accent-btn-theme-bg: var(--pulse-dark-t75-colour);
    --pulse-accent-btn-theme-colour: white;
    /* Used to switch colours while running */
    --pulse-accent-btn-bg: var(--pulse-accent-btn-theme-bg);
    --pulse-accent-btn-colour: var(--pulse-accent-btn-theme-colour);
    /* My Ok Button Variables */
    --pulse-ok-btn-bg: var(--success);
    --pulse-ok-btn-colour: rgb(255,255,255);
    /* My Cancel Button Variables */
    --pulse-cancel-btn-bg: var(--error);
    --pulse-cancel-btn-colour: rgb(255,255,255);
    /* Mode Toggle Button */
    --pulse-mode-btn-on-bg: #9fdf9f;
    /*#9900FF;*/
    /*#1D722A;*/
    --pulse-mode-btn-on-item-colour: black; /* white;*/
    --pulse-mode-btn-off-bg: white;
    --pulse-mode-btn-off-item-colour: #9900FF;
    --pulse-mode-btn-bg: #9fdf9f; /* #9900FF;*/
    /*#1D722A;*/
    --pulse-mode-btn-item-colour: white;
    --datagrid-hover-color: var(--pulse-light-colour);
    --bs-info: #9900FF !important;
    --bs-info-rgb: 153, 0, 255 !important;
}
:root, [data-bs-theme=light] {
    --bs-info: #9900FF !important;
    --bs-info-rgb: 153, 0, 255 !important;
}
