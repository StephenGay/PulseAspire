@code {
    [Inject] private Radzen.DialogService RadzenDialogService { get; set; } = default!;
    [CascadingParameter] 
    private MasterLayout MasterLayout { get; set; } = default!;

    private List<ProductionStreamMessageDto> productionMessages = new();
    private List<ApplicationUserStream> Subscribed = [];
    private List<SystemDataStream> Unsubscribed = [];
    private List<SystemDataStream> DivisionStreams = [];
    private List<ProductionStreamMessageDto> filteredStreamMessages = new();
    private ApplicationUserStream? selectedSub;
    private SystemDataStream? selectedDivStream;
    private bool IsLoading = true;
    private string? searchStreams = string.Empty;
    private string? hoveredStreamName = null;

    private enum MessageFilter { Active, Archived }
    private enum ComposeMode { None, Reply, NewMessage }

    [Parameter]
    public Action<bool>? OnCloseDrawer { get; set; }

    private List<PulseMessage>? messages;
    private PulseMessage? selectedMessage;
    private PulseMessage? composingMessage;
    private ComposeMode composeMode = ComposeMode.None;
    private string currentUserId = string.Empty;
    private bool fltrPulseAI = true;
    private bool fltrUsers = true;
    private bool fltrStreams = true;
    private bool fltrNotify = true;
    private bool showFilterMenu = false;
    private bool isSendingEmail = false;
    private List<UserPresenceDto> presenceList = new();
    private MessageFilter messageFilter = MessageFilter.Active;

    private List<PulseMessage> filteredMessages =>
    messages?.Where(m =>
        (messageFilter == MessageFilter.Active ? m.Delivered != true : m.Delivered == true) &&
        (fltrPulseAI && m.Role.ToLower() == "pulseai" ||
         fltrUsers && m.Role.ToLower() == "user" ||
         fltrStreams && m.Role.ToLower() == "stream" ||
         fltrNotify && m.Role.ToLower() == "notification")
    ).ToList() ?? new();

    protected override async Task OnInitializedAsync()
    {
        // Ensure connection
        await MsgHubService.EnsureConnectedAsync();
        appState.OnProductionChange += async () => await LoadMessagesAsync();
        // Subscribe to events
        


    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Division d = await dataTrf.GetgvSelectedDivision();
            currentUserId = _authService.aspireUserId;
            var uResponse = await pApi.GetAsync<ApiResponse<List<ApplicationUserStream>>>(ApiEndpoints.User.Subscriptions.GetSystemStreams(currentUserId));
            if (uResponse != null && uResponse.Success && uResponse.Data != null)
            {
                var uSub = uResponse.Data;
                Subscribed = new List<ApplicationUserStream>();
                foreach(var st in uSub)
                {
                    Subscribed.Add(new ApplicationUserStream { StreamName = st.StreamName, StreamDivisionID = st.StreamDivisionID, Id = st.Id });
                }
            }
            var response = await pApi.GetAsync<ApiResponse<List<SystemDataStream>>>(ApiEndpoints.Divisions.WithDivisionID.GetSystemDataStreams(d.DivisionID));
            if ( response != null && response.Success && response.Data != null)
            {
                DivisionStreams = response.Data;
                Unsubscribed = DivisionStreams.Where(ds => Subscribed.All(s => s.StreamID != ds.StreamID && s.StreamDivisionID != MasterLayout?.division!.DivisionID)).ToList();
            }

            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }

    }
    private void OnSearchInput(ChangeEventArgs e)
    {
        searchStreams = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    private List<SystemDataStream> GetFilteredStreams()
    {
        if (Unsubscribed == null || string.IsNullOrWhiteSpace(searchStreams))
        {
            return Unsubscribed?.OrderBy(u => u.StreamName).ToList() ?? new();
        }

        var query = searchStreams.ToLower();
        return Unsubscribed
            .Where(u => (u.StreamName).ToLower().Contains(query))
            .OrderBy(u => u.StreamName)
            .ToList();
    }

    private async Task OnStreamClicked(SystemDataStream stream)
    {
        var confirmed = await ConfirmSubscriptionDialogAsync(stream.StreamName);
        if (!confirmed)
        {
            return;
        }
        ApplicationUserStream userStream = new ApplicationUserStream
            {
                ApplicationUserID = currentUserId,
                StreamName = stream.StreamName,
                StreamID = stream.StreamID,
                StreamType = StreamType.System,
                StreamDivisionID = MasterLayout?.division!.DivisionID!
            };
        var response = await pApi.PostAsync<ApplicationUserStream, ApiResponse<ApplicationUserStream>>(ApiEndpoints.User.Subscriptions.Subscribe, userStream);
        if (response != null && response.Success && response.Data != null)
        {
            Subscribed.Add(response.Data);
            Unsubscribed.RemoveAll(s => s.StreamID == stream.StreamID);
            await MsgHubService.JoinGroup($"{stream.StreamName}_{MasterLayout?.division!.DivisionID}", MasterLayout?.UserPreferredName!);
            PulseToastService.ShowToast("Success", $"You are now subscribed to the {stream.StreamName} data stream for this Division.", true);
            await Global_AI.AISpeak($"You are now subscribed to the {stream.StreamName} data stream for this Division.", "PulseAI");
        }
        else
        {
            PulseToastService.ShowToast("Error", $"There was an error subscribing to the {stream.StreamName} data stream.<br />Please try again.", true);
            await Global_AI.AISpeak($"There was an error subscribing to the {stream.StreamName} data stream.<br />Please try again.", "PulseAI");
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task<bool> ConfirmSubscriptionDialogAsync(string streamName)
    {
        var result = await RadzenDialogService.Confirm(
            // $"Do you want to subscribe to the Data Stream\n\n<div style=\"text-align:center\">{streamName}?</div>",
            GetMessage(streamName),
            "Confirm",
            new ConfirmOptions
            {
                OkButtonText = "Subscribe",
                CancelButtonText = "Cancel"
                // OkButtonColor = ButtonColor.Danger
            });

        return result == true;
    }
    RenderFragment GetMessage(string streamName)
    {
        return __builder =>
        {
            <text>
                Click <b>Subscribe</b> to start receiving updates from the following Data Stream:
            </text>
            <br />
            <br />
            <div style="text-align:center">Division   : @MasterLayout?.division!.DivisionName</div>
            <div style="text-align:center">Data Stream: @streamName</div>
            <br />
        };
    }
    private async Task LoadMessagesAsync()
    {
        // Wait a moment for MasterLayout to load messages via SignalR and save to DataTransferService
        IsLoading = true;
        filteredStreamMessages = [];
        await Task.Delay(1500);
        productionMessages = await dataTrf.GetProductionStream();
        if (selectedSub != null)
        {
            filteredStreamMessages = productionMessages.Where(m => m.ProductionGroupName == $"0_{selectedSub.StreamID}_{selectedSub.StreamDivisionID}").OrderByDescending(m => m.MsgTimestamp).ToList();
        }
        IsLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void SetMessageFilter(MessageFilter filter)
    {
        messageFilter = filter;
        // Clear selected message when switching filters
        selectedMessage = null;
        StateHasChanged();
    }

    private async Task ArchiveMsg()
    {
        await MsgHubService.MarkMessageAsDeliveredAsync(selectedMessage.Id);
        selectedMessage.Delivered = true;
        SetMessageFilter(messageFilter);
    }

    private void HandleReceiveMessage(PulseMessage msg)
    {
        if (messages != null)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private void HandlePresenceListUpdated(List<UserPresenceDto> list)
    {
        presenceList = list;
        InvokeAsync(StateHasChanged);
    }

    private async Task SelectSubscription(ApplicationUserStream sub)
    {
        selectedSub = sub;
        await LoadMessagesAsync();
    }

    private void StartReply(PulseMessage msgToReplyTo)
    {
        if (msgToReplyTo.Role.ToLower() == "pulseai")
        {
            var m = "I'm sorry, I can't receive replies to messages.";
            PulseToastService.ShowToast("Information", m, true, true, msgToReplyTo.SenderUserName);
            Global_AI.AISpeak(m, msgToReplyTo.SenderUserName);
            return;
        }

        var sub = msgToReplyTo.Subject.StartsWith("RE: ") ? msgToReplyTo.Subject : "RE: " + msgToReplyTo.Subject;

        composingMessage = new PulseMessage
        {
            RecipientUserId = msgToReplyTo.SenderUserId,
            RecipientUserName = msgToReplyTo.SenderUserName,
            SenderUserId = currentUserId,
            Subject = sub,
            SenderUserName = _authService.aspireFullName,
            Content = "",
            Role = "User"
        };

        composeMode = ComposeMode.Reply;
    }

    private void StartNewMessage()
    {
        composingMessage = new PulseMessage
        {
            RecipientUserId = "",
            RecipientUserName = "",
            SenderUserId = currentUserId,
            SenderUserName = _authService.aspireFullName,
            Subject = "",
            Content = "",
            Role = "User"
        };

        composeMode = ComposeMode.NewMessage;
    }

    private void CancelCompose()
    {
        composeMode = ComposeMode.None;
        composingMessage = null;
    }

    private async Task SendComposedMessage()
    {
        if (composingMessage == null || string.IsNullOrWhiteSpace(composingMessage.Content))
        {
            return;
        }

        isSendingEmail = true;

        try
        {
            if (composeMode == ComposeMode.Reply && selectedMessage != null)
            {
                composingMessage.Content += $"<br /><br /><p style='font-size:0.95em; font-weight:bold;'>{selectedMessage.SenderUserName} - ({selectedMessage.SentAt})</p><div style='color:#666666; font-style:italic; font-size:0.95em;'>{selectedMessage.Content}</div>";
            }

            await MsgHubService.SendPrivateMessageAsync(composingMessage);

            PulseToastService.ShowToast("Success", "Message sent successfully");
            await Global_AI.AISpeak("Your message has been sent", "PulseAI");

            CancelCompose();
        }
        catch (Exception ex)
        {
            PulseToastService.ShowToast("Error", $"Failed to send message: {ex.Message}");
            await Global_AI.AISpeak("There was an error sending your message", "PulseAI");
        }
        finally
        {
            isSendingEmail = false;
        }
    }

    private async Task OnPresenceUserSelected(UserPresenceDto user)
    {
        composingMessage = new PulseMessage
        {
            RecipientUserId = user.UserId,
            RecipientUserName = user.FullName,
            Role = "User",
            SenderUserId = currentUserId,
            SenderUserName = _authService.aspireFullName,
            Subject = "",
            Content = ""
        };

        composeMode = ComposeMode.NewMessage;
        await InvokeAsync(StateHasChanged);
    }

    private string GenerateExportHeader(PulseMessage msgToSend)
    {
        var htmlHeader = "<div style=\"display:flex;width: 100% ; padding: 8px; border-bottom: 1px solid hsl(0,100%,20%); justify-content: start; \">";

        switch (msgToSend.Role.ToLower())
        {
            case "pulseai":
                if (msgToSend.SenderUserName.ToLower() == "ali")
                {
                    htmlHeader += "<img src=\"https://hmtechnologies.org/Pulse/Aspire/Images/AI/Ali.jpg\" style=\"width:50px;height:50px;margin-right:10px\"><h3>Analysis By Ali</h3>";
                }
                else if (msgToSend.SenderUserName.ToLower() == "flapper")
                {
                    htmlHeader += "<img src=\"https://hmtechnologies.org/Pulse/Aspire/Images/AI/Flapper.jpg\" style=\"width:50px;height:50px;margin-right:10px\"><h3>Conversations With Flapper</h3>";
                }
                else if (msgToSend.SenderUserName.ToLower() == "tables")
                {
                    htmlHeader += "<img src=\"https://hmtechnologies.org/Pulse/Aspire/Images/AI/Tables.jpg\" style=\"width:50px;height:50px;margin-right:10px\"><h3>Data Extraction By Tables</h3>";
                }
                break;
            default:
                break;
        }
        htmlHeader += "</div>";
        return @htmlHeader;
    }

    private async Task SendToEmail(PulseMessage msgToSend)
    {
        bool isSuccess = false;
        isSendingEmail = true;

        try
        {
            var hdr = GenerateExportHeader(msgToSend);
            var css = GetExportCss();
            var htmlBodyContent = ParseToHtml(msgToSend.Content);
            var msghtml = $"{css}{hdr}{htmlBodyContent}";

            EMailMessage emsg = new EMailMessage
            {
                ToEMailAddress = _authService.aspireEmail,
                ToEMailName = _authService.aspireFullName,
                Subject = msgToSend.Subject ?? "Message From Pulse Aspire",
                HtmlBody = msghtml
            };

            var result = await pApi.PostAsync<EMailMessage, ApiResponse>(ApiEndpoints.Utilities.SendEmail, emsg);
            isSuccess = result?.Success == true;
        }
        catch (Exception ex)
        {
            isSuccess = false;
        }
        finally
        {
            if (isSuccess)
            {
                var Msg = "The message was forwarded to your email.";
                PulseToastService.ShowToast("Success", Msg);
                await Global_AI.AISpeak(Msg, "PulseAI");
            }
            else
            {
                var Msg = "There was an error forwarding the message.<br />Please try again.";
                PulseToastService.ShowToast("Error", Msg);
                await Global_AI.AISpeak(Msg, "PulseAI");
            }
            isSendingEmail = false;
        }
    }

    private string GetExportCss()
    {
        return @"
            <style>
                body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 20px; }
                h1, h2, h3, h4, h5 { color: #660000; }
                table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
                th { background-color: #660000; color: white; padding: 8px; text-align: left; }
                td { border: 1px solid #ddd; padding: 8px; }
                tr:nth-child(even) { background-color: #f1f1f1; }
                tr:hover { background-color: black; color: white; }
            </style>";
    }

    public async ValueTask DisposeAsync()
    {
        MsgHubService.OnReceiveMessage -= HandleReceiveMessage;
        MsgHubService.OnPresenceListUpdated -= HandlePresenceListUpdated;
    }

    private string ParseToHtml(string markdown)
    {
        var pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
        return Markdig.Markdown.ToHtml(markdown, pipeline);
    }
}
