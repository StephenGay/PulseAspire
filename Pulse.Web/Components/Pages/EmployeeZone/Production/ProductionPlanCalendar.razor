    public string? DivisionId;
    private List<ProductionPlanEvent>? events;
    private List<ProductionUnPlannedEvent>? unplannedWO;

    private IJSObjectReference? calendarModule;
    private DotNetObjectReference<ProductionPlanCalendar>? dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Division x = await dt.GetgvSelectedDivision();
            DivisionId = x.DivisionID;

            events = await pApi.GetAsync<List<ProductionPlanEvent>>(
                      $"/Divisions/{DivisionId}/GetWIP/PlanItems");

            calendarModule = await JS.InvokeAsync<IJSObjectReference>("import", "js/calendarInterop.js");
            dotNetRef = DotNetObjectReference.Create(this);


            // var json = JsonSerializer.Serialize(Events,
            //     new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });

            await calendarModule.InvokeVoidAsync("initCalendar", "calendar", dotNetRef, events);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Division y = await dt.GetgvSelectedDivision();

        unplannedWO = await pApi.GetAsync<List<ProductionUnPlannedEvent>>($"/Divisions/{y.DivisionID}/GetWIP/UnPlannedItems");
        // var events = new[]
        // {
        //     new { title = "Meeting", start = DateTime.Now },
        //     new { title = "Conference", start = DateTime.Now.AddDays(2) }
        // };
        // await JS.InvokeVoidAsync("fullCalendarInterop.initialize", "#calendar", events, resources);


    }
    [JSInvokable]
    public async Task HandleEventDrop(int eventId, string newStart, string newEnd)
    {
        // Parse dates (ISO format from JS)
        var start = DateTime.Parse(newStart);
        var end = string.IsNullOrEmpty(newEnd) ? (DateTime?)null : DateTime.Parse(newEnd);
        // var updatedEvent = new ProductionPlanEvent() { eventId, string.Empty, start, end };
        ProductionPlanItem updatedEvent = await pApi.GetAsync<ProductionPlanItem>($"/Divisions/WIP/GetPlanItem/{eventId}");
        updatedEvent.PlannedStartTime = start;
        updatedEvent.PlannedEndTime = end;
        await pApi.UpdatePlanItem(updatedEvent);
        // Create updated model
        // var updatedEvent = new ProductionPlanEvent(eventId);  // Title not needed for update
        // updatedEvent.Id = eventId;
        // Post to API securely via DownstreamApi (handles Entra token)
        // await DownstreamApi.PutForUserAsync<object>("MyApi", $"/api/events/{eventId}", updatedEvent);

        // Optional: Refresh calendar or show FluentToast success
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }
    // These are called from JavaScript
    // [JSInvokable]
