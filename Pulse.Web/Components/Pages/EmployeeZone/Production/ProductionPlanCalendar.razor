
@inject IJSRuntime JS
@inject PulseApiService pApi
@inject DataTransferService dt
@using Microsoft.JSInterop
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web
@using Pulse.Models.CustomComponents
@using Pulse.Models.Organizational
@using Pulse.Models.Production
@using Pulse.Web.Services

<div id="external-events" style="flex: 1 1; max-width:10%;">
    @if (unplannedWO != null)
    {
        foreach (var item in unplannedWO)
        {
            string eventInfo = $"{item.ClientName}<br />{item.Description}<br />{item.Stage}";
            <Popover Placement="Placement.Bottom" Title="@item.Title" Content="@eventInfo" IsHtml="true">
                <div class="fc-event" data-id=@item.Id>@item.Title</div>
            </Popover>
            @* <div class="fc-event" data-event="id: @item.Id">@item.Title</div> *@
        }
    }
</div>
<div id="calendar" class="fc-container" style="width:90%;"></div>
@* <div id="calendar" class="fc-container"></div> *@

@code {
    // [Parameter] public string ElementId { get; set; } = "calendar";
    // [Parameter] public IEnumerable<CalendarEvent> Events { get; set; } = Array.Empty<CalendarEvent>();

    // // These are the callbacks from JS
    // [Parameter] public EventCallback<string> DateClicked { get; set; }
