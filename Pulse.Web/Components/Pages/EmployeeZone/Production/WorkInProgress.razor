    private IDialogReference? _dialog;

    // Filter state
    private string filterWONo = string.Empty;
    private string filterClient = string.Empty;
    private string filterWorkType = string.Empty;
    private string filterStage = string.Empty;
    private bool showFilter = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Division = await dataTrf.GetgvSelectedDivision();
            await dataTrf.SetgvContextArea(3);
            ShowAiIcon showAi = new ShowAiIcon();
            showAi.showAli = true;
            await dataTrf.SetgvShowAI(showAi);
            await AppState.NotifyStateChanged();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error loading WIP: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            wipItems = await pApiClient.GetAsync<List<WorkInProgressDto>>($"/Divisions/{Division.DivisionID}/GetWIP");
            await dataTrf.SetgvSelectedDivisionWIP(wipItems);
            filteredItems = wipItems?.ToList() ?? new();
            filteredItemsQueryable = filteredItems.AsQueryable();
            await LoadStateAsync();
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnCellContextMenu(DataGridCellMouseEventArgs<WorkInProgressDto> args)
    {
        selectedWO = new List<WorkInProgressDto>() { args.Data };
        StateHasChanged(); // Add this to ensure UI updates immediately

        ContextMenuService.Open(args,
            new List<ContextMenuItem> {
            new ContextMenuItem(){ Text = "View The WO Details", Value = 1, Icon = "pageview", IconColor="@Colors.Info" },
            new ContextMenuItem(){ Text = "Add To Todays Plan", Value = 2, Icon = "note_add", IconColor="@Colors.Success" },
            new ContextMenuItem(){ Text = "Complete This Stage", Value = 3, Icon = "check_circle", IconColor="@Colors.Warning" },
            },
            async (e) =>
            {
                var tM = $"Cell context menu item clicked. Value={e.Value}, Column: {args.Column.Property}, WO No: {args.Data.WorksOrderNo}";
                woPulseToastService.ShowToast("Success", tM, true);
                await woGlobal_AI.AISpeak(tM, "PulseAI");

                // Handle different menu options
                switch (e.Value)
                {
                    case 1: // View WO Details
                        await InvokeAsync(StateHasChanged);
                        break;
                    case 2: // Add To Todays Plan
                            // Your logic here
                        break;
                    case 3: // Complete This Stage
                            // Your logic here
                        break;
                }
            }
        );
    }


    void ToggleGroups(bool value)
    {
        allGroupsExpanded = value;
    }
    void OnGroupRowRender(GroupRowRenderEventArgs args)
    {

        args.Expanded = allGroupsExpanded; 
        args.Expandable = true;
    }
    

    DataGridSettings _WIPdgSettings;
    public DataGridSettings WIPdgSettings
    {
        get
        {
            return _WIPdgSettings;
        }
        set
        {
            if (_WIPdgSettings != value)
            {
                _WIPdgSettings = value;
                InvokeAsync(SaveStateAsync);
            }
        }
    }
    void LoadSettings(DataGridLoadSettingsEventArgs args)
    {
        if (WIPdgSettings != null)
        {
            args.Settings = WIPdgSettings;
        }
    }
    private async Task LoadStateAsync()
    {
        await Task.CompletedTask;

        var result = await JS.InvokeAsync<string>("window.localStorage.getItem", "WIPdgSettings");
        if (!string.IsNullOrEmpty(result))
        {
            _WIPdgSettings = JsonSerializer.Deserialize<DataGridSettings>(result);
        }
    }

    private async Task SaveStateAsync()
    {
        await Task.CompletedTask;

        await JS.InvokeVoidAsync("window.localStorage.setItem", "WIPdgSettings", JsonSerializer.Serialize<DataGridSettings>(WIPdgSettings));
    }

