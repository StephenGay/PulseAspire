        // {
        //     Content = wipWO,
        //     Alignment = Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Left,
        //     Title = "Work Order Production Plan",
        //     PrimaryAction = "Add To Plan",
        //     SecondaryAction = "Cancel",
        //     Width = "50%",
        // });
