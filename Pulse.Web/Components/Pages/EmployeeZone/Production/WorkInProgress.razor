@page "/EmployeeZone/Production/WorkInProgress"
@using Pulse.Models.Misc
@using Pulse.Models.Organizational
@using Pulse.Models.Production
@using System.Net.Http.Json
@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Web.Services
@using System.Threading.Tasks
@using System.Text.Json
@using Pulse.Web.Components.Pages.EmployeeZone.Production.Dialogs
@* @inject HttpClient Http *@
@inject IPulseToastService woPulseToastService
