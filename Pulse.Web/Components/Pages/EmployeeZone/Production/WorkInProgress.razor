            <FluentSpacer />
            
        </FluentStack>
    </div> *@
    
    @if (wipItems is null)
    {
        <div class="div-center-screen">
            <FluentProgressRing />
        </div>
    }
    else if (!wipItems.Any())
    {
        <div class="div-center-screen">
            <FluentLabel Typo="Typography.Header" >No Work In Progress Found</FluentLabel>
        </div>
    }
    else
    {
        
        <!-- Data Grid -->
        <div class="ccontent">

            <RadzenDataGrid @ref="radWIPGrid"
                            Data="@wipItems"
                            FilterMode="FilterMode.Simple"
                            AllowFiltering="true"
                            AllowPaging="false"
                            AllowSorting="true"
                            AllowColumnResize="true"
                            ExpandMode="DataGridExpandMode.Multiple"
                            ShowExpandAll="true"
                            ExpandAllTitle="Ex"
                            ShowGroupExpandColumn="true"
                            Style="height:100%;border-radius:10px"
                            AllowVirtualization="true"
                            AllowColumnPicking="true"
                            @bind-AllGroupsExpanded="@allGroupsExpanded"
                            GroupRowRender="OnGroupRowRender"
                            AllowGrouping="true"
                            HideGroupedColumn="true"
                            IsLoading="@isLoading"
                            SelectionMode="DataGridSelectionMode.Single"
                            @bind-Value="@selectedWO"
                            @bind-Settings="@WIPdgSettings"
                            LoadSettings="@LoadSettings"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            LogicalFilterOperator="LogicalFilterOperator.And"
                            CellContextMenu="@((DataGridCellMouseEventArgs<WorkInProgressDto> args) => OnCellContextMenu(args))"
                            ColumnWidth="200px">
                <HeaderTemplate>
                    <div style="text-align:left;width:stretch">
                    @* <RadzenButton Text="Expand all groups" Click="@(args => ToggleGroups(true))" Disabled=@(allGroupsExpanded == true) />
                        <RadzenButton Text="Collapse all groups" Click="@(args => ToggleGroups(true))" Disabled=@(allGroupsExpanded == true) /> *@
                        <FluentButton BackgroundColor="var(--pulse-accent-btn-bg)" Class=@(allGroupsExpanded == false ? "btnShadow" : "") style="border: 1px solid var(--pulse-accent-btn-colour); width:50px;height:50px" OnClick="@(args => ToggleGroups(true))" Disabled=@(allGroupsExpanded == true)>
                            <FluentIcon Value="@(new Icons.Filled.Size28.PanelLeftExpand())" Width="36px" Color="MsFluent.Color.Custom" CustomColor="var(--pulse-accent-btn-colour)" />
                        </FluentButton>
                        <FluentButton BackgroundColor="var(--pulse-accent-btn-bg)" Class="myAccentBtn" style="border: 1px solid var(--pulse-accent-btn-colour); width:50px;height:50px" OnClick="@(args => ToggleGroups(false))" Disabled=@(allGroupsExpanded == false)>
                            <FluentIcon Value="@(new Icons.Filled.Size28.PanelRightExpand())" Width="36px" Color="MsFluent.Color.Custom" CustomColor="var(--pulse-accent-btn-colour)" />
                    </FluentButton>
                        <FluentButton Appearance="Appearance.Neutral" Class="myOkBtn" BackgroundColor="var(--pulse-ok-btn-bg)" Style="margin-left:30px;margin-right:30px;height:50px;padding-left:10px;padding-right:10px;" id="btnSaveLayout" OnClick="() => InvokeAsync(SaveStateAsync)">
                            <FluentIcon Value="@(new Icons.Filled.Size28.Save())" Width="36px" Color="MsFluent.Color.Custom" CustomColor="var(--pulse-ok-btn-colour)" />
                            Save Layout
                    </FluentButton>
                        <FluentButton BackgroundColor="var(--pulse-accent-btn-bg)" Class="myAccentBtn" Style="margin-right:30px;height:50px;padding-left:10px;padding-right:10px" id="btnPlanByWO" data-bs-toggle="offcanvas" data-bs-target="#WOPlan">
                            <FluentIcon Value="@(new Icons.Filled.Size28.DocumentOnePageMultiple())" Width="36px" Color="MsFluent.Color.Custom" CustomColor="var(--pulse-accent-btn-colour)" />
                            WO Details
                    </FluentButton>
                    </div>
                </HeaderTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="WorkInProgressDto" Property="WorksOrderNo" Title="WO No" Width="70px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="WorkInProgressDto" Property="WorkTypeName" Title="Work Type" FilterMode="FilterMode.CheckBoxList" />
                    <RadzenDataGridColumn TItem="WorkInProgressDto" Property="WorkCentreName" Title="Work Centre" Pickable="true" FilterMode="FilterMode.CheckBoxList" />
                    <RadzenDataGridColumn TItem="WorkInProgressDto" Property="ClientName" Title="Client Name" />
                    <RadzenDataGridColumn TItem="WorkInProgressDto" Property="Description" Title="Description" />
                    <RadzenDataGridColumn TItem="WorkInProgressDto" Property="UndelQty" Title="Qty" Filterable="false" />
                    <RadzenDataGridColumn TItem="WorkInProgressDto" Property="ProductionStageName" Title="Stage" Pickable="true" FilterMode="FilterMode.CheckBoxList" />
                    <RadzenDataGridColumn TItem="WorkInProgressDto" Property="MaterialCost" Title="Material Cost" Filterable="false" Visible="false" />
                    <RadzenDataGridColumn TItem="WorkInProgressDto" Property="SellPrice" Title="Sell Price" Pickable="true" Filterable="false" Visible="false" />

                </Columns>
            </RadzenDataGrid>

            


           
        </div>
    }
    <div class="offcanvas offcanvas-bottom" style="width:100%; height:calc(100vh - 112px)" tabindex="-1" id="WOPlan" aria-labelledby="woLabel">
        <FluentButton BackgroundColor="rgba(255,255,255,1)" Style="position:absolute; border: 1px solid red;height:40px;margin-top:8px;left:calc(100vw - 5%)"
                      IconStart="@(new Icons.Filled.Size32.DismissSquare().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Error))" data-bs-dismiss="offcanvas">
            Close
        </FluentButton>
        <PlanByWODrawer SelectedWorkOrder="@selectedWO?.FirstOrDefault()" />
    </div>
</div>


