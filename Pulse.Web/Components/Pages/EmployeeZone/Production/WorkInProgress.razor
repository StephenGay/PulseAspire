<style>
    .cparent {
        display: flex;
        flex-direction: column;
        height: 100%;
        width:100%;
    }

    .cheader, .cfooter {
        height: 50px;
        /* width: 50%;
        z-index: 200; */
    }

    .ccontent {
        flex: 1;
        background: white;
        margin: -10px -10px -10px -10px;
        /* padding: 10px; */
        border-radius: 10px;
        overflow: auto;
    }
    :root{
        --rz-grid-header-background-color: var(--pulse-light-colour) !important;
        --rz-grid-header-filter-icon-active-color: var(--pulse-light-colour) !important;
        --rz-grid-header-color: var(--pulse-light-colour) !important;
        --rz-grid-selected-background-color: var(--pulse-dark-colour) !important;
        --rz-grid-selected-color: var(--pulse-light-colour) !important;
        --rz-grid-hover-background-color: var(--pulse-light-colour) !important;
    }

    .wipfdgrselected {
        background-color: #bcd1d4 !important;
        color: rgb(54,91,102) !important;
    }

    .wipfdgrunselected {
        background-color: white;
        color: rgb(54,91,102) !important;
    }

    .wipfdgrunselected:hover {
        cursor: pointer;
    }

    .filter-section {
        background-color: #f5f5f5;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 10px;
    }

    .filter-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        gap: 12px;
        margin-bottom: 12px;
    }

    @@media (max-width: 1200px) {
        .filter-row {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 768px) {
        .filter-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="cparent">
    @* <div class="cheader">
        <FluentStack Orientation="MsFluent.Orientation.Horizontal" VerticalAlignment="MsFluent.VerticalAlignment.Center" Style="padding-top:15px;padding-left:15px;padding-right:15px;padding-bottom:0px">
