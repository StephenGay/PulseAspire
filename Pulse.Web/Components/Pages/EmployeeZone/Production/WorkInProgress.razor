@page "/EmployeeZone/Production/WorkInProgress"
@using Pulse.Models.Misc
@using Pulse.Models.Organizational
@using Pulse.Models.Production
@using System.Net.Http.Json
@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Web.Services
@using System.Threading.Tasks
@using Pulse.Web.Components.Pages.EmployeeZone.Production.Dialogs
@* @inject HttpClient Http *@
@inject PulseApiService pApiClient
@inject DataTransferService dataTrf
@inject AppState AppState
@inject IDialogService DialogService
@inject IJSRuntime JS
@rendermode InteractiveServer

<style>
    .cparent {
        display: flex;
        flex-direction: column;
        height: 100%;
        width:100%;
    }

    .cheader, .cfooter {
        min-height: 50px;
    }

    .ccontent {
        flex: 1;
        background: white;
        margin: 10px;
        padding: 10px;
        border-radius: 10px;
        overflow: auto;
    }

    .wipfdgrselected {
        background-color: #bcd1d4 !important;
        color: rgb(54,91,102) !important;
    }

    .wipfdgrunselected {
        background-color: white;
        color: rgb(54,91,102) !important;
    }

    .wipfdgrunselected:hover {
        cursor: pointer;
    }

    .filter-section {
        background-color: #f5f5f5;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 10px;
    }

    .filter-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        gap: 12px;
        margin-bottom: 12px;
    }

    @@media (max-width: 1200px) {
        .filter-row {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 768px) {
        .filter-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="cparent">
    <div class="cheader">
        <FluentStack Orientation="MsFluent.Orientation.Horizontal" VerticalAlignment="MsFluent.VerticalAlignment.Center" Style="padding-top:15px;padding-left:15px;padding-right:15px;padding-bottom:0px">
            <FluentLabel Typo="MsFluent.Typography.Header" Color="MsFluent.Color.Custom" CustomColor="rgb(255,255,255)">Work In Progress for Division @Division.DivisionName</FluentLabel>
            <FluentSpacer />
            <FluentButton Appearance="Appearance.Neutral" id="btnPlanByWO" data-bs-toggle="offcanvas" data-bs-target="#WOPlan"> @*  OnClick="() => AddToPlan(selectedWO[0])"> *@
                WO Details
            </FluentButton>
        </FluentStack>
    </div>
    
    @if (wipItems is null)
    {
        <div class="div-center-screen">
            <FluentProgressRing />
        </div>
    }
    else if (!wipItems.Any())
    {
        <FluentMessageBar Severity="MessageSeverity.Info">No WIP items found.</FluentMessageBar>
    }
    else
    {
        @if (showFilter)
        {
            
        
        <!-- Filter Section -->
        <div class="filter-section">
                <FluentStack Orientation="MsFluent.Orientation.Vertical" Style="gap: 12px;">
                <FluentLabel Typo="Typography.H5">Filters</FluentLabel>
                
                <div class="filter-row">
                    <FluentTextField @bind-Value="filterWONo" 
                                     Label="WO No" 
                                     Placeholder="Filter by Work Order..."
                                     @oninput="@((ChangeEventArgs e) => { filterWONo = e.Value?.ToString() ?? string.Empty; ApplyFilters(); })" />
                    
                    <FluentTextField @bind-Value="filterClient" 
                                     Label="Client" 
                                     Placeholder="Filter by Client..."
                                     @oninput="@((ChangeEventArgs e) => { filterClient = e.Value?.ToString() ?? string.Empty; ApplyFilters(); })" />
                    
                    <FluentTextField @bind-Value="filterWorkType" 
                                     Label="Work Type" 
                                     Placeholder="Filter by Work Type..."
                                     @oninput="@((ChangeEventArgs e) => { filterWorkType = e.Value?.ToString() ?? string.Empty; ApplyFilters(); })" />
                    
                    <FluentTextField @bind-Value="filterStage" 
                                     Label="Stage" 
                                     Placeholder="Filter by Stage..."
                                     @oninput="@((ChangeEventArgs e) => { filterStage = e.Value?.ToString() ?? string.Empty; ApplyFilters(); })" />
                </div>

                <FluentStack Orientation="MsFluent.Orientation.Horizontal" Style="gap: 8px;">
                    <FluentButton Appearance="Appearance.Neutral" OnClick="ClearFilters">
                        Clear Filters
                    </FluentButton>
                    <FluentLabel Typo="MsFluent.Typography.Body" Style="color: #666;">
                        Showing @filteredItems?.Count() of @wipItems?.Count() items
                    </FluentLabel>
                </FluentStack>
            </FluentStack>
        </div>
        }
        <!-- Data Grid -->
        <div class="ccontent">

            <RadzenDataGrid @ref="radWIPGrid"
                            Data="@wipItems"
                            FilterMode="FilterMode.Simple"
                            AllowFiltering="true"
                            AllowPaging="false"
                            AllowSorting="true"
                            AllowColumnResize="true"
                            Style="height:100%;border-radius:10px"
                            AllowVirtualization="true"
                            AllowColumnPicking="true"
                            onh
                            IsLoading="@isLoading"
                            SelectionMode="DataGridSelectionMode.Single"
                            @bind-Value="@selectedWO"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            LogicalFilterOperator="LogicalFilterOperator.And"
                            ColumnWidth="200px">

                <Columns>
                    <RadzenDataGridColumn TItem="WorkInProgressDto" Property="WorksOrderNo" Title="WO No" Width="70px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="WorkInProgressDto" Property="WorkTypeName" Title="Work Type" FilterMode="FilterMode.CheckBoxList" />
                    <RadzenDataGridColumn TItem="WorkInProgressDto" Property="WorkCentreName" Title="Work Centre" Pickable="true" FilterMode="FilterMode.CheckBoxList" />
                    <RadzenDataGridColumn TItem="WorkInProgressDto" Property="ClientName" Title="Client Name" />
                    <RadzenDataGridColumn TItem="WorkInProgressDto" Property="Description" Title="Description" />
                    <RadzenDataGridColumn TItem="WorkInProgressDto" Property="UndelQty" Title="Qty" Filterable="false" />
                    <RadzenDataGridColumn TItem="WorkInProgressDto" Property="ProductionStageName" Title="Stage" Pickable="true" FilterMode="FilterMode.CheckBoxList" />
                    <RadzenDataGridColumn TItem="WorkInProgressDto" Property="MaterialCost" Title="Material Cost" Filterable="false" Visible="false" />
                    <RadzenDataGridColumn TItem="WorkInProgressDto" Property="SellPrice" Title="Sell Price" Pickable="true" Filterable="false" Visible="false" />

                </Columns>
            </RadzenDataGrid>

            <div class="offcanvas offcanvas-bottom" style="width:100%; height:calc(100vh - 112px)" tabindex="-1" id="WOPlan" aria-labelledby="woLabel">
                <FluentButton BackgroundColor="rgba(255,255,255,1)" Style="position:absolute; border: 1px solid red;height:40px;margin-top:8px;left:calc(100vw - 50%)"
                                IconStart="@(new Icons.Filled.Size32.DismissSquare().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Error))" data-bs-dismiss="offcanvas">
                    Close
                </FluentButton>
                <PlanByWODrawer SelectedWorkOrder="@selectedWO?.FirstOrDefault()" />
            </div>


            @* <FluentDataGrid Items="@filteredItemsQueryable" 
                TGridItem="WorkInProgressDto" 
                GenerateHeader="GenerateHeaderOption.Sticky" 
                SelectionMode="SelectionMode.Single"
                SelectedItem="@selectedWO"
                RowClass="@(context => context == selectedWO ? "wipfdgrselected" : "wipfdgrunselected")"
                ResizableColumns="true" 
                Pagination="@pagination" 
                OnRowClick="OnWORowClick"
                AutoFit="true">
                <PropertyColumn Property="@(c => c.WorksOrderNo)" Sortable="true" Align="Align.Center" Title="WO No" />
                <PropertyColumn Property="@(c => c.WorkTypeName)" Sortable="true" Title="Work Type" />
                <PropertyColumn Property="@(c => c.ClientName)" Sortable="true" Title="Client" />
                <PropertyColumn Property="@(c => c.Description)" Title="Description" />
                <PropertyColumn Property="@(c => c.UndelQty)" Sortable="true" Align="Align.Center" Title="Qty" Format="#,##0.##" />
                <PropertyColumn Property="@(c => c.ProductionStageName)" Sortable="true" Title="Stage" />
                <TemplateColumn Title="Plan" Style="padding:0px !important;">
                    <FluentIcon Value="@(new Icons.Filled.Size32.AddSquare().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Success))" OnClick="() => AddToPlan(context)" />
                    <FluentIcon Value="@(new Icons.Filled.Size32.CalendarEdit().WithColor(Microsoft.FluentUI.AspNetCore.Components.Color.Accent))" OnClick="() => AddToPlan(context)" />
                </TemplateColumn>
            </FluentDataGrid>
            <FluentPaginator State="@pagination" Style="background-color: #365b66 ; padding:10px ; color: white; width:100%" /> *@
        </div>
    }
</div>


@code {
    private RadzenDataGrid<WorkInProgressDto>? radWIPGrid;
    private Division? Division;
    private List<WorkInProgressDto>? wipItems;
    private bool isLoading = true;
    private IList<WorkInProgressDto>? selectedWO;

    private List<WorkInProgressDto>? filteredItems;
    private IQueryable<WorkInProgressDto>? filteredItemsQueryable;
    
    private PaginationState pagination = new PaginationState { ItemsPerPage = 23 };
    private IDialogReference? _dialog;

    // Filter state
    private string filterWONo = string.Empty;
    private string filterClient = string.Empty;
    private string filterWorkType = string.Empty;
    private string filterStage = string.Empty;
    private bool showFilter = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Division = await dataTrf.GetgvSelectedDivision();
            await dataTrf.SetgvContextArea(3);
            ShowAiIcon showAi = new ShowAiIcon();
            showAi.showAli = true;
            await dataTrf.SetgvShowAI(showAi);
            await AppState.NotifyStateChanged();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error loading WIP: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            wipItems = await pApiClient.GetAsync<List<WorkInProgressDto>>($"/Divisions/{Division.DivisionID}/GetWIP");
            await dataTrf.SetgvSelectedDivisionWIP(wipItems);
            filteredItems = wipItems?.ToList() ?? new();
            filteredItemsQueryable = filteredItems.AsQueryable();
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        if (wipItems == null) return;

        filteredItems = wipItems
            .Where(item => 
                (string.IsNullOrWhiteSpace(filterWONo) || item.WorksOrderNo.ToString().Contains(filterWONo, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrWhiteSpace(filterClient) || (item.ClientName?.Contains(filterClient, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (string.IsNullOrWhiteSpace(filterWorkType) || (item.WorkTypeName?.Contains(filterWorkType, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (string.IsNullOrWhiteSpace(filterStage) || (item.ProductionStageName?.Contains(filterStage, StringComparison.OrdinalIgnoreCase) ?? false))
            )
            .ToList();

        filteredItemsQueryable = filteredItems.AsQueryable();
        
        // Reset pagination to first page by creating new PaginationState
        pagination = new PaginationState { ItemsPerPage = 23 };
        
        StateHasChanged();
    }

    private void ClearFilters()
    {
        filterWONo = string.Empty;
        filterClient = string.Empty;
        filterWorkType = string.Empty;
        filterStage = string.Empty;
        
        filteredItems = wipItems?.ToList() ?? new();
        filteredItemsQueryable = filteredItems.AsQueryable();
        
        // Reset pagination to first page by creating new PaginationState
        pagination = new PaginationState { ItemsPerPage = 23 };
        
        StateHasChanged();
    }

    private void OnWORowClick(FluentDataGridRow<WorkInProgressDto> args)
    {
        try
        {
            // selectedWO = args.Item;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            return;
        }
    }

    private async Task AddToPlan(WorkInProgressDto wipWO)
    {
