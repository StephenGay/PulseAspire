@code {
    [CascadingParameter]
    MasterLayout masterLayout { get; set; } = default!;

    private bool pgMain = true;
    private string pgFrom = "Main";
    private List<EquipmentTableItemDto> equipmentTableItemDtos = [];
    private RadzenDataGrid<EquipmentTableItemDto> eqGrid = default!;
    private EquipmentTableItemDto? selectedEquip;
    private IList<EquipmentTableItemDto>? selectedEquipDto;
    private EquipmentItem? editingEquip;
    private List<EquipmentCategory> eqCat = [];
    private bool startAni = false;
    private bool isSaving = false;
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadEquipmentCategories();
        await LoadEquipment();
        await InvokeAsync(StateHasChanged);
    }
    private async Task SaveEquipment()
    {
        isSaving = true;
        var response = await pApi.PostAsync<EquipmentItem, ApiResponse>(ApiEndpoints.Production.Equipment.MasterFile.Update, editingEquip);
        if (response.Success)
        {
            // editingEquip = new EquipmentItem();
            await LoadEquipment();
            isSaving = false;
            isEditing = false;
            // startAni = true;
            // await InvokeAsync(StateHasChanged);
        }

    }
    private async Task CancelEdit()
    {
        // editingEquip = new EquipmentItem();
        isEditing = false;
        // startAni = true;
        // await InvokeAsync(StateHasChanged);
    }
    private async Task LoadEquipment()
    {
        try
        {
            equipmentTableItemDtos = (await pApi.GetAsync<ApiResponse<List<EquipmentTableItemDto>>>(ApiEndpoints.Production.Equipment.ByDivision.GetList(masterLayout.division.DivisionID))).Data;

            // StateHasChanged();
        }
        catch (Exception ex)
        {
            // NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to load themes: {ex.Message}");
        }
    }

    private async Task LoadEquipmentCategories()
    {
        try
        {
            eqCat = (await pApi.GetAsync<ApiResponse<List<EquipmentCategory>>>(ApiEndpoints.Production.Equipment.Categories.Get)).Data;

            // StateHasChanged();
        }
        catch (Exception ex)
        {
            // NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to load themes: {ex.Message}");
        }
    }

    private void EndAnimation(string pgCalling)
    {
        if (pgCalling == pgFrom)
        {
            pgMain = !pgMain;
        }
        else
        {
            if (pgMain)
            {
                pgFrom = "Main";
            }
            else
            {
                pgFrom = "Edit";
            }
            startAni = false;
        }
    }
    private async Task EditEquip(EquipmentTableItemDto equip)
    {
        var itemID = equip.EquipmentID.ToString();
        editingEquip = (await pApi.GetAsync<ApiResponse<EquipmentItem>>(ApiEndpoints.Production.Equipment.GetByID(itemID))).Data;
        await InvokeAsync(StateHasChanged);
        startAni = true;
