@page "/EmployeeZone/Production/Setup/Equipment/EquipmentPg"

@using Pulse.Models.Api
@using Pulse.Models.Dtos.Equipment
@using Pulse.Web.Services
@using Pulse.Models.Production
@using Pulse.Models.Misc

@inject PulseApiService pApi
@rendermode InteractiveServer

<FluentHeader Style="background-color: var(--pulse-dark-t75-colour); margin: -16px -16px 16px -16px; padding: 10px;">
    
    <FluentLabel Typo="Typography.PaneHeader" Style="margin-left:10px;color:var(--pulse-light-colour);">
        @(pgMain ? "Equipment" : (editingEquip.EquipmentItemID == null ? "New Equipment Item" : $"{(isEditing ? "Edit: " : "")}  {editingEquip.EquipmentItemDescription}"))
    </FluentLabel>
    <FluentSpacer />
    <FluentButton Class="myAccentBtn" BackgroundColor="var(--pulse-accent-btn-bg)" style="height:35px;width:fit-content;padding: 5px;margin-top:5px" Color="var(--pulse-accent-btn-colour)" Disabled="@(pgMain || isEditing ? true : false)" OnClick="@(() => { startAni = true; })">
        <FluentIcon Value="@(new Icons.Filled.Size16.ArrowCircleLeft().WithColor("var(--pulse-accent-btn-colour)"))" />
        Back
    </FluentButton>
</FluentHeader>
@* <div Id="divOverview" style="height:stretch;width:stretch"> *@
@if (pgMain)
{
    <Animation Effect="@(pgFrom == "Main" ? Effect.BounceOutDown : Effect.BounceInUp)" Enabled="@startAni" Speed="@Speed.Slow" Style="height:calc(100% - 66px);" OnAnimationEnd="@(() => EndAnimation("Main"))">
    <RadzenDataGrid @ref="eqGrid"
    Data="@equipmentTableItemDtos"
    TItem="EquipmentTableItemDto"
    AllowSorting="true"
    AllowVirtualization="true"
    AllowPaging="false"
    PageSize="11"
    AllowGrouping="true"
    Style="display: flex; height:stretch;overflow:auto;"
    FilterMode="FilterMode.Simple"
    AllowFiltering="true"
                        
    SelectionMode="DataGridSelectionMode.Single"
    @bind-Value="@selectedEquipDto">
        @* RowClick="@(args => EditTheme(args.Data))" *@
        <Columns>
            <RadzenDataGridColumn TItem="EquipmentTableItemDto" Property="Description" Title="Description" Width="180px" />
            <RadzenDataGridColumn TItem="EquipmentTableItemDto" Property="Category" Title="Category" FilterMode="FilterMode.CheckBoxList" Width="90px" />
            <RadzenDataGridColumn TItem="EquipmentTableItemDto" Property="ManufacturerName" Title="Manufacturer" FilterMode="FilterMode.CheckBoxList" Width="80px" />
            <RadzenDataGridColumn TItem="EquipmentTableItemDto" Property="Model" Title="Model" Width="80px" />
                <RadzenDataGridColumn TItem="EquipmentTableItemDto" Property="IsOperational" Title="Operational" Width="70px">
                <Template Context="equip">
                    @if (equip.isOperational)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Yes" />
                    }
                    else
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="No" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EquipmentTableItemDto" Title="Actions" Width="160px" Sortable="false">
                <Template Context="equip">
                    <RadzenButton Icon="edit" Click="() => EditEquip(equip)"
                    ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" class="me-1" />
                    @* <RadzenButton Icon="check_circle" Text="Activate"
                                  Click="() => ActivateTheme(theme)"
                                  ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                  Disabled="@theme.IsActive" class="me-1" /> *@
                    <RadzenButton Icon="delete" Click="() => DeleteEquip(equip)"
                    ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    </Animation>
}
else
{
    @if(editingEquip == null)
    {

    }
    else
    {
        
        <Animation Effect="@(pgFrom == "Main" ? Effect.BounceInUp : Effect.BounceOutDown)" Enabled="@startAni" Speed="@Speed.Slow" Style="height:calc(100% - 66px);" OnAnimationEnd="@(() => EndAnimation("Edit"))">

            @* <FluentCard Style="@(isEditing ? "opacity:0.5" : "opacity:1")"> *@
            <div style="background-color:rgba(0,0,0,0);overflow:auto;padding:20px;">
                    <RadzenRow Gap="1rem">
                        @* <div class="d-flex justify-content-between align-items-center mb-3" style="width:stretch;padding-top:10px">
                        <FluentLabel Typo="Typography.H5">@(editingEquip.EquipmentItemID == null ? "New Equipment Item" : $"{(isEditing ? "Edit: " : "")}  {editingEquip.EquipmentItemDescription}")</FluentLabel>
                            @* <h5 class="mb-0">@(editingEquip.EquipmentItemID == null ? "New Equipment Item" : $"{(isEditing ? "Edit: " : "")}  {editingEquip.EquipmentItemDescription}")</h5> *@
                    @* <div>
                                <FluentButton Class="myAccentBtn" BackgroundColor="var(--pulse-accent-btn-bg)" 
                                                Color="var(--pulse-accent-btn-colour)"
                                              @onclick="() => isEditing = true"
                                              IconStart="@(new Icons.Filled.Size24.Edit().WithColor("var(--pulse-accent-btn-colour)"))"
                                              Style="height:40px;"
                                              Disabled="@isEditing">
                                    Edit
                                </FluentButton>
                                <FluentButton Class="myAccentBtn" 
                                                BackgroundColor="var(--pulse-accent-btn-bg)"
                                                Color="var(--pulse-accent-btn-colour)"
                                                IconStart="@(new Icons.Filled.Size24.ArrowCircleLeft().WithColor("var(--pulse-accent-btn-colour)"))"
                                                Style="height:40px"
                                                onclick="() => startAni = true"
                                                Disabled="@isEditing">
                                    Back
                                </FluentButton>
                            </div>
                        </div> *@
                        <RadzenColumn Size="4" >
                            <div class="@(isEditing ? "colEditMode" : "colViewMode")" style="margin-bottom:20px">
                            <FluentTextField @bind-Value="editingEquip.EquipmentItemDescription" Style="width:stretch" Appearance="FluentInputAppearance.Filled" Placeholder="Enter a description for the item" ReadOnly="!isEditing" Label="Description" />
                            <FluentTextField @bind-Value="editingEquip.EquipmentItemDescription2" Style="width:stretch" Appearance="FluentInputAppearance.Filled" Placeholder="Enter an alternative description for the item" ReadOnly="!isEditing" Label="Description (Alternate)" />
                                <FluentSelect @bind-Value="editingEquip.EquipmentCategoryID"
                                                ReadOnly="!isEditing"
                                                Items=@eqCat
                                                Appearance="Appearance.Filled"  
                                                Label="Category" 
                                                TOption="EquipmentCategory" 
                                          Style="width:stretch"
                                                OptionValue="@(i => i.EquipmentCategoryID)"
                                                OptionText="@(i => i.EquipmentCategoryName)" />
                            <FluentTextField @bind-Value="editingEquip.ManufacturerName" Style="width:stretch" Appearance="FluentInputAppearance.Filled" Placeholder="Enter the name of the Manufacturer" ReadOnly="!isEditing" Label="Manufacturer" />
                            <FluentTextField @bind-Value="editingEquip.Model" Style="width:stretch" Appearance=" FluentInputAppearance.Filled" Placeholder="Enter the Model Name" ReadOnly="!isEditing" Label="Model" />
                            <FluentTextField @bind-Value="editingEquip.FixedAssetNo" Style="width:stretch" Appearance="FluentInputAppearance.Filled" Placeholder="Enter the Fixed Asset Code" ReadOnly="!isEditing" Label="Fixed Asset Code" />
                            <FluentTextField @bind-Value="editingEquip.SerialNo" Style="width:stretch" Appearance="FluentInputAppearance.Filled" Placeholder="Enter the Serial Number" ReadOnly="!isEditing" Label="Serial Number" />
                            <FluentLabel Typo="Typography.Body">Operational Status</FluentLabel>
                            <FluentSwitch @bind-Value="editingEquip.IsOperational" CheckedMessage="Operational" UncheckedMessage="Currently Offline" ReadOnly="!isEditing" /><br />
                            <br />
                            <FluentLabel Typo="Typography.Body">Active / Decommisioned</FluentLabel>
                            <FluentSwitch @bind-Value="editingEquip.IsActive" CheckedMessage="Active" UncheckedMessage="Decommisioned" ReadOnly="!isEditing" /><br />
                            <div class="d-flex justify-content-center align-items-center mb-3" style="width:stretch; margin-top:20px">
                                    @if (isEditing)
                                    {
                                        <FluentButton Class="myCancelBtn"
                                                      BackgroundColor="var(--pulse-cancel-btn-bg)"
                                                      Disabled="!isEditing"
                                                      Color="var(--pulse-cancel-btn-colour)"
                                                      IconStart="@(new Icons.Filled.Size24.DismissCircle().WithColor("var(--pulse-cancel-btn-colour)"))"
                                                      Style="height:40px;margin-right:10px"
                                                      onclick="CancelEdit">
                                            Cancel
                                        </FluentButton>
                                        <FluentButton Class="myOkBtn"
                                                      BackgroundColor="var(--pulse-ok-btn-bg)"
                                                      Color="var(--pulse-ok-btn-colour)"
                                                      @onclick="SaveEquipment"
                                                      IconStart="@(new Icons.Filled.Size24.Save().WithColor("var(--pulse-ok-btn-colour)"))"
                                                      Style="height:40px;"
                                                      Disabled="@(isSaving || !isEditing ? true : false)">
                                            Save
                                        </FluentButton>
                                    }
                                    else
                                    {
                                        <FluentButton Class="myAccentBtn" BackgroundColor="var(--pulse-accent-btn-bg)"
                                                      Color="var(--pulse-accent-btn-colour)"
                                                      @onclick="() => isEditing = true"
                                                      IconStart="@(new Icons.Filled.Size24.Edit().WithColor("var(--pulse-accent-btn-colour)"))"
                                                      Style="height:40px;margin-left:10px;"
                                                      Disabled="@isEditing">
                                            Edit
                                        </FluentButton>
                                    }
                                    
                                
                            </div>
                            </div>
                        </RadzenColumn>
                        <RadzenColumn Size="4" >
                            <div class="@(isEditing ? "colEditMode" : "colViewMode")" style="margin-bottom:20px">
                            <FluentTextField @bind-Value="editingEquip.Barcode" Appearance="FluentInputAppearance.Filled" Placeholder="Enter the QR Code" ReadOnly="!isEditing" Label="QR Code" Style="width:stretch" />
                            <RadzenStack AlignItems="AlignItems.Center" JustifyContent="Radzen.JustifyContent.Center" >
                                <RadzenQRCode Value="@editingEquip.Barcode" Style="width:50%;height:auto" />
                            </RadzenStack>
                            </div>
                        </RadzenColumn>
                    </RadzenRow>
                </div>
            @* </FluentCard> *@
        </Animation>
    }
}
@* </div> *@
