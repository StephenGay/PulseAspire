@using Pulse.Models.Api
@using Pulse.Models.Organizational
@using Pulse.Models.Production.Layout
@using Pulse.Web.Services

@inject PulseApiService ApiService
@inject ILogger<ZoneDialog> Logger
@inject IPulseToastService PulseToastService
@inject Global_AI_Functions GlobalAI
@inject DataTransferService dTrf

@implements IDialogContentComponent<FactoryZone>

<FluentDialogHeader ShowDismiss="false">
    <FluentLabel Typo="Typography.PaneHeader">
        @Dialog.Instance.Parameters.Title
    </FluentLabel>
</FluentDialogHeader>
<FluentDialogBody>
    <div style="min-width: 500px;max-width:500px;width:95%;border-radius:10px">
        <FluentTextField @bind-Value="Content.Name"
                Placeholder="Enter a Zone Name"
                Required="true"
                Label="Zone Name"
                Style="width:stretch; min-width: 200px;border: 1px solid var(--pulse-dark-colour);margin-bottom:5px" />
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Start" VerticalAlignment="VerticalAlignment.Center" Style="margin:10px 0 10px 0">
            <FluentLabel >Daily Target : </FluentLabel>
            <FluentSpacer />
            <FluentNumberField @bind-Value="Content.TargetMinUnitsPerDay"
                                Required="true"
                                Label="Minimum"
                               Style="width:100px;text-align:center;border: 1px solid var(--pulse-dark-colour);" />
            <FluentSpacer />
            <FluentNumberField @bind-Value="Content.TargetMaxUnitsPerDay"
                                Required="true"
                                Label="Maximum"
                               Style="width:100px;text-align:center;border: 1px solid var(--pulse-dark-colour);" />
        </FluentStack>
        <FluentTextField @bind-Value="Content.Notes"
                Placeholder="Enter Any Notes For Zone"
                Required="false"
                Label="Notes"
                Style="width:stretch; min-width: 200px;border: 1px solid var(--pulse-dark-colour);margin-bottom:5px" />
    
    </div>
</FluentDialogBody>
<FluentDialogFooter>
    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center">
        <FluentButton Class="myCancelBtn"
                      BackgroundColor="var(--pulse-cancel-btn-bg)"
                      Color="var(--pulse-cancel-btn-colour)"
                      IconStart="@(new Icons.Filled.Size24.DismissCircle().WithColor("--pulse-cancel-btn-colour"))"
                      Style="height:40px"
                      OnClick="@CancelAsync">
            Cancel
        </FluentButton>
        <FluentButton Class="myOkBtn"
                      BackgroundColor="var(--pulse-ok-btn-bg)"
                      Color="var(--pulse-ok-btn-colour)"
                      @onclick="SaveZone"
                      IconStart="@(new Icons.Filled.Size24.Save().WithColor("--pulse-ok-btn-colour"))"
                      Style="height:40px;"
                      Disabled="@(string.IsNullOrEmpty(Content?.Name))">
            Save
        </FluentButton>
    </FluentStack>
</FluentDialogFooter>

@code{
    [Parameter]    
    public FactoryZone? Content { get; set; } = default!;
    [CascadingParameter]
    public FluentDialog Dialog { get; set; } = default!;

    private async Task SaveZone()
    {
        bool isSuccess = false;

        try
        {
            Division d = await dTrf.GetgvSelectedDivision();
            var createResponse = await ApiService.PostAsync<FactoryZone, ApiResponse>(ApiEndpoints.Divisions.WithDivisionID.Factory.FactoryLayout.Zones.Save(d.DivisionID), Content);
            isSuccess = createResponse?.Success == true;
        }
        catch (Exception ex)
        {
            isSuccess = false;
        }
        finally
        {
            if (isSuccess)
            {
                PulseToastService.ShowToast("Success", $"The zone has been saved.");
                await GlobalAI.AISpeak($"The zone has been saved.", "PulseAI");
                await Dialog.CloseAsync();
            }
            else
            {
                Logger.LogError("Error saving zone");
                PulseToastService.ShowToast("Error", "There was a problem saving the Zone.<br />Please try again.");
                await GlobalAI.AISpeak("There was a problem saving the Zone.<br />Please try again.", "PulseAI");
            }
        }
        
    }

    private async Task CancelAsync()
    {
        await Dialog.CancelAsync();
    }
         
}