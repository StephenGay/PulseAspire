@using Pulse.Models.Production.Layout
@using Radzen.Blazor.Rendering
@implements IAsyncDisposable


<!-- DraggableZone.razor -->
<svg xmlns="http://www.w3.org/2000/svg" width="auto" height="auto">
    <g transform="translate(@Zone.X, @Zone.Y)"
       @onpointerdown="OnPointerDownWithSelection"
       @onpointerdown:stopPropagation="true"
       style="
           cursor: @(GetCursorStyle());
           user-select: none;
           transition: all 0.2s ease-out;">

        @if (IsSelected)
        {
            <defs>
                <filter id="@($"shadow-{Zone.Id}")" x="-50%" y="-50%" width="200%" height="200%">
                    <feGaussianBlur in="SourceAlpha" stdDeviation="4" />
                    <feOffset dx="3" dy="6" result="offsetblur" />
                    <feComponentTransfer>
                        <feFuncA type="linear" slope="0.6" />
                    </feComponentTransfer>
                    <feMerge>
                        <feMergeNode />
                        <feMergeNode in="SourceGraphic" />
                    </feMerge>
                </filter>
            </defs>
        }

        

        <rect width="@Zone.Width" height="@Zone.Height"
              fill="@Zone.Color" fill-opacity="0.85"
              stroke="@GetZoneStrokeColor(isDashboardHighlighted)" 
              stroke-width="@(GetZoneStrokeWidth(isDashboardHighlighted))"   
              rx="8"
              filter="@(IsSelected ? $"url(#shadow-{Zone.Id})" : "")" 
              class="@(Zone.IsBehindSchedule ? "zone-behind" : "")"
              style="transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);" />

        <text x="@(Zone.Width / 2)" y="@((Zone.Height - 5) / 2 )"
              text-anchor="middle" 
              fill="@Zone.TextColor" 
              font-size="14" 
              font-weight="500">
            @Zone.Description
        </text>

        <text x="@(Zone.Width / 2)" y="@(((Zone.Height - 5) / 2) + 16)"
              text-anchor="middle" fill="@Zone.TextColor" font-size="14"
              font-weight="500">
            @Zone.Name
        </text>

        <!-- ==================== VIEW MODE ONLY: Status Indicators ==================== -->
        @if (isDashboardHighlighted)
        {
            <g>
                <text x="@(Zone.Width / 2)" y="-8" 
                      text-anchor="middle" fill="#22d3ee" font-size="11" font-weight="700">
                    SELECTED
                </text>
            </g>
        }
        @if (!IsEditMode)
        {
            <!-- Progress Bar -->
            @if (Zone.WorkOrdersPlanned > 0)
            {
                double progress = Math.Clamp((double)Zone.WorkOrdersComplete / Zone.WorkOrdersPlanned * 100, 0, 100);
                double barWidth = Zone.Width * 0.85;
                double barX = (Zone.Width - barWidth) / 2;
                double barY = Zone.Height - 16;

                <rect x="@barX" y="@barY" width="@barWidth" height="7" rx="3.5" fill="#374151" />
                <rect x="@barX" y="@barY" width="@(barWidth * progress / 100)" height="7" rx="3.5" fill="#10b981" />

                @* <g>
                    <text x="@(Zone.Width / 2)" y="@(barY - 3)"
                          text-anchor="middle" fill="#e5e7eb" font-size="9" font-weight="600">
                        @(progress.ToString("F0"))%
                    </text>
                </g> *@
            }

            <!-- Work Orders Planned - Top Left -->
            @if (Zone.WorkOrdersPlanned > 0)
            {
                <g transform="translate(6, 6)">
                    <rect width="28" height="16" rx="8" fill="#3b82f6" />
                    <g>
                        <text x="14" y="11.5" text-anchor="middle" fill="white" font-size="11" font-weight="700">
                            @(Zone.WorkOrdersPlanned)
                        </text>
                    </g>
                    <title>Work Orders Planned</title>
                </g>
            }

            <!-- Work Orders Complete - Top Right -->
            @if (Zone.WorkOrdersComplete > 0)
            {
                <g transform="translate(@(Zone.Width - 34), 6)">
                    <rect width="28" height="16" rx="8" fill="#10b981" />
                    <g>
                        <text x="14" y="11.5" text-anchor="middle" fill="white" font-size="11" font-weight="700">
                            @(Zone.WorkOrdersComplete)
                        </text>
                    </g>
                    <title>Work Orders Completed</title>
                </g>
            }
        }

        @if (IsEditMode && IsSelected) 
        {
            <circle cx="@(Zone.Width)" cy="0" r="7" fill="white" stroke="#2563eb" stroke-width="2"
                    @onpointerdown="@(e => StartResize(e, ResizeHandle.SE))"
                    @onpointerdown:stopPropagation="true"
                    style="cursor: nesw-resize;transition: all 0.2s ease;" />
            <circle cx="@(Zone.Width)"     cy="@(Zone.Height)"  r="7" fill="white" stroke="#2563eb" stroke-width="2" 
                    @onpointerdown="@(e => StartResize(e, ResizeHandle.SW))" @onpointerdown:stopPropagation="true" style="cursor: nwse-resize;transition: all 0.25s ease-out;" />
            <circle cx="0"                 cy="@(Zone.Height)"  r="7" fill="white" stroke="#2563eb" stroke-width="2" 
                    @onpointerdown="@(e => StartResize(e, ResizeHandle.NE))" @onpointerdown:stopPropagation="true" style="cursor: nesw-resize;transition: all 0.2s ease;" />
            <circle cx="0"                 cy="0"               r="7" fill="white" stroke="#2563eb" stroke-width="2" 
                    @onpointerdown="@(e => StartResize(e, ResizeHandle.NW))" @onpointerdown:stopPropagation="true" style="cursor: nwse-resize;transition: all 0.2s ease;" />

            @* <!-- Edge handles (midpoints) - optional for finer control --> *@
            <circle cx="@(Zone.Width / 2)" cy="0"               r="5" fill="white" stroke="#2563eb" stroke-width="2" 
                    @onpointerdown="@(e => StartResize(e, ResizeHandle.N))" @onpointerdown:stopPropagation="true" style="cursor: ns-resize;transition: all 0.2s ease;" />
            <circle cx="@(Zone.Width / 2)" cy="@(Zone.Height)"  r="5" fill="white" stroke="#2563eb" stroke-width="2" 
                    @onpointerdown="@(e => StartResize(e, ResizeHandle.S))" @onpointerdown:stopPropagation="true" style="cursor: ns-resize;transition: all 0.2s ease;" />
            <circle cx="0"                 cy="@(Zone.Height/2)" r="5" fill="white" stroke="#2563eb" stroke-width="2" 
                    @onpointerdown="@(e => StartResize(e, ResizeHandle.W))" @onpointerdown:stopPropagation="true" style="cursor: ew-resize;transition: all 0.2s ease;" />
            <circle cx="@(Zone.Width)"     cy="@(Zone.Height/2)" r="5" fill="white" stroke="#2563eb" stroke-width="2" 
                    @onpointerdown="@(e => StartResize(e, ResizeHandle.E))" @onpointerdown:stopPropagation="true" style="cursor: ew-resize;transition: all 0.2s ease;" />
        }
    </g>
</svg>

@code {
    [Parameter] public FactoryZone Zone { get; set; } = null!;
    [Parameter] public EventCallback<FactoryZone> OnPositionChanged { get; set; }
    [Parameter] public EventCallback<FactoryZone> OnSizeChanged { get; set; }
    [Parameter] public bool SnapToGrid { get; set; }
    [Parameter] public bool IsSelected { get; set; } = true;
    [Parameter] public bool IsEditMode { get; set; } = false;
    [Parameter] public ElementReference ContainerRef { get; set; }
    [Parameter] public EventCallback<FactoryZone> OnZoneSelected { get; set; }
    [Parameter]
    public Func<double, double, Task<(double SvgX, double SvgY)>> GetSvgPointFromMouse { get; set; } = default!;
    [Parameter] public Guid? SelectedZoneId { get; set; }
    [Inject] private IMouseService MouseService { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    private bool isDashboardHighlighted => !IsEditMode && SelectedZoneId == Zone.Id;
    private bool isDragging;
    private bool isResizing;
    private ResizeHandle activeHandle;
    private double startX, startY, startZoneX, startZoneY, startWidth, startHeight;

    private enum ResizeHandle { NW, N, NE, E, SE, S, SW, W }

    protected override void OnInitialized()
    {
        MouseService.OnMove += HandleGlobalMove;
        MouseService.OnUp += HandleGlobalUp;
    }

    private string GetCursorStyle()
    {
        if (!IsEditMode) return "pointer";
        return "move";
    }

    private string GetZoneStrokeColor(bool isDashboardHighlighted)
    {
        // @Zone.TextColor
        if (Zone.IsBehindSchedule) return "#ef4444";           // Red when behind
        if (isDashboardHighlighted) return "#2563eb";
        return Zone.TextColor ?? "#1f2937";
    }

    private double GetZoneStrokeWidth(bool isDashboardHighlighted)
    {
        if (isDashboardHighlighted) return 5;
        if (Zone.IsBehindSchedule && !IsEditMode) return IsSelected ? 5 : 3.5;
        return IsSelected && IsEditMode ? 4.5 : 2;
    }

    private async Task StartResize(PointerEventArgs e, ResizeHandle handle)
    {
        if (!IsEditMode) return;

        var (svgX, svgY) = await GetSvgPointFromMouse.Invoke(e.ClientX, e.ClientY);

        isResizing = true;
        activeHandle = handle;
        startX = svgX;
        startY = svgY;
        startZoneX = Zone.X;
        startZoneY = Zone.Y;
        startWidth = Zone.Width;
        startHeight = Zone.Height;
    }

    private async Task OnPointerDownWithSelection(PointerEventArgs e)
    {
        await OnZoneSelected.InvokeAsync(Zone);
        await OnPointerDown(e);
    }

    private async Task OnPointerDown(PointerEventArgs e)
    {
        if (!IsEditMode || e.Button != 0) return;  // only left click

        var (svgX, svgY) = await GetSvgPointFromMouse.Invoke(e.ClientX, e.ClientY);

        isDragging = true;
        startX = svgX;
        startY = svgY;
        startZoneX = Zone.X;
        startZoneY = Zone.Y;
    }

    private async void HandleGlobalMove(object? sender, PointerEventArgs e)
    {
        if (!IsEditMode || (!isDragging && !isResizing)) return;

        var (currentSvgX, currentSvgY) = await GetSvgPointFromMouse.Invoke(e.ClientX, e.ClientY);
        double dx = currentSvgX - startX;
        double dy = currentSvgY - startY;

        if (isDragging)
        {
            double newX = startZoneX + dx;
            double newY = startZoneY + dy;

            if (SnapToGrid)
            {
                newX = Math.Round(newX / 10) * 10;
                newY = Math.Round(newY / 10) * 10;
            }

            Zone.X = Math.Max(0, newX);
            Zone.Y = Math.Max(0, newY);

            await OnPositionChanged.InvokeAsync(Zone);
        }
        else if (isResizing)
        {
            double newX = startZoneX;
            double newY = startZoneY;
            double newW = startWidth;
            double newH = startHeight;

            switch (activeHandle)
            {
                case ResizeHandle.SE:
                    newW = startWidth + dx;
                    newH = startHeight + dy;
                    break;
                case ResizeHandle.SW:
                    newX = startZoneX + dx;
                    newW = startWidth - dx;
                    newH = startHeight + dy;
                    break;
                case ResizeHandle.NE:
                    newY = startZoneY + dy;
                    newW = startWidth + dx;
                    newH = startHeight - dy;
                    break;
                case ResizeHandle.NW:
                    newX = startZoneX + dx;
                    newY = startZoneY + dy;
                    newW = startWidth - dx;
                    newH = startHeight - dy;
                    break;
                case ResizeHandle.E:
                    newW = startWidth + dx;
                    break;
                case ResizeHandle.W:
                    newX = startZoneX + dx;
                    newW = startWidth - dx;
                    break;
                case ResizeHandle.S:
                    newH = startHeight + dy;
                    break;
                case ResizeHandle.N:
                    newY = startZoneY + dy;
                    newH = startHeight - dy;
                    break;
            }

            if (newW < 40) newW = 40;
            if (newH < 30) newH = 30;

            if (SnapToGrid)
            {
                newX = Math.Round(newX / 10) * 10;
                newY = Math.Round(newY / 10) * 10;
                newW = Math.Round(newW / 10) * 10;
                newH = Math.Round(newH / 10) * 10;
            }

            Zone.X = newX;
            Zone.Y = newY;
            Zone.Width = newW;
            Zone.Height = newH;

            await OnPositionChanged.InvokeAsync(Zone);
        }
    }

    private void HandleGlobalUp(object? sender, PointerEventArgs e)
    {
        isDragging = false;
        isResizing = false;
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        MouseService.OnMove -= HandleGlobalMove;
        MouseService.OnUp -= HandleGlobalUp;
        await ValueTask.CompletedTask;
    }
}