                <Card IsShadow="true">
                    <HeaderTemplate>
                        <FluentLabel Typo="Typography.Body" style="color:white; width:max-content; word-wrap:revert"><strong>EQUIPMENT ID @eqItem.EquipmentItemID</strong></FluentLabel>
                    </HeaderTemplate>
                    <BodyTemplate>
                                <FluentLabel Typo="Typography.Body" Alignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center">@eqItem.EquipmentItemDescription</FluentLabel>
                                @* <FluentTextArea Typo="Typography.Body" Rows="2" ReadOnly="true" Alignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" Placeholder=@eqItem.EquipmentItemDescription></FluentTextArea> *@
                    </BodyTemplate>
                    <FooterTemplate>
                                @if (eqItem.EquipmentCategory != null)
                        {
                                    <FluentLabel Typo="Typography.Body" Alignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center">@eqItem.EquipmentCategory.EquipmentCategoryName</FluentLabel>
                        }
                        else
                        {
                                    <FluentLabel Typo="Typography.Body" Alignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center">Unassigned</FluentLabel>
                        }
                    </FooterTemplate>
                </Card>
                @* <FluentCard Style="margin:10px;height:100%;">@eqItem.EquipmentItemDescription</FluentCard> *@
            </FluentDropZone>
        }
        
        
    }
                </FluentHorizontalScroll>
</FluentStack>
</FluentDragContainer>
</div>



@code {
    [Parameter][SupplyParameterFromQuery(Name = "ProductionStageID")] public int? psID { get; set; }
    ProductionStage? PS;
    List<EquipmentCapability>? _allPSEquip;
    List<EquipmentItem>? allDivEquip;
    List<EquipmentItem>? filteredEquip;
    Division? d;

    protected override async Task OnInitializedAsync()
    {
        d = await dTrf.GetgvSelectedDivision();
        await dTrf.SetgvContextArea(0);
        PS = await pApiClient.GetAsync<ProductionStage>($"/Divisions/Production/GetProductionStageByID/{psID}");
        _allPSEquip = await pApiClient.GetAsync<List<EquipmentCapability>>($"/Divisions/GetProductionStageEquipment/{psID}");
        allDivEquip = await pApiClient.GetAsync<List<EquipmentItem>>($"/Divisions/{d.DivisionID}/GetDivisionEquipment");
        await FilterEquip();
    }
    private async Task FilterEquip()
    {
        filteredEquip = allDivEquip
            .Where(e => !_allPSEquip.Any(p => p.EquipmentItemID == e.EquipmentItemID))
            .ToList();
    }
    private async void OnDropEquip(FluentDragEventArgs<EquipmentItem> eqI)
    {
        var source = eqI.Source.Item;
        EquipmentCapability newEC = new EquipmentCapability
        {
            EquipmentItemID = source.EquipmentItemID,
            ProductionStageID = psID.Value
        };
        await pApiClient.AddEquipmentCapabilityAsync(newEC);
        _allPSEquip = await pApiClient.GetAsync<List<EquipmentCapability>>($"/Divisions/GetProductionStageEquipment/{psID}");
        await FilterEquip();
        StateHasChanged();
    }
    private async Task btnWorkCentreClick()
    {
        // Navigation.NavigateTo($"/Production/ProductionStages/{w.WorkTypeID}");
    }
    private async Task btnEquipClick()
    {

        //Navigation.NavigateTo($"/Production/ProductionStages/{w.WorkTypeID}");

    }
    private async Task OnPSEClick(EquipmentCapability e)
    {

        //Navigation.NavigateTo($"/Production/ProductionStages?WorkTypeID={w.WorkTypeID}");
    }
}
