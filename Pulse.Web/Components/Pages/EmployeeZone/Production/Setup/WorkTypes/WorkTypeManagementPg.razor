    private async Task SaveWorkCentre()
    {
        bool isSuccess = false;

        try
        {

            if (editedWC.WorkCentreId <= 0)
            {
                editedWC.DivisionID = d.DivisionID;
                editedWC.BranchID = d.BranchID;
                var createResponse = await ApiService.PostAsync<WorkCentre, ApiResponse<WorkCentre>>(ApiEndpoints.Divisions.WithDivisionID.Factory.WorkCentres.Create(d.DivisionID), selectedWC);
                isSuccess = createResponse?.Success == true;
                selectedWC = createResponse?.Data ?? new WorkCentre();
            }
            else
            {
                var createResponse = await ApiService.PostAsync<WorkCentre, ApiResponse<WorkCentre>>(ApiEndpoints.Divisions.WithDivisionID.Factory.WorkCentres.Update(d.DivisionID), selectedWC);
                isSuccess = createResponse?.Success == true;
                selectedWC = createResponse?.Data ?? new WorkCentre();
            }
        }
        catch(Exception ex)
        {
            isSuccess = false;
        }
        finally
        {
            if (isSuccess)
            {
                PulseToastService.ShowToast("Success", $"The {selectedWC?.WorkCentreName} work centre has been saved.");
                await GlobalAI.AISpeak($"The {selectedWC?.WorkCentreName} work centre has been saved.", "PulseAI");
                pgWCMode = "ViewSetup";
                editedWC = new WorkCentre();
                await LoadDivisionWorkCentres();
                StateHasChanged();
            }
            else
