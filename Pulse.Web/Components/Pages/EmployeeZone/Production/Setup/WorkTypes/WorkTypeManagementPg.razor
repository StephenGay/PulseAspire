    protected override async Task OnInitializedAsync()
    {
        await dTrf.SetgvContextArea(0);
        await LoadWorkTypes();
    }
    private async Task AddWtToDiv()
    {
        if(selectedWT != null && selectedWT.WorkTypeID > 0)
        {
            var newDivWT = new DivisionWorkType
            {
                DivisionId = d.DivisionID,
                WorkTypeID = selectedWT.WorkTypeID,
                TargetWorkingDays = selectedWT.TargetWorkingDays,
                SortOrder = DivWorkTypes.Any() ? DivWorkTypes.Max(dwt => dwt.SortOrder) + 1 : 1,
                IsActive = true
            };
            var response = await ApiService.PostAsync<DivisionWorkType,ApiResponse>(ApiEndpoints.Production.WorkTypes.Division.Add(d.DivisionID), newDivWT);
            if(response?.Success == true)
            {
                PulseToastService.ShowToast("Success", $"Work Type '{selectedWT.WorkTypeName}' added to division successfully.");
                await GlobalAI.AISpeak($"Work Type '{selectedWT.WorkTypeName}' added to division successfully.", "PulseAI");
                isAddWorkType = false;
                await LoadWorkTypes();
            }
            else
            {
                PulseToastService.ShowToast("Error", $"Failed to add Work Type '{selectedWT.WorkTypeName}' to division.<br />Please try again.", true);
                await GlobalAI.AISpeak($"Failed to add Work Type '{selectedWT.WorkTypeName}' to division.<br />Please try again.", "PulseAI");
            }
        }
    }
    private async Task LoadWorkTypes()
    {
        bool isSuccess = false;
        isLoadingWorkTypes = true;
        AllWorkTypes = new List<WorkType>();
        DivWorkTypes = new List<DivisionWorkType>();

        try
        {
            d = await dTrf.GetgvSelectedDivision();
            var response = await ApiService.GetAsync<ApiResponse<List<WorkType>>>(ApiEndpoints.Production.WorkTypes.GetAllActive);
            isSuccess = response?.Success == true;
            if (isSuccess)
            {
                AllWorkTypes = response?.Data ?? new List<WorkType>();
                var divResponse = await ApiService.GetAsync<ApiResponse<List<DivisionWorkType>>>(ApiEndpoints.Production.WorkTypes.Division.GetAllActive(d.DivisionID));
                isSuccess = divResponse?.Success == true;
                if (isSuccess)
                {
                    DivWorkTypes = divResponse?.Data ?? new List<DivisionWorkType>();
                    if(!DivWorkTypes.Any())
                    {
                        PulseToastService.ShowToast("Information", "No Work Types currently assigned to this Division.<br />Select A Work Type to add to this Division from the items shown",true);
                        await GlobalAI.AISpeak("No Work Types currently assigned to this Division.<br />Select A Work Type to add to this Division from the items shown", "PulseAI");
                        isAddWorkType = true;
                    }
                }
                AvailableWorkTypes = AllWorkTypes.Where(wt => !DivWorkTypes.Any(dwt => dwt.WorkTypeID == wt.WorkTypeID)).ToList();
            }

        }
        catch (Exception ex)
        {
            isSuccess = false;
            Logger.LogError(ex, "Failed to load work types");
        }
        finally
        {
            if (!isSuccess)
            {
                PulseToastService.ShowToast("Error", "There was a problem loading the Work Types.<br />Please try again.", true);
                await GlobalAI.AISpeak("There was a problem loading the Work Types.<br />Please try again.", "PulseAI");
            }
            else
            {
                isLoadingWorkTypes = false;
                StateHasChanged();
            }
        }
    }


