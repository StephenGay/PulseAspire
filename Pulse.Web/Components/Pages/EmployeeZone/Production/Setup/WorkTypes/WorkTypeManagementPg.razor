    private async Task ViewWCSetup()
    {
        await LoadWorkCentreZones();
        pgWCMode = "ViewSetup";
    }

    private async Task LoadWorkCentreZones()
    {
        bool isSuccess = false;
        AllWorkCentreZones = new List<FactoryZone>();
        TopLevelZones = new List<FactoryZone>();
        ZoneEquipment = new List<FactoryZone>();

        try
        {
            var response = await ApiService.GetAsync<ApiResponse<List<FactoryZone>>>(ApiEndpoints.Divisions.WithDivisionID.Factory.WorkCentres.GetWorkCentreZones(d.DivisionID, selectedWC.WorkCentreId));
            isSuccess = response?.Success == true;
            if(isSuccess)
            {
                AllWorkCentreZones = response?.Data ?? new List<FactoryZone>();
                TopLevelZones = AllWorkCentreZones.Where(z => z.Level == 0).ToList();
                ZoneEquipment = AllWorkCentreZones.Where(z => z.Level > 0).ToList();
            }
        }
        catch(Exception ex)
        {
            isSuccess = false;
            Logger.LogError(ex, "Failed to load work centre zones");
        }
        finally
        {
            if(!isSuccess)
            {
                PulseToastService.ShowToast("Error", "There was a problem loading the Work Centre Zones.<br />Please try again.",true);
                await GlobalAI.AISpeak("There was a problem loading the Work Centre Zones.<br />Please try again.", "PulseAI");
            }
            StateHasChanged();
        }
    }

    private async Task EditWCDetails()
    {
        if(selectedWC != null)
        {
            editedWC = new WorkCentre
            {
                WorkCentreId = selectedWC.WorkCentreId,
                DivisionID = selectedWC.DivisionID,
                BranchID = selectedWC.BranchID,
                WorkCentreName = selectedWC.WorkCentreName,
                Description = selectedWC.Description,
                Colour = selectedWC.Colour,
                TextColour = selectedWC.TextColour,
                ApplyTargets = selectedWC.ApplyTargets,
                TargetMinUnitsPerDay = selectedWC.TargetMinUnitsPerDay,
                TargetMaxUnitsPerDay = selectedWC.TargetMaxUnitsPerDay,
                IsActive = selectedWC.IsActive
            };
            pgWCMode = "EditSetup";
        }
    }

    private async Task LoadDivisionWorkCentres()
    {
        isLoadingWorkCentres = true;
        try{
            d = await dTrf.GetgvSelectedDivision();

            // divWorkCentres = await ApiService.GetAsync<List<WorkCentre>>($"/Divisions/{d.DivisionID}/GetWorkCentres");
            var response = await ApiService.GetAsync<ApiResponse<List<WorkCentre>>>(ApiEndpoints.Divisions.WithDivisionID.Factory.WorkCentres.GetAll(d.DivisionID));
            divWorkCentres = response?.Data ?? new();
            Logger.LogInformation("Loaded {Count} work centres", divWorkCentres?.Count ?? 0);
        }
        catch(Exception ex)
        {
            Logger.LogError(ex, "Failed to load work centres");
            errorMessage = "Failed to load work centres.";
        }
        finally
        {
            isLoadingWorkCentres = false;
            StateHasChanged();
        }
    }

    private async Task CancelEditDetails()
    {
        if(pgWCMode == "NewWC")
        {
            selectedWC = new WorkCentre() ;
            pgWCMode = "ViewAll";
        }
        else
        {
            selectedWC.ApplyTargets = editedWC.ApplyTargets;
            selectedWC.BranchID = editedWC.BranchID;
            selectedWC.Colour = editedWC.Colour;
            selectedWC.Description = editedWC.Description;
            selectedWC.DivisionID = editedWC.DivisionID;
            selectedWC.TextColour = editedWC.TextColour;
            selectedWC.TargetMaxUnitsPerDay = editedWC.TargetMaxUnitsPerDay;
            selectedWC.TargetMinUnitsPerDay = editedWC.TargetMinUnitsPerDay;
            selectedWC.IsActive = editedWC.IsActive;
            selectedWC.WorkCentreName = editedWC.WorkCentreName;
            selectedWC.WorkCentreId = editedWC.WorkCentreId;
            editedWC = new WorkCentre();
            pgWCMode = "ViewSetup";    
        }
    }

