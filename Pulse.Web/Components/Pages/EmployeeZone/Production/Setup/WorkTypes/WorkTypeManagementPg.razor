<style>
    

    .equal-height-fluent-item {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--neutral-layer-1);
    border: 1px solid var(--neutral-stroke-1);
    border-radius: 4px;
    padding: 12px;
    box-sizing: border-box;
}
    .permission-card {
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        /* padding: 12px; */
        background: white;
        cursor: pointer;
        transition: box-shadow 0.2s ease;
    }

    .permission-card:hover {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .permission-item {
        padding: 8px;
        background: #f5f5f5;
        border-radius: 4px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .permission-item:last-child {
        margin-bottom: 0;
    }

    .permissions-container {
        max-height: 500px;
        overflow-y: auto;
        border: 1px solid #e0e0e0;
        border-radius: 4px;
        padding: 12px;
    }

   

    .selected-wc {
                
                border:2px double var(--pulse-dark-colour);
                /*background-color:  var(--pulse-dark-t25-colour);*/
                animation: selected-item-pulse 2s infinite; 
            }
    @@keyframes selected-item-pulse {
                0%, 100% {
                    box-shadow: 0 0 0 0 var(--pulse-dark-t25-colour);
                }

                50% {
                    box-shadow: 0 0 15px 8px var(--pulse-dark-t75-colour);
                }
            }
    @@media (max-width: 768px) {
        .permission-grid {
            grid-auto-flow: row;
            grid-auto-columns: 1fr;
            max-height: none;
            overflow-x: hidden;
            overflow-y: auto;
        }
    }

    .column-header[b-w6qdxfylwy] {
        min-width: 50px !important;
        min-height: 32px !important;
    }
</style>

