                                            <FluentLabel Typo="Typography.Body" Weight="MsFluent.FontWeight.Bolder" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="var(--pulse-dark-colour)"><em>Targets Not Implemented For This Work Centre</em></FluentLabel>
                                        }
                                    }
                                        <FluentStack Orientation="MsFluent.Orientation.Horizontal" Style="padding: 12px;">
                                            <FluentSpacer />
                                            @if (pgWCMode == "ViewSetup")
                                            {
                                                <FluentButton Class="myAccentBtn" BackgroundColor="var(--pulse-accent-btn-bg)" style="height:30px;padding-right:10px;padding-left:10px" Color="var(--pulse-accent-btn-colour)" OnClick="EditWCDetails">
                                                    <FluentIcon Value="@(new Icons.Filled.Size20.Edit().WithColor("var(--pulse-accent-btn-colour)"))" /> Edit Details
                                                </FluentButton>
                                            }
                                            else
                                            {
                                                <FluentButton Class="myCancelBtn"
                                                        BackgroundColor="var(--pulse-cancel-btn-bg)"
