                                                    <FluentSpacer />
                                                    <FluentLabel Typo="Typography.Body" Style="font-size: 0.75rem; color: #999;">Active: @(workCentre.IsActive ? "Yes" : "No")</FluentLabel>
                                                </FluentStack>
                                                <div style="height:fit-content;width:100%;background-color: @(workCentre.Colour ?? "#660000");border: 1px solid @(workCentre.TextColour ?? "#ffffff");" >
