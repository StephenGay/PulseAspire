                                                    Cancel
                                                </FluentButton>
                                                <FluentSpacer />
                                                <FluentButton Class="myOkBtn"
                                                        BackgroundColor="var(--pulse-ok-btn-bg)"
                                                        Color="var(--pulse-ok-btn-colour)"
                                                        @onclick="SaveWorkCentre"
                                                        IconStart="@(new Icons.Filled.Size24.Save().WithColor("var(--pulse-ok-btn-colour)"))"
                                                        Style="height:40px;"
                                                        Disabled="@(string.IsNullOrEmpty(selectedWC?.WorkCentreName))">
                                                    Save
                                                </FluentButton>
                                            }
                        
                                            <FluentSpacer />
                                    @* </div> *@
                                    </FluentStack>
                                </FluentStack>
                            </div>
                            <div class="@(!isAddZone  ? "viewWCSetup" : "editWCSetup")" style="min-width: 500px;max-width:500px;width:95%;border-radius:10px;padding:10px;margin: 10px 0 0 10px;">
                                @if (isAddZone)
                                {
                                    <FluentTextField @bind-Value="editZone.Name"
                                         Placeholder="Enter a Zone Name"
                                         Required="true"
                                         Label="Zone Name"
                                         Style="width:stretch; min-width: 200px;border: 1px solid var(--pulse-dark-colour);margin-bottom:5px" />
                                    <FluentStack Orientation="MsFluent.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center">
                                        <FluentLabel >Daily Target : </FluentLabel>
                                        <FluentNumberField @bind-Value="editZone.TargetMinUnitsPerDay"
                                                           Required="true"
                                                           Label="Minimum"
                                                           Style="width:100px;text-align:center" />
                                        
                                        <FluentNumberField @bind-Value="editZone.TargetMaxUnitsPerDay"
                                                           Required="true"
                                                           Label="Maximum"
                                                           Style="width:100px;text-align:center" />
                                    </FluentStack>
                                    <FluentTextField @bind-Value="editZone.Notes"
                                         Placeholder="Enter Any Notes For Zone"
                                         Required="false"
                                         Label="Notes"
                                         Style="width:stretch; min-width: 200px;border: 1px solid var(--pulse-dark-colour);margin-bottom:5px" />
                                    <FluentStack Orientation="MsFluent.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center">
                                        <FluentButton Class="myCancelBtn"
                                                BackgroundColor="var(--pulse-cancel-btn-bg)"
                                                Color="var(--pulse-cancel-btn-colour)"
                                                IconStart="@(new Icons.Filled.Size24.DismissCircle().WithColor("var(--pulse-cancel-btn-colour)"))"
                                                Style="height:40px"
                                                onclick="() => {editZone = new FactoryZone() ; isAddZone = false ;}">
                                            Cancel
                                        </FluentButton>
                                        <FluentButton Class="myOkBtn"
                                                      BackgroundColor="var(--pulse-ok-btn-bg)"
                                                      Color="var(--pulse-ok-btn-colour)"
                                                      @onclick="SaveZone"
                                                      IconStart="@(new Icons.Filled.Size24.Save().WithColor("var(--pulse-ok-btn-colour)"))"
                                                      Style="height:40px;"
                                                      Disabled="@(string.IsNullOrEmpty(editZone?.Name))">
                                            Save
                                        </FluentButton>
                                    </FluentStack>
                                }
                                else
                                {
                                    <FluentDataGrid Items="TopLevelZones.AsQueryable()" 
                                                    TGridItem="FactoryZone"
                                                    Style="font-size:10px;width:480px"
                                                    AutoFit="false"
                                                    RowClass="@(context => context == selZone ? "fdgrselected" : "fdgrunselected")"
                                                    SelectionMode="SelectionMode.Single"
                                                    SelectedItem="@selZone"
                                                    ShowHover="true"
                                                    OnRowClick="ClickZoneRow"
                                                    >
                                        <PropertyColumn Title="Zone Name" Width="270px" Property="@(context => context.Name)" />
                                        <PropertyColumn Title="Min" Width="70px" Property="@(context => context.TargetMinUnitsPerDay)" />
                                        <PropertyColumn Title="Max" Width="70px" Property="@(context => context.TargetMaxUnitsPerDay)" />
                                        <PropertyColumn Title="Plotted" Width="70px" Property="@(context => context.IsPlotted)" />
                                    </FluentDataGrid>
                                    <FluentStack Orientation="MsFluent.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" Style="padding: 12px;">
                                        <FluentButton Class="myAccentBtn" BackgroundColor="var(--pulse-accent-btn-bg)" style="height:30px;padding-right:10px;padding-left:10px" Color="var(--pulse-accent-btn-colour)" OnClick="AddNewZone">
                                            <FluentIcon Value="@(new Icons.Filled.Size20.Edit().WithColor("var(--pulse-accent-btn-colour)"))" /> New Zone
                                        </FluentButton>
                                        <FluentButton Class="myAccentBtn" BackgroundColor="var(--pulse-accent-btn-bg)" style="height:30px;padding-right:10px;padding-left:10px" Color="var(--pulse-accent-btn-colour)" OnClick="EditZone">
                                            <FluentIcon Value="@(new Icons.Filled.Size20.Edit().WithColor("var(--pulse-accent-btn-colour)"))" /> Edit Zone
