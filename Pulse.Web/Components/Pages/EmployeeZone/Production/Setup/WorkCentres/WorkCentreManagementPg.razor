@code {
    private List<WorkCentre> workCentres = new();
    private List<RoleWithIdDto> roles = new();
    private RolePermissionDto? rolePermissions;
    private List<RolePermission>? permissionRoles;
    private List<string> assignedRoleIds = new();
    private List<PermissionCategory>? categories;
    private List<FactoryZone>? AllWorkCentreZones;
    private List<FactoryZone>? TopLevelZones;
    private List<FactoryZone>? ZoneEquipment;
    private FactoryZone? selZone;
    private FactoryZone? editZone;
    private string? selectedZone;

    private string newPermissionName = string.Empty;
    private string newPermissionDesc = string.Empty;
    private string? newCategory;
    private WorkCentre selectedWC = new WorkCentre();
    private WorkCentre editedWC = new WorkCentre();
    private PermissionDto? selectedPermission;
    private RoleWithIdDto? selectedRole;
    private string activeTab = "tbOverview";
    private string tabTitle = "Permissions Overview";

    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private string pgWCMode = "ViewAll";
    private bool isAddZone = false;
    private bool isEditZone = false;
    private bool addEditPermission = false;

    private bool isLoadingPermissions = true;
    private bool isLoadingRoles = true;

    private bool isSavingPermission = false;
    private string? selWCTextrgba;
    private string? selWCBackrgba;
    private List<WorkCentre>? divWorkCentres;
    private bool isLoadingWorkCentres = true;
    private Division? d;

    protected override async Task OnInitializedAsync()
    {
        await dTrf.SetgvContextArea(0);
        await LoadDivisionWorkCentres();
    }

    private void  ClickZoneRow(FluentDataGridRow<FactoryZone> item)
    {
        selZone = item.Item;
        StateHasChanged();
    }

    private async Task ChangeWCColour(string type, string newval)
    {
        if (type == "Background")
        {
            selWCBackrgba = newval;
            selectedWC.Colour = GlobalFunctions.RgbaToHex(selWCBackrgba);
        }
        else
        {
            selWCTextrgba = newval;
            selectedWC.TextColour = GlobalFunctions.RgbaToHex(selWCTextrgba);
        }
        await InvokeAsync(StateHasChanged);
    }
    private async Task AddNewZone()
    {
        editZone = new FactoryZone
            {
                DivisionId = d.DivisionID,
                Level = 0,
                ParentZoneId = "0",
                WorkCentreID = selectedWC.WorkCentreId,
                Description = selectedWC.WorkCentreName,
                IsPlotted = false,
                Color = selectedWC.Colour,
                TextColor = selectedWC.TextColour
            };
        isEditZone = false;
        isAddZone = true;

    }
    private async Task EditZone()
    {
        editZone = new FactoryZone
        {
            Id = selZone.Id,
            DivisionId = selZone.DivisionId,
            Name = selZone.Name,
            Level = selZone.Level,
            ParentZoneId = selZone.ParentZoneId,
            WorkCentreID = selZone.WorkCentreID,
            EquipmentCapabilityID = selZone.EquipmentCapabilityID,
            Description = selZone.Description,
            IsPlotted = selZone.IsPlotted,
            TargetMinUnitsPerDay = selZone.TargetMinUnitsPerDay,
            TargetMaxUnitsPerDay = selZone.TargetMaxUnitsPerDay,
            X = selZone.X,
            Y = selZone.Y,
            Width = selZone.Width,
            Height = selZone.Height,
            Color = selZone.Color,
            TextColor = selZone.TextColor,
            Notes = selZone.Notes
        };
        isEditZone = true;
        isAddZone = true;
    }
    private async Task ViewWCSetup()
    {
        selWCBackrgba = GlobalFunctions.HexToRgba(selectedWC.Colour ?? "#ffffff");
        selWCTextrgba = GlobalFunctions.HexToRgba(selectedWC.TextColour ?? "#000000");
        await InvokeAsync(StateHasChanged);
        await LoadWorkCentreZones();
        pgWCMode = "ViewSetup";
    }

    private async Task LoadWorkCentreZones()
    {
        bool isSuccess = false;
        AllWorkCentreZones = new List<FactoryZone>();
        TopLevelZones = new List<FactoryZone>();
        ZoneEquipment = new List<FactoryZone>();

        try
        {
            var response = await ApiService.GetAsync<ApiResponse<List<FactoryZone>>>(ApiEndpoints.Divisions.WithDivisionID.Factory.WorkCentres.GetWorkCentreZones(d.DivisionID, selectedWC.WorkCentreId));
            isSuccess = response?.Success == true;
            if(isSuccess)
            {
                AllWorkCentreZones = response?.Data ?? new List<FactoryZone>();
                TopLevelZones = AllWorkCentreZones.Where(z => z.Level == 0).ToList();
                ZoneEquipment = AllWorkCentreZones.Where(z => z.Level > 0).ToList();
            }
        }
        catch(Exception ex)
        {
            isSuccess = false;
            Logger.LogError(ex, "Failed to load work centre zones");
        }
        finally
        {
            if(!isSuccess)
            {
                PulseToastService.ShowToast("Error", "There was a problem loading the Work Centre Zones.<br />Please try again.",true);
                await GlobalAI.AISpeak("There was a problem loading the Work Centre Zones.<br />Please try again.", "PulseAI");
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task EditWCDetails()
    {
        if(selectedWC != null)
        {
            editedWC = new WorkCentre
            {
                WorkCentreId = selectedWC.WorkCentreId,
                DivisionID = selectedWC.DivisionID,
                BranchID = selectedWC.BranchID,
                WorkCentreName = selectedWC.WorkCentreName,
                Description = selectedWC.Description,
                Colour = selectedWC.Colour,
                TextColour = selectedWC.TextColour,
                ApplyTargets = selectedWC.ApplyTargets,
                TargetMinUnitsPerDay = selectedWC.TargetMinUnitsPerDay,
                TargetMaxUnitsPerDay = selectedWC.TargetMaxUnitsPerDay,
                IsActive = selectedWC.IsActive
            };
            pgWCMode = "EditSetup";
        }
    }

    private async Task LoadDivisionWorkCentres()
    {
        isLoadingWorkCentres = true;
        try{
            d = await dTrf.GetgvSelectedDivision();

            // divWorkCentres = await ApiService.GetAsync<List<WorkCentre>>($"/Divisions/{d.DivisionID}/GetWorkCentres");
            var response = await ApiService.GetAsync<ApiResponse<List<WorkCentre>>>(ApiEndpoints.Divisions.WithDivisionID.Factory.WorkCentres.GetAll(d.DivisionID));
            divWorkCentres = response?.Data ?? new();
            Logger.LogInformation("Loaded {Count} work centres", divWorkCentres?.Count ?? 0);
        }
        catch(Exception ex)
        {
            Logger.LogError(ex, "Failed to load work centres");
            errorMessage = "Failed to load work centres.";
        }
        finally
        {
            isLoadingWorkCentres = false;
            StateHasChanged();
        }
    }

    private async Task CancelEditDetails()
    {
        if(pgWCMode == "NewWC")
        {
            selectedWC = new WorkCentre() ;
            pgWCMode = "ViewAll";
        }
        else
        {
            selectedWC.ApplyTargets = editedWC.ApplyTargets;
            selectedWC.BranchID = editedWC.BranchID;
            selectedWC.Colour = editedWC.Colour;
            selectedWC.Description = editedWC.Description;
            selectedWC.DivisionID = editedWC.DivisionID;
            selectedWC.TextColour = editedWC.TextColour;
            selectedWC.TargetMaxUnitsPerDay = editedWC.TargetMaxUnitsPerDay;
            selectedWC.TargetMinUnitsPerDay = editedWC.TargetMinUnitsPerDay;
            selectedWC.IsActive = editedWC.IsActive;
            selectedWC.WorkCentreName = editedWC.WorkCentreName;
            selectedWC.WorkCentreId = editedWC.WorkCentreId;
            editedWC = new WorkCentre();
            pgWCMode = "ViewSetup";    
        }
    }

    private async Task DeActivateWC()
    {
        PulseToastService.ShowToast("Information", $"This feature is not yet implemented.");
        await GlobalAI.AISpeak("I'm sorry, but this feature is still under development.", "PulseAI");
    }

    private async Task SaveZone()
    {
        bool isSuccess = false;

        try
        {

            if (!isEditZone)
            {
                var createResponse = await ApiService.PostAsync<FactoryZone, ApiResponse>(ApiEndpoints.Divisions.WithDivisionID.Factory.FactoryLayout.Zones.Create(d.DivisionID), editZone);
                isSuccess = createResponse?.Success == true;
            }
            else
            {
                var createResponse = await ApiService.PostAsync<FactoryZone, ApiResponse>(ApiEndpoints.Divisions.WithDivisionID.Factory.FactoryLayout.Zones.Update(d.DivisionID), editZone);
                isSuccess = createResponse?.Success == true;
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
        }
        finally
        {
            if (isSuccess)
            {
                PulseToastService.ShowToast("Success", $"The zone has been saved.");
                await GlobalAI.AISpeak($"The zone has been saved.", "PulseAI");
                editZone = new FactoryZone();
                await LoadWorkCentreZones();
                isEditZone = false;
                isAddZone = false;
                StateHasChanged();
            }
            else
            {
                Logger.LogError("Error saving zone");
                PulseToastService.ShowToast("Error", "There was a problem saving the Zone.<br />Please try again.");
                await GlobalAI.AISpeak("There was a problem saving the Zone.<br />Please try again.", "PulseAI");
            }
        }
    }
    private async Task SaveWorkCentre()
    {
        bool isSuccess = false;

        try
        {

            if (editedWC.WorkCentreId <= 0)
            {
                editedWC.DivisionID = d.DivisionID;
                editedWC.BranchID = d.BranchID;
                var createResponse = await ApiService.PostAsync<WorkCentre, ApiResponse<WorkCentre>>(ApiEndpoints.Divisions.WithDivisionID.Factory.WorkCentres.Create(d.DivisionID), selectedWC);
                isSuccess = createResponse?.Success == true;
                selectedWC = createResponse?.Data ?? new WorkCentre();
            }
            else
            {
                var createResponse = await ApiService.PostAsync<WorkCentre, ApiResponse<WorkCentre>>(ApiEndpoints.Divisions.WithDivisionID.Factory.WorkCentres.Update(d.DivisionID), selectedWC);
                isSuccess = createResponse?.Success == true;
                selectedWC = createResponse?.Data ?? new WorkCentre();
            }
        }
        catch(Exception ex)
        {
            isSuccess = false;
        }
        finally
        {
            if (isSuccess)
            {
                PulseToastService.ShowToast("Success", $"The {selectedWC?.WorkCentreName} work centre has been saved.");
                await GlobalAI.AISpeak($"The {selectedWC?.WorkCentreName} work centre has been saved.", "PulseAI");
                pgWCMode = "ViewSetup";
                editedWC = new WorkCentre();
                await LoadDivisionWorkCentres();
                StateHasChanged();
            }
            else
            {
                Logger.LogError("Error saving work centre");
                PulseToastService.ShowToast("Error", "There was a problem saving the Work Centre.<br />Please try again.");
                await GlobalAI.AISpeak("There was a problem saving the Work Centre.<br />Please try again.", "PulseAI");
            }
        }
    }
