                                    </FluentStack>
                                }
                            </div>   
                            <div class="viewWCSetup" style="min-width: 500px;max-width:500px;width:95%;border-radius:10px;padding:10px;margin: 10px 0 0 10px;">
                                <WorkCentreFunctionsPg wcID="@(selectedWC.WorkCentreId)"></WorkCentreFunctionsPg>
                            </div>
                            @* </div> *@
                            </FluentStack>
                        }
                    }




                    @*else
                    {
                        <FluentMessageBar Severity="MessageSeverity.Warning">
                            No permissions found. Create one to get started!
                        </FluentMessageBar>
                    }
                 </FluentStack> *@
            </div>
        
    
