                                <div style="height:fit-content;width:100%;background-color: @(selectedWC.Colour ?? "#ffffff");border: 1px solid @(selectedWC.TextColour ?? "#000000");margin-bottom:5px" >
                                        <FluentLabel Typo="Typography.Body" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="@(selectedWC.TextColour ?? "#000000")" Style="font-weight: bold;padding:10px 5px">@selectedWC.WorkCentreName</FluentLabel>
                                </div>
                                
