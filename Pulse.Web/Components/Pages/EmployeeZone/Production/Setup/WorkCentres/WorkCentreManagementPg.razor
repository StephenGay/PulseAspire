                                                <FluentSpacer />
                                                <FluentLabel Typo="Typography.Body" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="var(--pulse-dark-colour)">Minimum: </FluentLabel>
                                                <FluentNumberField @bind-Value="selectedWC.TargetMinUnitsPerDay"
                                                Required="true"
                                                Style="width:100px;text-align:center" />
                                                <FluentSpacer />
                                                <FluentLabel Typo="Typography.Body" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="var(--pulse-dark-colour)">Maximum: </FluentLabel>
                                                <FluentNumberField @bind-Value="selectedWC.TargetMaxUnitsPerDay"
                                                Required="true"
                                                Style="width:100px;text-align:center" />
