                                    <FluentStack Orientation="MsFluent.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="margin-bottom:5px">
                                        <RadzenColorPicker Value="@selWCBackrgba" disabled="@(pgWCMode == "ViewSetup" ? true : false)" ShowHSV="true" ShowRGBA="true" ShowColors="true" ShowButton="true" ValueChanged="@((args) => ChangeWCColour("Background", args))" />
                                        @* <input type="color" disabled="@(pgWCMode == "ViewSetup" ? true : false)" id="colorPicker" @bind-value="selectedWC.Colour"> *@
                                        <FluentLabel Typo="Typography.Body" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="var(--pulse-dark-colour)">Background Colour</FluentLabel>
                                    </FluentStack>
                                    <FluentStack Orientation="MsFluent.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="margin-bottom:5px">
                                        <RadzenColorPicker Value="@selWCTextrgba" disabled="@(pgWCMode == "ViewSetup" ? true : false)" ShowHSV="true" ShowRGBA="true" ShowColors="true" ShowButton="true" ValueChanged="@((args) => ChangeWCColour("Text", args))" />
                                        @* <input type="color" disabled="@(pgWCMode == "ViewSetup" ? true : false)" id="textColorPicker" @bind-value="selectedWC.TextColour"> *@
                                        <FluentLabel Typo="Typography.Body" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="var(--pulse-dark-colour)">Text Colour</FluentLabel>
