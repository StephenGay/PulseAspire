@page "/EmployeeZone/Production/Setup/old/WorkCentres"
@using Microsoft.AspNetCore.Authorization
@using Pulse.Models.Organizational
@using Pulse.Models.Production
@using Pulse.Web.Components.Layout
@using Pulse.Web.Services
@inject Pulse.Web.Services.PulseApiService pApiClient
@inject DataTransferService dTrf
@inject NavigationManager Navigation
@* @attribute [Authorize(Roles = "Admin")] *@
@rendermode InteractiveServer

@* <div class="div-center-screen" style="align-items:center"> *@
    <ListView TItem="WorkCentre" Items="@_allWorkCentres" style="align-items:center; width:100%; margin:10px" OnListViewItemClick="OnWCClick" >
        <HeaderTemplate>
            <div style="color:white">WORK CENTRES</div>
        </HeaderTemplate>
        <BodyTemplate>
            <Card IsShadow="true">
                <HeaderTemplate>
                    WORK CENTRE ID: @context.WorkCentreId.ToString()
                </HeaderTemplate>
                <BodyTemplate>
                <FluentLabel Typo="Typography.Body" Alignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center">@context.WorkCentreName</FluentLabel>
                </BodyTemplate>
            </Card>
        </BodyTemplate>
        <FooterTemplate>
            @* <div class="col-6 col-sm-4 col-md-3 col-lg-auto"><Button OnClick="@ButtonClick" Color="Color.Info">Information</Button></div> *@
        </FooterTemplate>
    </ListView>
@* </div> *@


@code {
    
    List<WorkCentre>? _allWorkCentres;
    Division? d;

    protected override async Task OnInitializedAsync()
    {
        d = await dTrf.GetgvSelectedDivision();
        await dTrf.SetgvContextArea(0);
        _allWorkCentres = await pApiClient.GetAsync<List<WorkCentre>>($"/Divisions/{d.DivisionID}/GetWorkCentres");
    }

    private async Task OnWCClick(WorkCentre w)
    {
        
        Navigation.NavigateTo($"/EmployeeZone/Production/Setup/Old/WorkCentreProductionStages?WorkCentreID={w.WorkCentreId}");
    }
}
