@page "/EmployeeZone/Production/Setup/old/WorkTypes"
@using Pulse.Models.Organizational
@using Pulse.Models.Production
@using Pulse.Web.Components.Layout
@using Pulse.Web.Services
@inject Pulse.Web.Services.PulseApiService pApiClient
@inject DataTransferService dTrf
@inject NavigationManager Navigation

@rendermode InteractiveServer

@* <div class="div-center-screen" style="align-items:center"> *@
    <ListView TItem="WorkType" Items="@_allWorkTypes" style="align-items:center; width:100%" OnListViewItemClick="OnWTClick" >
        <HeaderTemplate>
            <div style="color:white">WORK TYPES</div>
        </HeaderTemplate>
        <BodyTemplate>
            <Card IsShadow="true" HeaderText="@context.WorkTypeName">
                <BodyTemplate>
                <FluentLabel Typo="Typography.Body" Style="margin:5px" Alignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center">Target : @context.TargetWorkingDays Days</FluentLabel>
                <FluentLabel Typo="Typography.Body" Alignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center">Material : @context.WorkTypeMaterial</FluentLabel>
                </BodyTemplate>
            </Card>
        </BodyTemplate>
        <FooterTemplate>
            @* <div class="col-6 col-sm-4 col-md-3 col-lg-auto"><Button OnClick="@ButtonClick" Color="Color.Info">Information</Button></div> *@
        </FooterTemplate>
    </ListView>
@* </div> *@


@code {
    
    List<WorkType>? _allWorkTypes;

    protected override async Task OnInitializedAsync()
    {
        await dTrf.SetgvContextArea(0);
        _allWorkTypes = await pApiClient.GetAsync<List<WorkType>>("/Divisions/GetWorkTypes");
    }

    private async Task OnWTClick(WorkType w)
    {
        
        Navigation.NavigateTo($"/EmployeeZone/Production/Setup/Old/ProductionStages?WorkTypeID={w.WorkTypeID}");
    }
}
