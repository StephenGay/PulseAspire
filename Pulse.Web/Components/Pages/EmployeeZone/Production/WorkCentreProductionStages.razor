@code {
    [Parameter][SupplyParameterFromQuery(Name = "WorkCentreID")] public int? wcID { get; set; }
    WorkCentre? WC;
    List<WorkCentreFunctions>? _allWCFunctions;
    List<ProductionStage>? allDivPS;
    List<ProductionStage>? filteredPS;
    Division? d;

    protected override async Task OnInitializedAsync()
    {
        d = await dTrf.GetgvSelectedDivision();
        await dTrf.SetgvContextArea(0);
        WC = await pApiClient.GetAsync<WorkCentre>($"/Divisions/Production/GetWorkCentreByID/{wcID}");
        _allWCFunctions = await pApiClient.GetAsync<List<WorkCentreFunctions>>($"/Divisions/Production/GetWorkCentreFunctionsByID/{wcID}");
        allDivPS = await pApiClient.GetAsync<List<ProductionStage>>($"/Divisions/{d.DivisionID}/GetAllProductionStagesByDiv");
        await FilterStage();
    }
    private async Task FilterStage()
    {
        filteredPS = allDivPS
            .Where(e => e.ProductionStageId.ToString() == string.Empty)
            .ToList();
    }
    private async void OnDropStage(FluentDragEventArgs<ProductionStage> psI)
    {
        var source = psI.Source.Item;
        WorkCentreFunctions newWcF = new WorkCentreFunctions
        {
            WorkCentreID = wcID.Value,
            ProductionStageID = source.ProductionStageId
        };
        await pApiClient.AddWorkCentreFunctionAsync(newWcF);
        _allWCFunctions = await pApiClient.GetAsync<List<WorkCentreFunctions>>($"/Divisions/Production/GetWorkCentreFunctionsByID/{wcID}");
        allDivPS = await pApiClient.GetAsync<List<ProductionStage>>($"/Divisions/{d.DivisionID}/GetAllProductionStagesByDiv");
        await FilterStage();
        StateHasChanged();
    }
    private async Task btnWorkCentreClick()
    {
        // Navigation.NavigateTo($"/Production/ProductionStages/{w.WorkTypeID}");
    }
    private async Task btnEquipClick()
    {

        //Navigation.NavigateTo($"/Production/ProductionStages/{w.WorkTypeID}");

    }
    private async Task OnWcPsClick(WorkCentreFunctions e)
    {

        Navigation.NavigateTo($"/Production/ProductionStageEquipment?ProductionStageID={e.ProductionStageID}");
    }
}
