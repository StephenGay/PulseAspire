        int Hrs = Convert.ToInt32(dur.Substring(0, dur.IndexOf(":")));
        int min = Convert.ToInt32(dur.Substring(dur.IndexOf(":") + 1, 2));
        TimeSpan d = new TimeSpan(Hrs, min, 0);
        eD = start.Add(d);
