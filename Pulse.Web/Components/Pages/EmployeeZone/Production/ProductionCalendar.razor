        // DateTime? st = updatedEvent.PlannedStartTime;
        // DateTime? end = if (updatedEvent.PlannedEndTime == null) { st; }else { updatedEvent.PlannedEndTime; }
        // TimeSpan duration = end - updatedEvent.PlannedStartTime;
        //     eD = start.Add(dur);
        // }
        // else
        // {
        // int Hrs = Convert.ToInt32(dur.Substring(0, dur.IndexOf(":")));
        // int min = Convert.ToInt32(dur.Substring(dur.IndexOf(":") + 1, 2));
        // TimeSpan d = new TimeSpan(Hrs, min, 0);
        // eD = start.Add(d);
        // }

        // updatedEvent.PlannedStartTime = start;
        // updatedEvent.PlannedEndTime = eD;
