@page "/EmployeeZone/Production/ProductionCalendar"
@using Pulse.Models.CustomComponents
@using Pulse.Models.Organizational
@using Pulse.Models.Production
@using Pulse.Web.Services
@* @using Microsoft.JSInterop *@
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject PulseApiService pApi
@inject DataTransferService dt

@rendermode InteractiveServer

<style>
    #external-events {
        padding: 10px;
        /* width: 150px; */
        /* height: auto; */
        /* max-height: 600px; */
        overflow: auto;
        border: 1px solid #ccc;
        border-radius: 10px;
        background: #bcd1d4;
        text-align: center;
    }
    #external-events .fc-event {
        margin: 10px 0;
        cursor: pointer;
        padding: 4px;
            background-color: #365b66;
        color: white;
        border-radius: 3px;
        }
    .wcSelect{
        border: 1px solid black;
        text-align:center;
    }
</style>


@* <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" Width="100%" Style="height: 100%;"> *@
@* <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" Width="100%" Style="height: 100%; padding: 10px;"> *@
    @* <div style="width:100%; height:100%; padding: 20px;border: 2px solid black; border-radius: 10px; background-color:white; overflow: scroll;"> *@
        
    <div style="width:100%; height:95%; padding: 10px; margin:5px; border: 2px solid black; border-radius: 10px; background-color:white; display: flex; flex-direction: column; overflow: hidden;">
        <FluentStack Orientation="MsFluent.Orientation.Horizontal" Style="flex: 0">
        <FluentStack Orientation="MsFluent.Orientation.Horizontal" Width="50%" HorizontalAlignment="MsFluent.HorizontalAlignment.Start" VerticalAlignment="MsFluent.VerticalAlignment.Bottom">
                <h6>PRODUCTION PLAN</h6>
            </FluentStack>
            <FluentStack Orientation="MsFluent.Orientation.Horizontal" Width="50%" HorizontalAlignment="MsFluent.HorizontalAlignment.End" VerticalAlignment="MsFluent.VerticalAlignment.Bottom">
                <h6>WORK CENTRE </h6>
                <FluentSelect Items=@workCentres 
                        TOption="WorkCentre"
                          OptionText="@(i => i.WorkCentreName)"
                          OptionValue="@(i => i.WorkCentreId.ToString())"
                          Class="wcSelect"
                            Placeholder="All Work Centres"
                          OptionSelected="@(i => i.WorkCentreId == (workCentre!=null ? workCentre.WorkCentreId : null))"
                          SelectedOptionChanged="wcChanged"
                          @bind-Value="@selWC" />
            @if(workCentre != null)
                {
                    <FluentButton IconEnd="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.DismissCircle())"
                                  Title="Clear"
                                  OnClick="btnClearWC" />
                }
            </FluentStack>
        </FluentStack>

        <FluentDivider Style="width: 100%; margin-top:5px;margin-bottom:5px;" Role="DividerRole.Presentation"></FluentDivider>

        @* <FluentStack Orientation="Orientation.Horizontal" Style="overflow : scroll;"> *@
        <FluentStack Orientation="MsFluent.Orientation.Horizontal" Style="flex: 1; overflow: hidden; display: flex;">

            @* <div id='external-events' style="width:10%;"> *@
            <div id='external-events' style="width:10%; height: 100%; overflow-y: auto;">
                @if(unplannedWO != null)
                {
                    foreach( var item in unplannedWO)
                        {
                        string eventInfo = $"{item.ClientName}<br />{item.Description}<br />{item.Stage}";
                            <Popover Placement="Placement.Bottom" Title="@item.Title" Content="@eventInfo" IsHtml="true">
                    <div id="@item.Id" class="fc-event" >@item.Title</div>
                        </Popover>
                    
                        }
                }
            </div>
            @* <div id='calendar' style="width:90%;"></div> *@
            <div id='calendar' style="width:90%; height: 100%; overflow-y: auto;"></div>
        </FluentStack>
    </div>
@*  </FluentStack> *@
 <div>
    <FluentDialog @ref="_myFluentDialog" Hidden="true" >
        <FluentDialogHeader Visible="false" />
        
        @if (selectedItem != null)
        {
            <h4>@selectedItem.WorksOrder.Customer.ClientName</h4>
            <div></div>
            <div>WO No: @selectedItem.WorkOrderNo.ToString()</div>
            <div>@selectedItem.WorksOrder.WorkType.WorkTypeName</div>
            <div>@selectedItem.ProductionStage.ProductionStageName</div> 
            <div>Planned Start: @selectedItem.PlannedStartTime</div>
            <div>Planned End: @selectedItem.PlannedEndTime</div>
            <div>Equipment: @(selectedItem.EquipmentItem == null ? "Unassigned" : selectedItem.EquipmentItem.EquipmentItemDescription)</div>
        }
        <FluentButton Appearance="Appearance.Accent" Autofocus="true" @onclick="OnCloseDialog">Close dialog</FluentButton>
        <FluentButton>Another button</FluentButton>

    </FluentDialog>
</div>


@code {
    public string? DivisionId; 
    private List<ProductionPlanEvent>? events;
    private List<ProductionUnPlannedEvent>? unplannedWO;
    private List<ProductionPlanResource>? resources;
    private DotNetObjectReference<ProductionCalendar>? dotNetRef;
    private List<WorkCentre>? workCentres;
    private WorkCentre? workCentre;
    private FluentDialog? _myFluentDialog;
    private bool isLoaded = false;
    private ProductionPlanItem? selectedItem;
    public string? selWC;
    private IJSObjectReference? calendarModule;
    private Division? y;

    protected override void OnAfterRender(bool firstRender)
    {
        // if (firstRender)
        //     _myFluentDialog!.Hide();
    }
    private void OnCloseDialog()
    {
        _myFluentDialog!.Hide();
    }
    private async void btnClearWC()
    {
        workCentre = null;
        selWC = string.Empty;
        unplannedWO = null;
        events = await pApi.GetAsync<List<ProductionPlanEvent>>($"/Divisions/{DivisionId}/GetWIP/PlanItems");
        resources = await pApi.GetAsync<List<ProductionPlanResource>>($"/Divisions/{DivisionId}/GetPlanningEquipment");
        await JS.InvokeVoidAsync("fullCalendarInterop.initialize", "#calendar", events, resources, dotNetRef);
        unplannedWO = await pApi.GetAsync<List<ProductionUnPlannedEvent>>($"/Divisions/{DivisionId}/GetWIP/UnPlannedItems");
        StateHasChanged();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // _myFluentDialog!.Hide();
            Division x = await dt.GetgvSelectedDivision();
            DivisionId = x.DivisionID;

            events = await pApi.GetAsync<List<ProductionPlanEvent>>($"/Divisions/{DivisionId}/GetWIP/PlanItems");

            //resources = await pApi.GetAsync<List<ProductionPlanResource>>($"/Divisions/GetPlanningEquipment/ByWorkCentre/{selWC}");
            resources = await pApi.GetAsync<List<ProductionPlanResource>>($"/Divisions/{DivisionId}/GetPlanningEquipment");
            dotNetRef = DotNetObjectReference.Create(this);
            calendarModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/fullcalendarInterop.js");
            await JS.InvokeVoidAsync("fullCalendarInterop.initialize", "#calendar", events, resources, dotNetRef);
            // await JS.InvokeVoidAsync("fullCalendarInterop.initialize", "#calendar", dotNetRef, events, resources);
            isLoaded = true;
        }
    } 

    private async void wcChanged(WorkCentre wc)
    {
        if(isLoaded == false)
        {
            return;
        }
        workCentre = wc;
        selWC = wc.WorkCentreId.ToString();
        unplannedWO = null;
        //resources = await pApi.GetAsync<List<ProductionPlanResource>>($"/Divisions/GetPlanningEquipment/ByWorkCentre/{selWC}");
        resources = await pApi.GetAsync<List<ProductionPlanResource>>($"/Divisions/GetPlanningEquipment/ByWorkCentre/{selWC}");
        events = await pApi.GetAsync<List<ProductionPlanEvent>>($"/Divisions/GetWIP/PlanItems/ByWorkCentre/{selWC}");
        unplannedWO = await pApi.GetAsync<List<ProductionUnPlannedEvent>>($"/Divisions/GetWIP/UnPlannedItems/ByWorkCentre/{selWC}");
        await JS.InvokeVoidAsync("fullCalendarInterop.initialize", "#calendar", events, resources, dotNetRef);
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        y = await dt.GetgvSelectedDivision();
        await dt.SetgvContextArea(0);
        unplannedWO = await pApi.GetAsync<List<ProductionUnPlannedEvent>>($"/Divisions/{y.DivisionID}/GetWIP/UnPlannedItems");
        workCentres = await pApi.GetAsync<List<WorkCentre>>($"/Divisions/{y.DivisionID}/GetWorkCentres");
        // workCentre = workCentres.FirstOrDefault();
        // selWC = workCentre.WorkCentreId.ToString();
    }

