    [JSInvokable]
    public async Task OnEventChanged(string planId, string timeStart, string timeEnd, string equipID)
    {
        ProductionPlanItem updatedEvent = await pApi.GetAsync<ProductionPlanItem>($"/Divisions/WIP/GetPlanItem/{planId}");
        var start = DateTime.Parse(timeStart);
        var end = DateTime.Parse(timeEnd);

        updatedEvent.PlannedStartTime = start;
        updatedEvent.PlannedEndTime = end;
        if(equipID != "Same")
        {
            updatedEvent.EquipmentItemID = equipID;
        }
        
        await pApi.UpdatePlanItem(updatedEvent);
    }

    [JSInvokable]
    public async Task OnEventResized(string planId, string timeStart, string timeEnd)
    {
        ProductionPlanItem updatedEvent = await pApi.GetAsync<ProductionPlanItem>($"/Divisions/WIP/GetPlanItem/{planId}");
        var start = DateTime.Parse(timeStart);
        var end = DateTime.Parse(timeEnd);

        updatedEvent.PlannedStartTime = start;
        updatedEvent.PlannedEndTime = end;
        await pApi.UpdatePlanItem(updatedEvent);
    }
