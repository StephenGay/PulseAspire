@page "/EmployeeZone/Production/ProductionDashboard"

@using Pulse.Models.Production
@using Pulse.Web.Components.PulseComponents.Controls
@using static Pulse.Web.Models.MiscEnumLists
@using Pulse.Models.Api
@using Pulse.Models.Dtos.Production
 
@inject Pulse.Web.Services.DataTransferService dt
@inject Pulse.Web.Services.PulseApiService pApiClient
@rendermode InteractiveServer


@if (isLoading)
{
    <div style="display:flex; align-items:center; justify-content:center; height:200px">
        <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="MsFluent.HorizontalAlignment.Center" Style="gap: 12px;">
            <FluentProgressRing IsActive="true" />
            <FluentLabel Typo="Typography.Body">Loading work centres...</FluentLabel>
        </FluentStack>
    </div>
}
else
{
    @* <FluentGrid Style="margin:10px"> *@
        @* <div style="display:flex; align-items:center; justify-content:center; height:100%"> *@
    <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="20px" JustifyContent="Radzen.JustifyContent.Center" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Style="height: 100%;width: 100%;padding:20px">
        @for (var i = 0; i < wipStats.Count; i++)
        {
            var item = wipStats[i];
            @* <FluentGridItem xs="12" sm="6" md="4" lg="2"> *@
            <AnimatedObserver Animation="AnimationType.FadeUp" StaggerDelay="@(i * 120)">
                
        
                    <div class="permission-card divShadow" style=" margin-bottom:10px; border-radius: 8px;width:300px">
                    
                        <FluentStack Orientation="MsFluent.Orientation.Vertical" Style="gap:1px;background-color: var(--pulse-light-colour); border-radius: 8px; padding: 12px;")">
                            <FluentLabel Typo="Typography.H6" Style="color: var(--pulse-dark-colour); font-weight:700;margin-bottom:10px;">@item.WorkCentreName</FluentLabel>
                            @* <FluentStack Orientation="Orientation.Vertical" Style="gap: 8px;"> *@
                            @* <FluentStack Orientation="MsFluent.Orientation.Horizontal" Style="gap: 8px;"> *@
                            <FluentLabel Typo="Typography.Body" Style="font-size: 0.75rem; color: black;">WO at Work Centre : @item.TotalWOCount</FluentLabel>
                            <FluentLabel Typo="Typography.Body" Style="font-size: 0.75rem; color: black;">Planned For Today : @item.PlannedTodayCount</FluentLabel>
                                @* <FluentSpacer /> *@
                                <FluentLabel Typo="Typography.Body" Style="font-size: 0.75rem; color: black;">Completed : @item.CompletedTodayCount</FluentLabel>
                            <FluentLabel Typo="Typography.Body" Style="font-size: 0.75rem; color: black;">In Progress : @item.InProgress</FluentLabel>
                            <div style=@($"background-color:forestgreen;width:{@item.StatusPercent}%;height:10px;") />
                            @* </FluentStack> *@
                        </FluentStack>
                    </div>
                
            </AnimatedObserver>
            @* </FluentGridItem> *@
        }
        @* </FluentGrid> *@
        @* </div> *@
    </RadzenStack>
}
@* <AuthorizeView Roles="admin">
    <Authorized>
        <FluentButton>Admin Action</FluentButton>
    </Authorized>
    <NotAuthorized>
        <FluentMessageBar>Access Denied</FluentMessageBar>
    </NotAuthorized>
</AuthorizeView> *@
@code {
    [CascadingParameter]
    public MasterLayout masterLayout { get; set; } = default!;
    private bool start = true;
    private bool stop = false;
    private bool ti = true;
    private bool isLoading = true;
    private List<WorkCentreWipStatsDto> wipStats = new List<WorkCentreWipStatsDto>();

    protected override async Task OnInitializedAsync()
    {
        await dt.SetgvContextArea(0);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        var response = await pApiClient.GetAsync<ApiResponse<List<WorkCentreWipStatsDto>>>(ApiEndpoints.Production.WorkInProgress.ByDivision.Plan.WorkCentres.GetStats(masterLayout.division?.DivisionID ?? ""));
        if (response != null && response.Success && response.Data != null)
        {
            wipStats = response.Data;
        }
        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }
}
