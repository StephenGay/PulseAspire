@page "/EmployeeZone/Production/ProductionDashboard"
@using Azure

@using Pulse.Models.Production
@using static MappingExtensions
 
@inject Pulse.Web.Services.DataTransferService dt
@inject Pulse.Web.Services.PulseApiService pApiClient
 @rendermode InteractiveServer


@if (wcGrps.Count == 0)
{
    <div style="display:flex; align-items:center; justify-content:center; height:200px">
        <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="MsFluent.HorizontalAlignment.Center" Style="gap: 12px;">
            <FluentProgressRing IsActive="true" />
            <FluentLabel Typo="Typography.Body">Loading work centres...</FluentLabel>
        </FluentStack>
    </div>
}
else
{
    <FluentGrid Style="margin:10px">
        @foreach (var wC in wcGrps)
        {
            <FluentGridItem xs="12" sm="6" md="4" lg="2">
                @* <div class="permission-card @(selectedDivWT == wC ? "box" : "divShadow") " style=" margin-bottom:10px" @onclick="() => selectedDivWT = wC"> *@
                <div class="permission-card divShadow" style=" margin-bottom:10px; border-radius: 8px;">
                    
                    <FluentStack Orientation="MsFluent.Orientation.Vertical" Style="gap:1px;background-color: var(--pulse-light-colour); border-radius: 8px; padding: 12px;")">
                        <FluentLabel Typo="Typography.H6" Style="color: var(--pulse-dark-colour); font-weight:700;margin-bottom:10px;">@wC.wcName</FluentLabel>
                        @* <FluentStack Orientation="Orientation.Vertical" Style="gap: 8px;"> *@
                        @* <FluentStack Orientation="MsFluent.Orientation.Horizontal" Style="gap: 8px;"> *@
                        <FluentLabel Typo="Typography.Body" Style="font-size: 0.75rem; color: black;">WO at Work Centre : @wC.woCount</FluentLabel>
                            <FluentLabel Typo="Typography.Body" Style="font-size: 0.75rem; color: black;">Planned For Today : xx</FluentLabel>
                            @* <FluentSpacer /> *@
                            <FluentLabel Typo="Typography.Body" Style="font-size: 0.75rem; color: black;">Completed : @wC.woCount</FluentLabel>
                        <div style="background-color:rgba(0,255,0,0.5);width:30%;height:10px;" />
                        @* </FluentStack> *@
                    </FluentStack>
                </div>
            </FluentGridItem>
        }
        </FluentGrid>
}
@* <AuthorizeView Roles="admin">
    <Authorized>
        <FluentButton>Admin Action</FluentButton>
    </Authorized>
    <NotAuthorized>
        <FluentMessageBar>Access Denied</FluentMessageBar>
    </NotAuthorized>
</AuthorizeView> *@
@code {
    private bool start = true;
    private bool stop = false;
    private bool ti = true;
    private List<wcGrp> wcGrps = new List<wcGrp>();

    protected override async Task OnInitializedAsync()
    {
        await dt.SetgvContextArea(0);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            List<WorkInProgressDto> wp = await pApiClient.GetAsync<List<WorkInProgressDto>>("/Divisions/150/GetWIP");
            wcGrps = wp.GroupBy(w => w.WorkCentreName).Select(g => new wcGrp { wcName = g.Key , woCount = g.Count() }).ToList();
            await InvokeAsync(StateHasChanged);
        }
        // foreach (var item in wp)
        // {
        //     var p = pApiClient.GetAsync<List<ProductionPlanItem>>($"/Divisions/Production/WorkOrder/{item.WorksOrderNo}/CreateProductionPlan");
        // }
        // ti = true;
    }
    // private async Task CallApi()
    // {
    //     var response = await DownstreamApi.PostForUserAsync<MyResponse>("MyApi", "/api/query", new NaturalLanguageQuery ("Show all users"));
    //     // Process response (e.g., display in FluentDataGrid)
    // }
    private record wcGrp
    {
        public int wcID { get; set; }
        public string wcName { get; set; }
        public int woCount { get; set; } = 0;
    }

}
