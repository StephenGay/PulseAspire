@page "/Production/ProductionStages"
@using Pulse.Models.Organizational
@using Pulse.Models.Production
@using Pulse.Web.Components.Layout
@using Pulse.Web.Services
@inject Pulse.Web.Services.PulseApiService pApiClient
@inject DataTransferService dTrf
@inject NavigationManager Navigation

@rendermode InteractiveServer

@* <div class="div-center-screen" style="align-items:center"> *@
    <ListView TItem="ProductionStage" Items="@_allWTPS"  style="align-items:center; width:100%" OnListViewItemClick="OnWTPSClick" >
        <HeaderTemplate>
            <div style="color:white">WORK TYPE PRODUCTION STAGES</div>
        </HeaderTemplate>
        <BodyTemplate>
            <Card IsShadow="true">
                <HeaderTemplate>
                    <FluentLabel Typo="Typography.H6" style="color:white"><strong>STEP @context.StepNo: @context.ProductionStageName</strong></FluentLabel>
                </HeaderTemplate>
                <BodyTemplate>
                    
                    <FluentLabel Typo="Typography.Body" Style="margin-top:5px;padding-left:10px">Compare: @context.DifficultyMeasurement</FluentLabel>
                <FluentLabel Typo="Typography.Body" Style="padding-left:10px">Base Value: @context.BaseValue = @context.BaseMinutesAtStage mins at Stage</FluentLabel>
                <FluentLabel Typo="Typography.Body" Style="margin-bottom:5px;padding-left:10px">Results Page: @context.ResultsPage</FluentLabel>
                    
                </BodyTemplate>
                <FooterTemplate>
                    <Badge IsPill="true" Color=@(context.HasMaterial? BootstrapBlazor.Components.Color.Primary : BootstrapBlazor.Components.Color.Light)>Material</Badge>
                    <Badge IsPill="true" Color=@(context.RequiresSignOff? BootstrapBlazor.Components.Color.Primary : BootstrapBlazor.Components.Color.Light)>Sign Off</Badge>
                    <Badge IsPill="true" Color=@(context.RequiresPlanning? BootstrapBlazor.Components.Color.Primary : BootstrapBlazor.Components.Color.Light)>Planning</Badge>
                    <Badge IsPill="true" Color=@(context.IsOptional? BootstrapBlazor.Components.Color.Primary : BootstrapBlazor.Components.Color.Light)>Optional</Badge>
                    <Badge IsPill="true" Color=@(context.IsDefault? BootstrapBlazor.Components.Color.Primary : BootstrapBlazor.Components.Color.Light)>Default</Badge>
                    @* <Button OnClick="@btnWorkCentreClick" Color="BootstrapBlazor.Components.Color.Info">Work Centre</Button>
                    <Button OnClick="@btnEquipClick" Color="BootstrapBlazor.Components.Color.Info">Equipment</Button> *@
                </FooterTemplate>
            </Card>
        </BodyTemplate>
        <FooterTemplate>
            @* <div class="col-6 col-sm-4 col-md-3 col-lg-auto"><Button OnClick="@ButtonClick" Color="BootstrapBlazor.Components.Color.Info">Information</Button></div> *@
        </FooterTemplate>
    </ListView>
@* </div> *@


@code {
    [Parameter][SupplyParameterFromQuery(Name = "WorkTypeID")] public int? wtID { get; set; }
    List<ProductionStage>? _allWTPS;
    Division? d;

    protected override async Task OnInitializedAsync()
    {
        d = await dTrf.GetgvSelectedDivision();
        await dTrf.SetgvContextArea(0);
        _allWTPS = await pApiClient.GetAsync<List<ProductionStage>>($"/Divisions/{d.DivisionID}/GetProductionStagesByWorkType/{wtID}");
    }
    private async Task btnWorkCentreClick()
    {
        // Navigation.NavigateTo($"/Production/ProductionStages/{w.WorkTypeID}");
    }
    private async Task btnEquipClick()
    {

        //Navigation.NavigateTo($"/Production/ProductionStages/{w.WorkTypeID}");
        
    }
    private async Task OnWTPSClick(ProductionStage p)
    {

        Navigation.NavigateTo($"/Production/ProductionStageEquipment?ProductionStageID={p.ProductionStageId}");
    }
}
