@page "/EmployeeZone/Production/DashboardFH"
@inject IJSRuntime JS
@rendermode InteractiveServer

<style>
    .cparent {
        display: flex;
        flex-direction: column;
        height: 100%;
    }
    .ccontent {
        flex: 1; /* This magic makes it grow to fill the space */
        background: rgba(255,255,255,0.5);
        margin: 10px;
        /* padding: 10px; */
        border-radius: 10px;
        overflow: auto;
    }
    .cheader, .cfooter {
        /* Fixed sizes; flexbox will respect these */
        height: 50px; /* Or min-height if you want flexibility */
        background: lightgray;
    }

    :root {
    --primary: #3b82f6;
    --primary-dark: #2563eb;
    --primary-glow: rgba(59, 130, 246, 0.3);
    --bg: #0a0e1a;
    --bg-card: #111827;
    --bg-surface: #1a2236;
    --bg-hover: #243049;
    --text: var(--pulse-light-colour); /*#e8edf5;*/
    --text-muted: var(--pulse-light-colour);
    --text-dim: var(--pulse-light-colour); /* #4a5568; */
    --border: #1e293b;
    --border-light: #2a3a52;
    --success: #10b981;
    --success-glow: rgba(16, 185, 129, 0.25);
    --warning: #f59e0b;
    --warning-glow: rgba(245, 158, 11, 0.25);
    --danger: #ef4444;
    --danger-glow: rgba(239, 68, 68, 0.3);
    --critical: #dc2626;
    --info: #6366f1;
    --cyan: #06b6d4; 
    --grid-line: rgba(59, 130, 246, 0.06);
    --grid-line-major: rgba(59, 130, 246, 0.12);
    --bs-alert-margin-bottom: 0px;
}
.alert {
    margin-bottom: 0px !important;
}
</style>

