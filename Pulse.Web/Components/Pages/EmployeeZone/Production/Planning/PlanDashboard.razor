@page "/EmployeeZone/Production/Planning/PlanDashboard"
@using Pulse.Models.Api
@using Pulse.Models.Production.Layout
@using Pulse.Web.Services
@using Pulse.Web.Components.PulseComponents.Cards
@using Pulse.Web.Components.Pages.EmployeeZone.Production.Setup.Factory.FactoryLayout
@inject PulseApiService ApiService
@inject Radzen.DialogService RadzenDialogService


@inject ProductionStateService State

@implements IDisposable

@* <RadzenLayout> *@
    @* <RadzenHeader>
        <RadzenRow JustifyContent="Radzen.JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="rz-px-4 rz-py-2">
            <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Pulse Factory Dashboard</RadzenText>
            <RadzenButton Text="Refresh" Icon="refresh" Click="LoadData" />
        </RadzenRow>
    </RadzenHeader> *@

    <RadzenBody>
        <div class="rz-p-4">
            <!-- KPI Cards -->
            <RadzenRow Gap="1rem" class="rz-mb-4">
                <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                    <KpiCard Title="Total Zones" Value="@State.Zones.Count" Icon="factory" Color="#3b82f6" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                    <KpiCard Title="Work Orders Planned" Value="@TotalPlanned" Icon="assignment" Color="#3b82f6" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                    <KpiCard Title="Work Orders Complete" Value="@TotalComplete" Icon="check_circle" Color="#10b981" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                    <KpiCard Title="Behind Schedule" Value="@ZonesBehind" Icon="warning" Color="#ef4444" />
                </RadzenColumn>
            </RadzenRow>

            <!-- Gauge + Factory Layout -->
            <RadzenRow Gap="1rem">
                <!-- Overall Factory Progress Gauge -->
                <RadzenColumn Size="12" SizeLG="4">
                    <RadzenCard>
                        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Overall Factory Progress</RadzenText>
                        <RadzenArcGauge Value="@OverallProgress" Max="100" Min="0" FormatString="{0}%" 
                                        Style="width:100%; height:220px;">
                            <RadzenArcGaugeScale>
                                <RadzenArcGaugeScaleValue Value="@OverallProgress" Fill="#10b981" />
                            </RadzenArcGaugeScale>
                        </RadzenArcGauge>
                    </RadzenCard>
                </RadzenColumn>

                <!-- Embedded Factory Layout (Forced View Mode) -->
                <RadzenColumn Size="12" SizeLG="8">
                    <RadzenCard style="padding:0; overflow:hidden;">
                        <div style="padding:12px 16px; background:#f8fafc; border-bottom:1px solid #e5e7eb;">
                            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">Factory Floor – Live View</RadzenText>
                        </div>
                        <FactoryLayout IsEditMode="false" />
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>

            <!-- Filters + DataGrid -->
            <RadzenRow class="rz-mt-4">
                <RadzenColumn>
                    <RadzenCard>
                        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Zone Summary</RadzenText>

                        <!-- Status Filter -->
                        <RadzenRow Gap="1rem" class="rz-mb-3">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenDropDown @bind-Value="SelectedStatusFilter" 
                                                Data="@StatusFilters" 
                                                TextProperty="Text" ValueProperty="Value"
                                                Placeholder="Filter by Status"
                                                Change="ApplyFilters" />
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenDataGrid Data="@FilteredZones" 
                                        AllowFiltering="true" 
                                        AllowSorting="true" 
                                        AllowPaging="true" 
                                        PageSize="12"
                                        TItem="FactoryZone"
                                        RowClick="@OnZoneRowClick">
                            <Columns>
                                <RadzenDataGridColumn TItem="FactoryZone" Property="Name" Title="Zone Name" />
                                <RadzenDataGridColumn TItem="FactoryZone" Property="WorkOrdersPlanned" Title="Planned" />
                                <RadzenDataGridColumn TItem="FactoryZone" Property="WorkOrdersComplete" Title="Complete" />
                                <RadzenDataGridColumn TItem="FactoryZone" Title="Progress">
                                    <Template Context="zone">
                                        <RadzenProgressBar Value="@GetProgress(zone)" ShowValue="true" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="FactoryZone" Title="Status">
                                    <Template Context="zone">
                                        @if (zone.IsBehindSchedule)
                                        {
                                            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Behind Schedule" />
                                        }
                                        else
                                        {
                                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="On Track" />
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>
        </div>
    </RadzenBody>
@* </RadzenLayout> *@

@code {
    [CascadingParameter]
    private MasterLayout masterLayout { get; set; } = default!;
    private string SelectedStatusFilter = "All";

    private List<StatusFilterOption> StatusFilters = new()
    {
        new() { Text = "All", Value = "All" },
        new() { Text = "Behind Schedule", Value = "Behind" },
        new() { Text = "On Track", Value = "OnTrack" }
    };

    private List<FactoryZone> FilteredZones => ApplyFilter(State.Zones);

    private List<WorkOrderStatus> WorkOrderStatusData = new();

    private int TotalPlanned => State.Zones.Sum(z => z.WorkOrdersPlanned);
    private int TotalComplete => State.Zones.Sum(z => z.WorkOrdersComplete);
    private int ZonesBehind => State.Zones.Count(z => z.IsBehindSchedule);
    private double OverallProgress => TotalPlanned > 0 
        ? Math.Round((double)TotalComplete / TotalPlanned * 100) 
        : 0;

    protected override void OnInitialized()
    {
        // Subscribe to central state changes (SignalR updates will trigger this)
        State.OnProductionPlanChange += StateHasChanged;
    }

    private void ApplyFilters() => State.NotifyProductionPlanChanged();

    private List<FactoryZone> ApplyFilter(List<FactoryZone> zones)
    {
        if (SelectedStatusFilter == "Behind")
            return zones.Where(z => z.IsBehindSchedule).ToList();
        if (SelectedStatusFilter == "OnTrack")
            return zones.Where(z => !z.IsBehindSchedule).ToList();
        return zones;
    }

    private double GetProgress(FactoryZone zone) =>
        zone.WorkOrdersPlanned > 0 
            ? Math.Round((double)zone.WorkOrdersComplete / zone.WorkOrdersPlanned * 100) 
            : 0;

    private void OnZoneRowClick(DataGridRowMouseEventArgs<FactoryZone> args)
    { 
        // TODO: Highlight the corresponding zone in the embedded SVG
        // You can extend FactoryLayoutState with a SelectedZoneId property
        // Then make DraggableZone react to it when IsEditMode = false
        // Console.WriteLine($"Row clicked → Highlight zone: {args.Data.Id}");
        State.SelectZone(args.Data.Id);
    }

    private async Task LoadData()
    {
        // Optional: Force reload from API if needed
        // Usually not necessary if SignalR is already pushing updates into FactoryLayoutState
        await Task.CompletedTask;
    }

    public void Dispose()
    {
        State.OnProductionPlanChange -= StateHasChanged;
    }

    public class StatusFilterOption
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }
}

public class WorkOrderStatus
{
    public string Status { get; set; } = "";
    public int Count { get; set; }
}

