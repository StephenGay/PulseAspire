@page "/EmployeeZone/CustomerSearch"

@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Models.Customers
@using Pulse.Web.Services
@inject PulseApiService pApiClient
@inject NavigationManager Navigation
@inject DataTransferService dts
@attribute [StreamRendering(true)]
@rendermode InteractiveServer

<style>
    
    .table-dark{
    --bs-table-bg: #365b66 !important;
        
        
        
    }
    .table{
        --bs-table-striped-bg: #bcd1d4 !important;
        --bs-table-striped-color: #365b66 !important;
        --bs-table-hover-bg: #365b66 !important;
        --bs-table-active-bg: blue !important;
        --bs-table-active-color: #fff !important;
        --bs-table-hover-color: #fff !important;
    }
    .table-row.active{
        --bs-table-active-bg-type: blue !important;
    }

    .table tbody tr.active:not(.is-edit) {
        --bs-table-active-bg-type: blue !important;
    }
</style>

<FluentLayout Style="display: flex; flex-direction: column; height: 100vh; width: 100%; overflow: auto;">
    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" class="px-4 ai-toprow">
        <FluentSearch @bind-value="srchName" Immediate="true" style="width: 100%;" Placeholder="Search For Customer"></FluentSearch>
        <FluentButton Appearance="Appearance.Accent" Disabled="@(selClient != null ? false : true)" OnClick="btnSelectClick">
            <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Play())" Slot="start" Style="fill:white;" />
            Select
        </FluentButton>
    </FluentStack>

    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" Style="flex: 1 0 none; overflow-y : scroll; " >
        <Table TItem="Customer" class="table-virtualize-demo"
            HeaderStyle="TableHeaderStyle.Dark"
           IsBordered="true" IsStriped="true" IsFixedFooter="true"
           Items="FilteredCustomers" ScrollMode="ScrollMode.Virtual"
           ClickToSelect="true" OnClickRowCallback="@ClickRow"
           
           ShowFooter="true">
        <TableColumns>
            <TableColumn @bind-Field="@context.FullClientID" Sortable="true" />
            <TableColumn @bind-Field="@context.ClientName" Sortable="true" />
            <TableColumn @bind-Field="@context.Address1" Sortable="true" />
            <TableColumn @bind-Field="@context.Address2" Sortable="true" />
            
        </TableColumns>
        <TableFooter>
            <TableFooterCell colspan="4" Text="Count：" Align="Alignment.Left" />

        </TableFooter>
    </Table>
    </FluentStack>
    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" Style="flex: 0 0 auto; padding: 10px;" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center">

    </FluentStack>
</FluentLayout>

@code {
    FluentDataGrid<Customer>? grid;
    string? srchName;
    List<Customer>? _allCustomers;
    Customer? selectedCustomer;
    private Customer? selClient { get; set; }


    IQueryable<Customer>? qryCust = Enumerable.Empty<Customer>().AsQueryable();

    private IQueryable<Customer>? FilteredCustomers
    {
        get
        {
            // grid?.SetLoadingState(true);
            IQueryable<Customer>? customers = qryCust;
            if (!string.IsNullOrEmpty(srchName))
                customers = qryCust?.Where(c => c.ClientName.Contains(srchName, StringComparison.CurrentCultureIgnoreCase));
            // grid?.SetLoadingState(false);

            if (customers != null)
                return customers.AsQueryable();

            return null;

        }    
    }

    private Task ClickRow(Customer item)
    {
        selClient = item;
        StateHasChanged();
        return Task.CompletedTask;
    }
    protected override async Task OnInitializedAsync()
    {
        _allCustomers = await pApiClient.GetAsync<List<Customer>>("/Customers/GetAll");
        if(_allCustomers == null)
        {
            _allCustomers = new();
        }
        qryCust = _allCustomers.AsQueryable();
    }

    private async Task btnSelectClick()
    {
        await dts.SetgvSelectedClient(selClient);
        Navigation.NavigateTo("/EmployeeZone/Customers/ClientDashboard");
    }
    
}
