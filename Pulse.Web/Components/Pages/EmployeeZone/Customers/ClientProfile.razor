@page "/EmployeeZone/Customers/ClientProfile"
@using Pulse.Models.Customers
@using Pulse.Models.Misc
@using Services
@using System.ComponentModel.DataAnnotations;
@inject PulseApiService pulseApi
@inject DataTransferService DTrf
@inject AppState AppState
@* @attribute [StreamRendering(true)] *@
@rendermode InteractiveServer

<PageTitle> </PageTitle>


<div class="cparent">
    <div class="ccontent">

@if (_client is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h3 class="h3Overide"> </h3>
    @* <FluentSpacer /> *@
    <Animation Effect="@Effect.FadeIn" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(0.5)">
    
    <EditForm Model="_client" style="margin-top:20px" FormName="ClientProfile">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="container">
            <div class="row">
                <div class=" mb-3 col-6">
                    <div class="input-group">
                        <span class="input-group-text labelOveride">Client ID</span>
                        <InputText id="clientId" class="form-control controlOveride" @bind-Value="_client.ClientID" Disabled="true" />
                    </div>
                </div>
                <div class="mb-3 col-6">
                    <label class="form-control labelOveride">
                        Invoices must show Order No
                        <InputCheckbox class="form-check-input" @bind-Value="_client.RequireOrderNo" />
                    </label>
                </div>
            </div>
            <div class="row">
                <div class="input-group mb-3 col-12">
                    <span class="input-group-text labelOveride">Client Name</span>
                    <InputText id="clientName" class="form-control controlOveride" @bind-Value="_client.ClientName" />
                </div>
            </div>
            <div class="row">
                <div class="mb-3 col-6">
                    <label class="form-control labelOveride">Delivery Address</label>
                    <InputText id="address1" class="form-control controlOveride" @bind-Value="_client.Address1" />
                    <InputText id="address2" class="form-control controlOveride" @bind-Value="_client.Address2" />
                    <InputText id="address3" class="form-control controlOveride" @bind-Value="_client.Address3" />
                    <InputText id="address4" class="form-control controlOveride" @bind-Value="_client.Address4" />
                    <InputText id="address5" class="form-control controlOveride" @bind-Value="_client.Address5" />
                </div>
                <div class="mb-3 col-6">
                    <label class="form-control labelOveride">Postal Address</label>
                    <InputText id="Paddress1" class="form-control controlOveride" @bind-Value="_client.PostalAddress1" />
                    <InputText id="Paddress2" class="form-control controlOveride" @bind-Value="_client.PostalAddress2" />
                    <InputText id="Paddress3" class="form-control controlOveride" @bind-Value="_client.PostalAddress3" />
                    <InputText id="Paddress4" class="form-control controlOveride" @bind-Value="_client.PostalAddress4" />
                    <InputText id="Paddress5" class="form-control controlOveride" @bind-Value="_client.PostalAddress5" />
                </div>
            </div>
            <div class="row">
                <div class="mb-3 col-6">
                    <div class="input-group">
                        <span class="input-group-text labelOveride">VAT Registration No</span>
                        <InputText id="vat" class="form-control controlOveride" @bind-Value="_client.VATNo" />
                    </div>
                </div>
                <div class="mb-3 col-6">
                    <div class="input-group">
                        <span class="input-group-text labelOveride">Telephone No</span>
                        <InputText id="phone" class="form-control controlOveride" @bind-Value="_client.Phone" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="input-group mb-3 col-12">
                    <span class="input-group-text labelOveride">E-Mail</span>
                    <InputText id="email" class="form-control controlOveride" @bind-Value="_client.EMail" />
                </div>
            </div>
            <div class="row">
                <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" Width="100%">
                    <div class="card text-center" style="width:20%;height:100%">
                        <header class="card-header">Industry</header>
                        <div class="card-body" style="display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100%;">
                            <h5>@_client.Industry?.IndustryName</h5>
                        </div>
                    </div>
                    <FluentSpacer />
                                <div class="card text-center" style="width:20%;height:100%">
                        <header class="card-header">Sales Region</header>
                        <div class="card-body" style="display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100%;">
                            <h5>@_client.Region?.RegionName</h5>
                            @_client.Region?.Province?.ProvinceName
                        </div>
                    </div>
                    <FluentSpacer />
                                <div class="card text-center" style="width:20%;height:100%">
                        <header class="card-header">Sales Representative</header>
                        <div class="card-body" style="display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100%;">
                            <h5>@_client.SalesRepresentative?.RepresentativeName</h5>
                        </div>
                    </div>
                </FluentStack>
            </div>
            @* <button type="submit" class="btn btn-primary">Save Changes</button> *@
        </div>

    </EditForm>
	</Animation>
}
</div>
</div>

@code {
    // [CascadingParameter]
	private string _customer_Id = string.Empty;

    private Customer? _client;

    protected override async Task OnInitializedAsync()
    {
        // Simulate asynchronous loading to demonstrate streaming rendering
        // await Task.Delay(500);
        _client = await DTrf.GetgvSelectedClient();
        await DTrf.SetgvContextArea(0);
        ShowAiIcon showAi = new ShowAiIcon();
        await DTrf.SetgvShowAI(showAi);
        await AppState.NotifyStateChanged();

    }
}
