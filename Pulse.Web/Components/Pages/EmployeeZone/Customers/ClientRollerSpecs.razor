    private async Task GetClientInfo()
    {
        Customer cl = await DTrf.GetgvSelectedClient();

        if (cl is null)
        {

        }
        else
        {
            if (cl.ClientRollerSpecifications == null)
            {
                cl.ClientRollerSpecifications = await pAI.GetClientRollerSpecificationsAsync(cl.FullClientID);
                await DTrf.SetgvSelectedClient(cl);

            }
            // qrySpec = _client.ClientRollerSpecifications.AsQueryable();
