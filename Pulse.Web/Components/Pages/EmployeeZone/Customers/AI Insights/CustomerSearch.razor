@page "/EmployeeZone/CustomerSearch2"

@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Models.Customers
@using Pulse.Web.Services
@inject PulseApiService pApiClient
@inject NavigationManager Navigation
@inject DataTransferService dts
@attribute [StreamRendering(true)]
@rendermode InteractiveServer

<FluentLayout Style="display: flex; flex-direction: column; height: 100vh; width: 100%; overflow: hidden;">
    
    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" class="px-4 ai-toprow">
        <FluentSearch @bind-value="srchName" Immediate="true" style="width: 100%;" Placeholder="Search For Customer"></FluentSearch>
        <FluentButton Appearance="Appearance.Accent" Disabled="@(selectedCustomer != null ? false : true)" OnClick="btnSelectClick">
            <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Play())" Slot="start" Style="fill:white;" />
            Select
        </FluentButton>
    </FluentStack>

    @* DisplayMode="DataGridDisplayMode.Table"  *@
    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" Style="flex: 1; padding: 10px; overflow: auto;">
        <div style="width: 100%; overflow-y: scroll;">
            <FluentDataGrid @ref="grid" 
                            Items="@FilteredCustomers" 
                            TGridItem="Customer"
                            Virtualize="true" 
                            SelectionMode="SelectionMode.Single"
                            SelectedItem="@selectedCustomer"
                            OnRowClick="OnClientRowClick"
                            ResizableColumns="true"
                            Style="width: 100%;" 
                            RowClass="@(context => context == selectedCustomer ? "fdgrselected" : "fdgrunselected")"
                            ItemSize="40" 
                            GenerateHeader="@GenerateHeaderOption.Sticky">
                <ChildContent>
                    <PropertyColumn Width="10%" Title="Client ID" Property="@(c => c.FullClientID)" Align="Align.Center" Sortable="true" />
                    <PropertyColumn Width="30%" Title="Client Name" Property="@(c => c.ClientName)" />
                    <PropertyColumn Width="30%" Title="Address 1" Property="@(c => c.Address1)" />
                    <PropertyColumn Width="30%" Title="Address 2" Property="@(c => c.Address2)" />
                </ChildContent>
                <EmptyContent>
                    &nbsp; Nothing to see here. Carry on!
                </EmptyContent>
                <LoadingContent>
                    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center">
                        Loading...<br />
                        <FluentProgress Width="240px" />
                    </FluentStack>
                </LoadingContent>
            </FluentDataGrid>
        </div>
    </FluentStack>

    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" Style="flex: 0 0 auto; padding: 10px;" HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center">
        <FluentButton OnClick="SimulateDataLoading">Simulate data loading</FluentButton>
    </FluentStack>
</FluentLayout>

@code {
    FluentDataGrid<Customer>? grid;
    string? srchName;
    List<Customer>? _allCustomers;
    Customer? selectedCustomer;

    IQueryable<Customer>? qryCust = Enumerable.Empty<Customer>().AsQueryable();

    private IQueryable<Customer>? FilteredCustomers
    {
        get
        {
            grid?.SetLoadingState(true);
            IQueryable<Customer>? customers = qryCust;
            if (!string.IsNullOrEmpty(srchName))
                customers = qryCust?.Where(c => c.ClientName.Contains(srchName, StringComparison.CurrentCultureIgnoreCase));
            grid?.SetLoadingState(false);

            if (customers != null)
                return customers.AsQueryable();

            return null;

        }    
    }

    protected override async Task OnInitializedAsync()
    {
        _allCustomers = await pApiClient.GetAsync<List<Customer>>("/Customers/GetAll");
        // if(_allCustomers == null)
        // {
        //     _allCustomers = new();
        // }
        qryCust = _allCustomers.AsQueryable();
    }

    private void OnClientRowClick(FluentDataGridRow<Customer> args)
    {
        try
        {

            selectedCustomer = args.Item;

            StateHasChanged();  // Ensure UI updates if needed
        }
        catch (Exception ex)
        {
            return;
        }
    }

    private async Task btnSelectClick()
    {
        await dts.SetgvSelectedClient(selectedCustomer);
        Navigation.NavigateTo("/EmployeeZone/Customers/ClientDashboard");
    }
    private async Task SimulateDataLoading()
    {
        grid?.SetLoadingState(true);

        await Task.Delay(1500);

        grid?.SetLoadingState(false);
    }
}
