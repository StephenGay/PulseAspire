@* @page "/EmployeeZone/Customers/AI Insights/ClientSalesForecast"
@using Markdig
@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Models.Customers
@inject Pulse.Web.Services.Pulse_AI pAI

@if (isLoading)
{
    <FluentProgressRing style="width: 102px; height: 102px;"></FluentProgressRing>
}
else
{
    <FluentCard Width="50%" Height="80%">
        <header>Sales Trend</header>
        <details>
            <p>@((MarkupString)ParseToHtml(trend))</p>
        </details>
    </FluentCard>
}

@code {
    [CascadingParameter(Name ="casClient")]
    protected Customer? customer { get; set; }
    private bool isLoading = true;

    private string? trend;

    protected override async Task OnInitializedAsync()
    {
        trend = await pAI.GetClientSalesAnalysisAsync($"Create a Sales Forecast for the next 12 months for client {customer.ClientName} based on their provided Sales History.", customer.FullClientID);
        isLoading = false;
    }

    private string ParseToHtml(string markdownContent)
    {
        var pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build(); // Customize extensions (e.g., syntax highlighting)
        return Markdown.ToHtml(markdownContent, pipeline);
    }
}
 *@