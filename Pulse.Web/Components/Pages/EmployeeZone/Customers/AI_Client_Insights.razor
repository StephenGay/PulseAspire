    private string ParseToHtml(string markdownContent)
    {
        var pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build(); // Customize extensions (e.g., syntax highlighting)
        var res = Markdig.Markdown.ToHtml(markdownContent, pipeline);
        res = AddMUcss(res);
        return res;
    }
    private string AddMUcss(string toMU)
    {
        toMU = toMU.Replace("<table>", "<table class=\"table table-striped table-hover table-bordered\">");
        toMU = toMU.Replace("<th>", "<th style=\"background-color: #365b66; color: #bcd1d4;\">");
        return toMU;
    }
}
