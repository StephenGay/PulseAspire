@using Pulse.Models.CustomComponents
@using Pulse.Web.Services
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.AspNetCore.Components

@inject MessageHubService MsgHubService
@inject ILogger<UserPresenceList> _logger

<div class="presence-list-container" style="background-color: var(--pulse-light-colour)">
    @* <h3>Online Users</h3> *@

    @if (presenceList == null)
    {
        <FluentProgressRing Width="32px"></FluentProgressRing>
        <p>Loading presence list...</p>
    }
    else if (presenceList.Count == 0)
    {
        <p>No users online</p>
    }
    else
    {
        <!-- Search Box -->
        <FluentStack Orientation="Orientation.Vertical" Style="gap: 8px; margin-bottom: 12px; border-bottom: 1px solid var(--pulse-dark-colour);">
            <FluentTextField 
                @bind-Value="searchQuery"
                @oninput="OnSearchInput"
                Placeholder="Search users..."
                IconStart="@(new Icons.Regular.Size20.Search())"
                Appearance="FluentInputAppearance.Filled"
                Style="width: 100%;">
            </FluentTextField>
        </FluentStack>

        <!-- Users List -->
        @if (GetFilteredUsers().Count == 0)
        {
            <p style="text-align: center; color: var(--neutral-foreground-hint);">No users match your search</p>
        }
        else
        {
            <FluentStack Orientation="Orientation.Vertical" Style="gap: 8px;">
                @foreach (var user in GetFilteredUsers())
                {
                    <div style="@($"padding: 8px; border-radius: 6px; cursor: pointer; transition: background-color 0.2s; background-color: {(hoveredUserId == user.UserId ? "var(--accent-fill-rest)" : "transparent")}; color: {(hoveredUserId == user.UserId ? "white" : "inherit")};")" 
                         @onmouseover="@((e) => hoveredUserId = user.UserId)" 
                         @onmouseout="@((e) => hoveredUserId = null)"
                         @onclick="@(() => OnUserClicked(user))">
                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap: 12px;">
                            <FluentPersona Status="@user.EffectiveStatus"
                                           StatusSize="PresenceBadgeSize.Medium"

                                           Image="@(new Icons.Regular.Size48.Person().ToDataUri(size: "25px", color: "white"))"
                                           ImageSize="40px">
                            </FluentPersona>
                            <div>
                                <span>@(user.FullName ?? user.UserName)</span>
                                <br />
                                <small style="@(hoveredUserId == user.UserId ? "color: rgba(255,255,255,0.7);" : "color: gray;")">(@GetPresenceText(user.EffectiveStatus))</small>
                            </div>
                        </FluentStack>
                    </div>
                }
            </FluentStack>
        }
    }
</div>

@code {
    [Parameter]
    public Func<UserPresenceDto, Task>? OnUserSelected { get; set; }

    private List<UserPresenceDto> presenceList = null;
    private bool isLoading = false;
    private string? hoveredUserId = null;
    private string searchQuery = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Fetch presence list on component load
        await LoadPresenceListAsync();

        // Subscribe to real-time presence updates
        MsgHubService.OnPresenceListUpdated += OnPresenceListUpdated;
    }

    private async Task LoadPresenceListAsync()
    {
        try
        {
            isLoading = true;
            presenceList = await MsgHubService.GetPresenceListAsync();
            _logger?.LogInformation("Loaded {Count} users from presence list", presenceList?.Count ?? 0);
        }
        catch (Exception ex)
        {
            _logger?.LogError(ex, "Error loading presence list");
            presenceList = new();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OnPresenceListUpdated(List<UserPresenceDto> updatedList)
    {
        try
        {
            presenceList = updatedList;
            _logger?.LogInformation("Presence list updated: {Count} users", presenceList.Count);
            InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _logger?.LogError(ex, "Error updating presence list");
        }
    }

    private async Task OnUserClicked(UserPresenceDto user)
    {
        if (OnUserSelected != null)
        {
            await OnUserSelected(user);
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    private List<UserPresenceDto> GetFilteredUsers()
    {
        if (presenceList == null || string.IsNullOrWhiteSpace(searchQuery))
        {
            return presenceList?.OrderBy(u => u.FullName ?? u.UserName).ToList() ?? new();
        }

        var query = searchQuery.ToLower();
        return presenceList
            .Where(u => (u.FullName ?? u.UserName ?? "").ToLower().Contains(query))
            .OrderBy(u => u.FullName ?? u.UserName)
            .ToList();
    }

    private string GetPresenceText(PresenceStatus status) => status switch
    {
        PresenceStatus.Available => "Available",
        PresenceStatus.Busy => "Busy",
        PresenceStatus.DoNotDisturb => "Do Not Disturb",
        PresenceStatus.Away => "Away",
        PresenceStatus.OutOfOffice => "Out Of Office",
        PresenceStatus.Offline => "Offline",
        _ => "Unknown"
    };
    public void Dispose()
    {
        MsgHubService.OnPresenceListUpdated -= OnPresenceListUpdated;
    }
}