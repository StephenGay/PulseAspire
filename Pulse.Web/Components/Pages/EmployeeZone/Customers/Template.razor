@page "/EmployeeZone/Customers/Template"

<style>
.cparent {
  display: flex;
  flex-direction: column; /* Stack children vertically */
  height: 100%; /* Or whatever height your parent should be, like 100% */
}

.cheader, .cfooter {
  /* Fixed sizes; flexbox will respect these */
  height: 50px; /* Or min-height if you want flexibility */
  background: lightgray;
}

.ccontent {
  flex: 1; /* This magic makes it grow to fill the space */
  background: white;
  margin:10px;
  border-radius:10px;
  overflow: auto;
}
</style>

<div class="cparent">
    @* <div class="cheader">Fixed Header (e.g., 50px)</div> *@
    <div class="ccontent">This will fill the remaining space</div>
   @*  <div class="cfooter">Fixed Footer (e.g., 30px)</div> *@
</div>

