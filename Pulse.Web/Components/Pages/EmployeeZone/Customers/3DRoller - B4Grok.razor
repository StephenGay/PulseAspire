@page "/EmployeeZone/Customers/3DRollerB4Grok"

@using Pulse.Web.Services
@using Pulse.Models.Customers
@using Pulse.Models.Rollers
@using Microsoft.JSInterop

@inject DataTransferService DTrf
@inject RollerDataTransferService RollerDTrf
@inject IJSRuntime JS
@rendermode InteractiveServer

<style>
.cparent {
  display: flex;
  flex-direction: column;
  /* height: 100%; */
  width: 100%;
}

.button-container {
  padding: 10px;
  background: #f5f5f5;
  flex-shrink: 0;
}

.viewer-container {
  flex: 1;
  overflow: hidden;
  width: 100%;
  min-height: 400px;
}

</style>

<div class="cparent">
    @* <div class="button-container">
        @if (isRollerLoaded)
        {
            <span class="badge bg-success">✓ Roller Loaded</span>
        }
        else
        {
            <span class="text-muted">Loading 3D Viewer...</span>
        }
    </div> *@
    <div class="viewer-container">
        <div @ref="viewerContainer" style="width: 100%; height: 100%;"></div>
    </div>
</div>

@code {
    private ElementReference viewerContainer;
    private bool isRollerLoaded = false;
    private ClientRollerSpecification? roller;
    private List<RollerShaft>? shafts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("console.log", "🔷 OnAfterRenderAsync - initializing Three.js viewer");
            await InitializeViewerAsync();
        }
    }

    private async Task InitializeViewerAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("console.log", "🔷 Initializing viewer...");

            bool success = await JS.InvokeAsync<bool>("RollerViewer3D.init", viewerContainer);

            if (success)
            {
                await JS.InvokeVoidAsync("console.log", "✅ Viewer initialized successfully");

                // Load roller data first to get dimensions for positioning reference
                roller = await DTrf.GetgvSelectedRollSpec();
                if (roller is null)
                {
                    await JS.InvokeVoidAsync("console.warn", "⚠️ No roller data loaded");
                    return;
                }

                // Add components in order: shafts, roller, cover, then apply positioning

                bool rollerSuccess = await AddRollerToSceneAsync();
                bool shaftsSuccess = await AddShaftsToSceneAsync();
                bool coverSuccess = await AddRollerCoverToSceneAsync();


                if (shaftsSuccess && rollerSuccess && coverSuccess)
                {
                    await ApplyScalingAndPositioningAsync();
                    isRollerLoaded = true;
                    await InvokeAsync(() => StateHasChanged());
                }
            }
            else
            {
                await JS.InvokeVoidAsync("console.warn", "⚠️ Failed to initialize viewer");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"❌ Error initializing viewer: {ex.Message}");
        }
    }

    private async Task<bool> AddShaftsToSceneAsync()
    {
        try
        {
            double shellLength = (double)roller?.ShellLength!;
            float leftYPos = (float)shellLength;
            float rightYPos = 0;

            await JS.InvokeVoidAsync("console.log", "🔷 AddShaftsToSceneAsync called");

            shafts = await RollerDTrf.GetgvSelectedRollerShafts();

            if (shafts is null || shafts.Count == 0)
            {
                await JS.InvokeVoidAsync("console.log", "ℹ️ No shafts to load");
                return true;
            }

            await JS.InvokeVoidAsync("console.log", $"🔷 Found {shafts.Count} shaft(s) to add");

            bool allSuccess = true;

            for (int i = 0; i < shafts.Count; i++)
            {
                var shaft = shafts[i];

                if (shaft is null || shaft.OuterDiameter <= 0 || shaft.Length <= 0)
                {
                    await JS.InvokeVoidAsync("console.warn", $"⚠️ Shaft {i} has invalid data - skipping");
                    allSuccess = false;
                    continue;
                }

                await JS.InvokeVoidAsync("console.log",
                    $"🔷 Adding Shaft {i} - Diameter: {shaft.OuterDiameter}mm, Length: {shaft.Length}mm, AxialPos: {shaft.AxialPosition}mm, RadialOffset: {shaft.RadialOffset}mm, Position: {shaft.ShaftPosition}");

                try
                {
                    float outerDiameter = (float)shaft.OuterDiameter;
                    float length = (float)shaft.Length;
                    float boreDiameter = (float)shaft.BearingBoreDiameter;
                    float radialOffset = (float)(shaft.RadialOffset ?? 0.0);
                    string shaftName = $"shaft_{i}";
                    string position = shaft.ShaftPosition?.ToLower() ?? "center";

                    // Debug: Check if roller data is available
                    if (roller == null || roller.ShellLength == null)
                    {
                        await JS.InvokeVoidAsync("console.error", "❌ Roller is null or missing ShellLength");
                        allSuccess = false;
                        continue;
                    }

                    // Calculate Y position based on side and roller length
                    // Center the roller at Y=0, so:
                    // - Left shaft at: ShellLength / 2
                    // - Right shaft at: -(ShellLength / 2)
                    float yPosition = 0.0f;
                    if (position == "left")
                    {
                        yPosition = leftYPos; // (float)roller.ShellLength / 2;
                        leftYPos += length;
                    }
                    else if (position == "right")
                    {
                        yPosition = rightYPos - length; // -((float)roller.ShellLength / 2);
                        rightYPos -= length;
                    }

                    await JS.InvokeVoidAsync("console.log",
                        $"   DEBUG: Roller.ShellLength={roller.ShellLength}, calculated yPos={yPosition}");
                    await JS.InvokeVoidAsync("console.log",
                        $"   Calling addShaft: diameter={outerDiameter}, length={length}, yPos={yPosition}, position={position}");

                    bool success = await JS.InvokeAsync<bool>("RollerViewer3D.addShaft",
                        outerDiameter,
                        length,
                        boreDiameter,
                        shaftName,
                        yPosition,
                        position,
                        radialOffset
                    );

                    if (success)
                    {
                        await JS.InvokeVoidAsync("console.log", $"✅ Shaft {i} added successfully");
                    }
                    else
                    {
                        await JS.InvokeVoidAsync("console.warn", $"⚠️ JavaScript addShaft returned false for shaft {i}");
                        allSuccess = false;
                    }
                }
                catch (JSDisconnectedException)
                {
                    await JS.InvokeVoidAsync("console.error", "❌ Circuit disconnected while adding shaft");
                    return false;
                }
                catch (Exception ex)
                {
                    await JS.InvokeVoidAsync("console.error", $"❌ Error adding shaft {i}: {ex.Message}");
                    allSuccess = false;
                }
            }

            return allSuccess;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"❌ ERROR in AddShaftsToSceneAsync: {ex.Message}");
            return false;
        }
    }

    private async Task<bool> AddRollerToSceneAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("console.log", "🔷 AddRollerToSceneAsync called");

            if (roller is null || roller.ShellDiameter is null || roller.ShellLength is null)
            {
                await JS.InvokeVoidAsync("console.warn", "⚠️ No roller data loaded or incomplete spec");
                return false;
            }

            await JS.InvokeVoidAsync("console.log", $"🔷 Adding Roller - Diameter: {roller.ShellDiameter}, Length: {roller.ShellLength}");

            float diameter = (float)roller.ShellDiameter;
            float length = (float)roller.ShellLength;
            float scale = 1f;

            try
            {
                bool success = await JS.InvokeAsync<bool>("RollerViewer3D.addRoller", diameter, length, scale);

                if (success)
                {
                    await JS.InvokeVoidAsync("console.log", "✅ Roller added to scene");
                    return true;
                }
                else
                {
                    await JS.InvokeVoidAsync("console.warn", "⚠️ Failed to add roller to scene");
                    return false;
                }
            }
            catch (JSDisconnectedException)
            {
                await JS.InvokeVoidAsync("console.error", "❌ Circuit disconnected while adding roller");
                return false;
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"❌ ERROR in AddRollerToSceneAsync: {ex.Message}");
            return false;
        }
    }

    private async Task<bool> AddRollerCoverToSceneAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("console.log", "🔷 AddRollerCoverToSceneAsync called");

            if (roller is null || roller.ShellDiameter is null || roller.ShellLength is null)
            {
                await JS.InvokeVoidAsync("console.warn", "⚠️ No roller data loaded or incomplete spec");
                return false;
            }

            await JS.InvokeVoidAsync("console.log", $"🔷 Adding Roller Cover - Diameter: {roller.CoverDiameter}, Length: {roller.CoverLength}");

            float thickness = (float)((roller.CoverDiameter - roller.ShellDiameter) / 2);
            float length = (float)(roller.CoverLength - 30);

            try
            {
                bool success = await JS.InvokeAsync<bool>("RollerViewer3D.addRubberCover",
                    roller.CoverLeftOffset,
                    length,
                    thickness,
                    0xFF0000
                );

                if (success)
                {
                    await JS.InvokeVoidAsync("console.log", "✅ Roller Cover added to scene");
                    return true;
                }
                else
                {
                    await JS.InvokeVoidAsync("console.warn", "⚠️ Failed to add roller cover to scene");
                    return false;
                }
            }
            catch (JSDisconnectedException)
            {
                await JS.InvokeVoidAsync("console.error", "❌ Circuit disconnected while adding cover");
                return false;
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"❌ ERROR in AddRollerCoverToSceneAsync: {ex.Message}");
            return false;
        }
    }

    private async Task ApplyScalingAndPositioningAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("console.log", "🔷 ApplyScalingAndPositioningAsync called");

            float scale = 1f;

            try
            {
                bool success = await JS.InvokeAsync<bool>("RollerViewer3D.applyScalingAndPositioning", scale);

                if (success)
                {
                    await JS.InvokeVoidAsync("console.log", "✅ Scaling and positioning applied successfully");
                }
                else
                {
                    await JS.InvokeVoidAsync("console.warn", "⚠️ Failed to apply scaling and positioning");
                }
            }
            catch (JSDisconnectedException)
            {
                await JS.InvokeVoidAsync("console.error", "❌ Circuit disconnected while applying scaling");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"❌ ERROR in ApplyScalingAndPositioningAsync: {ex.Message}");
        }
    }
}


