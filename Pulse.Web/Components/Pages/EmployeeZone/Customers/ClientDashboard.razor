                            </div>
                        </div>
                        </Animation>
                    </FluentGridItem>
		        
            }
            @if (stats.countOpenQuotes > 0)
            {
                
                   @*  <FluentGridItem xs="12" sm="10" md="6" lg="4" xl="2" Style="width:100%">
                    <Animation Effect="@Effect.FlipInX" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(1)">
                    <Card IsShadow="true" Color="BootstrapBlazor.Components.Color.Dark" IsCenter="true">
                        <HeaderTemplate>
                            Open Quotations
                        </HeaderTemplate>
