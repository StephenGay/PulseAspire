        }
        @if (cmSales != null)
        {
            
                <FluentGridItem xs="12" sm="10" md="6" lg="4" xl="2" Style="width:100%">
                    <Animation Effect="@Effect.FlipInX" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(1)">
                    <div class="card text-center btnShadow" style="height:100%">
                        <header class="card-header">Current Month Sales</header>
                        <div class="card-body" style="display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100%;">
                            <h1>@cmSales.Amount</h1>
                        </div>
                    </div>
                </Animation>
                </FluentGridItem>
            
        }
        @if (cYtdSales != null && cYtdSales != 0)
        {
            
            <FluentGridItem xs="12" sm="10" md="6" lg="4" xl="2" Style="width:100%">
                <Animation Effect="@Effect.FlipInX" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(1)">
