@page "/EmployeeZone/Customers/ClientDashboard"
@using Pulse.Models.Customers
@using Pulse.Web.Services
@inject PulseApiService pulseApi
@inject Pulse.Web.Services.Pulse_AI pAI
@inject NavigationManager Navigation
@inject DataTransferService DataTransferService
@* @attribute [StreamRendering(true)] *@
@rendermode InteractiveServer

<PageTitle>Customer Dashboard</PageTitle>

@if (_client == null)
{
    <div>Loading...</div>
}
else
{
    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Left" Width="100%" Style="height: 100%; overflow-y : scroll;">

        @if(stats.countWipWOs>0)
        {
            <Animation Effect="@Effect.FadeIn" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(0.5)">
                <Card IsShadow="true" Color="BootstrapBlazor.Components.Color.Dark" style="margin-top: 50px;margin-left: 20px;margin-right: 20px;margin-bottom:0px;" IsCenter="true">
                    <HeaderTemplate>
                        Work Orders In Progress
                    </HeaderTemplate>
                    <BodyTemplate>
                        <h1><span class="badge text-bg-primary">@stats.countWipWOs</span></h1>
                    </BodyTemplate>
                    <FooterTemplate>
                        <button class="btn btn-primary btnOveride mt-4" @onclick="NavigateToWIP">View Status</button>
                    </FooterTemplate>
                </Card>
		    </Animation>
        }
        @if (stats.countOpenQuotes > 0)
        {
            <Animation Effect="@Effect.FadeIn" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(0.5)">
                <Card IsShadow="true" Color="BootstrapBlazor.Components.Color.Dark" style="margin-top: 50px;margin-left: 20px;margin-right: 20px;margin-bottom:0px;" IsCenter="true">
                    <HeaderTemplate>
                        Open Quotations
                    </HeaderTemplate>
                    <BodyTemplate>
                        <h1><span class="badge text-bg-primary">@stats.countOpenQuotes</span></h1>
                    </BodyTemplate>
                    <FooterTemplate>
                        <button class="btn btn-primary btnOveride mt-4" @onclick="NavigateToQuotes">View Quotes</button>
                    </FooterTemplate>
                </Card>
            </Animation>
        }
    @if (accWarning)
    {
            <Animation Effect="@Effect.FadeIn" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(0.5)">
                <Card IsShadow="true" Color="BootstrapBlazor.Components.Color.Dark" style="margin-top: 50px;margin-left: 20px;margin-right: 20px;margin-bottom:0px;" IsCenter="true">
                    <HeaderTemplate>
                        Account Status Warning
                    </HeaderTemplate>
                    <BodyTemplate>
                        <FluentStack Orientation="Orientation.Vertical" Style="flex :content">
                        <div style="padding:20px">
                            <FluentStack Orientation="Orientation.Horizontal" Style="flex :content">
                                <FluentStack Orientation="Orientation.Vertical" Style="flex :content">
                                    <p><strong>Payment Terms:</strong> @_client.TermDays Days</p>
                                    <p><strong>Credit Limit:</strong> @String.Format("{0:#,##0.00;(#,##0.00)}", _client.CreditLimit)</p>
                                    
                                </FluentStack>

                        <table class="table table-bordered">
                            <tr class=@dCur>
                                <td class=@dCur>
                                    Current
                                </td>
                                <td class=@dCur>
                                    @String.Format("{0:#,##0.00;(#,##0.00)}", _client.Ageing05)
                                </td>
                            </tr>
                            <tr class=@d30>
                                <td class=@d30>
                                    30 Days
                                </td>
                                <td class=@d30>
                                    @String.Format("{0:#,##0.00;(#,##0.00)}", _client.Ageing04)
                                </td>
                            </tr>
                            <tr class=@d60>
                                <td class=@d60>
                                    60 Days
                                </td>
                                <td class=@d60>
                                    @String.Format("{0:#,##0.00;(#,##0.00)}", _client.Ageing03)
                                </td>
                            </tr>
                            <tr class=@d90>
                                <td class=@d90>
                                    90 Days
                                </td>
                                <td class=@d90>
                                    @String.Format("{0:#,##0.00;(#,##0.00)}", _client.Ageing02)
                                </td>
                            </tr>
                            <tr class=@d120>
                                <td class=@d120>
                                    120 Days+
                                </td>
                                <td class=@d120>
                                    @String.Format("{0:#,##0.00;(#,##0.00)}", _client.Ageing01)
                                </td>
                            </tr>
                        </table>
                            </FluentStack>
                        </div>
                            <div style="align-self:center"> <strong>Balance:</strong> @String.Format("{0:#,##0.00;(#,##0.00)}", _client.CreditLimit)</div>
                            </FluentStack>
                    </BodyTemplate>
                    <FooterTemplate>
                        <button class="btn btn-primary btnOveride">Follow Up</button>
                        @* <a href="payment.html" class="btn btn-primary btnOveride mt-4" id="payButton">Follow Up</a> *@
                    </FooterTemplate>
                </Card>
            </Animation>
    }
            
    </FluentStack>
}

@code {

    private string _customer_Id = string.Empty;

    private Customer? _client;
    private string? d120 = string.Empty ;
    private string? d90 = string.Empty;
    private string? d60 = string.Empty;
    private string? d30 = string.Empty;
    private string? dCur = string.Empty;
    private bool isLoading = true;
    private bool accWarning = false;
    private ClientCurrentStats? stats;
    private int WOCount = 0;
    private int QuoteCount = 0;
    private bool startAni = false;

    protected override async Task OnInitializedAsync()
    {
        // Simulate asynchronous loading to demonstrate streaming rendering
        // await Task.Delay(3000);
        await GetClientInfo();
        isLoading = false;
    }

    private async Task GetClientInfo()
    {
        Customer _cust = await DataTransferService.GetgvSelectedClient();
        // await Task.Delay(3000);
        // _client = await pulseApi.GetAsync<Customer>($"Customers/Details/{_customer_Id}");
        //.GetClientByIdAsync(_customer_Id);
        if (_cust is null)
        {

        }
        else
        {
            if (_cust.ClientSales == null)
            {
                _cust.ClientSales = await pAI.GetClientSalesAsync(_cust.FullClientID);
                await DataTransferService.SetgvSelectedClient(_cust);
            }
            stats = await DataTransferService.GetgvSelectedClientStats();
            if (stats == null || stats.FullClientID != _cust.FullClientID){
                stats = await pAI.GetClientStatsAsync(_cust.FullClientID);
                await DataTransferService.SetgvSelectedClientStats(stats);
            }
            
            if (_cust.Ageing01 > 0) { d120 = "myWarning"; accWarning = true; } else { d120 = "mySuccess"; }
            if (_cust.Ageing02 > 0 && _cust.TermDays < 90) { d90 = "myWarning"; accWarning = true; } else { d90 = "mySuccess"; }
            if (_cust.Ageing03 > 0 && _cust.TermDays < 60) { d60 = "myWarning"; accWarning = true; } else { d60 = "mySuccess"; }
            if (_cust.Ageing04 > 0 && _cust.TermDays < 30) { d30 = "myWarning"; accWarning = true; } else { d30 = "mySuccess"; }
            if (_cust.Ageing05 > 0 && _cust.TermDays < 1) { dCur = "myWarning"; accWarning = true; } else { dCur = "mySuccess"; }
            
            _client = _cust;

        }
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!startAni && _client is not null)
        {
            startAni = true;
            // if (!firstRender)
            // {
                StateHasChanged();
            // }
            
        }
        
    }

    private void NavigateToProfile()
    {
        Navigation.NavigateTo("/EmployeeZone/Customers/ClientProfile");
    }
    private void NavigateToWIP()
    {
        Navigation.NavigateTo("/CustomerZone/ClientWIP");
    }
    private void NavigateToQuotes()
    {
        Navigation.NavigateTo("/CustomerZone/ClientProfile");
    }

    private void NavigateToRollers()
    {
        Navigation.NavigateTo("/EmployeeZone/Customers/ClientRollerSpecifications");
    }
}
