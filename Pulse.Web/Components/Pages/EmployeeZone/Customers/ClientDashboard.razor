                        <table class="table table-bordered">
                            <tr class=@dCur>
                                <td class=@dCur>
                                    Current
                                </td>
                                <td class=@dCur>
                                    @String.Format("{0:#,##0.00;(#,##0.00)}", _client.Ageing05)
                                </td>
                            </tr>
                            <tr class=@d30>
                                <td class=@d30>
                                    30 Days
                                </td>
                                <td class=@d30>
                                    @String.Format("{0:#,##0.00;(#,##0.00)}", _client.Ageing04)
                                </td>
                            </tr>
                            <tr class=@d60>
                                <td class=@d60>
                                    60 Days
                                </td>
                                <td class=@d60>
                                    @String.Format("{0:#,##0.00;(#,##0.00)}", _client.Ageing03)
                                </td>
                            </tr>
                            <tr class=@d90>
                                <td class=@d90>
                                    90 Days
                                </td>
                                <td class=@d90>
                                    @String.Format("{0:#,##0.00;(#,##0.00)}", _client.Ageing02)
                                </td>
                            </tr>
                            <tr class=@d120>
                                <td class=@d120>
                                    120 Days+
                                </td>
                                <td class=@d120>
                                    @String.Format("{0:#,##0.00;(#,##0.00)}", _client.Ageing01)
                                </td>
                            </tr>
                        </table>
                            </FluentStack>
                        </div>
                            <div style="align-self:center"> <strong>Balance:</strong> @String.Format("{0:#,##0.00;(#,##0.00)}", _client.CreditLimit)</div>
                            </FluentStack>
                    </BodyTemplate>
                    <FooterTemplate>
                        <button class="btn btn-primary btnOveride">Follow Up</button>
                    </FooterTemplate>
                </Card>
                </FluentGridItem> *@
            @* </Animation> *@
    }
        
    </FluentGrid>
}

@code {

    private string _customer_Id = string.Empty;
    [CascadingParameter]
    Customer _client { get; set; } = default!;

    private string? d120 = string.Empty ;
    private string? d90 = string.Empty;
    private string? d60 = string.Empty;
    private string? d30 = string.Empty;
    private string? dCur = string.Empty;
    private bool isLoading = true;
    private bool accWarning = false;
    private ClientSale? cmSales;
    private decimal? cYtdSales;
    private Period? curPer;
    private ClientCurrentStats? stats;
    private int WOCount = 0;
    private int QuoteCount = 0;
    private bool startAni = false;

    protected override async Task OnInitializedAsync()
    {
        // Simulate asynchronous loading to demonstrate streaming rendering
        // await Task.Delay(3000);
        // await DTrf.SetgvContextArea(0);
        // ShowAiIcon showAi = new ShowAiIcon();
        // await DTrf.SetgvShowAI(showAi);
        cdAppState.OnClientChange += async () =>
        {
            await GetClientData();
        };
        // await AppState.NotifyStateChanged();
        isLoading = false;
    }



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            
            await GetClientData();
        }
        
    }
    private async Task GetClientData()
    {
        isLoading = true;
        curPer = await DTrf.GetgvCurrentPeriod();
        stats = await DTrf.GetgvSelectedClientStats();
        if (stats == null || stats.FullClientID != _client.FullClientID)
        {
            stats = await pAI.GetClientStatsAsync(_client.FullClientID);
            await DTrf.SetgvSelectedClientStats(stats);
        }
        // StateHasChanged();
        if (_client.Ageing01 > 0) { d120 = "myWarning"; accWarning = true; } else { d120 = "mySuccess"; }
        if (_client.Ageing02 > 0 && _client.TermDays < 90) { d90 = "myWarning"; accWarning = true; } else { d90 = "mySuccess"; }
        if (_client.Ageing03 > 0 && _client.TermDays < 60) { d60 = "myWarning"; accWarning = true; } else { d60 = "mySuccess"; }
        if (_client.Ageing04 > 0 && _client.TermDays < 30) { d30 = "myWarning"; accWarning = true; } else { d30 = "mySuccess"; }
        if (_client.Ageing05 > 0 && _client.TermDays < 1) { dCur = "myWarning"; accWarning = true; } else { dCur = "mySuccess"; }
        
        if (_client.ClientSales != null)
        {
            cmSales = _client.ClientSales.FirstOrDefault(s => s.PeriodID == curPer.PeriodID);
            cYtdSales = _client.ClientSales.Where(sa => sa.PeriodID < curPer.PeriodID && sa.Period.FinancialYear == curPer.FinancialYear).Sum(sa => sa.Amount);
        }
        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void NavigateToProfile()
    {
        Navigation.NavigateTo("/EmployeeZone/Customers/ClientProfile");
    }
    private void NavigateToWIP()
    {
        Navigation.NavigateTo("/CustomerZone/ClientWIP");
    }
    private void NavigateToQuotes()
    {
        Navigation.NavigateTo("/CustomerZone/ClientProfile");
    }

    private void NavigateToRollers()
    {
        Navigation.NavigateTo("/EmployeeZone/Customers/ClientRollerSpecifications");
    }
}
