@page "/EmployeeZone/Customers/ClientContacts"
@using Pulse.Models.Customers
@using Pulse.Models.Misc
@using Pulse.Web.Services
@inject PulseApiService pApi
@inject DataTransferService DTrf
@inject AppState AppState
@rendermode InteractiveServer


<style>
    .cparent {
        display: flex;
        flex-direction: column; /* Stack children vertically */
        height: 100%; /* Or whatever height your parent should be, like 100% */
        overflow:hidden;
    }

    .cheader, .cfooter {
        /* Fixed sizes; flexbox will respect these */
        height: 50px; /* Or min-height if you want flexibility */
        background: lightgray;
    }

   
</style>

<div class="cparent">
    <div class="ccontent">

<FluentGrid Style="height:inherit">
            @if(c == null)
            {
                <div class="div-center-screen">
                    <FluentProgressRing />
                </div>
            }
            else
            {
                @foreach(ClientContact clientContact in c.ClientContacts)
                {
                    <FluentGridItem lg="2" md="4" sm="8" xs="12">
                        <Animation Effect="@Effect.FadeIn" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(0.5)">
                        <div class="card text-center" style="height:100%">

                            <header class="card-header">@clientContact.FullName</header>
                            <div class="card-body" >
                                <h6>@clientContact.ContactTitle</h6>
                                <span>@clientContact.ContactMobile</span>
                                <span>@clientContact.ContactEmail</span>
                            </div>
                        </div>
                        @* <FluentCard>
                            <FluentLabel><strong>@clientContact.FullName</strong></FluentLabel>
                            <FluentLabel>@clientContact.ContactTitle</FluentLabel>
                        </FluentCard> *@
                        </Animation>
                    </FluentGridItem>
                }
            }
        </FluentGrid>
</div>
</div>


@code {
    Customer? c;

    protected override async Task OnInitializedAsync()
    {
        // Simulate asynchronous loading to demonstrate streaming rendering
        // await Task.Delay(3000);
        ShowAiIcon showAi = new ShowAiIcon();
        await DTrf.SetgvShowAI(showAi);
        await AppState.NotifyStateChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Customer cl = await DTrf.GetgvSelectedClient();
            if (cl.ClientContacts == null)
            {
                cl.ClientContacts = await pApi.GetAsync<List<ClientContact>>($"/Customers/Details/{cl.FullClientID}/Contacts/GetAll");
                await DTrf.SetgvSelectedClient(cl);
            }
            c = cl;
            StateHasChanged();
        }
    }
}
