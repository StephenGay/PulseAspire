@code {
    Customer? c;
    int noContact = 0;

    protected override async Task OnInitializedAsync()
    {
        // Simulate asynchronous loading to demonstrate streaming rendering
        // await Task.Delay(3000);
        ShowAiIcon showAi = new ShowAiIcon();
        await DTrf.SetgvShowAI(showAi);
        await AppState.NotifyStateChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Customer cl = await DTrf.GetgvSelectedClient();
            if (cl.ClientContacts == null)
            {
                cl.ClientContacts = await pApi.GetAsync<List<ClientContact>>(ApiEndpoints.Customers.ByFullClientID.Contacts.Get(cl.FullClientID));
                await DTrf.SetgvSelectedClient(cl);
            }
            c = cl;
            StateHasChanged();
        }
    }
    private async Task OnContactClick(ClientContact contact)
    {
        // await DTrf.SetgvSelectedClientContact(contact);
        // Navigate to contact details page or open a dialog, etc.
    }
}
