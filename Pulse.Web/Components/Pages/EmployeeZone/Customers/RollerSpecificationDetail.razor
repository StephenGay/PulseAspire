                                        <FluentSpacer />
                                        <FluentNumberField @bind-Value=cSpec.ShellLength Appearance="FluentInputAppearance.Filled" ReadOnly="true">Shell Length</FluentNumberField>
                                        <FluentSpacer />
                                        <FluentNumberField @bind-Value=cSpec.ShellWeight Appearance="FluentInputAppearance.Filled" ReadOnly="true">Shell Weight</FluentNumberField>
                                        <FluentSpacer />
                                        <FluentTextField @bind-Value=cSpec.ShellTypeName Appearance="FluentInputAppearance.Filled" ReadOnly="true">Shell Type</FluentTextField>
                                    </FluentStack>
                                </FluentStack>

                                <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" Width="100%" Style="border: 1px solid black; border-radius:10px;margin-top:10px">
                                    <FluentLabel Typo="Typography.H6" Style="width:100%;background-color: #365b66; color:white;border-bottom: 1px solid black; text-align:center; border-top-left-radius:10px; border-top-right-radius:10px;padding-top:10px;padding-bottom:10px">Cover Details</FluentLabel>
