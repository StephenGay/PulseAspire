                                        <FluentNumberField @bind-Value=cSpec.HardnessToleranceAllowed Appearance="FluentInputAppearance.Filled" ReadOnly="true">Tolerance Allowed</FluentNumberField>
                                        <FluentSpacer />
                                        <FluentTextField @bind-Value=cSpec.HardnessTypeRequired Appearance="FluentInputAppearance.Filled" ReadOnly="true">Hardness Type</FluentTextField>
