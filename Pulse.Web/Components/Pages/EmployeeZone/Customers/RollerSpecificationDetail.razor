                                        <FluentNumberField @bind-Value=cSpec.CoverLength Appearance="FluentInputAppearance.Filled" ReadOnly="true">Cover Length</FluentNumberField>
                                        <FluentSpacer />
                                        <FluentNumberField @bind-Value=cSpec.CoverDiameter Appearance="FluentInputAppearance.Filled" ReadOnly="true">Cover Diameter</FluentNumberField>
