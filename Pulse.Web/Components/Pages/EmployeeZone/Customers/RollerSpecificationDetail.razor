            </FluentStack>
            @* <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" Width="100%" Style="padding: 10px; overflow-y: auto; height:40%;">
                
            </FluentStack> *@
        }
    @* </FluentStack> *@
    </div>
    @* <div class="cfooter" /> *@
</div>
@* </FluentLayout> *@

@code {
    private ClientRollerSpecification? cSpec;
    private bool isLoading = true;
    private List<ClientRollerDto>? rollers2;
    private List<RollerType>? rollerTypes;
    private RollerType? selectedRollerType;
    private IndustryProcess? selectedProcess;
    private List<IndustryProcess>? industryProcesses;
    private Customer? customer;

    protected override async Task OnInitializedAsync()
    {
        // Simulate asynchronous loading to demonstrate streaming rendering
        // await Task.Delay(3000);
        await GetSpecInfo();
        ShowAiIcon showAi = new ShowAiIcon();
        showAi.showAli = true;
        await DTrf.SetgvShowAI(showAi);
        await AppState.NotifyStateChanged();
        rollerTypes = await pApiClient.GetAsync<List<RollerType>>("/Technical/RollerTypes/GetAll");
        isLoading = false;
    }

    private async Task GetSpecInfo()
    {
        await DTrf.SetgvAIContextMode("RollerSpecification");
        await DTrf.SetgvContextArea(2);
        ClientRollerSpecification tmpSpec = await DTrf.GetgvSelectedRollSpec();
        customer = await DTrf.GetgvSelectedClient();
        if (customer.IndustryID == null)
        {
            industryProcesses = new List<IndustryProcess>();
        }
        else
        {
            industryProcesses = await pApiClient.GetAsync<List<IndustryProcess>>($"/Technical/IndustryProcess/GetByIndustry/{customer.IndustryID}");
        }
        
        if(tmpSpec.ClientRollers == null)
        {
            var rollers = await Http.GetFromJsonAsync<ICollection<ClientRollerDto>>($"http://localhost:7466/Customers/RollerSpecifications/AllDetailsBySpecID/{tmpSpec.ClientRollerSpecificationID}");
            rollers2 = rollers?.ToList();
            tmpSpec.ClientRollers = rollers.ToClientRollers();
            foreach(var roller in tmpSpec.ClientRollers)
            {
                roller.WorksOrders = await Http.GetFromJsonAsync<ICollection<WorksOrder>>($"http://localhost:7466/Customers/RollerSpecifications/GetWOByRollerID/{roller.ClientRollerID}") ?? new List<WorksOrder>();
            }
            tmpSpec.WorksOrders = await Http.GetFromJsonAsync<ICollection<WorksOrder>>($"http://localhost:7466/Customers/RollerSpecifications/GetWOBySpecID/{tmpSpec.ClientRollerSpecificationID}") ?? new List<WorksOrder>();
            await DTrf.SetgvSelectedRollSpec(tmpSpec);
        }
        cSpec = tmpSpec;
    }
}
