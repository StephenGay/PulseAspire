                                    <FluentLabel Typo="Typography.H6" Style="width:100%;background-color: #365b66; color:white;border-bottom: 1px solid black; text-align:center; border-top-left-radius:10px; border-top-right-radius:10px;padding-top:10px;padding-bottom:10px">Operating Environment</FluentLabel>
                                    <FluentStack Orientation="Orientation.Horizontal"
