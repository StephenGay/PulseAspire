@page "/EmployeeZone/Customers/3DRoller"
@using Pulse.Web.Services
@using Pulse.Models.Rollers
@using Pulse.Models.Customers
@* @using Microsoft.FluentUI.AspNetCore.Components *@
@inject RollerModelGenerationService Roller3D
@inject DataTransferService DTrf
@inject RollerDataTransferService RollerDTrf
@rendermode InteractiveServer

<div class="cparent">
    <FluentToolbar Orientation="MsFluent.Orientation.Horizontal" Style="padding:12px; background:#f8f9fa; border-bottom:1px solid #ddd;">
        <FluentButton Appearance="Appearance.Accent" @onclick="ReloadModel">
            <FluentIcon Value="@(new Icons.Regular.Size24.Play())" /> Reload Model
        </FluentButton>

        <FluentDivider Orientation="MsFluent.Orientation.Vertical" />

        <!-- Animation -->
        <FluentLabel>Animation:</FluentLabel>
        <FluentButton @onclick="() => Roller3D.StartSpinAsync()">▶️ Spin</FluentButton>
        <FluentButton @onclick="() => Roller3D.StopSpinAsync()">⏸️ Stop</FluentButton>

        <div style="width: 200px; margin-left: 12px; display:flex; align-items:center; gap:8px;">
            <FluentSlider TValue="float" Min="0f" Max="0.1f" Step="0.01f"
                          Value="@spinSpeed"
                          ValueChanged="@(newVal => OnSpinSpeedChanged(newVal))" />
            <span style="width:50px; font-size:0.9em; font-family:monospace;">@(spinSpeed.ToString("0.000"))</span>
        </div>

        <FluentDivider Orientation="MsFluent.Orientation.Vertical" />

        <!-- Advanced Features -->
        <FluentSwitch Label="Exploded" @bind-Value="isExploded" @onchange="OnExplodedChanged" />
        <FluentButton @onclick="ToggleDimensions">📏 Dim</FluentButton>
        <FluentButton @onclick="ToggleLabels">📐 Labels</FluentButton>
        <FluentButton Appearance="Appearance.Neutral" @onclick="() => Roller3D.CaptureScreenshotAsync()">
            📸 Screenshot
        </FluentButton>

        <FluentSpacer />

        <!-- Camera -->
        <FluentLabel Style="margin-right:8px;">View:</FluentLabel>
        <FluentSelect TOption="string"
                      Items="@cameraPresetOptions"
                      OptionText="@(item => item)"
                      OptionValue="@(item => item)"
                      @bind-SelectedOption="selectedPreset"
                      Width="150px"
                      @onchange="OnCameraPresetChanged" />

        <FluentButton @onclick="() => Roller3D.ResetCameraAsync()">Reset Camera</FluentButton>
        <FluentButton @onclick="ToggleAllVisibility">
            @(allVisible ? "Hide All" : "Show All")
        </FluentButton>
    </FluentToolbar>

    <!-- Parts Visibility + Opacity Panel -->
    <FluentCard Width="300px" Style="position:absolute; top:280px; right:20px; z-index:100; max-height:70vh; overflow:auto;">
        <FluentTitle Style="padding:12px 16px; border-bottom:1px solid #eee;">Parts Control</FluentTitle>

        <div style="padding:12px; display:flex; flex-direction:column; gap:12px;">
            @if (parts?.Any() == true)
            {
                @foreach (var part in parts)
                {
                    <div>
                        <FluentLabel Style="font-weight:bold;">@part.DisplayName</FluentLabel>
                        <FluentSwitch Label="Visible" 
                                      @bind-Value="part.Visible"
                                      @onchange="() => OnPartVisibilityChanged(part)" />
                        
                        <div style="margin-top:4px;">
                            <span style="font-size:0.8em; color:#666;">Opacity: @((part.Opacity * 100).ToString("0"))%</span>
                            <FluentSlider TValue="float"
                                          Min="0.1f" Max="1f" Step="0.05f"
                                          Value="@part.Opacity"
                                          ValueChanged="@(newVal => OnOpacityValueChanged(part, newVal))" />
                        </div>
                    </div>
                }

                <FluentButton Appearance="Appearance.Neutral" @onclick="ResetAllOpacities">
                    Reset All Opacity
                </FluentButton>
            }
            else
            {
                <p style="color:#888; font-style:italic;">No parts loaded</p>
            }
        </div>
    </FluentCard>

    <!-- 3D Viewer -->
    <div class="viewer-container">
        <div @ref="viewerContainer" style="width:100%; height:100%;"></div>
    </div>
</div>

@code {
    private ElementReference viewerContainer;
    private bool isLoaded = false;
    private bool isExploded = false;
    private bool dimensionsVisible = false;
    private bool labelsVisible = false;

    private float spinSpeed = 0.004f;
    private string? selectedPreset = "isometric";

    private ClientRollerSpecification? roller;
    private List<RollerShaft>? shafts;
    private List<RollerModelPartVisibility> parts = new();
    private bool allVisible = true;

    private readonly List<string> cameraPresetOptions = new() { "isometric", "front", "side", "top" };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await InitializeAsync();
    }

    private async Task InitializeAsync()
    {
        isLoaded = false;
        StateHasChanged();

        await Roller3D.InitializeViewerAsync(viewerContainer);

        roller = await DTrf.GetgvSelectedRollSpec();
        shafts = await RollerDTrf.GetgvSelectedRollerShafts();

        await Roller3D.LoadRollerAsync(roller!, shafts ?? new());

        await LoadPartsListAsync();

        await Roller3D.SetSpinSpeedAsync(spinSpeed);
        await Roller3D.StartSpinAsync();
        await Roller3D.EnableAdvancedInteractivityAsync();

        isLoaded = true;
        StateHasChanged();
    }

    private async Task LoadPartsListAsync()
    {
        try
        {
            var list = await Roller3D.GetPartsListAsync();
            parts = list?.Select(p => new RollerModelPartVisibility
            {
                Name = p.Name,
                DisplayName = p.DisplayName,
                Visible = p.Visible,
                Opacity = 1.0f
            }).ToList() ?? new();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            System.Console.Error.WriteLine($"Error loading parts: {ex.Message}");
            parts = new();
        }
    }

    private async Task OnPartVisibilityChanged(RollerModelPartVisibility part)
        => await Roller3D.ToggleVisibilityAsync(part.Name, part.Visible);

    private async Task ToggleAllVisibility()
    {
        allVisible = !allVisible;
        await Roller3D.SetAllVisibilityAsync(allVisible);
        await LoadPartsListAsync();
    }

    private async Task OnOpacityValueChanged(RollerModelPartVisibility part, float newValue)
    {
        part.Opacity = newValue;
        await Roller3D.SetOpacityAsync(part.Name, newValue);
    }

    private async Task ResetAllOpacities()
    {
        await Roller3D.ResetAllOpacitiesAsync();
        foreach (var p in parts) p.Opacity = 1.0f;
        StateHasChanged();
    }

    private async Task OnSpinSpeedChanged(float newValue)
    {
        spinSpeed = newValue;
        await Roller3D.SetSpinSpeedAsync(newValue);
    }

    private async Task OnExplodedChanged()
        => await Roller3D.SetExplodedFactorAsync(isExploded ? 1.0 : 0.0);

    private async Task OnCameraPresetChanged()
    {
        if (!string.IsNullOrEmpty(selectedPreset))
            await Roller3D.SetCameraPresetAsync(selectedPreset);
    }

    private async Task ToggleDimensions()
    {
        dimensionsVisible = !dimensionsVisible;
        if (dimensionsVisible)
            await Roller3D.AddDimensionLinesAsync();
        else
            await Roller3D.RemoveDimensionLinesAsync();
    }

    private async Task ToggleLabels()
    {
        labelsVisible = !labelsVisible;
        if (labelsVisible)
            await Roller3D.AddMeasurementLabelsAsync();
        else
            await Roller3D.RemoveMeasurementLabelsAsync();
    }

    private async Task ReloadModel()
    {
        await InitializeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await Roller3D.DisposeAsync();
    }
}