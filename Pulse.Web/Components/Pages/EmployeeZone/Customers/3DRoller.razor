@page "/EmployeeZone/Customers/3DRoller"
@using Pulse.Web.Services
@using Pulse.Models.Rollers
@using Pulse.Models.Customers
@using Microsoft.FluentUI.AspNetCore.Components
@inject RollerModelGenerationService Roller3D
@inject DataTransferService DTrf
@inject RollerDataTransferService RollerDTrf
@rendermode InteractiveServer

<div class="cparent">
    <FluentToolbar Orientation="MsFluent.Orientation.Horizontal" Style="padding:12px; background:#f8f9fa; border-bottom:1px solid #ddd;">
        <FluentButton Appearance="Appearance.Accent" @onclick="ReloadModel">
            <FluentIcon Value="@(new Icons.Regular.Size24.Play())" /> Reload Model
        </FluentButton>

        <FluentDivider Orientation="MsFluent.Orientation.Vertical" />

        <!-- Animation Controls -->
        <FluentLabel>Animation:</FluentLabel>
        <FluentButton @onclick="() => Roller3D.StartSpinAsync()">▶️ Spin</FluentButton>
        <FluentButton @onclick="() => Roller3D.StopSpinAsync()">⏸️ Stop</FluentButton>

        <div style="width: 200px; margin-left: 12px;">
            <FluentSlider Min="0" Max="0.015" Step="0.0005"
                          @bind-Value="spinSpeed"
                          @onchange="OnSpinSpeedChanged" />
                        <span style="width:50px; font-size:0.9em;">@(spinSpeed.ToString("0.000"))</span>
        </div>

        <FluentDivider Orientation="MsFluent.Orientation.Vertical" />

        <!-- Advanced Features -->
        <FluentSwitch Label="Exploded" @bind-Value="isExploded" @onchange="OnExplodedChanged" />
        <FluentButton @onclick="ToggleDimensions">📏 Dimensions</FluentButton>
        <FluentButton @onclick="ToggleLabels">📐 Labels</FluentButton>
        <FluentButton Appearance="Appearance.Neutral" @onclick="() => Roller3D.CaptureScreenshotAsync()">
            📸 Screenshot
        </FluentButton>

        <FluentSpacer />

        <!-- Camera Preset -->
        <FluentLabel Style="margin-right:8px;">View:</FluentLabel>
        <FluentSelect TOption="string"
                      Items="@cameraPresetOptions"
                      OptionText="@(item => item)"
                      OptionValue="@(item => item)"
                      @bind-SelectedOption="selectedPreset"
                      Width="150px"
                      @onchange="OnCameraPresetChanged" />

        <FluentButton @onclick="() => Roller3D.ResetCameraAsync()">Reset Camera</FluentButton>
    </FluentToolbar>

    <!-- 3D Viewer -->
    <div class="viewer-container">
        <div @ref="viewerContainer" style="width:100%; height:100%;"></div>
    </div>
</div>

@code {
    private ElementReference viewerContainer;
    private bool isLoaded = false;
    private bool isExploded = false;
    private bool dimensionsVisible = false;
    private bool labelsVisible = false;

    private double spinSpeed = 0.004;
    private string? selectedPreset = "isometric";

    private ClientRollerSpecification? roller;
    private List<RollerShaft>? shafts;

    // ✅ Correct way with Fluent UI Blazor
    private readonly List<string> cameraPresetOptions = new()
{
    "isometric", "front", "side", "top"
};

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await InitializeAsync();
    }

    private async Task InitializeAsync()
    {
        isLoaded = false;
        StateHasChanged();

        await Roller3D.InitializeViewerAsync(viewerContainer);

        roller = await DTrf.GetgvSelectedRollSpec();
        shafts = await RollerDTrf.GetgvSelectedRollerShafts();

        await Roller3D.LoadRollerAsync(roller!, shafts ?? new());

        await Roller3D.SetSpinSpeedAsync((float)spinSpeed);
        await Roller3D.StartSpinAsync();
        await Roller3D.EnableAdvancedInteractivityAsync();   // Hover + Right-click panel

        isLoaded = true;
        StateHasChanged();
    }
    private async Task OnSpinSpeedChanged()
    {
        await Roller3D.SetSpinSpeedAsync((float)spinSpeed);
        StateHasChanged();
    }
    private async Task OnExplodedChanged()
        => await Roller3D.SetExplodedFactorAsync(isExploded ? 1.0 : 0.0);

    private async Task OnCameraPresetChanged()
    {
        if (!string.IsNullOrEmpty(selectedPreset))
            await Roller3D.SetCameraPresetAsync(selectedPreset);
    }

    private async Task ToggleDimensions()
    {
        dimensionsVisible = !dimensionsVisible;
        if (dimensionsVisible)
            await Roller3D.AddDimensionLinesAsync();
        else
            await Roller3D.RemoveDimensionLinesAsync();
    }
    private async Task ReloadModel()
    {
        await InitializeAsync();
    }
    private async Task ToggleLabels()
    {
        labelsVisible = !labelsVisible;
        if (labelsVisible)
            await Roller3D.AddMeasurementLabelsAsync();
        else
            await Roller3D.RemoveMeasurementLabelsAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await Roller3D.DisposeAsync();
    }
}