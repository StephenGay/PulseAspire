@page "/EmployeeZone/Customers/ClientRollerSpecifications"
@using Pulse.Models.Customers
@using Pulse.Web.Services

@inject DataTransferService DataTransferService
@inject Pulse.Web.Services.Pulse_AI pAI
@rendermode InteractiveServer

<FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Center" Width="100%" Style="height: 100%; overflow-y : scroll;">

@if (isLoading)
{
    <FluentLabel Typo="Typography.Body" Style="color:black;">Loading...</FluentLabel>
}else{

    <FluentGrid Spacing="4" Style="width:100%;">
        @* <FluentGridItem xs="12"> *@
        <FluentDataGrid Items="FilteredItems" TGridItem="ClientRollerSpecification"
                            RowClass="@(context => context == selSpec ? "fdgrselected" : "fdgrunselected")"
                            SelectionMode="SelectionMode.Single"
                            SelectedItem="@selSpec"
                            ResizableColumns="true"
                            
                            ShowHover="true"
                            AutoFit="true"
                            Virtualize="true"
                            Style="width: 100%;"
                            GenerateHeader="GenerateHeaderOption.Sticky">

                    <PropertyColumn Property="@(context => context.ClientRollerSpecificationID)" Title="Spec ID" Sortable="true" Align="Align.Center" Width="8%" />
                            <PropertyColumn Property="@(context => context.Description)" Title="Roll Description" Width="30%" Align="Align.Start" Sortable="true" Comparer="@StringLengthComparer.Instance" Filtered="!string.IsNullOrWhiteSpace(nameFilter)">
                    <ColumnOptions>
                        <div class="search-box">
                                <FluentSearch type="search" Autofocus=true @bind-Value=nameFilter @oninput="HandleCountryFilter" @bind-Value:after="HandleClear" Placeholder="Roll Description..." />
                        </div>
                    </ColumnOptions>
                </PropertyColumn>
                    @* <TemplateColumn Title="Name" InitialSortDirection=SortDirection.Descending SortBy="@nameSort" IsDefaultSortColumn=true Filtered="!string.IsNullOrWhiteSpace(nameFilter)">
                        <ColumnOptions>
                            <div class="search-box">
                                <FluentSearch type="search" Autofocus=true @bind-Value=nameFilter @oninput="HandleCountryFilter" @bind-Value:after="HandleClear" Placeholder="Country name..." />
                            </div>
                        </ColumnOptions>
                        <ChildContent>
                            @(context.Description)
                        </ChildContent>
                    </TemplateColumn> *@
                    @* <PropertyColumn Property="@(context => context.Description)" Title="Roll Description" Align="Align.Start" Sortable="true"></PropertyColumn> *@
                <PropertyColumn Property="@(context => context.ArticleNumber)" Title="Article No" Width="10%" Sortable="true" />
                <PropertyColumn Property="@(context => context.ShellTypeName)" Align="Align.Start" title="Shell Type" Width="10%" Sortable="true">
                    
                </PropertyColumn>
                <PropertyColumn Property="@(context => context.ShellLength)" Align="Align.Center" Width="10%" Title="Shell Length" Sortable="true"/>
            <PropertyColumn Property="@(context => context.ShellDiameter)" Align="Align.Center" Width="10%" Title="Shell Diameter" Sortable="true" />
                <PropertyColumn Property="@(context => context.CompoundCode)" Align="Align.Center" Width="10%" Title="Cover" Sortable="true"/>
            <PropertyColumn Property="@(context => context.CoverDiameter)" Align="Align.Center" Width="10%" Title="Cover Diameter" Sortable="true">
                </PropertyColumn>

                @* <TemplateColumn Title="SQL Query (Truncated)" Context="gridContext">
                                    user.UserFavouriteQueries.FirstOrDefault(q => q.QueryId == selectedSavedQuery.AiQueryID)
                                    @GetTruncatedSql(gridContext.SqlQuery)
                                </TemplateColumn> *@
            </FluentDataGrid>
            @* <FluentPaginator State="@pagination" Style="background-color: #365b66 ; padding:10px ; color: white; width:100%" /> *@
        @* </FluentGridItem> *@

    </FluentGrid>

}
</FluentStack>

    @code {
    Customer? _client;
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    string nameFilter = string.Empty;
    IQueryable<ClientRollerSpecification>? specs = null;
    private ClientRollerSpecification? selSpec; 
    PaginationState pagination = new PaginationState { ItemsPerPage = 50 };
    GridSort<ClientRollerSpecification> nameSort = GridSort<ClientRollerSpecification>.ByAscending(x => x.Description, StringLengthComparer.Instance);
    IQueryable<ClientRollerSpecification>? FilteredItems //=> specs; //?.Where(x => x.Description.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase));

    {
        get
        {
            // grid?.SetLoadingState(true);
            IQueryable<ClientRollerSpecification>? tempRS = specs;
            if (!string.IsNullOrEmpty(nameFilter))
            {
                tempRS = tempRS?.Where(x => x.Description.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase));
            }
            // grid?.SetLoadingState(false);

            if (tempRS != null)
                return tempRS.AsQueryable();

            return null;

        }
    }
    protected override async Task OnInitializedAsync()
    {
        // Simulate asynchronous loading to demonstrate streaming rendering
        // await Task.Delay(3000);
        await GetClientInfo();
        specs = _client.ClientRollerSpecifications.AsQueryable();
        isLoading = false;
    }

    private void HandleCountryFilter(ChangeEventArgs args)
    {
        if (args.Value is string value)
        {
            nameFilter = value;
        }
    }
    private void HandleClear()
    {
        if (string.IsNullOrWhiteSpace(nameFilter))
        {
            nameFilter = string.Empty;
        }
    }
    private async Task GetClientInfo()
    {
        _client = await DataTransferService.GetgvSelectedClient();

        if (_client is null)
        {

        }
        else
        {
            if (_client.ClientRollerSpecifications == null)
            {
                _client.ClientRollerSpecifications = await pAI.GetClientRollerSpecificationsAsync(_client.FullClientID);
                await DataTransferService.SetgvSelectedClient(_client);
            }
        }
    }

    public class StringLengthComparer : IComparer<string>
    {
        public static readonly StringLengthComparer Instance = new StringLengthComparer();

        public int Compare(string? x, string? y)
        {
            if (x is null)
            {
                return y is null ? 0 : -1;
            }

            if (y is null)
            {
                return 1;
            }

            return x.Length.CompareTo(y.Length);
        }
    }

}
