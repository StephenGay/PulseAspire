@page "/login"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Models.AI.AIds
@using Pulse.Models.Api
@using Pulse.Models.Misc
@using Pulse.Models.Users
@using Pulse.Web.Services
@using Toolbelt.Blazor.SpeechSynthesis

@inject PulseApiService ApiService
@inject AuthService AuthService
@inject CustomAuthenticationStateProvider AuthProvider
@inject DataTransferService DataTransfer
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject SpeechSynthesis SpeechSynthesis
@inject ILogger<Login> Logger

<style>
    .fluent-input-label[b-hum22yrq17] {
        color: white !important;
    }

</style>

<FluentCard Style="min-width: 400px; background-color: rgb(0,0,0)">
    @* <FluentHeader Style="background-color: #365b66;">
        Login
    </FluentHeader> *@

    <FluentBodyContent>
        @if (isForgot)
        {
            @if (!string.IsNullOrEmpty(errorForgotMessage))
            {
                <FluentMessageBar Intent="MessageIntent.Error"
                                  Style="margin-bottom: 16px;">
                    @errorForgotMessage
                </FluentMessageBar>
            }
            @if (!string.IsNullOrEmpty(successForgotMessage))
            {
                <FluentMessageBar Intent="MessageIntent.Success"
                                  Style="margin-bottom: 16px;">
                    @successForgotMessage
                </FluentMessageBar>
            }
            if (CheckEmail)
            {
                <p style="color:white">Reset your password and try login again.</p>
                <FluentButton 
                BackgroundColor="#660000"
                Appearance="Appearance.Accent"
                OnClick="() => { CheckEmail = false; ChangePasswordRequired = false; isForgot = false; }">
                    Back To Login
                </FluentButton>

            }
            else
            {
                if (ChangePasswordRequired)
                {
                    @* <p style="color:white">A password reset is required for this account.</p> *@
                    <p style="color:white">If you did not receive an email or the email link has expired, click the button below to resend.</p>
                }
                <EditForm Model="ForgotModel" OnValidSubmit="HandleForgotAsync">
                    <DataAnnotationsValidator />

                    <div style="margin-bottom: 16px;">
                        <FluentTextField @bind-Value="ForgotModel.Email"
                        Label="Email"
                        Style="width: 100%;"
                        Placeholder="Enter your email"
                        ReadOnly="true" />
                        <ValidationMessage For="@(() => ForgotModel.Email)" />
                    </div>

                    <div style="display: flex; justify-content: center; margin-top: 24px; gap: 16px;">
                        <FluentButton Type="Microsoft.FluentUI.AspNetCore.Components.ButtonType.Submit"
                        BackgroundColor="#660000"
                        Style="border:1px solid white"
                        Appearance="Appearance.Accent"
                        Disabled="isProcessingForgot">
                            @(isProcessingForgot ? "Sending..." : "Send Reset Email")
                        </FluentButton>
                    </div>
                </EditForm>
            }
        }
        else
        {
            <EditForm Model="Model" OnValidSubmit="HandleLoginAsync">
                <DataAnnotationsValidator />

                <div style="margin-bottom: 16px;">
                    <FluentTextField @bind-Value="Model.Email"
                    Label="Email"
                    Style="width: 100%;"
                    Placeholder="Enter your email"
                    ReadOnly="isLoading" />
                    <ValidationMessage For="@(() => Model.Email)" />
                </div>

                <div style="margin-bottom: 16px;">
                    <FluentTextField @bind-Value="Model.Password"
                    Label="Password"
                    Style="width: 100%;"
                    Type="password"
                    Placeholder="Enter your password"
                    ReadOnly="isLoading" />
                    <ValidationMessage For="@(() => Model.Password)" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <FluentMessageBar Intent="MessageIntent.Error"
                    Style="margin-bottom: 16px;">
                        @errorMessage
                    </FluentMessageBar>
                }
                
                
                @* <div style="display: flex; justify-content: center; margin-top: 24px; gap: 16px;"> *@
                <FluentStack Horizontal AlignItems="AlignItems.Center" Gap="8px" Style="width: 100%;">
                    @* <span>Forgot your password?</span> *@
                    <FluentButton BackgroundColor="#660000"
                    Style="border:1px solid white"
                    Appearance="Appearance.Accent"
                    @onclick="StartResetProcess"
                    Disabled="isLoading">
                        Forgot Password?
                    </FluentButton>
                    <FluentSpacer />
                    <FluentButton Type="Microsoft.FluentUI.AspNetCore.Components.ButtonType.Submit"
                    BackgroundColor="#660000"
                    Style="border:1px solid white"
                    Appearance="Appearance.Accent"
                    Disabled="isLoading">
                        @(isLoading ? "Logging in..." : "Login")
                    </FluentButton>
                </FluentStack>
                @* </div> *@
            </EditForm>
        }
    </FluentBodyContent>
</FluentCard>

@code {
    private LoginModel Model = new();
    private ForgotPasswordModel ForgotModel = new();
    private string? errorMessage;
    private string? errorForgotMessage;
    private string? successForgotMessage;
    private bool ChangePasswordRequired = false;
    private bool CheckEmail = false;
    private bool isLoading = false;
    private string? firstName;
    private bool isForgot = false;
    private bool isProcessingForgot = false;
    private string? pTheme;
    private IEnumerable<SpeechSynthesisVoice>? Voices;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Voices = await SpeechSynthesis.GetVoicesAsync();
        }
    }
    protected override async Task OnInitializedAsync()
    {
        // try
        // {
        //     Voices = await SpeechSynthesis.GetVoicesAsync();
        // }
        // catch (Exception ex)
        // {
        //     Logger.LogWarning(ex, "Failed to load speech synthesis voices");
        // }
    }

    private async Task StartResetProcess()
    {
        if (string.IsNullOrEmpty(Model.Email))
        {
            errorMessage = "Ënter your Email Address first.";
            return;
        }
        ForgotModel.Email = Model.Email;
        isForgot = true;
    }
    private async Task HandleForgotAsync()
    {
        errorForgotMessage = null;
        successForgotMessage = null;
        isProcessingForgot = true;
        StateHasChanged();

        try
        {
            Logger.LogInformation("Attempting to send reset password email for {Email}", ForgotModel.Email);
            // ChangePasswordRequired = true;
            // Deserialize to the wrapped response
            var apiResponse = await ApiService.PostAsync<ForgotPasswordModel, ApiResponse>(
                "/Security/forgot-password", ForgotModel);

            if (!apiResponse?.Success ?? true)
            {
                errorForgotMessage = apiResponse?.Message ?? "Password reset request failed. Please try again.";
                Logger.LogWarning("Password reset request failed for {Email}", ForgotModel.Email);
                return;
            }

            Logger.LogInformation("Password reset request successful for {Email}", ForgotModel.Email);
            successForgotMessage = apiResponse?.Message ?? "Password reset request sent. Please check your email.";
            CheckEmail = true;
        }
        catch (PulseApiException ex)
        {
            Logger.LogError(ex, "API error during login: {UserMessage}", ex.UserMessage);
            
            // Provide specific error messages based on category
            errorForgotMessage = ex.Category switch
            {
                ErrorCategory.Network => "Unable to connect to server. Check your internet connection.",
                ErrorCategory.Authentication => "Invalid email or password. Please try again.",
                ErrorCategory.Server => "Server error. Please try again later.",
                _ => ex.UserMessage ?? "Login failed. Please try again."
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error during login: {Message}", ex.Message);
            errorForgotMessage = "An unexpected error occurred. Please try again later.";
        }
        finally
        {
            isProcessingForgot = false;
            StateHasChanged();
        }
        // return Task.CompletedTask;
    }

    private async Task HandleLoginAsync()
    {
        errorMessage = null;
        isLoading = true;
        StateHasChanged();

        

        try
        {
            Logger.LogInformation("Attempting login for {Email}", Model.Email);

            // Deserialize to the wrapped response
            var apiResponse = await ApiService.PostAsync<LoginModel, ApiResponse<AuthenticationToken>>(
                "/Security/login", Model);

            if (apiResponse?.Data?.Token == null && apiResponse?.StatusCode != 409)
            {
                errorMessage = "Login failed: No authentication token received. Please check your credentials.";
                Logger.LogWarning("Login response missing token for user {Email}", Model.Email);
                return;
            }
            if(apiResponse?.StatusCode == 409)
            {
                errorForgotMessage = "A Password change is required. Please update your password.";
                Logger.LogWarning("Password change required for user {Email}", Model.Email);
                ForgotModel.Email = Model.Email;
                isForgot = true;
                ChangePasswordRequired = true;
                return;
            }

            Logger.LogInformation("Login successful for {Email}", Model.Email);

            await AuthService.SetAuthenticatedAsync(apiResponse.Data.Token);
            AuthProvider.NotifyStateChanged();

            var uSettings = await ApiService.GetAsync<ApplicationUserSettings>(ApiEndpoints.User.Settings.GetSettings(AuthService.aspireUserId));
            if(uSettings.PreferredUserName=="User"){ uSettings.PreferredUserName = AuthService.aspireFullName; }
            await DataTransfer.SetgvUserSettings(uSettings);
            // var user = await ApiService.GetAsync<User>(
            //     $"/Security/OldEmployeeLogin/email={Uri.EscapeDataString(Model.Email)}");

            // if (user == null)
            // {
            //     errorMessage = "User profile not found. Please contact support.";
            //     Logger.LogWarning("User profile not found after login for {Email}", Model.Email);
            //     return;
            // }

            // await DataTransfer.SetgvUser(user);
            pTheme = uSettings.UserTheme ?? "pulse";
            await JS.InvokeVoidAsync("applyPulseTheme", pTheme);
            // firstName = await DataTransfer.GetgvUserFirstName();
            await InitializeAIAsync(uSettings);

            Navigation.NavigateTo("/DivisionLogon?nextpage=/EmployeeZone/");
        }
        catch (PulseApiException ex)
        {
            Logger.LogError(ex, "API error during login: {UserMessage}", ex.UserMessage);
            
            // Provide specific error messages based on category
            errorMessage = ex.Category switch
            {
                ErrorCategory.Network => "Unable to connect to server. Check your internet connection.",
                ErrorCategory.Authentication => "Invalid email or password. Please try again.",
                ErrorCategory.Server => "Server error. Please try again later.",
                _ => ex.UserMessage ?? "Login failed. Please try again."
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error during login: {Message}", ex.Message);
            errorMessage = "An unexpected error occurred. Please try again later.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task InitializeAIAsync(ApplicationUserSettings userSettings)
    {
        if (Voices?.Any() != true)
            return;

        try
        {
            if (userSettings?.AIHasVoice == true && !string.IsNullOrEmpty(userSettings.AIVoiceID))
            {
                var voice = Voices.FirstOrDefault(v => v.VoiceIdentity.ToString() == userSettings.AIVoiceID);
                if (voice != null)
                {
                    await DataTransfer.SetgvUserAIVoice(voice);
                    await AISpeakAsync($"Hey {userSettings.PreferredUserName}, welcome back!", voice);
                }
            }

            Tables tables = new Tables();
            tables._Voice = Voices.FirstOrDefault(v => v.VoiceIdentity.ToString() == tables._VoiceId);
            await DataTransfer.SetgvTables(tables);

            Ali ali = new Ali();
            ali._Voice = Voices.FirstOrDefault(v => v.VoiceIdentity.ToString() == ali._VoiceId);
            await DataTransfer.SetgvAli(ali);

            Flapper flapper = new Flapper();
            flapper._Voice = Voices.FirstOrDefault(v => v.VoiceIdentity.ToString() == flapper._VoiceId);
            await DataTransfer.SetgvFlapper(flapper);

            var showAiIcon = new ShowAiIcon();
            await DataTransfer.SetgvShowAI(showAiIcon);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to initialize AI components");
        }
    }

    private SpeechSynthesisVoice? GetVoiceById(string? voiceId)
    {
        if (string.IsNullOrEmpty(voiceId) || Voices?.Any() != true)
            return null;

        return Voices.FirstOrDefault(v => v.VoiceIdentity.ToString() == voiceId);
    }

    private async Task AISpeakAsync(string text, SpeechSynthesisVoice voice)
    {
        try
        {
            var utterance = new SpeechSynthesisUtterance { Text = text, Voice = voice };
            await SpeechSynthesis.SpeakAsync(utterance);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to speak text");
        }
    }
}