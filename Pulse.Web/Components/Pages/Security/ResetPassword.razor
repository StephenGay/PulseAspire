@page "/reset-password"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Models.Api
@using Pulse.Models.Users
@using Pulse.Web.Services
@using FluentUI = Microsoft.FluentUI.AspNetCore.Components

@inject PulseApiService ApiService
@inject NavigationManager Navigation
@inject ILogger<ResetPassword> Logger

<style>
    .fluent-input-label[b-hum22yrq17] {
        color: white !important;
    }
</style>
<div style="background-color: rgb(0,0,0);" class="div-center-screen">
<div style="background-color: rgb(0,0,0);height:fit-content;width:fit-content;text-align:center;margin-top:auto;margin-bottom:auto;">
    @* <div style="height:50vh;width:fit-content; margin:auto;padding-top:calc(50vh - 277px);padding-bottom:0px;"> *@
        <img src="images/Logos/PulseAspireLogo610x277.png" class="img-fluid" alt="Pulse Aspire Logo" />
    @* </div>
    <Animation Effect="@Effect.ZoomIn" Speed="@TimeSpan.FromSeconds(1)" Delay="@TimeSpan.FromSeconds(1)"> *@
        @* <div style="height:50vh;width:fit-content;margin-left:auto;margin-right:auto;height:fit-content;"> *@
    <FluentCard Style="min-width: 400px; max-width:610px;width:95%; background-color: rgb(0,0,0);margin-left: auto;margin-right:auto;height:fit-content;">
                <FluentBodyContent>
                    @if (string.IsNullOrEmpty(Token) || string.IsNullOrEmpty(Email))
                    {
                        <FluentMessageBar Intent="MessageIntent.Error">
                            Invalid reset link. Please request a new password reset.
                        </FluentMessageBar>
                        <FluentButton @onclick="GoBackToLogin" Style="margin-top: 16px;">
                            Back to Login
                        </FluentButton>
                    }
                    else
                    {
                        <h3 style="color:white;">Reset Your Password</h3>
            
                        <EditForm Model="ResetModel" OnValidSubmit="@HandleResetAsync">
                            <DataAnnotationsValidator />

                           @*  <div style="margin-bottom: 16px;">
                                <FluentTextField @bind-Value="ResetModel.Email"
                                                 Label="Email"
                                                 Style="width: 100%;"
                                                 Disabled="true"
                                                 ReadOnly="true" />
                            </div> *@

                            <div style="margin-bottom: 16px;">
                                <FluentTextField @bind-Value="ResetModel.NewPassword"
                                                 Label="New Password"
                                                 Style="width: 100%;"
                                                 Type="password"
                                                 Placeholder="Enter your new password"
                                                 ReadOnly="isProcessing" />
                                <ValidationMessage For="@(() => ResetModel.NewPassword)" />
                            </div>

                            <div style="margin-bottom: 16px;">
                                <FluentTextField @bind-Value="ConfirmPassword"
                                                Immediate="true"
                                                 Label="Confirm Password"
                                                 Style="width: 100%;"
                                                 Type="password"
                                                 Placeholder="Confirm your new password"
                                                 ReadOnly="isProcessing" />
                                @if (!PasswordsMatch)
                                {
                                    <FluentMessageBar Intent="MessageIntent.Warning"
                                                      Style="margin-bottom: 16px;">
                                        Passwords do not match
                                    </FluentMessageBar>
                                    @* <span style="color: #c50f1f; font-size: 12px;">Passwords do not match</span> *@
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <FluentMessageBar Intent="MessageIntent.Error"
                                                  Style="margin-bottom: 16px;">
                                    @errorMessage
                                </FluentMessageBar>
                            }

                            @if (!string.IsNullOrEmpty(successMessage))
                            {
                                <FluentMessageBar Intent="MessageIntent.Success"
                                                  Style="margin-bottom: 16px;">
                                    @successMessage
                                </FluentMessageBar>
                            }

                           @*  <div style="display: flex; justify-content: center; gap: 16px;"> *@
                                <FluentStack Orientation="MsFluent.Orientation.Horizontal" HorizontalAlignment="MsFluent.HorizontalAlignment.Start">
                                    <FluentButton OnClick="() => viewRequirements = !viewRequirements"
                                                  BackgroundColor="#660000"
                                                  Style="border:1px solid white"
                                                  Appearance="MsFluent.Appearance.Accent">
                                        Requirements
                                    </FluentButton>
                                    <FluentSpacer />
                                    <FluentButton Type="MsFluent.ButtonType.Submit"
                                                  BackgroundColor="#660000"
                                                  Style="border:1px solid white"
                                                  Appearance="MsFluent.Appearance.Accent"
                                                  Disabled="!PasswordsMatch || isProcessing">
                                        @(isProcessing ? "Resetting Password..." : "Reset Password")
                                    </FluentButton>
                                    @* <FluentButton @onclick="GoBackToLogin"
                                                  Appearance="MsFluent.Appearance.Neutral"
                                                  Disabled="isProcessing">
                                        Cancel
                                    </FluentButton> *@
                            </FluentStack>
                            @* </div> *@
                        </EditForm>
                    }
                </FluentBodyContent>
            </FluentCard>
        @if (viewRequirements)
        {
            <FluentCard Style="text-align:left; min-width: 400px;margin-top:10px; max-width:610px;width:95%; border: 1px solid #f59e0b;background-color: #fffbeb;margin-left: auto;margin-right:auto;height:fit-content;">
                <FluentLabel Style="border-bottom:1px solid #660000;margin-bottom:5px;" Color="FluentUI.Color.Custom" CustomColor="#660000"><strong>Password Requirements:</strong></FluentLabel>
                <FluentBodyContent>
                    Minimum of 8 characters and contain:
                    <ul>
                        <li>At least 1 Numerical digit (0-9)</li>
                        <li>At least 1 Lowercase character (a-z)</li>
                        <li>At least 1 Uppercase character (A-Z)</li>
                        <li>At least 1 Non-AlphaNumeric character (&#$%!*{}., ...etc)</li>
                    </ul>
                </FluentBodyContent>
            </FluentCard>
        }
    </div>
</div>
    @* </Animation>
	
</div> *@


@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    private ResetPasswordModel ResetModel = new();
    private string ConfirmPassword = string.Empty;
    private string? errorMessage;
    private string? successMessage;
    private bool isProcessing = false;
    private bool viewRequirements = false;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Email))
        {
            ResetModel.Email = Email;
            ResetModel.Token = Token ?? string.Empty;
        }
    }

    private bool PasswordsMatch =>
        !string.IsNullOrEmpty(ResetModel.NewPassword) &&
        ResetModel.NewPassword == ConfirmPassword;

    private async Task HandleResetAsync()
    {
        errorMessage = null;
        successMessage = null;
        isProcessing = true;
        StateHasChanged();

        try
        {
            Logger.LogInformation("Attempting password reset for {Email}", ResetModel.Email);

            var response = await ApiService.PostAsync<ResetPasswordModel, ApiResponse>(
                "/Security/reset-password", ResetModel);

            if (response?.Success ?? false)
            {
                successMessage = "Password reset successfully! Redirecting to login...";
                Logger.LogInformation("Password reset successful for {Email}", ResetModel.Email);
                
                await Task.Delay(2000); // Show success message for 2 seconds
                Navigation.NavigateTo("/home");
            }
            else
            {
                errorMessage = response?.Message ?? "Password reset failed. Please try again.";
                Logger.LogWarning("Password reset failed for {Email}: {Message}", ResetModel.Email, response?.Message);
            }
        }
        catch (PulseApiException ex)
        {
            Logger.LogError(ex, "API error during password reset: {UserMessage}", ex.UserMessage);
            
            errorMessage = ex.Category switch
            {
                ErrorCategory.Network => "Unable to connect to server. Check your internet connection.",
                ErrorCategory.Validation => "Invalid or expired reset link. Please request a new password reset.",
                ErrorCategory.Server => "Server error. Please try again later.",
                _ => ex.UserMessage ?? "Password reset failed. Please try again."
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error during password reset: {Message}", ex.Message);
            errorMessage = "An unexpected error occurred. Please try again later.";
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private void GoBackToLogin()
    {
        Navigation.NavigateTo("/home");
    }
}
