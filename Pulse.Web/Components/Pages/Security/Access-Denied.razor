@using Microsoft.FluentUI.AspNetCore.Components
@inject NavigationManager Navigation

<div class="  divShadow" style="display: flex;overflow:hidden; justify-content:center;background-color:rgba(255,255,255,0.5);border:2px solid black;margin-top:10vh;margin-left:10vw;height:70vh;width:80vw;align-items:center;text-align:center">
    <div class="stack-vertical" style="align-items: center; justify-content: start; column-gap: 10px; row-gap: 10px; width: 100%; margin:20px; justify-content:center;">
        <p><h5>You are not logged in</h5></p>
        <FluentButton Appearance="Appearance.Accent" OnClick="HandleLoginClick">
            Login Here
        </FluentButton>
    </div>
</div>

@code {
    private void HandleLoginClick()
    {
        Navigation.NavigateTo("/login");
    }
}