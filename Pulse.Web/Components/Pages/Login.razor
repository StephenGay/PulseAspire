@page "/login"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Models.Users  // For LoginModel, if in shared Models project
@using Pulse.Web.Services
@using Toolbelt.Blazor.SpeechSynthesis

@inject IHttpClientFactory HttpFactory  // Configured in Program.cs for API calls with cookies
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider  // For notifying auth changes (if custom; optional with cookie auth)
@inject PulseApiService _pulseApiClient
@inject DataTransferService dT

@inject SpeechSynthesis SpeechSynthesis
@rendermode InteractiveServer

<FluentCard>
    <h3>Login</h3>
    <FluentTextField @bind-Value="loginModel.Email" Label="Email" /> 
    <FluentTextField @bind-Value="loginModel.Password" Label="Password" Type="password" /> 
    <FluentButton @onclick="HandleLogin" Appearance="Appearance.Accent">Login</FluentButton>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <FluentMessageBar Severity="MessageSeverity.Error">@errorMessage</FluentMessageBar>
    }
</FluentCard>

    @code {
    private LoginModel loginModel = new();
    private string errorMessage;
    IEnumerable<SpeechSynthesisVoice> Voices;
    private SpeechSynthesisVoice? _voice;
    private string? firstName;
    private async Task HandleLogin()
    {
        errorMessage = null;
        try
        {
            var client = HttpFactory.CreateClient("PulseApiClient");  // Named client with UseDefaultCredentials for cookies
            var response = await client.PostAsJsonAsync("/Security/login", loginModel);
            //var response = await _pulseApiClient.PostAsync("/Security/login", loginModel);
            if (response.IsSuccessStatusCode)
            {
                // Optional: Notify auth state if using custom provider
                // ((CustomAuthenticationStateProvider)AuthStateProvider).MarkUserAsAuthenticated(/* token or cookie handled server-side */);
                User? user = await _pulseApiClient.GetAsync<User>($"/Security/EmployeeLogin/email={loginModel.Email}");
                if (user == null)
                {
                    errorMessage = "Invalid E-Mail or Password. Please try again.";
                    return;
                }
                errorMessage = string.Empty;
                await dT.SetgvUser(user);
                firstName = await dT.GetgvUserFirstName();
                if(user.UserSettings.AIHasVoice)
                {
                    Voices = await SpeechSynthesis.GetVoicesAsync();
                    _voice = Voices.FirstOrDefault(v => v.VoiceIdentity.ToString() == user.UserSettings.AIVoiceID);
                    if (_voice != null)
                    {
                        var utterancet = new SpeechSynthesisUtterance
                        {
                            Text = $"Hey {firstName}, Welcome back!",
                            Voice = _voice // this.Voices.FirstOrDefault(v => v.Name.Contains("Haruka"))
                        };
                        await this.SpeechSynthesis.SpeakAsync(utterancet);
                        await dT.SetgvUserAIVoice(_voice);
                        // await SpeechSynthesis.SpeakAsync("Login successful. Welcome back!", _voice);
                    }
                };
                Navigation.NavigateTo("/DivisionLogon?nextpage=/EmployeeZone/");  // Redirect to home or dashboard
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Login failed: {ex.Message}";
        }
    }
}