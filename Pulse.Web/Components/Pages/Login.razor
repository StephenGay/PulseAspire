@page "/login"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.FluentUI.AspNetCore.Components
@using Pulse.Models.AI.AIds
@using Pulse.Models.Misc
@using Pulse.Models.Users  // For LoginModel, if in shared Models project
@using Pulse.Web.Services
@using Toolbelt.Blazor.SpeechSynthesis

@inject IHttpClientFactory HttpFactory  // Configured in Program.cs for API calls with cookies
@inject NavigationManager Navigation
@* @inject AuthenticationStateProvider AuthStateProvider  // For notifying auth changes (if custom; optional with cookie auth) *@
@inject PulseApiService _pulseApiClient
@inject DataTransferService dT
@inject IJSRuntime JS
@inject SpeechSynthesis SpeechSynthesis
@inject CustomAuthenticationStateProvider AuthProvider
@inject AuthService AuthService
@* @rendermode InteractiveServer *@

<FluentCard Style="min-width:500px">
    <FluentHeader Style="background-color:#365b66">
        Login
    </FluentHeader>
    <FluentBodyContent>
    <br />
        <FluentTextField @bind-Value="Model.Email" Label="Email" Style="width:100%" />
        <FluentTextField @bind-Value="Model.Password" Label="Password" Style="width:100%" Type="password" />
    <br />
     @if (!string.IsNullOrEmpty(errorMessage))
    {
            <FluentMessageBar Severity="MessageSeverity.Error">@errorMessage</FluentMessageBar>
    }   
    </FluentBodyContent>
    <FluentFooter>
        <FluentStack Orientation="Orientation.Horizontal">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.Start">
                <FluentButton Appearance="Appearance.Neutral" @onclick="btnRegisterClick">Register</FluentButton>
            </FluentStack>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment.End">
                <FluentButton @onclick="HandleLogin" BackgroundColor="#365b66" Appearance="Appearance.Accent">Login</FluentButton>
            </FluentStack>
        </FluentStack>
    </FluentFooter>
</FluentCard>

@code {
    // private LoginModel loginModel = new();
    private string errorMessage;
    IEnumerable<SpeechSynthesisVoice> Voices;
    private SpeechSynthesisVoice? _voice;
    private string? firstName;
    private string? pTheme;
    private LoginModel Model = new();

    private void btnRegisterClick()
    {
        Navigation.NavigateTo("/register");
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Voices = await SpeechSynthesis.GetVoicesAsync();
        }
    }
    
    private async Task HandleLogin()
    {
        errorMessage = null;
        try
        {
            var client = HttpFactory.CreateClient("PulseApiClient");  // Named client with UseDefaultCredentials for cookies
            var response = await client.PostAsJsonAsync("/Security/login", Model);
            // var response = await _pulseApiClient.PostAsync("/Security/login", Model);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"Login failed with status code: {response.StatusCode}";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<AuthResponse>();
            if (string.IsNullOrEmpty(result?.Token))
            {
                errorMessage = "Login returned no token";
                return;
            }

            if (response.IsSuccessStatusCode)
            // var result = await AuthService.Login(Model);
            // if (result == "Success")
            {
                // Optional: Notify auth state if using custom provider
                await AuthService.SetAuthenticatedAsync(result.Token);
                AuthProvider.NotifyStateChanged();
                // ((CustomAuthenticationStateProvider)AuthStateProvider).MarkUserAsAuthenticated(/* token or cookie handled server-side */);
                User? user = await _pulseApiClient.GetAsync<User>($"/Security/EmployeeLogin/email={Model.Email}");
                if (user == null)
                {
                    errorMessage = "Invalid E-Mail or Password. Please try again.";
                    return;
                }
                errorMessage = string.Empty;
                await dT.SetgvUser(user);
                pTheme = user.UserSettings!.UserTheme ?? "pulse";
                await JS.InvokeVoidAsync("applyPulseTheme", pTheme);
                firstName = await dT.GetgvUserFirstName();
                if (user.UserSettings.AIHasVoice)
                {
                    _voice = Voices.FirstOrDefault(v => v.VoiceIdentity.ToString() == user.UserSettings.AIVoiceID);

                    if (_voice != null)
                    {
                        await dT.SetgvUserAIVoice(_voice);
                        await aiSpeak($"Hey {firstName}, Welcome back!", _voice);
                        // await aiSpeak($"Just waiting for the team to check in then we will get going.", _voice);

                        // await SpeechSynthesis.SpeakAsync("Login successful. Welcome back!", _voice);
                    }
                }
                ;
                Tables tables = new Tables();
                tables._Voice = Voices.FirstOrDefault(v => v.VoiceIdentity.ToString() == tables._VoiceId);
                await dT.SetgvTables(tables);
                // await aiSpeak($"Tables here, ready to go!", tables._Voice);

                Ali ali = new Ali();
                ali._Voice = Voices.FirstOrDefault(v => v.VoiceIdentity.ToString() == ali._VoiceId);
                await dT.SetgvAli(ali);
                // await aiSpeak($"Yep, me too!", ali._Voice);

                // await aiSpeak($"Oh it's Ali by the way!", ali._Voice);

                Flapper flapper = new Flapper();
                flapper._Voice = Voices.FirstOrDefault(v => v.VoiceIdentity.ToString() == flapper._VoiceId);
                await dT.SetgvFlapper(flapper);
                // await aiSpeak($"Flapper ready to chat!", flapper._Voice);
                ShowAiIcon showAiIcon = new ShowAiIcon();
                await dT.SetgvShowAI(showAiIcon);

                Navigation.NavigateTo("/DivisionLogon?nextpage=/EmployeeZone/");  // Redirect to home or dashboard
            }
            else
            {
                errorMessage = result.ToString();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Login failed: {ex.Message}";
        }
    }

    public async Task aiSpeak(string txt, SpeechSynthesisVoice vc)
    {
        var utterancet = new SpeechSynthesisUtterance
        {
            Text = txt,
            Voice = vc // this.Voices.FirstOrDefault(v => v.Name.Contains("Haruka"))
        };
        await this.SpeechSynthesis.SpeakAsync(utterancet);
        // return ;
    }
}