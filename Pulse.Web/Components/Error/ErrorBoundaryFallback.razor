@inject NavigationManager Navigation

<div class="error-container p-4 text-center">
    <RadzenIcon Icon="error" Style="font-size: 4rem; color: var(--rz-danger);" />
    <h3 class="mt-3">Something went wrong</h3>
    <p class="text-muted">Don't worry — this has been logged. You can try again or go back to the dashboard.</p>

    <div class="d-flex justify-content-center gap-2 mt-4">
        <RadzenButton Text="Try Again"
                      ButtonStyle="ButtonStyle.Primary"
                      Click="Reload" />
        <RadzenButton Text="Go to Dashboard"
                      ButtonStyle="ButtonStyle.Secondary"
                      Click="GoHome" />
    </div>
</div>

@code {
    private void Reload() => Navigation.NavigateTo(Navigation.Uri, true);
    private void GoHome() => Navigation.NavigateTo("/EmployeeZone/");
}